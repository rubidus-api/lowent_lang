# Public surface is a WHITELIST: everything is ignored unless listed below.
# (Development material lives in a separate private repository; its files may
#  appear here as untracked symlinks and must never be committed.)
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/pkg.low
!/impl/
!/lib/
!/skills/
!/docs/
/docs/*
!/docs/spec/
!/docs/manual/
!/docs/example/
!/docs/proofs/
!/docs/book/
!/docs/index.html
!/docs/.nojekyll

# never public, even inside whitelisted folders
/impl/tests/golden.sh
/impl/tests/run-golden.sh
/impl/tests/.lw_*.low
/impl/tests/.z.low
/docs/spec/INTERNAL-*.md
/docs/spec/PRINCIPLES.md
/docs/spec/LEDGER.tsv
/docs/spec/COVERAGE.tsv
/docs/example/algo-global.md
/docs/example/context.md
/docs/example/generational-handle.md
/docs/example/coop-scheduler.md
/docs/example/priority-ceiling.md
/docs/example/labeled-block.md
/docs/example/llms-txt.md
/docs/example/cross-build.md
/docs/example/reactor.md
/docs/example/representations.md
/docs/example/build-manifest.md
/docs/example/build-scale.md

# book build products (PDFs go to releases; the web edition under web/ is committed for GitHub Pages)
/docs/book/build/

# Coq build products (the .v sources, Makefile and notes are public)
/docs/proofs/**/*.vo
/docs/proofs/**/*.vok
/docs/proofs/**/*.vos
/docs/proofs/**/*.glob
/docs/proofs/**/.*.aux
/docs/proofs/**/.*.cache
/docs/proofs/**/*.cm*
/docs/proofs/coq/lowent_cert.ml*
/docs/proofs/coq/cert_check

# build output
build/
build-archdev-*/
dist/
__pycache__/
*.pyc
*.o
*.tmp
*.log
.DS_Store
*.swp
*~
