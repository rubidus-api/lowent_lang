rem lowdiff — 두 폴더를 이름·크기·시각이 아니라 **내용으로** 비교한다 (X-0030 · 2026-10-03 새로 씀).
rem
rem   걷는 법: 경로를 다 모으지 않는다. 디렉터리 **쌍** 하나씩 — 양쪽 엔트리 이름을 읽어 정렬하고 합치며,
rem   둘 다 디렉터리인 것은 대기 목록에 넣는다. 그래서 메모리가 나무의 파일 수를 따라가지 않는다.
rem   파일 내용은 64 KiB 청크로 견준다 — 큰 파일도 버퍼는 그대로다.
rem
rem   한 줄 = 한 발견: added · deleted · changed · unreadable · skipped · symlink.
rem   읽지 못한 것은 «같다» 도 «없다» 도 아니다 — 따로 말하고, 멈추지 않는다.
rem   심링크는 따라가지 않는다: 한쪽만 링크면 차이, 양쪽 다 링크면 견주지 않고 `symlink` 로 말한다.
rem   종료 코드: 0 같다 · 1 차이 · 2 사용법 · 3 내부 한도(조용히 자르지 않는다) · 70 메모리.

module lowdiff .

use files .
use outbuf .

rem ── 한도: «기계가 못 해서» 가 아니라 «여기까지는 본다». 넘치면 말하고 3 으로 끝난다.
fn max_entries output u64 . do
  return 4096 .
end .

fn max_names output u64 . do
  return 262144 .
end .

fn max_pend output u64 . do
  return 4096 .
end .

rem 발견 한 줄을 끝까지 쓴다(잎은 짧게 쓸 수 있다 — outbuf.write_all 이 되풀이한다).
proc say input out cap io . input kind slice u8 . input rel slice u8 . output void . effects io . do
  let w1 option u64 outbuf.write_all out. 1 kind. . .
  let w2 option u64 outbuf.write_all out. 1 " " . .
  let w3 option u64 outbuf.write_all out. 1 rel. . .
  let w4 option u64 outbuf.write_all out. 1 "\n" . .
  return .
end .

rem 바이트 사전순으로 a < b 인가.
fn less input a slice u8 . input b slice u8 . output bool . do
  repeat i u64 min len a. . len b. . . do
    if ne idx a. i. . idx b. i. . . do
      return lt idx a. i. . idx b. i. . . .
    end .
  end .
  return lt len a. . len b. . . .
end .

rem arena 안의 i 번째 이름.
fn name_of input arena slice u8 . input offs slice u64 . input lens slice u64 . input i u64 . output slice u8 . do
  return subslice arena. idx offs. i. . add idx offs. i. . idx lens. i. . . . .
end .

rem 이름 색인을 바닥에서 위로 합쳐 정렬한다(안정 — 같으면 왼쪽). tmpo · tmpl 은 같은 크기의 임시 자리.
proc sort_names input arena slice u8 . input offs mut slice u64 . input lens mut slice u64 . input tmpo mut slice u64 . input tmpl mut slice u64 . input n u64 . output void . effects none .
  requires le n. len offs. . . .
  requires le n. len lens. . . .
  requires le n. len tmpo. . . .
  requires le n. len tmpl. . . .
do
  cycle w u64 1 while lt w. n. . next mul w. 2 . do
    cycle lo u64 0 while lt lo. n. . next add lo. mul w. 2 . . do
      let mid u64 min add lo. w. . n. . .
      let hi u64 min add lo. mul w. 2 . . n. . .
      var ia u64 lo. .
      var ib u64 mid. .
      cycle k u64 lo. while lt k. hi. . next add k. 1 . do
        var take_b bool false .
        if and lt ib. hi. . lt ia. mid. . . do
          set take_b. less name_of arena. offs. lens. ib. . name_of arena. offs. lens. ia. . . .
        end else if ge ia. mid. . do
          set take_b. true .
        end .
        if take_b. do
          set idx tmpo. k. . idx offs. ib. . .
          set idx tmpl. k. . idx lens. ib. . .
          set ib. add ib. 1 . .
        end else do
          set idx tmpo. k. . idx offs. ia. . .
          set idx tmpl. k. . idx lens. ia. . .
          set ia. add ia. 1 . .
        end .
      end .
      cycle m u64 lo. while lt m. hi. . next add m. 1 . do
        set idx offs. m. . idx tmpo. m. . .
        set idx lens. m. . idx tmpl. m. . .
      end .
    end .
  end .
  return .
end .

fn is_dot_name input nm slice u8 . output bool . do
  guard eq idx nm. 0 . '.' . else return false . .
  return or eq len nm. . 1 . and eq len nm. . 2 . eq idx nm. 1 . '.' . . . .
end .

rem 한 디렉터리의 이름을 모아 정렬한다(`.`·`..` 은 뺀다). 개수를 내고, 상태를 st[0] 에 적는다:
rem 0 = 됐다 · 3 = 한도 · 71 = 열기·읽기 실패 · 72 = 닫기 실패.
proc list_dir input fs cap file_system . input path slice u8 . input namebuf mut slice u8 . input arena mut slice u8 . input offs mut slice u64 . input lens mut slice u64 . input tmpo mut slice u64 . input tmpl mut slice u64 . input st mut slice u64 . output u64 . effects io .
  requires ge len st. . 1 . .
do
  set idx st. 0 . 0 .
  let opened result files.dir_handle files.file_error files.open_dir fs. path. . .
  guard is_ok opened. . else do
    set idx st. 0 . 71 .
    return 0 .
  end .
  var dh owned files.dir_handle ok_value opened. . .
  var n u64 0 .
  var used u64 0 .
  while true do
    let r result (option u64) files.file_error files.read_dir fs. dh. namebuf. . .
    guard is_ok r. . else do
      set idx st. 0 . 71 .
      break .
    end .
    let got option u64 ok_value r. . .
    guard is_some got. . else break . .
    let nl u64 some_value got. . .
    guard and gt nl. 0 . le nl. len namebuf. . . . else break . .
    if is_dot_name subslice namebuf. 0 nl. . . do
      continue .
    end .
    guard and lt n. max_entries. . le add used. nl. . max_names. . . else do
      set idx st. 0 . 3 .
      break .
    end .
    guard and lt n. len offs. . . and lt n. len lens. . . le add used. nl. . len arena. . . . . else do
      set idx st. 0 . 3 .
      break .
    end .
    set idx offs. n. . used. .
    set idx lens. n. . nl. .
    repeat c u64 nl. do
      set idx arena. add used. c. . . idx namebuf. c. . .
    end .
    set used. add used. nl. . .
    set n. add n. 1 . .
  end .
  let closed result void files.file_error files.close_dir fs. dh. . .
  if not is_ok closed. . . do
    set idx st. 0 . 72 .
  end .
  guard and le n. len offs. . . and le n. len lens. . . and le n. len tmpo. . . le n. len tmpl. . . . . . else return n. . .
  sort_names arena. offs. lens. tmpo. tmpl. n. .
  return n. .
end .

rem 같은 바이트열인가. ★ 순수 fn 으로 따로 둔다: 파일 잎을 부르는 proc 은 꼬리표 붙은 느린 길에 남으므로(`--why-slow`),
rem   바이트마다 도는 고리를 그 안에 두면 바이트마다 느린 길을 탄다 — 이 고리를 same_file 안에 두었던 첫 새 판이
rem   3,042 개 파일(110 MB)에서 56 초 걸렸다(옛 판 0.6 초, 2026-10-03 실측).
fn same_bytes input a slice u8 . input b slice u8 . output bool . do
  guard eq len a. . len b. . . else return false . .
  repeat i u64 len a. . do
    guard eq idx a. i. . idx b. i. . . else return false . .
  end .
  return true .
end .

rem 두 파일을 청크로 견준다: 0 = 같다 · 1 = 다르다 · 2 = 읽지 못했다.
rem files.read 는 셋을 가른다 — 오류 · 끝(none) · n 바이트. 끝과 실패를 뭉개면 «읽다 만 파일» 이 «같다» 가 된다.
proc same_file input fs cap file_system . input pa slice u8 . input pb slice u8 . input ba mut slice u8 . input bb mut slice u8 . output u64 . effects io . do
  let ha result files.handle files.file_error files.open fs. pa. 0 . .
  guard is_ok ha. . else return 2 . .
  var fa owned files.handle ok_value ha. . .
  let hb result files.handle files.file_error files.open fs. pb. 0 . .
  if not is_ok hb. . . do
    let ca result void files.file_error files.close fs. fa. . .
    drop ca. .
    return 2 .
  end .
  var fb owned files.handle ok_value hb. . .
  var verdict u64 0 .
  while true do
    let ra result (option u64) files.file_error files.read fs. fa. ba. . .
    let rb result (option u64) files.file_error files.read fs. fb. bb. . .
    guard and is_ok ra. . is_ok rb. . . else do
      set verdict. 2 .
      break .
    end .
    var na u64 0 .
    var nb u64 0 .
    let oa option u64 ok_value ra. . .
    let ob option u64 ok_value rb. . .
    if is_some oa. . do
      set na. some_value oa. . .
    end .
    if is_some ob. . do
      set nb. some_value ob. . .
    end .
    guard eq na. nb. . else do
      set verdict. 1 .
      break .
    end .
    guard gt na. 0 . else break . .
    guard and le na. len ba. . . le na. len bb. . . . else do
      set verdict. 2 .
      break .
    end .
    guard same_bytes subslice ba. 0 na. . subslice bb. 0 nb. . . else do
      set verdict. 1 .
      break .
    end .
  end .
  let ca2 result void files.file_error files.close fs. fa. . .
  let cb2 result void files.file_error files.close fs. fb. . .
  guard and is_ok ca2. . is_ok cb2. . . else return 2 . .
  return verdict. .
end .

rem 심링크 짝: 0 = 둘 다 아니다 · 1 = 둘 다 링크 · 2 = 한쪽만 링크. link_type 은 링크를 따라가지 않는다(3 = 링크).
proc link_pair input fs cap file_system . input pa slice u8 . input pb slice u8 . output u64 . effects io . do
  let la option u64 files.link_type_of fs. pa. . .
  let lb option u64 files.link_type_of fs. pb. . .
  let sa bool and is_some la. . eq value_or la. 0 . 3 . . .
  let sb bool and is_some lb. . eq value_or lb. 0 . 3 . . .
  guard eq sa. sb. . else return 2 . .
  guard not sa. . else return 1 . .
  return 0 .
end .

rem base + "/" + name 을 buf 에 짓는다(base 가 비었으면 name 만). 길이를 st[0] 에 적고, 자리가 모자라면 거짓.
proc join_path input base slice u8 . input name slice u8 . input buf mut slice u8 . input st mut slice u64 . output bool . effects none .
  requires ge len st. . 1 . .
do
  var head u64 0 .
  if gt len base. . 0 . do
    set head. add len base. . 1 . .
  end .
  let total u64 add head. len name. . . .
  guard le total. len buf. . . else return false . .
  repeat bi u64 len base. . do
    set idx buf. bi. . idx base. bi. . .
  end .
  if gt head. 0 . do
    set idx buf. len base. . . '/' .
  end .
  repeat ni u64 len name. . do
    set idx buf. add head. ni. . . idx name. ni. . .
  end .
  set idx st. 0 . total. .
  return true .
end .

rem 양쪽에 다 있는 이름 하나를 본다. 내는 수: 0 = 말할 것 없음 · 1 = 차이 · 2 = 읽기 실패(차이로도 센다) ·
rem 4 = 둘 다 디렉터리(부르는 쪽이 대기 목록에 넣는다).
proc visit_both input fs cap file_system . input out cap io . input pa slice u8 . input pb slice u8 . input rel slice u8 . input ca mut slice u8 . input cb mut slice u8 . output u64 . effects io . do
  let lp u64 link_pair fs. pa. pb. . .
  if eq lp. 1 . do
    say out. "symlink" rel. .
    return 0 .
  end .
  if eq lp. 2 . do
    say out. "changed" rel. .
    return 1 .
  end .
  let ka u64 value_or files.type_of fs. pa. . 9 . .
  let kb u64 value_or files.type_of fs. pb. . 9 . .
  if ne ka. kb. . do
    say out. "changed" rel. .
    return 1 .
  end .
  if eq ka. 1 . do
    return 4 .
  end .
  if eq ka. 0 . do
    let v u64 same_file fs. pa. pb. ca. cb. . .
    if eq v. 1 . do
      say out. "changed" rel. .
      return 1 .
    end .
    if eq v. 2 . do
      say out. "unreadable" rel. .
      return 2 .
    end .
    return 0 .
  end .
  rem 보통 파일도 디렉터리도 아닌 것(장치·파이프) — 견주지 않고 말한다.
  say out. "skipped" rel. .
  return 0 .
end .

proc main
  input fs cap file_system .
  input out cap io .
  input hp cap heap .
  input a  cap args .
  output u8 .
  effects heap io .
do
  let usage slice u8 "usage: lowdiff <before-dir> <after-dir>\n" .
  let a0 option slice u8 arg a. 0 . .
  let a1 option slice u8 arg a. 1 . .
  guard and is_some a0. . is_some a1. . . else do
    let wu option u64 outbuf.write_all out. 2 usage. . .
    return 2 .
  end .
  let root_a slice u8 some_value a0. . .
  let root_b slice u8 some_value a1. . .

  rem 버퍼는 한 덩어리(약 1.2 MiB)를 자라는 뿌리에서 한 번 받아 나눠 쓴다. 고정 창(64 KiB)에는 안 들어가고
  rem 이 도구는 운영체제 위에서만 뜻이 있다 — 서명(cap heap · effects heap)이 그렇게 말하므로
  rem `--target cortex_m --check` 는 본문을 열기 전에 거절한다(E-HEAP-NOHOST).
  let got option mut slice u8 alloc_bytes hp. capacity 1196096 . .
  guard is_some got. . else return 70 . .
  let mem mut slice u8 some_value got. . .
  let namebuf mut slice u8 subslice mem. 0 4096 . .
  let arena_a mut slice u8 subslice mem. 4096 266240 . .
  let arena_b mut slice u8 subslice mem. 266240 528384 . .
  let offs_a mut slice u64 view_array u64 subslice mem. 528384 561152 . . .
  let lens_a mut slice u64 view_array u64 subslice mem. 561152 593920 . . .
  let offs_b mut slice u64 view_array u64 subslice mem. 593920 626688 . . .
  let lens_b mut slice u64 view_array u64 subslice mem. 626688 659456 . . .
  let pend mut slice u8 subslice mem. 659456 921600 . .
  let poffs mut slice u64 view_array u64 subslice mem. 921600 954368 . . .
  let plens mut slice u64 view_array u64 subslice mem. 954368 987136 . . .
  let relbuf mut slice u8 subslice mem. 987136 991232 . .
  let path_a mut slice u8 subslice mem. 991232 995328 . .
  let path_b mut slice u8 subslice mem. 995328 999424 . .
  let chunk_a mut slice u8 subslice mem. 999424 1064960 . .
  let chunk_b mut slice u8 subslice mem. 1064960 1130496 . .
  let st mut slice u64 view_array u64 subslice mem. 1130496 1130560 . . .
  let tmpo mut slice u64 view_array u64 subslice mem. 1130560 1163328 . . .
  let tmpl mut slice u64 view_array u64 subslice mem. 1163328 1196096 . . .

  rem 대기 목록 = 아직 안 본 상대 경로. 뒤에서 꺼낸다. 시작은 뿌리(빈 경로) 하나.
  var np u64 1 .
  set idx poffs. 0 . 0 .
  set idx plens. 0 . 0 .
  var diffs u64 0 .
  var limit_hit bool false .

  while and gt np. 0 . not limit_hit. . . do
    set np. sub np. 1 . .
    let ro u64 idx poffs. np. . .
    let rel slice u8 subslice pend. ro. add ro. idx plens. np. . . . .
    var pused u64 ro. .
    guard join_path root_a. rel. path_a. st. . else do
      set limit_hit. true .
      break .
    end .
    let la u64 idx st. 0 . .
    guard join_path root_b. rel. path_b. st. . else do
      set limit_hit. true .
      break .
    end .
    let lb u64 idx st. 0 . .
    let n_a u64 list_dir fs. subslice path_a. 0 la. . namebuf. arena_a. offs_a. lens_a. tmpo. tmpl. st. . .
    let st_a u64 idx st. 0 . .
    let n_b u64 list_dir fs. subslice path_b. 0 lb. . namebuf. arena_b. offs_b. lens_b. tmpo. tmpl. st. . .
    let st_b u64 idx st. 0 . .
    if or eq st_a. 3 . eq st_b. 3 . . do
      set limit_hit. true .
      break .
    end .
    if or gt st_a. 3 . gt st_b. 3 . . do
      set diffs. add diffs. 1 . .
    end .

    rem 두 정렬 목록을 합친다. 하위 디렉터리는 대기 목록 끝에 쌓는다 — 꺼낸 경로의 바이트 자리부터 덮어쓰므로
    rem (자식 경로는 부모 경로로 시작해 앞부분이 그대로다) 대기 목록은 늘 «마지막에 넣은 것을 먼저» 꺼내야 한다.
    var ia u64 0 .
    var ib u64 0 .
    while or lt ia. n_a. . lt ib. n_b. . . do
      var side u64 0 .
      if ge ia. n_a. . do
        set side. 2 .
      end else if ge ib. n_b. . do
        set side. 1 .
      end else if less name_of arena_a. offs_a. lens_a. ia. . name_of arena_b. offs_b. lens_b. ib. . . do
        set side. 1 .
      end else if less name_of arena_b. offs_b. lens_b. ib. . name_of arena_a. offs_a. lens_a. ia. . . do
        set side. 2 .
      end .
      var nm slice u8 "" .
      if eq side. 2 . do
        set nm. name_of arena_b. offs_b. lens_b. ib. . .
      end else do
        set nm. name_of arena_a. offs_a. lens_a. ia. . .
      end .
      guard join_path rel. nm. relbuf. st. . else do
        set limit_hit. true .
        break .
      end .
      let child slice u8 subslice relbuf. 0 idx st. 0 . . .
      if eq side. 1 . do
        say out. "deleted" child. .
        set diffs. add diffs. 1 . .
        set ia. add ia. 1 . .
        continue .
      end .
      if eq side. 2 . do
        say out. "added" child. .
        set diffs. add diffs. 1 . .
        set ib. add ib. 1 . .
        continue .
      end .
      set ia. add ia. 1 . .
      set ib. add ib. 1 . .
      guard join_path root_a. child. path_a. st. . else do
        set limit_hit. true .
        break .
      end .
      let pa_len u64 idx st. 0 . .
      guard join_path root_b. child. path_b. st. . else do
        set limit_hit. true .
        break .
      end .
      let pb_len u64 idx st. 0 . .
      let v u64 visit_both fs. out. subslice path_a. 0 pa_len. . subslice path_b. 0 pb_len. . child. chunk_a. chunk_b. . .
      if or eq v. 1 . eq v. 2 . . do
        set diffs. add diffs. 1 . .
      end .
      if eq v. 4 . do
        let cl u64 len child. . .
        guard and lt np. max_pend. . le add pused. cl. . len pend. . . . else do
          set limit_hit. true .
          break .
        end .
        set idx poffs. np. . pused. .
        set idx plens. np. . cl. .
        repeat z u64 cl. do
          set idx pend. add pused. z. . . idx child. z. . .
        end .
        set pused. add pused. cl. . .
        set np. add np. 1 . .
      end .
    end .
  end .

  if limit_hit. do
    let wl option u64 outbuf.write_all out. 2 "lowdiff: an internal limit was reached (entries per directory, path length, or pending directories) - the comparison is INCOMPLETE\n" . .
    return 3 .
  end .
  guard eq diffs. 0 . else return 1 . .
  return 0 .
end .
