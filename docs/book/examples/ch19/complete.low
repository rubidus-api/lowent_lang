module complete .
rem run: session 3

type journal u64 .

enum flush_error do
  disk_full .
end .

fn finish input j owned journal . output result u8 flush_error .
  errors disk_full .
do
  drop j .
  return ok 0 .
end .

fn session input n u64 . output result u8 flush_error .
  errors disk_full .
do
  var j owned journal be n .
  return finish j .
end .
