module greet .

use args .
use stdio .
rem ko: (인자는 네이티브와 VM 의 번호가 달라 여기서는 검사만 한다) /// en: (argument numbering differs between native and VM, so this is only checked)

proc main input out cap io . input a cap args . output u8 . effects io .
do
  let who option slice u8 args.get a. 0 . .
  guard is_some who. . else return cast u8 stdio.write out. 1 "no name\n" . . . .
  let n usize stdio.write out. 1 "hello, " . .
  let m usize stdio.write out. 1 some_value who. . . .
  let k usize stdio.write out. 1 "\n" . .
  return 0 .
end .
