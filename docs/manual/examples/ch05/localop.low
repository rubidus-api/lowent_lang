module localop .
rem run: count_selected [3,7,1,15] 3
rem run: parity 7

rem ko: 쓰는 자리 가까이에 둔 보조 op --- 이 op 안에서만 보인다 /// en: a helper op kept next to its use --- visible only inside this op
export fn count_selected input xs slice u8 . input mask u8 . output u64 .
do
  fn has_bits input x u8 . input bits u8 . output bool .
  do
    return eq (bit_and x bits) bits .
  end
  return pipe xs do
    filter has_bits with mask .
    count .
  end .
end

rem ko: 선언 앞에서 불러도 되고, 형제끼리 서로 불러도 된다 /// en: it may be called before its declaration, and siblings may call each other
export fn parity input n u64 . output u64 .
do
  fn is_even input k u64 . output u64 .
  do
    if eq k 0 . do
      return 1 .
    end
    return is_odd (sub k 1) .
  end
  fn is_odd input k u64 . output u64 .
  do
    if eq k 0 . do
      return 0 .
    end
    return is_even (sub k 1) .
  end
  return is_even n .
end
