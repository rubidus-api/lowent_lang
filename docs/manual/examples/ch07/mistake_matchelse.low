module mistake_matchelse .
rem expect: E-MATCH-INEXHAUSTIVE

fn band input n u64 . output u64 . do
  match n do
    case 1 do
      return 10 .
    end .
    case 2 to 5 do
      return 20 .
    end .
    rem ko: ✘ 나머지를 else 로 받는다 — 문법 부록과 진단은 권하지만 이 판의 도구는 받지 않는다 /// en: ✘ catching the rest with else; the grammar annex and the diagnostic suggest it, but this edition's tool does not accept it
    else do
      return 99 .
    end .
  end .
end .
