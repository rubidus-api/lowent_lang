module cellfill .
rem run: table 3 5
rem run: table 3 1

rem ko: 칸을 골라 채운다 --- 0 번과 5 번만 적고, 나머지 칸은 모두 1 /// en: fill chosen cells --- name cells 0 and 5, every other cell holds 1
export fn table input a u64 . input i u64 . output u64 .
do
  let t lit array u64 6 do 0 100 . 5 (mul a 2) . _ 1 . end .
  guard lt i 6 else return 0 .
  return idx t i .
end
