module mistake_viewro .
rem expect: E-TYPE-MUT

struct pt do
  x u8 .
  y u8 .
end .

fn mark input b slice u8 . output u8 . do
  rem ko: ✘ 읽기 전용으로 받은 바이트의 뷰를 쓸 수 있는 이름에 묶는다 --- 칸에 쓰면 부른 쪽의 b 가 바뀐다 /// en: ✘ a view of bytes received read-only is bound to a writable name --- a field write would change the caller's b
  var h pt view pt b. . .
  set field h. y . 9 .
  return 0 .
end .
