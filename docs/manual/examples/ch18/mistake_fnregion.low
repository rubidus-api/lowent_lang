module mistake_fnregion .
rem expect: E-EFFECT-CALC

rem ko: ✘ 한꺼번에 돌려주니 바깥에 남는 것이 없다고 보고 `fn` 으로 적었다 /// en: ✘ written as a `fn` on the idea that nothing is left outside, since everything is returned at once
fn scratch_len input n u64 . output u64 .
do
  region work arena do
    let g be option mut slice u8 alloc_bytes work capacity n .
    guard is_some g . else return 0 .
    return len (some_value g) .
  end
  return 0 .
end
