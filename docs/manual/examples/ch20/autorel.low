module autorel .
rem run: rounds 10

use allocs .

rem ko: 블록에서 받은 바이트는 블록을 나갈 때 돌려준다 --- 64 바이트로 32 바이트를 열 번 받는다 /// en: bytes taken in a block are given back when the block ends --- 32 bytes ten times out of 64
export proc rounds input n u64 . output u64 . effects state .
do
  var back be lit array u8 64 _ . .
  var bb be allocs.bump_bytes spawn actor allocs.bump_bytes .
  let got be u64 send bb init back .
  var s be u64 0 .
  var i be u64 0 .
  while lt i n . do
    var t using bb be mut slice u64 lit array u64 4 i _ . . else return 999 .
    set s (add s (idx t 0)) .
    set i (add i 1) .
  end
  return add s (mul (send bb used) 1000) .
end
