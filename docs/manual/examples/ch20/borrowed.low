module borrowed .
rem run: carve [0,0,0,0,0,0,0,0]

use allocs .

proc carve input buf mut slice u8 . output u64 . effects state .
do
  var a allocs.bump_bytes spawn actor allocs.bump_bytes .
  let room u64 send a init buf .
  let p option mut slice u8 send a reserve 3 .
  guard is_some p else return 91 .
  let pv mut slice u8 some_value p .
  set (idx pv 0) 65 .
  let q option mut slice u8 send a reserve 99 .
  guard is_none q else return 92 .
  return send a used .
end
