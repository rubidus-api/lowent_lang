module keepbuf .
rem run: handoff

use allocs .

rem ko: `keep` 을 붙이면 블록 끝에 돌려주지 않는다 --- 도움 op 이 만든 버퍼를 부른 쪽이 받는다 /// en: with `keep` nothing is given back at the end of the block --- the caller receives the buffer a helper built
proc make_buf input bb mut allocs.bump_bytes . input d mut slice u64 . . output mut slice u64 . . effects state .
do
  var t using bb keep be mut slice u64 lit array u64 2 7 8 . . else return d .
  return t .
end

export proc handoff output u64 . effects state .
do
  var back be lit array u8 64 _ . .
  var d be lit array u64 1 _ . .
  var bb be allocs.bump_bytes spawn actor allocs.bump_bytes .
  let got be u64 send bb init back .
  let s be mut slice u64 make_buf bb d .
  return add (idx s 1) (mul (send bb used) 100) .
end
