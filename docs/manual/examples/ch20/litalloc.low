module litalloc .
rem run: fill 9

use allocs .

rem ko: 나열을 고른 할당기에서 받는다 --- 받으면 묶고, 바이트가 모자라면 `else` 로 /// en: take a list from the allocator you choose --- bind it if the bytes came, go to `else` if they ran out
export proc fill input a u64 . output u64 . effects state .
do
  var back be lit array u8 48 _ . .
  var bb be allocs.bump_bytes spawn actor allocs.bump_bytes .
  let got be u64 send bb init back .
  var xs using bb be mut slice u64 lit array u64 4 do 0 a . _ 1 . end . else return 0 .
  set (index xs 3) 100 .
  let big using bb be option mut slice u64 lit array u64 8 _ . .
  guard is_none big . else return 1 .
  return add (index xs 0) (index xs 3) .
end
