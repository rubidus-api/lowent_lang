module mistake_enumcase .
rem run: describe 5
rem run: describe 500

use sizes from "sizes.low" .

fn describe input n u64 . output u64 . do
  let k be sizes.kind sizes.classify n .
  match k do
    rem ko: ✘ 모듈 이름을 붙인 갈래 — 이 판에서는 어떤 값에나 맞는다 /// en: ✘ a variant with the module name in front; in this edition it matches any value
    case sizes.small do
      return 1 .
    end
    case sizes.big do
      return 2 .
    end
  end
end
