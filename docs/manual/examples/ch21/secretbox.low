module secretbox .
rem expect: W-EXPORT-HIDDEN

rem ko: `export` 가 없는 타입 --- 이 모듈 밖에서는 이름을 적을 수 없다 /// en: a type without `export` --- its name cannot be written outside this module
struct secret do
  v u64 .
end

rem ko: ✘ 내보낸 op 이 감춘 타입을 돌려준다 --- 들여온 쪽은 그 이름을 적을 수 없다 /// en: ✘ an exported op returns the hidden type --- the importing side cannot write that name
export fn make_secret output secret .
do
  return make secret do v 1 . end .
end
