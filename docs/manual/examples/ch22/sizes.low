module sizes .
rem run: report

fn bytes_for input comptime t type . input items u64 . output usize .
  requires le items. 1000000 . .
do
  return mul size_of t . cast usize items. . . .
end .

fn add_const input comptime n u8 . input a u8 . output u8 .
  requires le a. 200 . .
do
  return add a. n. . .
end .

fn report output usize .
do
  let a usize bytes_for u8. 100 . .
  let b usize bytes_for u64. 100 . .
  let c u8 add_const 7 10 . .
  return add add a. b. . cast usize c. . . .
end .
