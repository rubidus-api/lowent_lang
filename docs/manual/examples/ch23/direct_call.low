module direct_call .
rem run: f

struct rect do
  w u64 .
  h u64 .
end
fn rect.area input s rect . output u64 .
do
  return mul (field s w) (field s h) .
end
fn f output u64 .
do
  let r be rect make rect do w 2 . h 3 . end .
  rem ko: 같은 op 을 두 길로 부른다 --- 이름으로 곧장, 그리고 `method` 로 /// en: the same op called two ways --- directly by name, and through `method`
  return add (rect.area r) (method r area) .
end
