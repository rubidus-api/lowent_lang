module lambda_fixed .
rem run: count_big [1,2,3,4,5]

rem ko: 조건에 이름을 붙인다 --- 이름이 곧 설명이 된다 /// en: give the condition a name --- the name becomes its explanation
fn over2 input a u8 . output bool .
do
  return gt a 2 .
end

fn count_big input xs slice u8 . output u64 .
do
  return pipe xs do
    filter over2 .
    count .
  end
end
