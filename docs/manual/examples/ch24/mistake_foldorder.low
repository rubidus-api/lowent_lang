module mistake_foldorder .
rem run: sum_small_right [1,2,3,200]
rem run: sum_small_wrong [1,2,3,200]

rem ko: 올바른 차례 --- 누산값이 먼저, 원소가 다음 /// en: the right order --- accumulator first, element second
fn add_small input acc u64 . input x u8 . output u64 .
  requires le acc 1000000 .
do
  guard lt x 100 . else return acc .
  return add acc (widen u64 x) .
end .

rem ko: ✘ 원소를 먼저 받았다 --- 누산값이 `x` 로, 원소가 `acc` 로 들어온다 /// en: ✘ takes the element first --- the accumulator arrives as `x`, the element as `acc`
fn add_small_swapped input x u8 . input acc u64 . output u64 .
  requires le acc 1000000 .
do
  guard lt x 100 . else return acc .
  return add acc (widen u64 x) .
end .

fn sum_small_right input xs slice u8 . output u64 .
do
  return pipe xs do
    fold 0 add_small .
  end .
end .

fn sum_small_wrong input xs slice u8 . output u64 .
do
  return pipe xs do
    fold 0 add_small_swapped .
  end .
end .
