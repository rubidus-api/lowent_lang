module short_buffer .
rem run: big_doubled [3,4,5,6] [0,0]

fn over2 input a u8 . output bool .
do
  return gt a 2 .
end

fn dbl input a u8 . output u8 .
do
  return wrap_add a a .
end

rem ko: 남는 원소는 넷인데 버퍼는 두 칸이다 --- 멈추지 않고 두 칸에서 끝난다 /// en: four elements remain but the buffer has two slots --- it does not stop; it ends after two
proc big_doubled input xs slice u8 . input out mut slice u8 . output u64 . effects none .
do
  pipe xs do
    filter over2 .
    map dbl .
    collect into out .
  end
  return len out .
end
