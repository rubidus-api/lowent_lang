module awaiting .
rem run: drive
rem test

fn square input n u64 . output u64 .
  requires le n 1000 .
do
  return mul n n .
end

proc drive output u64 . effects state .
do
  var r be u64 0 .
  task_group do
    var h1 be u64 spawn square 5 .
    var h2 be u64 spawn square 6 .
    let a be u64 await h1 .
    let b be u64 await h2 .
    set r (add a b) .
  end
  return r .
end

test join_any_order schedule explore_interleavings .
do
  var r be u64 0 .
  task_group do
    var h1 be u64 spawn square 5 .
    var h2 be u64 spawn square 6 .
    let a be u64 await h1 .
    let b be u64 await h2 .
    set r (add a b) .
  end
  expect eq r 61 .
end
