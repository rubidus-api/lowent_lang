module mistake_reduceinit .

fn total input s slice u8 . output u64 .
  parallel s split .
  reduce acc add .
do
  rem ko: ✘ 누산을 100 에서 시작한다 --- 나누면 조각마다 100 에서 시작한다 /// en: ✘ the accumulator starts at 100 --- once split, every piece starts at 100
  var acc u64 be 100 .
  var i u64 be 0 .
  while lt i (len s) . do
    set acc (add acc (widen u64 (index s i))) .
    set i (add i 1) .
  end .
  return acc .
end .
