module mistake_splatinline .
rem expect: E-VEC-SPLAT

fn capped input b slice u8 . output u32 .
do
  var xs slice u32 view_array u32 b .
  var v vec u32 4 load xs 0 .
  rem ko: ✘ `splat` 을 식 안에 바로 적었다 --- 레인 수를 말해 줄 타입이 없다 /// en: ✘ `splat` written inline --- nothing says how many lanes
  var over mask 4 gt v (splat 5) .
  return reduce_add (lane_select over v v) .
end
