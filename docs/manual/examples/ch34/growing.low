module growing .
rem run: main

use allocs .
use vecgen .

proc main input h cap heap . output u8 . effects heap state .
do
  var hb be allocs.heap_bytes spawn actor allocs.heap_bytes .
  let vo using hb be option (vecgen.vec u32 allocs.heap_bytes) vecgen.open u32 4 .
  guard is_some vo . else return 255 .
  var v be (vecgen.vec u32 allocs.heap_bytes) some_value vo .
  var i be u32 0 .
  while lt i 100 . do
    let pushed be bool vecgen.append u32 allocs.heap_bytes v (mul i 2) .
    guard pushed . else return 254 .
    set i (add i 1) .
  end
  let x be option u32 vecgen.at u32 allocs.heap_bytes v 50 .
  guard is_some x . else return 253 .
  return narrow u8 (some_value x) .
end
