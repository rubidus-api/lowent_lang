module sorted .
rem run: main

use sortlib .
use searchlib .

proc main input al cap allocator . output u8 . effects alloc .
do
  let g option mut slice u8 alloc_bytes al capacity 40 .
  guard is_some g else return 255 .
  var xs mut slice u64 view_array u64 (some_value g) .
  set (idx xs 0) 42 .
  set (idx xs 1) 7 .
  set (idx xs 2) 19 .
  set (idx xs 3) 3 .
  set (idx xs 4) 25 .
  sortlib.sort xs .
  let at option u64 searchlib.bsearch xs 19 .
  guard is_some at else return 254 .
  let missing option u64 searchlib.bsearch xs 20 .
  guard is_none missing else return 253 .
  return narrow u8 (add (mul (idx xs 0) 10) (some_value at)) .
end
