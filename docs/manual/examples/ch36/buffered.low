module buffered .
rem run: main

use outbuf .

proc main input out cap io . input al cap allocator . output u8 . effects io alloc .
do
  let g be option mut slice u8 alloc_bytes al capacity 8 .
  guard is_some g . else return 1 .
  let buf be mut slice u8 some_value g .
  var p be owned outbuf.pending outbuf.buf_open 1 .
  let r1 be result (owned outbuf.pending) outbuf.io_error outbuf.buf_write out p buf "buffered " .
  guard is_ok r1 . else return 2 .
  var p2 be owned outbuf.pending ok_value r1 .
  let r2 be result (owned outbuf.pending) outbuf.io_error outbuf.buf_write out p2 buf "output\n" .
  guard is_ok r2 . else return 3 .
  var p3 be owned outbuf.pending ok_value r2 .
  let f be result void outbuf.io_error outbuf.buf_finish out p3 buf .
  guard is_ok f . else return 4 .
  return 0 .
end
