module grid_wrap .
rem run: grid [1,2,3,4] 2
rem proof

rem ko: 같은 주소를 감기는 곱으로 계산했다 /// en: the same address computed with a wrapping multiply
fn grid input a slice u8 . input n u64 . output u64 .
  requires le n 1000 .
  requires ge (len a) (mul n n) .
do
  var t u64 be 0 .
  var i u64 be 0 .
  while lt i n . do
    var k u64 be 0 .
    while lt k n . do
      set t (wrap_add t (widen u64 (index a (wrap_add (wrap_mul i n) k)))) .
      set k (add k 1) .
    end
    set i (add i 1) .
  end
  return t .
end
