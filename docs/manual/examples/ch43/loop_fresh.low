module loop_fresh .
rem run: drift 5

proc bump input p mut_ref u64 . output u64 . effects none .
do
  set p. add deref p. . 1 . .
  return deref p. . .
end .

proc drift input n u64 . output u64 .
  effects none .
  requires le n. 100 . .
do
  var x u64 1 .
  var i u64 0 .
  var seen u64 0 .
  while lt i. n. . do
    set seen. bump mut_ref x . . .
    set i. add i. 1 . .
  end .
  return seen. .
end .
