module recursive .
rem run: main

use stdio .

proc stars input out cap io . input n u64 . output usize . effects io .
  requires le n. 10 . .
do
  if eq n. 0 . do
    return stdio.write out. 1 "\n" . .
  end .
  let w usize stdio.write out. 1 "*" . .
  return add w. stars out. sub n. 1 . . . .
end .

proc main input out cap io . output u8 . effects io .
do
  return cast u8 stars out. 5 . . .
end .
