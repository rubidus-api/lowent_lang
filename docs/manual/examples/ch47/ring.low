module ring .
rem run: main

use spsc .

proc main input k cap atomic . input al cap allocator . output u8 . effects atomic alloc .
do
  let gc be option mut slice u8 alloc_bytes al capacity 16 .
  let gb be option mut slice u8 alloc_bytes al capacity 32 .
  let go be option mut slice u8 alloc_bytes al capacity 8 .
  guard is_some gc . else return 255 .
  guard is_some gb . else return 254 .
  guard is_some go . else return 253 .
  var ctl be mut slice u64 view_array u64 (some_value gc) .
  var buf be mut slice u64 view_array u64 (some_value gb) .
  var out be mut slice u64 view_array u64 (some_value go) .
  let a be u64 spsc.spsc_push k ctl buf 10 .
  let b be u64 spsc.spsc_push k ctl buf 32 .
  let got be u64 spsc.spsc_pop k ctl buf out .
  guard eq got 1 . else return 252 .
  let first be u64 index out 0 .
  let again be u64 spsc.spsc_pop k ctl buf out .
  return narrow u8 (add first (index out 0)) .
end
