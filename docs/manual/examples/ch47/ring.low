module ring .
rem run: main

use spsc .

proc main input k cap atomic . input al cap allocator . output u8 . effects atomic alloc .
do
  let gc option mut slice u8 alloc_bytes al capacity 16 .
  let gb option mut slice u8 alloc_bytes al capacity 32 .
  let go option mut slice u8 alloc_bytes al capacity 8 .
  guard is_some gc else return 255 .
  guard is_some gb else return 254 .
  guard is_some go else return 253 .
  var ctl mut slice u64 view_array u64 (some_value gc) .
  var buf mut slice u64 view_array u64 (some_value gb) .
  var out mut slice u64 view_array u64 (some_value go) .
  let a u64 spsc.spsc_push k ctl buf 10 .
  let b u64 spsc.spsc_push k ctl buf 32 .
  let got u64 spsc.spsc_pop k ctl buf out .
  guard eq got 1 else return 252 .
  let first u64 idx out 0 .
  let again u64 spsc.spsc_pop k ctl buf out .
  return narrow u8 (add first (idx out 0)) .
end
