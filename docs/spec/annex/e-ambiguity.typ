#import "../lib.typ": *

#clause("E", "부록 E — 모호 목록 (Annex E: Open ambiguities)")[

  #para("1")[
    이 부록은 **이 문서만으로는 뜻이 둘 이상으로 읽히는 자리**를 모은다. 그런 자리에서 이 문서는 하나를 고르지 아니하고,
    본문에 «모호» 상자로 표시한 뒤 가능한 풀이를 나란히 적는다.
  ]

  #para("2")[
    적합한 프로그램은 이 목록의 **열린** 자리에 기대지 아니한다(#cref("4.1")). «처리기가 지금 하는 것» 은 잰 사실이지
    규범이 아니다 — 풀이가 정해지면 달라질 수 있다.
  ]

  #note[
    이 목록은 *생성된 것*이다(`docs/spec/AMBIGUITY.tsv`). 번호는 다시 쓰지 아니한다 — 정해진 줄도 남는다.
  ]

  #para("3")[모두 6 줄이고 그 가운데 열린 것이 6 줄이다.]

  #tbl("모호 목록")[
    #table(columns: (auto, auto, 1fr), stroke: 0.5pt + rgb("#bbb"), inset: 5pt,
      [*번호*], [*조항*], [*물음 · 풀이 · 처리기가 지금 하는 것 · 상태*],
        [M-0001], [#cref("6.3.4")], [*`div` 와 `mod` 의 음수 나머지* \ 풀이 ㄱ: 몫은 0 쪽으로 자르고 나머지는 피제수의 부호를 따른다 \ 풀이 ㄴ: 몫은 아래로 내리고 나머지는 제수의 부호를 따른다 \ *처리기가 지금 하는 것:* 둘을 섞는다: `div -7 2` 는 -3, `mod -7 2` 는 1, `mod 7 -2` 는 -1 \ *상태:* 열림],
        [M-0002], [#cref("6.3.4")], [*가장 작은 값을 -1 로 나눈 나머지* \ 풀이 ㄱ: `div` 와 같이 멈춘다 \ 풀이 ㄴ: 0 을 낸다 \ *처리기가 지금 하는 것:* 0 을 낸다 \ *상태:* 열림],
        [M-0003], [#cref("6.3.3")], [*`min` 과 `max` 에 NaN 이 끼면* \ 풀이 ㄱ: NaN 이 아닌 쪽을 낸다 \ 풀이 ㄴ: NaN 을 낸다 \ *처리기가 지금 하는 것:* 인자의 차례에 따라 다르다: `min <NaN> 1.0` 은 1.0, `min 1.0 <NaN>` 은 NaN \ *상태:* 열림],
        [M-0004], [#cref("6.3.3")], [*`neg` 를 쓸 수 있는 타입과 가장 작은 값* \ 풀이 ㄱ: 부호 없는 정수는 거부하고 가장 작은 값에서는 멈춘다 \ 풀이 ㄴ: 폭 안으로 감은 값을 낸다 \ *처리기가 지금 하는 것:* 둘 다 받고 그 타입에 없는 값을 낸다(`i8` 의 -128 → 128) \ *상태:* 열림],
        [M-0005], [#cref("6.5.3.1")], [*`mut` 없는 `for` 원소에 `set`* \ 풀이 ㄱ: 번역이 거부된다 \ 풀이 ㄴ: 그 바퀴의 사본만 바꾼다 \ *처리기가 지금 하는 것:* 받아들이고 슬라이스는 바꾸지 않는다 \ *상태:* 열림],
        [M-0006], [#cref("6.1.1")], [*`note` 뒤에 태그가 없으면* \ 풀이 ㄱ: 번역이 거부된다 \ 풀이 ㄴ: 그 줄만 주석이다 \ *처리기가 지금 하는 것:* 그 줄만 건너뛴다 \ *상태:* 열림],
    )
  ]
]
