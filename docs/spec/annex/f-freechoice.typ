#import "../lib.typ": *

#clause("F", "부록 F — 자유 선택 목록 (Annex F: Free choices)")[

  #para("1")[
    이 부록은 #t("자유 선택", "free choice") 의 자리를 모은다(#cref("4.3")). 그것은 이 문서가 허용하는 둘 이상의 동작이나 결과 가운데
    하나를 고르는 것이며, 처리기는 어느 것을 골랐는지 문서로 적을 의무가 없다.
  ]

  #para("2")[
    *이 목록이 전부다.* 여기 없는 자리는 자유 선택이 아니다. 처리기는 «고를 수 있는 범위» 안에서만 고르고,
    «정해져 있는 것» 은 어느 처리기에서나 같다. 적합한 프로그램은 처리기가 어느 것을 고르는가에 기대지 아니한다.
  ]

  #note[
    이 목록은 *생성된 것*이다(`docs/spec/FREE-CHOICE.tsv`). 번호는 다시 쓰지 아니한다.
  ]

  #para("3")[모두 2 줄이다.]

  #tbl("자유 선택 목록")[
    #table(columns: (auto, auto, 1fr), stroke: 0.5pt + rgb("#bbb"), inset: 5pt,
      [*번호*], [*조항*], [*자리 · 고를 수 있는 범위 · 정해져 있는 것*],
        [FC-0001], [#cref("6.3.1")], [*피연산자를 계산하는 차례* \ *고를 수 있는 범위:* 한 연산의 피연산자들의 모든 차례 \ *정해져 있는 것:* 모두 계산한 뒤에 연산한다 · 피연산자마다 한 번씩만 계산한다 · `and` 와 `or` 는 앞에서부터이고 뒤를 건너뛸 수 있다 \ *언제 · 왜:* 2026-10-08 소유자 결정 — 처리기가 정한다],
        [FC-0002], [#cref("6.3.3")], [*`min` 과 `max` 에 NaN 이 끼면* \ *고를 수 있는 범위:* NaN 이 아닌 쪽의 값 · 또는 · NaN \ *정해져 있는 것:* 두 피연산자가 모두 NaN 이 아니면 결과는 하나다 \ *언제 · 왜:* 2026-10-08 모호 M-0003 에서 옮김 — 기계의 최소 · 최대 명령이 이 자리에서 서로 다르게 답한다],
    )
  ]
]
