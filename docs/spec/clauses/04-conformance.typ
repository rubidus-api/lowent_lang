#import "../lib.typ": *

#clause("4", "적합성 (Conformance)")[
  #sub("4.1", "적합한 프로그램")[
    #para("1")[
      #t("적합한 프로그램", "conforming program") 이란 이 문서의 구문(#cref("6")) 과
      제약(#cref("6")) 을 전부 지키는 프로그램을 말한다.
    ]
    #para("2")[
      적합한 프로그램은 이 문서가 정하지 않은 거동에 기대지 아니한다.
    ]
    #para("2a")[
      진단에는 두 갈래가 있다. #strong[번역을 막는 것];(이름이 `E-` 로 시작한다)과 #strong[막지 않는
      것];(`W-`·`NOTE-`)이다. 적합함을 정하는 것은 앞의 것뿐이며, 뒤의 것이 있어도 프로그램은
      적합할 수 있다.
    ]
    #para("2b")[
      곧 적합한 프로그램이란 #strong[번역을 막는 진단이 하나도 없는]; 프로그램이다.
    ]
    #ex("적합한 프로그램", "module ex_conform .

rem 이 프로그램은 이 문서가 정한 것을 전부 지킨다.
export fn clamp input n u32 . output u8 .
  requires le n. 255 . .
  ensures le ret. 255 . .
do
  return narrow u8 n. . .
end .

proc main output u8 . effects none .
do
  return 0 .
end .")
    #plain[
      위 프로그램을 `clamp 200` 으로 부르면 200 이 나온다. `clamp 300` 으로 부르면 —
      계약이 #emph["255 이하"]; 라 했으므로 — #strong[그 자리에서 멈춘다];(`E-VM-CONTRACT`).
      틀린 답을 돌려주지 않는다는 것이 이 언어의 약속이고, 그 약속은 실행에서 지켜진다.
    ]
    #caution("적합하다는 것과 옳다는 것은 다르다")[
      적합한 프로그램도 틀린 답을 낼 수 있다. 적합성은 #strong[언어의 규칙을 지켰는가];이지
      #strong[의도한 일을 하는가];가 아니다. 뒤엣것은 계약(#cref("6.4.3"))과 시험이 다룬다.
    ]
  ]
  #sub("4.2", "적합한 처리기")[
    #para("1")[
      #t("적합한 처리기", "conforming processor") 는 다음을 모두 만족하여야 한다.
    ]
    #para("2")[
      가) 적합한 프로그램을 이 문서가 정한 의미대로 번역하고 실행하여야 한다.
    ]
    #para("3")[
      나) 적합하지 않은 프로그램에 대하여 #strong[적어도 하나의 진단];을 내야 한다. 진단을 낸 뒤에
      번역을 계속할지는 처리기가 정한다.
    ]
    #para("4")[
      다) 이 문서가 정한 진단 식별자를 쓰는 경우, 그 뜻을 바꾸어 쓰지 아니한다.
    ]
    #para("5")[
      라) 이 문서가 정하지 않은 확장을 제공하는 경우, 그 확장을 쓰지 않은 적합한 프로그램의
      의미를 바꾸지 아니한다.
    ]
    #note[
      나) 는 #emph["모든 잘못을 찾아내야 한다"]; 는 뜻이 아니다. 적합하지 않은 프로그램 하나에 대해
      진단이 #strong[하나라도]; 나오면 된다. 다만 로우엔트는 검사를 미루지 않는 것을 원칙으로 하므로,
      실제 처리기는 대개 잘못을 전부 모아서 낸다.
    ]
  ]
  #sub("4.3", "구현 정의와 자유 선택")[
    #para("1")[
      이 문서가 처리기에 재량을 남기는 자리는 #strong[두 갈래];이고, 그 자리는 #strong[명시적으로 표시];한다.
    ]
    #term("구현 정의", "implementation-defined")[
      처리기가 정하되 #strong[문서로 적어야]; 하는 것. 예: 최대 재귀 깊이. 프로그램은 그 값을 물어볼
      수 있고, 처리기마다 다를 수 있다.
    ]
    #term("자유 선택", "free choice")[
      최적화나 처리기의 사정 때문에 #strong[고르는 것을 자유롭게 둘 필요가 있는 자리];. 이 문서가 그 자리에서
      허용하는 둘 이상의 동작이나 결과 가운데 하나를 처리기가 고른다. 처리기는 어느 것을 골랐는지
      #strong[문서로 적지 않아도 된다];.
    ]
    #para("1a")[
      #t("자유 선택", "free choice") 의 자리마다 이 문서는 #strong[고를 수 있는 범위];를 적는다. 처리기는 그 범위 안에서만 고른다.
    ]
    #para("1b")[
      처리기는 같은 프로그램의 같은 자리에서도 번역할 때마다, 실행할 때마다 다르게 고를 수 있다.
    ]
    #para("1c")[
      #t("자유 선택", "free choice") 은 #strong[정해지지 않은 것이 아니다.]; 범위 안의 어느 것이 골라지든 그것은 이 문서가 정한 동작이다.
    ]
    #para("1d")[
      #t("자유 선택", "free choice") 의 자리는 본문에 «자유 선택» 상자로 표시한다. 부록 F 가 그 전부를 모으며, 부록 F 에 없는 자리는
      #t("자유 선택", "free choice") 이 아니다. 자리를 더하거나 범위를 넓히는 것은 이 문서의 개정이다.
    ]
    #para("1e")[
      적합한 프로그램은 #t("자유 선택", "free choice") 에서 처리기가 #strong[어느 것을 고르는가];에 기대지 아니한다(#cref("4.1") (2)).
    ]
    #para("1f")[
      이 문서가 #strong[아직 정하지 않은]; 자리가 있다. 그런 자리는 재량이 아니다 — 처리기에 주어진 선택이 아니라
      이 문서가 앞으로 정해야 하는 것이다. 본문에 «모호» 상자로 표시하고 부록 E 가 모은다.
    ]
    #term("모호", "open issue")[
      이 문서가 #strong[아직 정하지 않았고 나중에 정해야 하는]; 자리. 가능한 풀이를 나란히 적어 둔다.
      정해지면 규범 문단이 되거나, 열어 두기로 정해지면 자유 선택이 된다.
    ]
    #para("1g")[
      모호와 #t("자유 선택", "free choice") 은 다르다. 모호는 #strong[미결];이고, #t("자유 선택", "free choice") 은 #strong[결정];이다 — 열어 두기로 정한 것이다.
      적합한 프로그램은 모호의 자리에도 기대지 아니한다(#cref("4.1") (2)).
    ]
    #para("2")[
      이 두 갈래 밖의 재량은 없다. #strong[안전한 부분집합];(#cref("4.4"))에서는 미정의 동작이
      존재하지 아니한다 — 그 안의 어떤 프로그램도 「무슨 일이 일어날지 모른다」는 상태로
      실행되지 아니한다.
    ]
    #plain[
      두 갈래를 쉬운 말로 적으면 이렇다. #strong[구현 정의];는 «처리기마다 다를 수 있지만, 무엇으로 정했는지 처리기가
      적어 둔다» 이다. #strong[자유 선택];은 «이 가운데 아무거나 골라도 되고, 무엇을 골랐는지 적지 않아도 된다» 이다.
    ]
    #plain[
      자유 선택을 두는 까닭은 처리기가 빠른 길을 고를 수 있게 하려는 것이다. 예를 들어 `add f x. . g y. . .` 에서
      `f` 와 `g` 가운데 무엇을 먼저 계산해도 답은 같다. 차례를 못 박아 두면 처리기는 더 빠른 차례를 알아도
      쓰지 못한다. 그래서 그 차례를 열어 둔다.
    ]
    #plain[
      열어 둔다고 해서 무슨 일이든 일어날 수 있는 것은 아니다. 자리마다 #strong[고를 수 있는 범위가 적혀 있고];,
      그 밖의 일은 일어나지 아니한다. 그리고 그런 자리는 부록 F 의 목록이 전부다 — 목록에 없는 자리에서
      처리기가 제 마음대로 고르는 일은 없다. 범위는 좁게, 자리 하나하나를 따져서 정한다.
    ]
    #plain[
      프로그램을 쓰는 사람이 기억할 것은 하나다: #strong[어느 것이 골라지는지에 기대지 않는다.]; 차례가 중요하면
      차례가 정해진 꼴로 적는다(#cref("6.3.1") 의 상자가 그 방법을 말한다).
    ]
  ]
  #sub("4.4", "안전한 부분집합과 신뢰 경계")[
    #para("1")[
      #t("안전한 부분집합", "safe subset") 은 `unsafe` 와 `extern` 을 쓰지 않는 프로그램의
      집합이다. 앞 조항의 보장은 이 집합에 대한 것이다.
    ]
    #para("2")[
      `unsafe` 와 `extern` 은 #t("신뢰 경계", "trust boundary") 를 표시한다(#cref("6.9")).
      그 자리에서 언어의 보장이 끝나고 #strong[사람이 적은 약속];이 시작한다.
    ]
    #para("3")[
      경계 밖의 약속이 참이면 프로그램 전체의 거동이 이 문서가 정한 대로다. 약속이 거짓이면
      이 문서는 아무것도 보장하지 아니한다 — 그때 무슨 일이 일어나는지는 정해지지 않는다.
    ]
    #para("4")[
      그러므로 경계는 #strong[좁아야 한다];. 넓힐수록 이 문서의 보장이 닿지 않는 넓이가 는다.
    ]
    #plain[
      이 조항이 있는 까닭은 정직함 때문이다. 다른 언어로 쓴 함수를 부르면서 #emph["우리 언어에는
      미정의 동작이 없다"]; 고 말할 수는 없다 — 그 함수가 무엇을 할지 이 문서는 모른다.
      말할 수 있는 것은 #strong[어디까지가 언어의 보장이고 어디부터가 사람의 약속인가];이며,
      `unsafe` 와 `extern` 은 그 자리를 #strong[소스에 남긴다];. 나중에 찾을 수 있다는 것이
      보장만큼 중요하다.
    ]
  ]
  #sub("4.5", "환경 한계")[
    #para("1")[
      처리기는 자원의 한계를 가질 수 있다. 그러나 한계에 부딪혔을 때 #strong[조용히 잘라내서는
      아니 된다]; — 진단을 내거나 트랩하여야 한다.
    ]
    #para("2")[
      처리기는 자기가 지원하는 한계를 문서로 적어야 한다(구현 정의).
    ]
    #para("3")[
      한계에 부딪혔을 때 나는 진단은 계열로 묶여 있다 — 처리기 안쪽의 표가 넘치면
      `E-IR-…`·`E-TYPE-LIMIT`·`E-PARSE-LIMIT` 이, 실행 중의 자원이 다하면 `E-VM-…` 이 난다. 이 문서는
      그 하나하나를 적지 아니하며, #strong[적어야 할 것은 (1) 과 (2)]; — 조용히 자르지 않고,
      한계를 문서로 적는 것이다.
    ]
    #plain[
      진단의 이름을 규범에 하나씩 박아 넣지 않는 까닭은, 그것이 #strong[처리기의 속사정];이기
      때문이다. 표 하나를 둘로 나누면 이름도 바뀌는데, 그때마다 규범을 고쳐야 한다면 그
      규범은 처리기를 따라다니는 그림자일 뿐이다. 규범이 정할 것은 #strong[무엇을 약속하는가];
      이고, 그 약속은 「넘치면 말한다」와 「얼마까지인지 적는다」 둘이다.
    ]
    #caution("")[
      한계를 적는 일과 한계를 #strong[지키는]; 일은 다르다. 적기만 하고 넘칠 때 조용히 자르면
      (1) 을 어긴 것이고, 지키기만 하고 적지 않으면 쓰는 사람은 #strong[부딪히고 나서야]; 그것이
      있었음을 안다. 둘 다 있어야 한다.
    ]
    #note[
      #emph["조용히 잘라내지 않는다"]; 가 이 조항의 요점이다. 한계 자체는 어느 처리기에나 있다.
      문제가 되는 것은 한계를 넘었는데 #strong[아무 말 없이 계속 도는 것];이며, 그때 프로그램의
      결과는 소스가 말한 것과 달라진다 — 그것이 곧 의미 엔트로피다(#cref("1.3")).
    ]
  ]
  #sub("4.6", "이 문서의 판과 언어의 판")[
    #para("1")[
      이 문서는 언어와 #strong[별개의 판 번호];를 갖는다. 겉장에 적힌 「문서 판」이 이 문서의 판이고,
      「언어 판」이 이 문서가 기술하는 언어의 판이다.
    ]
    #para("2")[
      문서 판의 뒷자리가 오르는 것은 #strong[서술이 늘거나 고쳐진 것];이며, 언어가 바뀐 것이 아니다.
      언어가 바뀌면 언어 판이 오르고, 이 문서의 가운데 자리 이상이 함께 오른다.
    ]
  ]
  #sub("4.7", "이 문서에 있으나 아직 처리기가 못 하는 것")[
    #para("1")[
      이 문서가 정한 것 가운데 처리기가 #strong[아직 하지 못하는]; 것이 있을 수 있다. 그때
      처리기는 그것을 #strong[없는 것처럼 다루지 아니한다.];
    ]
    #para("2")[
      그런 자리에서 처리기는 #emph["이 낱말은 명세에 있고, 못 하는 것은 처리기 쪽이다"]; 라고
      말하여야 한다. 곧 그것은 프로그램의 잘못이 아니다.
    ]
    #para("3")[
      이 구별이 규범인 까닭은 #strong[사람이 무엇을 할지가 달라지기]; 때문이다. #emph["없는 이름"];
      이라 하면 사람은 없는 오타를 찾으러 가고, #emph["아직 못 한다"]; 하면 다른 길을 찾거나
      기다린다. 진단 하나가 사람의 반나절을 정한다.
    ]
    #para("4")[
      처리기는 그런 자리를 #strong[셀 수 있게]; 하여야 한다 — 모든 정적 검사를 지났으나 실행으로
      내려가지 못하는 op 이 무엇인지 물으면 답하여야 한다.
    ]
    #plain[
      이것은 «미완성을 봐 준다» 는 조항이 아니다. 그 반대다 — 미완성을 #strong[드러내라];는
      조항이다. 못 하는 것을 조용히 못 하는 처리기와, 못 한다고 말하는 처리기 사이에는
      신뢰의 차이가 있다.
    ]
  ]
]
