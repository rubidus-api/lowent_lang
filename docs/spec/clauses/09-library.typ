#import "../lib.typ": *

#clause("9", "라이브러리 (Library)")[
  #para("1")[
    이 조항은 개별 라이브러리 함수의 목록을 정하지 아니한다. 정하는 것은 #strong[라이브러리가
      지켜야 할 규칙];이다. 그 규칙을 지키는 한, 어떤 라이브러리든 이 언어의 보장 안에 있다.
  ]
  #plain[
    C 표준은 언어와 라이브러리를 한 문서에 담고 함수 하나하나를 정한다. 로우엔트가 그러지
    않는 이유는, 라이브러리가 언어보다 훨씬 빨리 바뀌기 때문이다. 함수 목록을 여기 적으면
    이 문서가 곧 낡는다. 대신 #strong[규칙];을 적으면 낡지 않는다.
  ]
  #sub("9.1", "라이브러리도 같은 언어로 쓰인다")[
    #para("1")[
      표준 라이브러리의 #strong[이식 계층];은 이 문서가 정한 언어로 쓰이며, 특권을 갖지 아니한다.
      그 부분은 저자가 직접 쓴 코드와 같은 규칙을 받는다.
    ]
    #para("1a")[
      다만 라이브러리 전체가 한 층인 것은 아니다. 바깥 세상에 닿는 자리에는 좁은 잎(leaf)이
      있고, 그것은 `unsafe` 나 `extern` 을 써서 #strong[신뢰 경계];(#cref("4.4"))를 넘는다.
      그 경계는 좁게 유지되며 어디인지 소스에 적혀 있다.
    ]
    #para("1b")[
      이름을 주소로 바꾸는 일(DNS)은 #strong[연결을 거는 일과 다른 잎];이다. 둘 다 `cap net` 을
      받고 `io` 효과를 내지만, 가르는 까닭이 있다: 주소를 이미 가진 프로그램은 이름 해석에
      #strong[아예 닿지 아니하고];, 검사는 주소를 손으로 주어 #strong[망 없이]; 연결을 잴 수 있다.
      그리고 이름 해석은 기계와 시점에 따라 다른 답을 낼 수 있는데, 그 흔들림이 어느 줄에
      있는지가 소스에 보인다.
    ]
    #plain[
      편함으로 치면 연결 잎 하나가 이름도 받는 편이 낫다. 그러나 그러면 #emph["이 줄이 망에 몇 번
      닿는가"]; 를 소스만 보고는 알 수 없게 된다 --- 이 언어가 권한과 효과에서 되풀이하는 것과
      같은 물음이고, 같은 답을 준다: #strong[감춘 것을 이름으로 드러낸다.];
    ]
    #para("2")[
      곧 라이브러리의 op 도 계약을 적고(#cref("6.4")), 효과를 선언하며(#cref("7.1")),
      권한을 인자로 받는다(#cref("7.2")).
    ]
    #note[
      라이브러리에 특권이 없다는 것은 검사 가능성의 문제다. 라이브러리만 쓸 수 있는 숨은
      통로가 있으면, 그 통로를 지나는 순간 프로그램의 보장이 끊긴다.
    ]
  ]
  #sub("9.2", "라이브러리가 지켜야 할 것")[
    #para("1")[
      가) #strong[실패를 값으로 돌려준다.]; 특별한 값(−1 따위)으로 실패를 나타내지 아니한다
      (#cref("6.2.8")).
    ]
    #para("2")[
      나) #strong[없애는 일이 실패할 수 있으면 그것을 숨기지 아니한다];(#cref("8.5")).
    ]
    #para("3")[
      다) #strong[권한을 스스로 지어내지 아니한다.]; 필요한 권한은 인자로 받는다.
    ]
    #para("4")[
      라) #strong[효과를 정직하게 선언한다.]; 안쪽에서 부르는 것의 효과까지 포함한다.
    ]
    #para("5")[
      마) #strong[기준이 갈리는 수는 어느 기준인지 적는다.]; 행·열·색인·쪽 번호처럼 0 에서 세는지
      1 에서 세는지가 갈리는 값은, 그 op 의 `lowdoc` 이나 모듈 계약이 #strong[밝혀야]; 한다.
      이 언어의 색인은 0 기준이므로 라이브러리도 #strong[0 기준을 기본];으로 하며, 바깥 규약이
      1 기준이면(터미널의 ANSI 자리 지정 따위) 그 변환은 #strong[op 안에서]; 한다 — 부르는 쪽이
      바깥 규약을 알아야 하면 그것은 소스 밖의 지식이다(#cref("1.3")).
    ]
    #note[
      보기: `term.goto <버퍼> <자리> <행> <열>` 의 행과 열은 #strong[0 기준];이다(화면 왼쪽 위가
      `0 0`). ANSI 가 1 기준이라 op 이 안에서 1 을 더해 내보낸다 — 그 더하기는 부르는 쪽의
      일이 아니다.
    ]
    #ex("라이브러리도 같은 규칙을 지킨다", "module ex_lib .

def enum parse_error do
  too_short .
end .

rem 실패를 값으로 돌려준다 — 특별한 수(−1 따위)를 쓰지 않는다.
export fn first_byte input data slice u8 . output result u8 parse_error .
  errors too_short lt len data. . 1 . .
do
  guard ge len data. . 1 . else return error too_short . . .
  return ok idx data. 0 . . .
end .")
    #plain[
      이 넷은 새 규칙이 아니라 #strong[이미 정한 규칙을 라이브러리도 지킨다];는 말이다.
      라이브러리라고 예외를 두면, 그 라이브러리를 쓰는 순간 프로그램의 보장이 끊긴다.
    ]
  ]
  #sub("9.3", "무엇이 언어이고 무엇이 라이브러리인가")[
    #para("1")[
      #cref("6.3.3") 의 기본 연산과 빌트인 연산은 #strong[언어];다. 이름이 고정되어 있다. 기본 연산의 이름은 저자가 가릴 수
      없고, 빌트인 연산은 `call_builtin` 뒤에서만 서므로 저자의 이름과 만나지 아니한다.
    ]
    #para("1a")[
      빌트인 연산은 라이브러리를 짓는 재료다. 표준 라이브러리는 빌트인 연산을 감싼 op 을 내놓고, 응용
      프로그램은 그 op 을 부른다 — 빌트인 연산을 직접 부르는 것은 시스템 라이브러리와 처리기를 짓는 자리의 일이다.
    ]
    #para("2")[
      그 밖의 모든 것은 라이브러리이며, 모듈을 가져와 쓴다.
    ]
    #para("3")[
      어떤 기능이 언어에 들어가려면 다음을 만족해야 한다 — 라이브러리로는 표현할 수 없거나,
      표현하면 비용이 숨는 경우.
    ]
    #para("4")[
      언어와 라이브러리 사이에는 한 층이 더 있다 — #t("리프", "leaf") 다.
    ]
    #term("리프", "leaf")[
      운영체제나 하드웨어에 닿는 가장 얇은 조각. 로우엔트로는 쓸 수 없으므로 처리기가
      준다. 리프는 #strong[얇아야]; 한다 — 로우엔트로 쓸 수 있는 것은 리프가 아니라
      라이브러리다.
    ]
    #para("5")[
      어떤 조각이 리프 자격을 갖는지는 다음 물음이 가른다 — #emph["이것을 로우엔트로 쓸 수 있는가."];
      쓸 수 있으면 라이브러리다. #strong[편의는 리프 자격이 되지 아니한다.];
    ]
    #tbl("세 층")[
      #table(columns: (auto, auto, 1fr), stroke: 0.5pt + rgb("#bbb"), inset: 6pt,
      [*층*], [*누가 만드나*], [*자격*],
      [언어], [이 문서], [라이브러리로 표현할 수 없거나, 표현하면 비용이 숨는다],
      [리프], [처리기], [운영체제·하드웨어에 닿는다. 로우엔트로 쓸 수 없다],
      [라이브러리], [누구나], [나머지 전부. 로우엔트로 쓴다],
      )
    ]
    #diagram("세 층 — 파일 하나를 읽을 때", " library   files.open, files.read, files.slurp   Lowent code: owned handle, result
    |
 leaf      file_open, file_read, file_close      from the processor, needs cap file_system
    |
 OS        open, read, close                     the kernel
 language  add, len, idx, narrow ...           fixed words (6.3.3), used at every layer")
    #plain[
      예를 들어 「파일을 열어 정수 핸들을 받는 것」은 커널에 닿으므로 리프다. 그 핸들을
      #strong[잊을 수 없는 값];으로 감싸는 것은 로우엔트로 쓸 수 있으므로 라이브러리다.
      「파일을 통째로 읽어 주는 편의 함수」도 라이브러리다 — 편해서 리프가 되지는 않는다.
    ]
    #caution("편의는 언어에 들어가는 이유가 되지 아니한다")[
      #emph["이렇게 쓰면 편하다"]; 는 라이브러리의 일이다. 언어에 낱말을 더하면 그 낱말은 모든
      프로그램이 외워야 하는 것이 된다(#cref("6.1.2")). 그래서 언어는 #strong[표현할 수 없는 것];만
      받아들인다.
    ]
  ]
  #sub("9.4", "얼마나 익었는가 — 성숙도의 사다리")[
    #para("1")[
      라이브러리 모듈은 저마다 #strong[성숙도];를 적는다. 칸은 넷이며, 위 칸은 아래 칸의 의무를
      #strong[모두 포함한다];.
    ]
    #tbl("성숙도의 칸과 그 의무")[
      #table(columns: (auto, 1fr), stroke: 0.5pt + rgb("#bbb"), inset: 6pt,
      [*칸*], [*그 칸이 지는 의무*],
      [`experimental`], [성숙도가 #strong[적혀 있다];. 그 이상은 없다 — 그래서 실험이다],
      [`incubating`], [＋ 주인이 되는 결정 문서가 #strong[실제로 있다];],
      [`standard`], [＋ 사람이 읽는 설명이 있고, 회귀 증인이 그 모듈을 #strong[이름으로]; 부른다],
      [`deprecated`], [＋ 무엇으로 갈아타야 하는지 적혀 있다],
      )
    ]
    #para("2")[
      적은 칸의 의무를 지키지 못하는 모듈은 적합하지 아니하다. 칸을 #strong[올리는 것];은
      의무를 갖춘 뒤의 일이며, 갖추지 못했으면 낮은 칸에 그대로 두어야 한다.
    ]
    #note[
      #strong[사다리의 값어치는 위 칸이 아니라 아래 칸에 있다.]; `experimental` 이라 적는 것은
      #emph["아직 믿지 말라"]; 를 #strong[소스에]; 적는 일이고, 그 한 줄이 쓰는 사람에게 #emph["이것에 기대어
      설계해도 되는가"]; 를 답해 준다. 칸이 없으면 모든 모듈이 똑같아 보이고, 그러면
      #strong[가장 익지 않은 것이 가장 익은 것처럼]; 읽힌다.
    ]
    #note[
      칸은 #strong[약속의 크기];이지 품질의 등수가 아니다. 잘 만든 실험 모듈이 허술한 표준 모듈보다
      나을 수 있다 — 다른 것은 #emph["바뀌지 않는다고 얼마나 말했는가"]; 다.
    ]
  ]
  #sub("9.5", "무엇이 표준 라이브러리에 들어오는가")[
    #para("1")[
      라이브러리에 들어오는 것은 #strong[있어서];가 아니라 #strong[증거로]; 들어온다. 다음 여섯이
      들어옴을 가르는 잣대다.
    ]
    #tbl("라이브러리 헌장")[
      #table(columns: (auto, 1fr), stroke: 0.5pt + rgb("#bbb"), inset: 6pt,
      [*잣대*], [*무엇을 뜻하나*],
      [이 언어로 쓸 수 있으면 이 언어로 쓴다], [처리기 안의 잎(leaf)이 되는 것은 #strong[바깥 권위를 쓰거나]; 이 언어가 표현하지 못하는 일일 때뿐이다. #strong[편함은 근거가 아니다];],
      [시그니처가 비용과 권한의 장부다], [효과·권한·부르는 쪽의 저장·할당·소유·완료·기계 제약이 #strong[경계에서 보여야]; 한다],
      [셈과 권위를 가른다], [꼴 짓기와 내보내기, 해석과 파일 열기, 난수의 다음 걸음과 엔트로피 얻기, 규약 부호화와 실어 나르기는 #strong[각각 다른 것];이다],
      [자리는 여러 축으로 가른다], [권위·저장·실행 등급(⟦§10.8⟧)·프로파일(⟦§10.7⟧)은 #strong[하나의 사다리로 눌러 담지 아니한다];],
      [안에 있는 것은 작게 둔다], [이식되는 바탕과 얇게 감사된 host 어댑터까지. 큰 바깥 의존·정책이 무거운 설비·아직 연구인 표면은 들이지 아니한다],
      [모듈마다 증거가 있다], [지지 경계를 선언하고, 단위·음성·오라클·실패·프로파일 관문을 갖춘다],
      )
    ]
    #para("2")[
      이 문서는 라이브러리의 #strong[목록을 적지 아니한다.]; 무엇이 있는지는 소스에서 매번 다시
      세어 내는 원장이 권위이며, 이 문서가 그것을 베끼면 #strong[베낀 순간부터 갈라진다.];
    ]
    #plain[
      헌장이 목록을 겸하면, 아직 제안인 것이 표에 실렸다는 이유만으로 #strong[이미 있는 것처럼];
      보이게 된다. 실제로 그런 일이 있었다 — 있지도 않은 API 셋이 표에 있다는 이유로 사실로
      읽혔다. 그래서 이 절은 #strong[무엇이 들어오는가];만 정하고, #strong[무엇이 들어와 있는가];는
      세는 쪽에 맡긴다.
    ]
  ]
]
