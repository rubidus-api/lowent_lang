fn parse_header .
  input data slice u8 .
  output result header parse.error .
  requires ge len data 4 .
  errors too.short .
  errors bad.version .
do
  guard ge len data 4 . else return error too.short .
  guard eq index data 0 . 1 . else return error bad.version .
  return ok header .
end .

fn leaky .
  input data slice u8 .
  errors too.short .
do
  guard nonempty data . else return error way.too.long .
  return ok .
end .

fn typo_req .
  input xs slice u32 .
  requires ge len ys 1 .
do
  return ok .
end .
