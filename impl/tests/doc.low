rem ★ doc 픽스처도 bytes·path 를 선언 없이 썼다.
type bytes slice u8 . .
type path slice u8 . .

rem ★ errors 절이 거는 변형들이 **선언돼 있지 않았다**(E-ERR-UNDEF 가 잡았다).
enum parse_error .
  too_short .
  bad_version .
end .
enum io_error .
  open_failed .
  read_failed .
end .

module sorted_search .

fn parse_header .
  lowdoc text DOC
Parse the 4-byte header, returning version and length.
Fails if the input is shorter than the header.
DOC .
  input data bytes .
  output result .
  requires static ge (len data) 4 .
  errors too_short .
  errors bad_version .
  tests parse_header_ok parse_header_short .
do
  return ok true . .
end .

proc load_file .
  lowdoc "Read a file into a byte slice." .
  input a cap allocator .      rem ★ **할당 = 명시 권한**(RFC-0043 D1) — ambient 힙은 없다
  input fs cap file_system .   rem ★ **읽기도 권한이다** — 2026-07-20 까지 이 줄이 없었고,
                               rem   `effects io` 를 선언하면서 io 를 인가하는 cap 을 **안 들고
                               rem   있었다.** 검사가 `cap` 토큰 유무만 봐서 `cap allocator` 로
                               rem   통과했다 — **할당 권한이 파일 읽기를 인가했다.**
  input p path .
  output result .
  effects io alloc .
  errors open_failed .
  errors read_failed .
  tests load_file_ok load_file_missing .
do
  return ok true . .
end .

rem Compare two keys for ordering.
rem Returns negative, zero, or positive.
fn compare .
  input a i32 .
  input b i32 .
  output i32 .
do
  return 0 .
end .

rem ── `tests` 절이 이름으로 건 op 들. **정의돼 있지 않았다** — 검사기가 잡았다.
rem    이 픽스처는 문서 렌더링용이지만, 없는 이름을 거는 건 여기서도 거짓말이다.
fn parse_header_ok output bool . do return true . end .
fn parse_header_short output bool . do return false . end .
fn load_file_ok output bool . do return true . end .
fn load_file_missing output bool . do return false . end .
