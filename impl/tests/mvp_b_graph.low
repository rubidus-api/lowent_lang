rem SPEC-MVP §8 gate — example B: arena/stack graph traversal (proc + region).
rem Source: SPEC-015 §17.2. --check must be clean (escape/EXCL green).
rem ★ 명세의 예제 B 는 `node_count_of` 를 부르는데 **그것을 정의하지 않는다.**
rem    예제 A 와 같은 결함이다(--check 가 초록불이었다 — IR 만 E-IR-UNDEF 를 냈다).
rem    자립시킨다.
fn node_count_of
  input g graph .
  output u64 .
do
  return idx g 0 .
end

rem ★ 명세의 예제 B 는 타입을 **하나도 선언하지 않는다** — graph·bytes·node_id·node_count·frame 을
rem    쓰면서. 이름이 아무것도 가리키지 않았고, 아무도 확인하지 않았다(E-TYPE-UNDEF 가 잡았다).
def type bytes slice u8 .
def type graph slice u8 .
def type node_id u64 .
def type node_count u64 .
def type frame u64 .

fn children_of
  input g graph .
  input node u64 .
  output bytes .
do
  var at be u64 1 .
  var i be u64 0 .
  while lt i node . do
    set at expr at + (idx g at) + 1 .
    set i expr i + 1 .
  end
  return subslice g (add at 1) (add (add at 1) (idx g at)) .
end

proc graph_reachable
  input temp region frame .
  input g graph .
  input root node_id .
  input out mut bitset node_count .
  output void .
  effects alloc .
do
  let work be stack node_id stack_new temp capacity node_count_of g .
  push work root .
  while pop work into node . do
    if bitset_contains out node . do
      continue .
    end
    bitset_insert out node .
    for child children_of g node . do
      push work child .
    end
  end
end
