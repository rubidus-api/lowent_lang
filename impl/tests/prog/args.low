rem ★★★ **다섯 번째 진짜 프로그램 — 그리고 이 언어가 처음으로 명령줄 인자를 읽는다.**
rem
rem   여태 엔트리는 **인자를 받을 수 없었다**(E-ENTRY-PARAMS). 도구가 그렇게 말했다:
rem   "args 는 capability 입력으로 온다(RFC-0030 D2) — argv 매직 파라미터가 아니다.
rem    그런데 capability 가 아직 없다. 그래서 **못 한다고 말한다.**"
rem   이제 그 문이 열렸다: `input a cap args .` 가 **첫 capability** 다.
rem
rem ★ **인자는 건네받는 권리다.** ambient 가 아니라 cap 을 통해서만 닿는다 —
rem   `count a`(개수) · `arg a i`(i 번째, 없으면 **none**). cap 없이 `arg` 를 부르면 E-IR-UNSUP.
rem ★ **없음은 값이다**: 범위 밖은 트랩도 센티널(-1)도 아니라 `none` 이다(RFC-0068 §5.1 과 같은 결).
rem ★ **반환은 뷰**(`option str`) — 복사 0. lib/str.low 의 op 이 그대로 인자에 작동한다.
rem ★ **출력이 곧 종료 상태**(RFC-0030 D3) — 이 프로그램의 답은 프로세스 종료 코드로 나온다.
rem
rem   하는 일: 인자들을 훑어 `--` 로 시작하는 플래그와 나머지를 세고, 첫 비-플래그의 길이를 더한다.
rem   이 계산은 **두 백엔드가 같은 답을 내야 한다** — 골든이 같은 인자로 VM 과 네이티브를 대조한다.

module args .

use strings from "../../../lib/str.low" .

rem 플래그인가 — `--` 로 시작하면 플래그. lib/str.low 의 접두 검사를 그대로 쓴다.
fn is_flag input s slice u8 . output bool . do
  return strings.starts_with s "--" .
end .

proc main input a cap args . output u8 . effects none . do
  let n u64 be count a .
  var flags u64 be 0 .
  var plain u64 be 0 .
  var firstlen u64 be 0 .
  var seen bool be false .
  var i u64 be 0 .
  while lt i n . do
    let cur option slice u8 . be arg a i .
    guard is_some cur . else return 250 .        rem i < n 인데 none 이면 count 가 거짓말이다
    let s slice u8 be some_value cur .
    if is_flag s . do
      set flags (add flags 1) .
    end .
    if not (is_flag s) . do
      set plain (add plain 1) .
      if not seen . do
        set firstlen (len s) .
        set seen true .
      end .
    end .
    set i (add i 1) .
  end .
  rem ★ 범위 밖 질의는 **none** 이다 — 트랩이 아니다. 그것을 여기서 실측한다.
  let past option slice u8 . be arg a n .
  guard eq (is_some past) false . else return 251 .
  rem 답: flags*100 + plain*10 + firstlen  (u8 로 좁힌다 — 종료 코드는 1 바이트다)
  return (narrow u8 (add (add (mul flags 100) (mul plain 10)) firstlen)) .
end .
