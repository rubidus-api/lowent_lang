rem ★★★ **인증서 한 장이 다른 한 장에게 서명받았는가** — [verify](verify) 의 증인 (X-0032 P3).
rem
rem   표준 입력으로 두 장을 잇대어 받는다: `<4바이트 길이><인증서1><4바이트 길이><인증서2>`.
rem   첫째가 **서명된** 것이고 둘째가 **서명한** 것이다.
rem   낸 값: 0 = 맞다 · 1 = 안 맞다 · 그 밖 = 읽지 못했다.
rem
rem ★ 음성 시험이 본체다: 한 비트를 뒤집으면 **거절되어야** 한다. 통과 하나보다 거절이 증거다.

module certverify .

use verify from "../../../lib/verify.low" .
use x509 from "../../../lib/x509.low" .

proc run input k cap io . input al cap allocator . output u8 . effects alloc io .
do
  let g option mut slice u8 . . be alloc_bytes al capacity 65536 .
  guard is_some g . else return 9 .
  let buf mut slice u8 . be some_value g .
  let rn option u64 . be read_in k 0 buf .
  guard is_some rn . else return 9 .
  let n u64 be some_value rn .
  guard gt n 8 . else return 9 .

  let l1 u64 be add (add (mul (cast u64 (index buf 0)) 16777216) (mul (cast u64 (index buf 1)) 65536))
                    (add (mul (cast u64 (index buf 2)) 256) (cast u64 (index buf 3))) .
  guard gt l1 0 . else return 9 .
  guard le (add 4 l1) n . else return 9 .
  let o2 u64 be add 4 l1 .
  guard le (add o2 4) n . else return 9 .
  let l2 u64 be add (add (mul (cast u64 (index buf o2)) 16777216) (mul (cast u64 (index buf (add o2 1))) 65536))
                    (add (mul (cast u64 (index buf (add o2 2))) 256) (cast u64 (index buf (add o2 3)))) .
  guard gt l2 0 . else return 9 .
  guard le (add (add o2 4) l2) n . else return 9 .

  let c1 slice u8 be subslice buf 4 (add 4 l1) .
  let c2 slice u8 be subslice buf (add o2 4) (add (add o2 4) l2) .

  let wu mut slice u64 . be view_array u64 (subslice buf 40000 60000) .
  let good_r result u64 verify.verify_error . be verify.signed_by c1 c2 (subslice buf 20000 40000) wu .
  guard is_ok good_r . else return 0 .
  let good u64 be ok_value good_r .
  if eq good 1 . do  return 0 . end
  return 1 .
end






rem ★ 한 마디 잇기 — 이름·CA·기간·서명을 한 번에. `now` 는 인자로 받는다(검사가 못박을 수 있게).
proc link input k cap io . input al cap allocator . input now u64 . output u8 . effects alloc io .
do
  let g option mut slice u8 . . be alloc_bytes al capacity 65536 .
  guard is_some g . else return 99 .
  let buf mut slice u8 . be some_value g .
  let rn option u64 . be read_in k 0 buf .
  guard is_some rn . else return 99 .
  let l1 u64 be add (add (mul (cast u64 (index buf 0)) 16777216) (mul (cast u64 (index buf 1)) 65536))
                    (add (mul (cast u64 (index buf 2)) 256) (cast u64 (index buf 3))) .
  let o2 u64 be add 4 l1 .
  let l2 u64 be add (add (mul (cast u64 (index buf o2)) 16777216) (mul (cast u64 (index buf (add o2 1))) 65536))
                    (add (mul (cast u64 (index buf (add o2 2))) 256) (cast u64 (index buf (add o2 3)))) .
  let c1 slice u8 be subslice buf 4 (add 4 l1) .
  let c2 slice u8 be subslice buf (add o2 4) (add (add o2 4) l2) .
  let wu mut slice u64 . be view_array u64 (subslice buf 40000 60000) .
  return narrow u8 (verify.link_ok c1 c2 now (subslice buf 20000 40000) wu) .
end

rem ★ 이름 대조만 따로 — 와일드카드까지.
proc hostok input k cap io . input al cap allocator . input host slice u8 . output u8 . effects alloc io .
do
  let g option mut slice u8 . . be alloc_bytes al capacity 65536 .
  guard is_some g . else return 99 .
  let buf mut slice u8 . be some_value g .
  let rn option u64 . be read_in k 0 buf .
  guard is_some rn . else return 99 .
  let l1 u64 be add (add (mul (cast u64 (index buf 0)) 16777216) (mul (cast u64 (index buf 1)) 65536))
                    (add (mul (cast u64 (index buf 2)) 256) (cast u64 (index buf 3))) .
  let c1 slice u8 be subslice buf 4 (add 4 l1) .
  if verify.host_ok c1 host . do  return 0 . end
  return 1 .
end
