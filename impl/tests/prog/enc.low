rem ★★★ **진짜 프로그램 — 바이트를 다른 표현으로 옮긴다** (RFC-0075 §9.3 **S1**, 2026-08-05).
rem
rem   원장의 잔량을 줄이는 네 번째 프로그램. 여기서 처음으로 실물 일을 하는 모듈:
rem     `codec`(hex·base64) · `unicode`(글자 종류 표)
rem
rem ★★★★ **`utf16` 은 여기 못 들어온다 — 그리고 그것이 이 프로그램이 찾아낸 것이다.**
rem   `utf8` 과 `utf16` 은 **둘 다 `decode`·`next`·`count_chars`·`is_valid` 를 export** 하고,
rem   이름공간이 평평하다(RFC-0075 D6) ⇒ **한 단위에서 함께 못 쓴다**(두 줄이면 재현: E- 7건).
rem   ☞ 이것은 `vecgen`+`files` 보다 **나쁜 자리**다: UTF-8 ↔ UTF-16 변환은 그 두 모듈의
rem     **대표 용도**인데, 지금은 그 대표 용도가 **표현 불가능**하다.
rem   ⇒ 픽스처는 이것을 영원히 못 본다(모듈을 하나씩 쓴다). RFC-0075 §9.3 S2 의 둘째 티켓.
rem
rem ★★★ **이 프로그램은 자기 답을 스스로 검산한다 — 그것이 인코딩의 오라클이다.**
rem   인코딩에는 아주 강한 성질이 하나 있다: **decode(encode(x)) = x**. 정답표를 손으로
rem   적을 필요가 없고(적으면 그 표가 두 번째 진실이 된다), 입력이 무엇이든 성립해야 한다.
rem   ⇒ 이 프로그램은 **낼 때마다 되돌려 보고**, 다르면 종료 코드로 고발한다.
rem     · hex·base64:  encode → decode → 원본과 바이트 단위 비교
rem   ☞ 그래서 이 프로그램은 도구이면서 **성질 시험**이다(RFC-0075 §7.2 가 pure 분류에
rem     요구하는 "독립 참조 또는 성질 오라클"의 가장 싼 형태).
rem
rem 사용:  enc <hex|b64|scan> <파일>
rem 종료:  0 = 성공(그리고 왕복이 맞았다) · 2 = **왕복이 깨졌다**(결함) · 64~ = 자원/입력

module encprog .

use codec   from "../../../lib/codec.low" .
use unicode from "../../../lib/unicode.low" .
use utf8    from "../../../lib/utf8.low" .
rem ★★★ **두 줄이 함께 서는 것 자체가 이 프로그램의 발견이다** (RFC-0075 S2 · 2026-08-15).
rem   2026-08-05 에는 `use utf8` + `use utf16` 두 줄만으로 **E- 7 건**이 났다 — 둘 다
rem   `decode`·`next`·`count_chars`·`is_valid` 를 export 하는데 이름공간이 평평했고, `utf8.low` 은
rem   제 export 를 맨이름으로 불렀다. 그때 RFC 는 이렇게 적었다: *"UTF-8 ↔ UTF-16 변환은 그 두
rem   모듈의 대표 용도다. 지금 이 라이브러리는 자기 존재 이유를 표현할 수 없다."*
rem   맨이름이 남의 모듈을 집던 자리를 **여섯 곳** 고친 뒤(X-0008), 이제 표현할 수 있다.
use utf16   from "../../../lib/utf16.low" .
use files   from "../../../lib/file.low" .
use fmt     from "../../../lib/fmt.low" .
use allocs  from "../../../lib/alloc.low" .

rem ★ 두 바이트열이 같은가 — 왕복 검산이 쓴다.
fn same_bytes input a slice u8 . input b slice u8 . output bool . do
  if ne (len a) (len b) . do return false . end
  var i be u64 0 .
  while lt i (len a) . do
    if ne (idx a i) (idx b i) . do return false . end
    set i (add i 1) .
  end
  return true .
end

rem ★ 글자 종류를 센다 — `unicode` 의 표가 실제로 쓰이는 자리.
proc scan_kinds input src slice u8 . input dst mut slice u8 . . input pos0 u64 .
  output option u64 . effects none .
do
  var at be u64 0 .
  var n_letters be u64 0 .
  var n_digits be u64 0 .
  var n_spaces be u64 0 .
  var n_others be u64 0 .
  while lt at (len src) . do
    let d be option u64 utf8.decode src at .
    guard is_some d . else return none .
    let cp be u64 some_value d .
    if unicode.is_letter cp . do set n_letters (add n_letters 1) . end
    if unicode.is_number cp . do set n_digits (add n_digits 1) . end
    if unicode.is_space cp . do set n_spaces (add n_spaces 1) . end
    if eq (unicode.is_alnum cp) false . do
      if eq (unicode.is_space cp) false . do set n_others (add n_others 1) . end
    end
    let nx be option u64 utf8.next_start src at .
    guard is_some nx . else return none .
    set at (some_value nx) .
  end
  var pos be u64 pos0 .
  let sk1 be option u64 fmt.put_u64 dst pos n_letters .
  guard is_some sk1 . else return none .
  let sk2 be option u64 fmt.put_str dst (some_value sk1) " letters, " .
  guard is_some sk2 . else return none .
  let sk3 be option u64 fmt.put_u64 dst (some_value sk2) n_digits .
  guard is_some sk3 . else return none .
  let sk4 be option u64 fmt.put_str dst (some_value sk3) " digits, " .
  guard is_some sk4 . else return none .
  let sk5 be option u64 fmt.put_u64 dst (some_value sk4) n_spaces .
  guard is_some sk5 . else return none .
  let sk6 be option u64 fmt.put_str dst (some_value sk5) " spaces, " .
  guard is_some sk6 . else return none .
  let sk7 be option u64 fmt.put_u64 dst (some_value sk6) n_others .
  guard is_some sk7 . else return none .
  let sk8 be option u64 fmt.put_str dst (some_value sk7) " other" .
  guard is_some sk8 . else return none .
  return some (some_value sk8) .
end

proc main .
  input fs cap file_system .
  input al cap allocator .
  input a  cap args .
  input out cap io .
  output u8 .
  effects alloc io .
do
  let m0 be option slice u8 arg a 0 .
  guard is_some m0 . else return 64 .
  let p0 be option slice u8 arg a 1 .
  guard is_some p0 . else return 64 .
  let mode be slice u8 some_value m0 .
  let path be slice u8 some_value p0 .

  let gsrc be option mut slice u8 alloc_bytes al capacity 4096 .
  guard is_some gsrc . else return 70 .
  let srcbuf be mut slice u8 some_value gsrc .
  let sn be result u64 files.file_error files.slurp fs path srcbuf .
  guard is_ok sn . else return 66 .
  let src be slice u8 subslice srcbuf 0 (ok_value sn) .

  let genc be option mut slice u8 alloc_bytes al capacity 16384 .
  guard is_some genc . else return 70 .
  let encbuf be mut slice u8 some_value genc .

  let gback be option mut slice u8 alloc_bytes al capacity 4096 .
  guard is_some gback . else return 70 .
  let backbuf be mut slice u8 some_value gback .

  rem ── hex ─────────────────────────────────────────────────────────────────
  if eq (len mode) 3 . do
    if eq (idx mode 0) 104 . do
      let e be option u64 codec.hex_enc src encbuf .
      guard is_some e . else return 71 .
      let enc be slice u8 subslice encbuf 0 (some_value e) .
      rem ★ 낸 것을 **되돌려 본다** — 다르면 그 인코딩은 거짓말이다.
      let b be option u64 codec.hex_dec enc backbuf .
      guard is_some b . else return 2 .
      guard same_bytes src (subslice backbuf 0 (some_value b)) . else return 2 .
      let w be u64 write_out out 1 enc .
      return 0 .
    end
    if eq (idx mode 0) 98 . do
      rem ★ 이름을 갈라 준다 — 이름공간이 평평해서 같은 이름을 두 가지에 못 쓴다(E-NAME-DUP).
      let e6 be option u64 codec.b64_enc src encbuf .
      guard is_some e6 . else return 71 .
      let enc6 be slice u8 subslice encbuf 0 (some_value e6) .
      let b6 be option u64 codec.b64_dec enc6 backbuf .
      guard is_some b6 . else return 2 .
      guard same_bytes src (subslice backbuf 0 (some_value b6)) . else return 2 .
      let w6 be u64 write_out out 1 enc6 .
      return 0 .
    end
  end

  rem ── 글자 종류 세기 ──────────────────────────────────────────────────────
  if eq (len mode) 4 . do
    if eq (idx mode 0) 115 . do
      guard utf8.is_valid src . else return 65 .
      let e be option u64 scan_kinds src encbuf 0 .
      guard is_some e . else return 72 .
      let e2 be option u64 fmt.put_nl encbuf (some_value e) .
      guard is_some e2 . else return 72 .
      let w be u64 write_out out 1 (subslice encbuf 0 (some_value e2)) .
      return 0 .
    end
  end

  rem ── UTF-8 ↔ UTF-16 왕복 ─────────────────────────────────────────────────
  rem ★ `utf8` 에는 **인코더가 없다**(decode/next/count/is_valid 뿐). 없는 것을 있는 척하지 않고,
  rem   왕복을 **코드포인트 축**으로 돈다: utf8 로 풀고 → utf16 으로 쓰고 → utf16 으로 다시 풀어
  rem   **원래 코드포인트와 대조**한다. 하나라도 다르면 그 변환은 거짓말이다.
  if eq (len mode) 3 . do
    if eq (idx mode 0) 117 . do
      guard utf8.is_valid src . else return 65 .
      var u16buf be mut slice u16 view_array u16 encbuf .
      var rpos be u64 0 .
      var wpos be u64 0 .
      var n be u64 0 .
      while lt rpos (len src) . do
        let cp be option u64 utf8.decode src rpos .
        guard is_some cp . else return 65 .
        let np be option u64 utf16.put u16buf wpos (some_value cp) .
        guard is_some np . else return 72 .
        rem ★ 이제 `utf16.put` 도 **새 위치**를 돌려준다(2026-08-15) — `utf8.next_start` 와 같은 축이다.
        rem   이 프로그램이 그 비대칭에 걸려 본 자리이고(첫 판은 글자 수가 1 이 나왔다),
        rem   그래서 여기가 **축이 하나임을 상시 시험하는 자리**이기도 하다.
        set wpos (some_value np) .
        let nx be option u64 utf8.next_start src rpos .
        guard is_some nx . else return 65 .
        set rpos (some_value nx) .
        set n (add n 1) .
      end
      rem 되돌린다 — 두 축을 나란히 걸으며 코드포인트를 하나씩 맞댄다.
      let u16v be slice u16 subslice u16buf 0 wpos .
      guard utf16.is_valid u16v . else return 2 .
      var r2 be u64 0 .
      var w2 be u64 0 .
      var m be u64 0 .
      while lt w2 wpos . do
        let a2 be option u64 utf8.decode src r2 .
        guard is_some a2 . else return 2 .
        let b2 be option u64 utf16.decode u16v w2 .
        guard is_some b2 . else return 2 .
        guard eq (some_value a2) (some_value b2) . else return 2 .
        let ra be option u64 utf8.next_start src r2 .
        guard is_some ra . else return 2 .
        set r2 (some_value ra) .
        let rb be option u64 utf16.next_start u16v w2 .
        guard is_some rb . else return 2 .
        set w2 (some_value rb) .
        set m (add m 1) .
      end
      guard eq m n . else return 2 .
      rem ★ 세는 것도 두 모듈이 **따로** 답한다 — 같은 글자 수여야 한다.
      let c8 be option u64 utf8.count_chars src .
      guard is_some c8 . else return 2 .
      let c16 be option u64 utf16.count_chars u16v .
      guard is_some c16 . else return 2 .
      guard eq (some_value c8) (some_value c16) . else return 2 .
      rem ★ 답은 **다른 버퍼**에 쓴다 — `encbuf` 는 방금 u16 뷰가 덮고 있던 자리다.
      rem   끝났다고 같은 바이트를 두 뜻으로 겹쳐 쓰면, 다음 사람이 그 겹침을 못 본다.
      let e3 be option u64 fmt.put_u64 backbuf 0 n .
      guard is_some e3 . else return 72 .
      let e4 be option u64 fmt.put_nl backbuf (some_value e3) .
      guard is_some e4 . else return 72 .
      let w4 be u64 write_out out 1 (subslice backbuf 0 (some_value e4)) .
      return 0 .
    end
  end

  rem 모르는 모드는 **거절한다** — 조용히 아무 일도 안 하는 것보다 낫다.
  return 64 .
end
