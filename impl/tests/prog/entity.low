rem ★★★ **실물 프로그램: 개체 스텝 + 색인** (RFC-0075 §9 · S1).
rem
rem   여태 아무 프로그램도 안 쓰던 모듈 셋을 **한 프로그램에서 함께** 쓴다:
rem     · `soa`     — 위치·속도를 **필드별 배열**로 두고 한 번에 전진시킨다
rem     · `hashmap` — 개체 id → 배열 자리(호출자가 통을 준다)
rem     · `growvec` — 결과 리포트를 **스스로 자라는** 바이트 벡터에 쌓는다
rem
rem   ☞ 라이브러리가 혼자서 초록인 것과 **함께 쓸 만한** 것은 다른 일이고, 그 차이는
rem     실물 프로그램에서만 드러난다. 이 파일을 쓰다가 실제로 적재기 결함이 나왔다
rem     (같은 파일을 두 철자로 두 번 읽어 모듈 선언이 두 벌이 되던 것 — 단계 AA).
rem
rem   ★ 세 모듈이 **한 단위에 공존**한다는 것 자체가 이 프로그램이 지키는 주장이다.

module entity .

use soa     from "../../../lib/soa.low" .
use hashmap from "../../../lib/hashmap.low" .
use growvec from "../../../lib/growvec.low" .
use allocs  from "../../../lib/alloc.low" .

rem 개체 넷: id 는 10·20·30·40, 자리는 0·1·2·3.
rem 위치는 x = 100·200·300·400, 속도는 1·2·3·4 — 한 스텝 뒤 101·202·303·404 여야 한다.

proc main output u8 . input al cap allocator . effects state alloc . do
  rem ── ① soa — 필드별 배열을 세우고 한 스텝 전진 ──────────────────────
  let xso option mut slice u8 . . be alloc_bytes al capacity 32 .
  guard is_some xso . else return 90 .
  var xs mut slice u64 . be view_array u64 (some_value xso) .
  set (index xs 0) 100 . set (index xs 1) 200 .
  set (index xs 2) 300 . set (index xs 3) 400 .

  let vso option mut slice u8 . . be alloc_bytes al capacity 32 .
  guard is_some vso . else return 91 .
  var vxs mut slice u64 . be view_array u64 (some_value vso) .
  set (index vxs 0) 1 . set (index vxs 1) 2 .
  set (index vxs 2) 3 . set (index vxs 3) 4 .

  let moved u64 be soa.step_x xs vxs 4 .
  guard eq moved 4 . else return 1 .
  guard eq (soa.get_x xs 0) 101 . else return 2 .
  guard eq (soa.get_x xs 3) 404 . else return 3 .

  rem ── ② hashmap — id → 자리 (통은 호출자가 준다: 슬롯 8 = u64 16 칸) ──
  let bko option mut slice u8 . . be alloc_bytes al capacity 128 .
  guard is_some bko . else return 92 .
  var bk mut slice u64 . be view_array u64 (some_value bko) .
  var s u64 be 0 .
  while lt s (len bk) . do
    set (index bk s) 0 .
    set s (add s 1) .
  end .
  guard hashmap.put bk 10 0 . else return 4 .
  guard hashmap.put bk 20 1 . else return 5 .
  guard hashmap.put bk 30 2 . else return 6 .
  guard hashmap.put bk 40 3 . else return 7 .
  rem ★ 주의: `hashmap.size` 는 **담긴 개수가 아니라 용량**이다(`div (len b) 2`). 담긴 수는
  rem   `occupied_at` 로 훑어 센다. 처음 이 프로그램을 쓸 때 `size` 를 개수로 읽어 틀렸다 —
  rem   해시맵에서 `size` 는 대개 개수를 뜻하므로, 이름이 독자를 그쪽으로 민다.
  guard eq (hashmap.size bk) 8 . else return 8 .
  var occ u64 be 0 .
  var sl u64 be 0 .
  while lt sl (hashmap.size bk) . do
    if hashmap.occupied_at bk sl . do set occ (add occ 1) . end .
    set sl (add sl 1) .
  end .
  guard eq occ 4 . else return 22 .

  rem 색인이 실제로 자리를 짚는가 — 없는 id 는 none 이어야 한다.
  let i20 option u64 . be hashmap.lookup bk 20 .
  guard is_some i20 . else return 9 .
  guard eq (soa.get_x xs (some_value i20)) 202 . else return 10 .
  let miss option u64 . be hashmap.lookup bk 99 .
  guard not (is_some miss) . else return 11 .

  rem ── ③ growvec — 리포트를 스스로 자라는 벡터에 쌓는다 ────────────────
  let memo option mut slice u8 . . be alloc_bytes al capacity 512 .
  guard is_some memo . else return 93 .
  var bump allocs.bump_bytes be spawn actor allocs.bump_bytes . .
  var c u64 be send bump init (some_value memo) .
  let go option growvec.gvec . using bump be growvec.open 2 .
  guard is_some go . else return 12 .
  var g growvec.gvec . be some_value go .

  rem 개체마다 한 바이트 — 자리 순서대로 x 의 하위 바이트. 용량 2 로 열었으니 **자라야** 한다.
  var k u64 be 0 .
  while lt k 4 . do
    let ido u64 be add 10 (mul k 10) .
    let po option u64 . be hashmap.lookup bk ido .
    guard is_some po . else return 13 .
    guard growvec.add_byte g (narrow u8 (mod (soa.get_x xs (some_value po)) 256)) . else return 14 .
    set k (add k 1) .
  end .
  guard eq (growvec.count_of g) 4 . else return 15 .
  guard gt (growvec.cap_of g) 2 . else return 16 .

  rem 101·202·303·404 의 하위 바이트 = 101·202·47·148.
  let v slice u8 be growvec.view_of g .
  guard eq (len v) 4 . else return 17 .
  guard eq (index v 0) 101 . else return 18 .
  guard eq (index v 1) 202 . else return 19 .
  guard eq (index v 2) 47 . else return 20 .
  guard eq (index v 3) 148 . else return 21 .
  return 42 .
end .
