rem ★★★ **실물 프로그램: 작업 큐 + 결과 색인** (RFC-0075 §9 · S1).
rem
rem   `entity.low` 이 닫고 남은 것 중 **셋**을 한 프로그램에서 쓴다:
rem     · `pool`   — 작업마다 블록 하나를 빌리고 돌려준다(**세대 핸들**)
rem     · `mapgen` — 작업 id → 결과. 제네릭 표(`table u64 u64`)
rem     · `vecgen` — 처리 순서를 제네릭 벡터에 쌓는다(`vec u64`)
rem
rem   ☞ 셋은 서로 **다른 축**이다: 할당 · 연관 · 순차. 한 단위에 같이 서는지가 라이브러리로서
rem     첫 시험이고, 그것은 실물 프로그램에서만 물어진다.
rem
rem ★ 넷째(`spsc`)는 여기 없다 — 이 프로그램의 축(할당·연관·순차)과 다르기 때문이다.
rem   그 모듈은 `impl/tests/prog/ring.low` 이 쓴다.
rem   ☞ 이 파일을 처음 쓸 때는 **못 썼다**: `spsc` 의 모든 op 이 `cap atomic` 을 받는데
rem     진입점에 줄 수 있는 권한 목록에 그것이 없어 `main` 이 E-ENTRY-CAP 으로 거절됐고,
rem     그래서 그 모듈은 *안 쓰이는* 것이 아니라 **쓸 수 없는** 것이었다.
rem     ⇒ 소유자 결정(2026-08-07)으로 `cap atomic` 을 진입점에 열었다(단계 AB).

module jobq .

use pool   from "../../../lib/pool.low" .

rem ★ 브랜드 — RFC-0104 §8-2. 이 프로그램의 풀 하나에 이름 하나(§5.11).
newtype jobs u8 .
use mapgen from "../../../lib/mapgen.low" .
use vecgen from "../../../lib/vecgen.low" .
use allocs from "../../../lib/alloc.low" .

proc main input al cap allocator . output u8 . effects state alloc . do
  rem ── ① 작업 대기열(평범한 배열 — 링 버퍼는 ring.low 이 따로 시험한다) ─────
  let bufo option mut slice u8 . . be alloc_bytes al capacity 64 .
  guard is_some bufo . else return 91 .
  var buf mut slice u64 . be view_array u64 (some_value bufo) .
  var qn u64 be 0 .

  rem ── ② pool: 블록 8 개 × 16 바이트, 세대 배열 나란히 ───────────────────
  let pmo option mut slice u8 . . be alloc_bytes al capacity 128 .
  guard is_some pmo . else return 92 .
  var pmem mut slice u8 . be some_value pmo .
  let pgo option mut slice u8 . . be alloc_bytes al capacity 64 .
  guard is_some pgo . else return 93 .
  var pgen mut slice u64 . be view_array u64 (some_value pgo) .
  let plo option (pool.block_pool jobs) . be pool.init jobs pmem pgen 16 .
  guard is_some plo . else return 95 .
  var pl pool.block_pool jobs . be some_value plo .
  guard eq (pool.blocks jobs pl) 8 . else return 2 .

  rem ── ③ mapgen: id → 결과 · vecgen: 처리 순서 ──────────────────────────
  let amo option mut slice u8 . . be alloc_bytes al capacity 1024 .
  guard is_some amo . else return 94 .
  var bump allocs.bump_bytes be spawn actor allocs.bump_bytes . .
  var c0 u64 be send bump init (some_value amo) .
  let tbo option (mapgen.table u64 u64) . using bump be mapgen.open u64 u64 8 .
  guard is_some tbo . else return 3 .
  var tb mapgen.table u64 u64 . be some_value tbo .
  let vco option (vecgen.vec u64 allocs.bump_bytes) . using bump be vecgen.open u64 2 .
  guard is_some vco . else return 4 .
  var order vecgen.vec u64 allocs.bump_bytes . be some_value vco .

  rem ── ④ 생산: 작업 id 다섯을 민다 ──────────────────────────────────────
  var i u64 be 0 .
  while lt i 5 . do
    set (index buf i) (add 100 i) .
    set qn (add qn 1) .
    set i (add i 1) .
  end
  guard eq qn 5 . else return 6 .

  rem ── ⑤ 소비: 꺼내면서 블록을 빌리고, 결과를 색인하고, 순서를 남긴다 ────
  var done u64 be 0 .
  while lt done 5 . do
    let id u64 be index buf done .
    rem 블록을 빌린다 — 작업 하나가 쓰는 자리다.
    let ho option (pool.handle jobs) . be pool.take jobs pl .
    guard is_some ho . else return 8 .
    let h pool.handle jobs . be some_value ho .
    guard (pool.alive jobs pl h) . else return 9 .
    rem 결과 = id × 2. 색인에 넣고, 처리 순서를 벡터에 쌓는다.
    guard mapgen.insert u64 u64 tb id (mul id 2) . else return 10 .
    guard vecgen.append u64 allocs.bump_bytes order id . else return 11 .
    rem 블록을 돌려준다 — 세대가 올라가 옛 핸들은 죽는다.
    guard (pool.release jobs pl h) . else return 12 .
    guard not (pool.alive jobs pl h) . else return 13 .
    set done (add done 1) .
  end
  guard eq done 5 . else return 14 .

  rem ── ⑥ 대조: 색인·순서·풀이 서로 맞는가 ──────────────────────────────
  guard eq (mapgen.count_of u64 u64 tb) 5 . else return 15 .
  let r102 option u64 . be mapgen.lookup u64 u64 tb 102 .
  guard is_some r102 . else return 16 .
  guard eq (some_value r102) 204 . else return 17 .
  guard not (mapgen.has u64 u64 tb 999) . else return 18 .

  guard eq (vecgen.count_of u64 allocs.bump_bytes order) 5 . else return 19 .
  let f0 option u64 . be vecgen.at u64 allocs.bump_bytes order 0 .
  guard is_some f0 . else return 20 .
  guard eq (some_value f0) 100 . else return 21 .
  let f4 option u64 . be vecgen.at u64 allocs.bump_bytes order 4 .
  guard is_some f4 . else return 22 .
  guard eq (some_value f4) 104 . else return 23 .

  rem 빌린 것을 모두 돌려줬으니 미반납은 0 이어야 한다.
  guard eq (pool.outstanding jobs pl) 0 . else return 24 .
  return 42 .
end
