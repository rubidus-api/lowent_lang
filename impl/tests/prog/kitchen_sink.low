rem ★★★ **모든 새 기제가 한 프로그램에서 만난다** — 결함은 **모양이 만나는 자리**에서 나온다.
rem   모듈 + export/가시성 + trait 충족 + 타입 연관 op + 제네릭(단형화) + 경계 + 빌드 모드 + 엔트리.
rem
rem ★ 그리고 **즉시 진짜 버그가 나왔다**: `export struct rect` 의 **껍질이 안 벗겨졌다.**
rem   수식자 벗기기가 **fn/proc 만** 봤기 때문이다. 그래서 그 struct 는
rem     · **선언된 타입으로 보이지 않았고** → `rect.area` 가 **E-NAME-QUALIFIER**(거짓 오류)
rem     · 이름 중복·가시성 검사에서 **투명인간**이었다
rem   ★★ 그런데 **IR 은 잘 돌았다** — 프로그램이 24 를 냈다.
rem      **컴파일되고 실행되고 검사만 틀렸다.** 조용히 틀린 답의 사촌이다.
module lib .

build release_safe .

trait sized do
  area input s self . output u64 . effects none .
end

export def struct rect do
  satisfies sized .
  w u8 .
  h u8 .
end

export fn rect.area input s rect . output u64 . do
  return mul (widen u64 (field s w)) (widen u64 (field s h)) .
end

rem ★ 제네릭 + trait 경계 + export
export fn twice .
  input comptime t type .
  input a t .
  output u64 .
  requires sized t .
do
  return mul 2 (method a area) .
end

fn hidden input a u8 . output u8 . do return a . end
module app .
use lib .

proc main output u8 . effects none . do
  var r be lit lib.rect do w 3 . h 4 . end .
  return narrow u8 (lib.twice lib.rect r) .      rem 2*12 = 24
end
