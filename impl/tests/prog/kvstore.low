rem ★★★★★ **실물 프로그램: 작은 키-값 저장소** (RFC-0104 §8-13 · WO-0149).
rem
rem   §8 이 지은 **여덟 라이브러리를 한 프로그램에서 함께** 쓴다:
rem     · `budget`    — 핸들의 비트 예산(slot·shard·gen)
rem     · `pool`      — 레코드 슬래브(세대 핸들)
rem     · `nodelist`  — 그 슬롯 위의 **고리형 LRU**(침입형 목록)
rem     · `pagecache` — 색인 페이지 id 조회 + 읽는 동안 **고정(pin)**
rem     · `segarena`  — 값 바이트의 **분절 아레나**
rem     · `segview`   — 분절을 가로지르는 값 읽기
rem     · `shard`     — 두 일꾼이 **겹치지 않는** 키 구역을 쓴다
rem     · `lifemode`  — 공유되는 값의 **근거리 수명**(단일 스레드 refcount)
rem
rem   ☞ 라이브러리가 혼자 초록인 것과 **함께 쓸 만한** 것은 다른 일이다. §8 은 여덟을
rem     각자의 픽스처로만 세웠고, *여덟이 한 자리에 설 수 있는가* 는 아무도 안 물었다.
rem     이 파일이 그 물음이고, 동시에 `docs/bench/metrics.md` 의 **측정 하네스**다.

module kvstore .

use budget    from "../../../lib/budget.low" .
use pool      from "../../../lib/pool.low" .
use nodelist  from "../../../lib/nodelist.low" .
use pagecache from "../../../lib/pagecache.low" .
use segarena  from "../../../lib/segarena.low" .
use segview   from "../../../lib/segview.low" .
use shard     from "../../../lib/shard.low" .
use lifemode  from "../../../lib/lifemode.low" .
use allocs    from "../../../lib/alloc.low" .
use clock     from "../../../lib/clock.low" .

rem 브랜드 — **선언마다 하나**(§8-2: 브랜드는 값이 아니라 타입이다).
newtype kv_rec u8 .
newtype kv_page u8 .
newtype kv_bytes u8 .
newtype kv_keys u8 .
newtype kv_lru u32 .
rem 측정 하네스는 **제 저장소를 따로 연다** — 브랜드는 저장소 하나에 하나다(§8-2).
newtype kv_bench_rec u8 .
newtype kv_bench_keys u8 .

rem ── ① budget — 핸들 한 낱말에 slot·shard·gen 이 들어가는가 ────────────
proc handles output u64 . effects none . do
  let p budget.plan be budget.default64 .
  guard eq (field p slot_bits) 32 . else return 91 .
  let ho option u64 . be budget.pack 32 8 24 7 1 3 .
  guard is_some ho . else return 92 .
  let h u64 be some_value ho .
  guard eq (budget.slot_of 32 h) 7 . else return 93 .
  guard eq (budget.shard_of 32 8 h) 1 . else return 94 .
  guard eq (budget.gen_of 32 8 h) 3 . else return 95 .
  return 1 .
end

rem ── ② pool — 레코드 슬래브: 넷을 얻고 하나를 돌려준 뒤 재사용 ──────────
proc records input mem mut slice u8 . . input gens mut slice u64 . . output u64 .
  effects none .
do
  let po option (pool.block_pool kv_rec) . be pool.init kv_rec mem gens 16 .
  guard is_some po . else return 91 .
  var p pool.block_pool kv_rec . be some_value po .
  var got u64 be 0 .
  var i u64 be 0 .
  while lt i 4 . do
    let h option (pool.handle kv_rec) . be pool.take kv_rec p .
    if is_some h . do set got (add got 1) . end
    set i (add i 1) .
  end
  guard eq got 4 . else return 92 .
  guard eq (pool.outstanding kv_rec p) 4 . else return 93 .
  return 2 .
end


rem ── ③ nodelist — 슬롯 위의 **고리형 LRU**: 넷을 잇고 가운데를 끊는다 ──────
proc lru input nx mut slice u64 . . input pv mut slice u64 . . output u64 . effects none . do
  guard nodelist.nl_solo nx pv 0 . else return 91 .
  guard nodelist.nl_after nx pv 0 1 . else return 92 .
  guard nodelist.nl_after nx pv 1 2 . else return 93 .
  guard nodelist.nl_after nx pv 2 3 . else return 94 .
  guard eq (nodelist.nl_count nx 0) 4 . else return 95 .
  rem 가장 덜 쓰인 것(2)을 고리에서 뺀다 — 순회 중 제거가 오늘 그대로 써진다.
  guard eq (nodelist.nl_walk_cut nx pv 0 2) 4 . else return 96 .
  guard eq (nodelist.nl_count nx 0) 3 . else return 97 .
  return 3 .
end

rem ── ④ pagecache — 색인 페이지: 읽는 동안 고정하고, 놓은 뒤에야 축출된다 ────
proc index_read output u64 . effects none . do
  var c owned pagecache.cache kv_page . be pagecache.open kv_page 16 .
  var pin pagecache.pin kv_page . be pagecache.acquire kv_page c 42 .
  guard eq (pagecache.depth_of kv_page pin) 1 . else return 91 .
  rem 안쪽 페이지 하나를 더 집는다 — 고정은 **쌓이고** LIFO 로 풀린다.
  var pin2 pagecache.pin2 kv_page . be pagecache.acquire_more kv_page pin 43 .
  guard eq (pagecache.depth2_of kv_page pin2) 2 . else return 92 .
  var back owned pagecache.pin kv_page . be pagecache.release_more kv_page pin2 .
  var c2 owned pagecache.cache kv_page . be pagecache.release kv_page back .
  var c3 owned pagecache.cache kv_page . be pagecache.evict kv_page c2 .
  guard eq (pagecache.epoch_of kv_page c3) 1 . else return 93 .
  return 4 .
end

rem ── ⑤ segarena — 값 바이트를 분절로 키운다(분절당 directory load 1회) ────
proc values input dir mut slice u64 . . input cap0 u64 . output u64 . effects none . do
  var a segarena.arena kv_bytes . be segarena.open kv_bytes 2 .
  let b0 option u64 . be segarena.grow kv_bytes a dir cap0 .
  let b1 option u64 . be segarena.grow kv_bytes a dir cap0 .
  guard is_some b0 . else return 91 .
  guard is_some b1 . else return 92 .
  guard eq (some_value b0) 0 . else return 93 .
  guard eq (some_value b1) 4 . else return 94 .
  guard eq (segarena.seg_of kv_bytes a 5) 1 . else return 95 .
  guard eq (segarena.slot_of kv_bytes a 5) 1 . else return 96 .
  return 5 .
end

rem ── ⑥ segview — 분절 둘에 걸친 값을 **한 값으로** 읽는다 ────────────────
proc spanning input al cap allocator . output u64 . effects alloc . do
  let mb option mut slice u8 . . be alloc_bytes al capacity 64 .
  guard is_some mb . else return 91 .
  let md option mut slice u8 . . be alloc_bytes al capacity 32 .
  guard is_some md . else return 92 .
  let mo option mut slice u8 . . be alloc_bytes al capacity 16 .
  guard is_some mo . else return 93 .
  var back mut slice u8 . be some_value mb .
  set (index back 0) 7 . set (index back 1) 8 .
  set (index back 8) 9 . set (index back 9) 10 .
  var d mut slice u64 . be view_array u64 (some_value md) .
  rem (자리, 길이) 짝 둘 — 값이 분절 경계를 넘는다.
  set (index d 0) 0 . set (index d 1) 2 .
  set (index d 2) 8 . set (index d 3) 2 .
  var out mut slice u8 . be some_value mo .
  let ss be view_segments back d .
  guard eq (segs ss) 2 . else return 94 .
  guard eq (segview.total_len ss) 4 . else return 95 .
  let bo option u8 . be segview.byte_at ss 2 .
  guard is_some bo . else return 96 .
  guard eq (some_value bo) 9 . else return 97 .
  let no option u64 . be segview.coalesce ss out .
  guard is_some no . else return 98 .
  guard eq (some_value no) 4 . else return 99 .
  return 6 .
end

rem ── ⑦ shard — 두 일꾼이 겹치지 않는 키 구역을 쓴다(락·원자 없음) ────────
proc workers input mem mut slice u64 . . output u64 . effects none . do
  var r owned shard.token kv_keys . be shard.open kv_keys 8 .
  var h shard.halves kv_keys . be shard.split_at kv_keys r 4 .
  let lo shard.token kv_keys . be (field h low) .
  let hi shard.token kv_keys . be (field h high) .
  guard shard.write kv_keys lo mem 0 100 . else return 91 .
  guard eq (shard.write kv_keys lo mem 4 999) false . else return 92 .
  guard shard.write kv_keys hi mem 4 104 . else return 93 .
  let a option u64 . be shard.read kv_keys hi mem 4 .
  guard is_some a . else return 94 .
  guard eq (some_value a) 104 . else return 95 .
  return 7 .
end

rem ── ⑧ lifemode — 공유되는 값의 근거리 수명(단일 스레드 refcount) ────────
proc sharing input c mut slice u64 . . output u64 . effects none . do
  guard lifemode.near_open c 0 . else return 91 .
  let a option u64 . be lifemode.near_share c 0 .
  guard is_some a . else return 92 .
  guard eq (some_value a) 2 . else return 93 .
  let b option u64 . be lifemode.near_drop c 0 .
  guard is_some b . else return 94 .
  let z option u64 . be lifemode.near_drop c 0 .
  guard is_some z . else return 95 .
  guard eq (some_value z) 0 . else return 96 .
  return 8 .
end


rem ══ 측정 하네스 (RFC-0104 §6.6 · WO-0149) ══════════════════════════════════════
rem   ★ **벤치용 코드를 따로 짓지 않는다.** 위의 여덟 조각을 **되풀이해 돌리고 시간만 잰다** —
rem     그래서 재는 것과 쓰는 것이 같은 코드다. 다르면 그 수는 라이브러리 이야기가 아니다.
rem   ★★ 답은 **ns/op** 이다. 되풀이 수는 인자로 받는다(기계마다 다르게 부를 수 있게).
rem   ☞ 못 재는 것은 안 잰다: TLB miss(도구 없음) · atomic retry(단일 스레드)는 표에서
rem     `미측정` 으로 남고 그 까닭을 표가 적는다.

rem 고리 목록 — 넣고(nl_after) 세고(nl_count) 끊는다(nl_walk_cut).
proc bench_list input nx mut slice u64 . . input pv mut slice u64 . . input reps u64 . output u64 .
  effects none .
do
  var acc u64 be 0 .
  var r u64 be 0 .
  while lt r reps . do
    guard nodelist.nl_solo nx pv 0 . else return 0 .
    guard nodelist.nl_after nx pv 0 1 . else return 0 .
    guard nodelist.nl_after nx pv 1 2 . else return 0 .
    guard nodelist.nl_after nx pv 2 3 . else return 0 .
    set acc (add acc (nodelist.nl_count nx 0)) .
    set acc (add acc (nodelist.nl_walk_cut nx pv 0 2)) .
    set r (add r 1) .
  end
  return acc .
end

rem 슬래브 — 넷을 얻고 넷을 돌려준다(재사용 경로).
proc bench_pool input mem mut slice u8 . . input gens mut slice u64 . . input reps u64 . output u64 .
  effects none .
do
  let po option (pool.block_pool kv_bench_rec) . be pool.init kv_bench_rec mem gens 16 .
  guard is_some po . else return 0 .
  var p pool.block_pool kv_bench_rec . be some_value po .
  var acc u64 be 0 .
  var r u64 be 0 .
  while lt r reps . do
    let h option (pool.handle kv_bench_rec) . be pool.take kv_bench_rec p .
    if is_some h . do
      set acc (add acc 1) .
      if pool.release kv_bench_rec p (some_value h) . do set acc (add acc 1) . end
    end
    set r (add r 1) .
  end
  return acc .
end

rem 샤드 — 겹치지 않는 구역에 쓴다(steady state 에 락·원자가 없어야 한다).
proc bench_shard input mem mut slice u64 . . input reps u64 . output u64 . effects none . do
  var t owned shard.token kv_bench_keys . be shard.open kv_bench_keys 8 .
  var acc u64 be 0 .
  var r u64 be 0 .
  while lt r reps . do
    if shard.write kv_bench_keys t mem 3 r . do set acc (add acc 1) . end
    let v option u64 . be shard.read kv_bench_keys t mem 3 .
    if is_some v . do set acc (add acc 1) . end
    set r (add r 1) .
  end
  return acc .
end

rem 조각 사슬 — 경계를 넘는 바이트를 읽는다(원소마다 디렉터리를 다시 안 읽어야 한다).
proc bench_seg input back mut slice u8 . . input d mut slice u64 . . input reps u64 . output u64 .
  effects none .
do
  set (index d 0) 0 . set (index d 1) 2 .
  set (index d 2) 8 . set (index d 3) 2 .
  let ss be view_segments back d .
  var acc u64 be 0 .
  var r u64 be 0 .
  while lt r reps . do
    let b option u8 . be segview.byte_at ss (mod r 4) .
    if is_some b . do set acc (add acc 1) . end
    set r (add r 1) .
  end
  return acc .
end

rem ── 시간을 재는 자리 ────────────────────────────────────────────────────
rem   `= <ns/op> ` 하나만 낸다. 부르는 쪽(스크립트)이 그것을 표에 옮긴다.
export proc bench input k cap clock . input al cap allocator . input which u64 . input reps u64 .
  output u64 . effects alloc .
do
  guard gt reps 0 . else return 0 .
  let ab option mut slice u8 . . be alloc_bytes al capacity 512 .
  guard is_some ab . else return 0 .
  let bb option mut slice u8 . . be alloc_bytes al capacity 512 .
  guard is_some bb . else return 0 .
  var m8 mut slice u8 . be some_value ab .
  var m64 mut slice u64 . be view_array u64 (some_value bb) .

  let t0 u64 be clock.now_ns k .
  var work u64 be 0 .
  if eq which 0 . do
    let cb option mut slice u8 . . be alloc_bytes al capacity 512 .
    guard is_some cb . else return 0 .
    var pv mut slice u64 . be view_array u64 (some_value cb) .
    set work (bench_list m64 pv reps) .
  end
  if eq which 1 . do set work (bench_pool m8 m64 reps) . end
  if eq which 2 . do set work (bench_shard m64 reps) . end
  if eq which 3 . do set work (bench_seg m8 m64 reps) . end
  let dt u64 be clock.since_ns k t0 .
  guard gt work 0 . else return 0 .
  return div dt reps .
end

rem ── 여덟이 함께 서는지 확인하는 자리 ──────────────────────────────────────
rem   ★ **`main` 이 아니라 `stands` 다.** 까닭은 하나뿐이고 도구의 사정이다: 네이티브 빌드는
rem     `main` 이 있는 단위를 *그 main 만 도는 실행파일* 로, 없는 단위를 **op 디스패처**로
rem     만든다. 재려면 디스패처가 필요하다 ⇒ 이 단위에는 `main` 을 두지 않는다.
rem     그래서 확인도 측정도 **같은 파일 · 같은 코드**에서 나온다(벤치용 사본이 없다).
rem   쓰는 법:  lowentc --run stands tests/prog/kvstore.low
rem             lowentc --emit-c … && ./bin bench 0 0 <which> <reps>   → ns/op
export proc stands input al cap allocator . output u8 . effects alloc . do
  guard eq handles 1 . else return 1 .

  let mb option mut slice u8 . . be alloc_bytes al capacity 256 .
  guard is_some mb . else return 89 .
  let gb option mut slice u8 . . be alloc_bytes al capacity 128 .
  guard is_some gb . else return 88 .
  var mem mut slice u8 . be some_value mb .
  var gens mut slice u64 . be view_array u64 (some_value gb) .
  guard eq (records mem gens) 2 . else return 2 .

  let nb option mut slice u8 . . be alloc_bytes al capacity 64 .
  guard is_some nb . else return 87 .
  let pb option mut slice u8 . . be alloc_bytes al capacity 64 .
  guard is_some pb . else return 86 .
  var nx mut slice u64 . be view_array u64 (some_value nb) .
  var pv mut slice u64 . be view_array u64 (some_value pb) .
  guard eq (lru nx pv) 3 . else return 3 .

  guard eq index_read 4 . else return 4 .

  let db option mut slice u8 . . be alloc_bytes al capacity 64 .
  guard is_some db . else return 85 .
  var dir mut slice u64 . be view_array u64 (some_value db) .
  guard eq (values dir 8) 5 . else return 5 .

  guard eq (spanning al) 6 . else return 6 .

  let kb option mut slice u8 . . be alloc_bytes al capacity 64 .
  guard is_some kb . else return 84 .
  var keys mut slice u64 . be view_array u64 (some_value kb) .
  guard eq (workers keys) 7 . else return 7 .

  let cb option mut slice u8 . . be alloc_bytes al capacity 32 .
  guard is_some cb . else return 83 .
  var rc mut slice u64 . be view_array u64 (some_value cb) .
  guard eq (sharing rc) 8 . else return 8 .

  return 0 .
end
