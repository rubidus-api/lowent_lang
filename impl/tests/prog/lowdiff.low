rem ★★★ **lowdiff — 두 폴더를 «이름이 아니라 내용으로» 비교한다** (백로그 X-0030 · WO-0209).
rem
rem   이 저장소의 첫 «실물 도구»다. 작업 폴더와 백업(또는 배포) 폴더가 정말 같은지 묻는 일은
rem   흔하고, 그 답을 크기·수정시각으로 때우면 **조용히 틀린다**. 그래서 내용을 읽어 견준다.
rem
rem   ★ 왜 경로를 다 모으지 않는가: 이 언어의 힙 아레나는 **64 KiB**(`LOW_ROOTMEM_BYTES`,
rem     VM·네이티브 같은 수)다. 트리 전체의 경로 목록은 거기 안 들어간다. 그래서 **디렉터리
rem     쌍 단위로 나란히 걷는다** — 한 디렉터리의 엔트리만 양쪽에서 읽어 정렬·합치고, 공통
rem     하위 디렉터리는 대기 목록에 넣는다. 메모리가 **파일 총수와 무관**해진다.
rem   ★ 파일 내용도 **청크로** 읽는다(4 KiB씩) — 50 MB 파일도 버퍼는 그대로다.
rem
rem   종료 코드: 0 = 같다 · 1 = 차이가 있다 · 2 = 사용법 · 3 = 내부 한도 초과(조용히 자르지 않는다).
rem   출력 한 줄 = 하나의 발견: `added ` · `deleted ` · `changed ` · `unreadable ` · `skipped `.
rem   ☞ **읽지 못한 것은 «같다» 도 «없다» 도 아니다** — 따로 말하고, 실행을 멈추지 않는다.
rem
rem   ★ 오늘의 한계(정직하게): `file_type` 이 `stat` 이라 **심링크를 구분하지 못한다** — 심링크는
rem     그것이 가리키는 것으로 보인다. 「따라가지 않고 제외 보고」 하려면 `lstat` 자리가 필요하다.

module lowdiff .

use files from "../../../lib/file.low" .
use strbuf from "../../../lib/strbuf.low" .

rem ── 한도. 넘치면 **말하고 멈춘다**(3번 종료 코드). 조용히 자르는 것이 이 저장소가 가장
rem    무서워하는 일이다.
rem ★★ 이 수들은 **호스티드를 가정한다** (X-0031 · WO-0211, 소유자 지시). 1 차판은 뿌리 아레나가
rem   정적 64 KiB 였고, 그래서 한 디렉터리에 256 개까지만 받았다 — 실제 폴더에는 그보다 많은
rem   엔트리가 흔하다. 이제 호스티드에서는 아레나가 청크로 자라므로 그 천장에 맞출 이유가 없다.
rem   ☞ *한도는 여전히 있다. 그러나 그 수는 «기계가 못 해서» 가 아니라 «여기까지는 본다» 여야 한다.*
fn max_entries output u64 . do return 4096 . end .
fn max_names   output u64 . do return 262144 . end .
fn max_pend    output u64 . do return 4096 . end .
fn max_pendbuf output u64 . do return 262144 . end .
fn chunk_size  output u64 . do return 65536 . end .

rem 바이트 사전순: a < b 인가.
fn less input a slice u8 . input b slice u8 . output bool .
do
  var i u64 be 0 .
  var ans u64 be 2 .
  while lt i (len a) . do
    if lt i (len b) . do
      if eq ans 2 . do
        if lt (index a i) (index b i) . do set ans 1 . end .
        if gt (index a i) (index b i) . do set ans 0 . end .
      end .
    end .
    set i (add i 1) .
  end .
  if eq ans 2 . do
    if lt (len a) (len b) . do set ans 1 . end .
    if eq ans 2 . do set ans 0 . end .
  end .
  return eq ans 1 .
end .

rem 같은 바이트열인가.
fn same_bytes input a slice u8 . input b slice u8 . output bool .
do
  guard eq (len a) (len b) . else return false .
  var i u64 be 0 .
  var verd bool be true .
  while lt i (len a) . do
    if ne (index a i) (index b i) . do set verd false . end .
    set i (add i 1) .
  end .
  return verd .
end .

rem ── 한 디렉터리의 엔트리 이름을 모은다(`.`/`..` 은 뺀다). 색인만 정렬한다.
rem    돌려주는 수: 엔트리 개수. 실패·한도 초과는 `err` 에 적는다(0=ok · 71=열기 · 72=닫기 · 3=한도).
proc list_dir .
  input fs cap file_system .
  input path slice u8 .
  input namebuf mut slice u8 . .
  input arena mut slice u8 . .
  input offs mut slice u64 . .
  input lens mut slice u64 . .
  input st mut slice u64 . .
  output u64 .
  effects io .
do
  set (index st 0) 0 .
  let di result files.dir_handle files.file_error . be files.open_dir fs path .
  if eq (is_ok di) false . do set (index st 0) 71 . end .
  guard is_ok di . else return 0 .
  var dh owned files.dir_handle be ok_value di .

  var n u64 be 0 .
  var used u64 be 0 .
  var going bool be true .
  while going . do
    let r result (option u64) files.file_error . be files.read_dir fs dh namebuf .
    if eq (is_ok r) false . do set going false . set (index st 0) 71 . end .
    if is_ok r . do
      let nv option u64 . be ok_value r .
      if eq (is_some nv) false . do set going false . end .
      var nl u64 be 0 .
      if is_some nv . do set nl (some_value nv) . end .
      if eq nl 0 . do set going false . end .
      if gt nl 0 . do
        rem `.` 과 `..` 은 건너뛴다
        var skip bool be false .
        if eq nl 1 . do
          if eq (index namebuf 0) 46 . do set skip true . end .
        end .
        if eq nl 2 . do
          if eq (index namebuf 0) 46 . do
            if eq (index namebuf 1) 46 . do set skip true . end .
          end .
        end .
        if eq skip false . do
          if ge n (max_entries) . do set (index st 0) 3 . set going false . end .
          if lt n (max_entries) . do
            if gt (add used nl) (max_names) . do set (index st 0) 3 . set going false . end .
            if le (add used nl) (max_names) . do
              set (index offs n) used .
              set (index lens n) nl .
              var k u64 be 0 .
              while lt k nl . do
                set (index arena (add used k)) (index namebuf k) .
                set k (add k 1) .
              end .
              set used (add used nl) .
              set n (add n 1) .
            end .
          end .
        end .
      end .
    end .
  end .
  let c result void files.file_error . be files.close_dir fs dh .
  if eq (is_ok c) false . do set (index st 0) 72 . end .

  rem 삽입 정렬 — 색인만 옮긴다. 엔트리 수가 작아(한 디렉터리) 이것으로 충분하다.
  var i u64 be 1 .
  while lt i n . do
    var j u64 be i .
    var moving bool be true .
    while moving . do
      if eq j 0 . do set moving false . end .
      if gt j 0 . do
        let pj u64 be sub j 1 .
        let cur slice u8 be subslice arena (index offs j) (add (index offs j) (index lens j)) .
        let prv slice u8 be subslice arena (index offs pj) (add (index offs pj) (index lens pj)) .
        if less cur prv . do
          let sv_o u64 be index offs j .
          let sv_l u64 be index lens j .
          set (index offs j) (index offs pj) .
          set (index lens j) (index lens pj) .
          set (index offs pj) sv_o .
          set (index lens pj) sv_l .
          set j pj .
        end .
        if eq (less cur prv) false . do set moving false . end .
      end .
    end .
    set i (add i 1) .
  end .
  return n .
end .

rem ── 두 파일을 **청크로** 견준다. 0 = 같다 · 1 = 다르다 · 2 = 읽지 못했다.
proc same_file .
  input fs cap file_system .
  input pa slice u8 .
  input pb slice u8 .
  input ba mut slice u8 . .
  input bb mut slice u8 . .
  output u64 .
  effects io .
do
  let ha result files.handle files.file_error . be files.open fs pa 0 .
  guard is_ok ha . else return 2 .
  var fa owned files.handle be ok_value ha .
  let hb result files.handle files.file_error . be files.open fs pb 0 .
  if eq (is_ok hb) false . do
    rem ★ 여기서 **바로 돌아온다** — 닫고 나서 합류하면 `fa` 의 소유 상태가 갈래마다 달라진다
    rem   (E-OWN-JOIN: 한쪽에서만 소비된 owned 는 합류점에서 정적으로 일치해야 한다).
    let ca result void files.file_error . be files.close fs fa .
    drop ca .
    return 2 .
  end .
  var fb owned files.handle be ok_value hb .

  var verdict u64 be 0 .
  var going bool be true .
  while going . do
    rem ★ `files.read` 는 **세 자리**를 돌려준다: `error` = 못 읽었다 · `ok none` = 파일 끝 ·
    rem   `ok (some n)` = n 바이트. 끝과 실패를 한 자리로 뭉개면 «읽다 만 파일» 이 «같다» 가 된다.
    let ra result (option u64) files.file_error . be files.read fs fa ba .
    let rb result (option u64) files.file_error . be files.read fs fb bb .
    if eq (is_ok ra) false . do set verdict 2 . set going false . end .
    if eq (is_ok rb) false . do set verdict 2 . set going false . end .
    if going . do
      var na u64 be 0 .
      var nb u64 be 0 .
      let oa option u64 . be ok_value ra .
      let ob option u64 . be ok_value rb .
      if is_some oa . do set na (some_value oa) . end .
      if is_some ob . do set nb (some_value ob) . end .
      if ne na nb . do set verdict 1 . set going false . end .
      if eq na 0 . do set going false . end .
      if going . do
        if eq (same_bytes (subslice ba 0 na) (subslice bb 0 nb)) false . do
          set verdict 1 . set going false .
        end .
      end .
    end .
  end .

  let ca2 result void files.file_error . be files.close fs fa .
  let cb2 result void files.file_error . be files.close fs fb .
  if eq (is_ok ca2) false . do set verdict 2 . end .
  if eq (is_ok cb2) false . do set verdict 2 . end .
  return verdict .
end .

rem ── 두 경로가 **심링크인가**를 한 번에 묻는다. 0 = 둘 다 아니다 · 1 = 둘 다 링크다 ·
rem    2 = 한쪽만 링크다. `link_type` 은 링크를 **따라가지 않는다**(3 = 심링크).
rem    ☞ 이것을 따로 뺀 이유는 `main` 의 지역이 언어 한도(64)에 닿았기 때문이다 — 그리고
rem      빼고 나니 규칙이 한자리에 모여 읽기도 낫다.
proc link_pair .
  input fs cap file_system .
  input pa slice u8 .
  input pb slice u8 .
  output u64 .
  effects io .
do
  var sa bool be false .
  var sb bool be false .
  let la option u64 . be files.link_type_of fs pa .
  let lb option u64 . be files.link_type_of fs pb .
  if is_some la . do if eq (some_value la) 3 . do set sa true . end . end .
  if is_some lb . do if eq (some_value lb) 3 . do set sb true . end . end .
  if ne sa sb . do return 2 . end .
  if sa . do return 1 . end .
  return 0 .
end .

rem ── 경로 조립: base + "/" + name (base 가 비었으면 name 만). 실패하면 false.
proc join_path .
  input base slice u8 .
  input name slice u8 .
  input buf mut slice u8 . .
  input outlen mut slice u64 . .
  output bool .
  effects none .
do
  var b strbuf.str_buf be strbuf.new .
  if gt (len base) 0 . do
    let r1 result void strbuf.sb_error . be strbuf.append b buf base .
    guard is_ok r1 . else return false .
    let r2 result void strbuf.sb_error . be strbuf.append b buf "/" .
    guard is_ok r2 . else return false .
  end .
  let r3 result void strbuf.sb_error . be strbuf.append b buf name .
  guard is_ok r3 . else return false .
  set (index outlen 0) (len (strbuf.as_str b buf)) .
  return true .
end .

proc main .
  input fs cap file_system .
  input out cap io .
  input hp cap heap .
  input a  cap args .
  output u8 .
  effects heap io .
do
  var w u64 be 0 .
  let a0 option slice u8 . be arg a 0 .
  let a1 option slice u8 . be arg a 1 .
  if eq (is_some a0) false . do
    set w (write_out out 2 "usage: lowdiff <before-dir> <after-dir>\n") .
  end .
  guard is_some a0 . else return 2 .
  if eq (is_some a1) false . do
    set w (write_out out 2 "usage: lowdiff <before-dir> <after-dir>\n") .
  end .
  guard is_some a1 . else return 2 .
  let rootA slice u8 be some_value a0 .
  let rootB slice u8 be some_value a1 .

  rem ── 버퍼는 **한 덩어리로 한 번** 잡고 `subslice` 로 나눠 쓴다.
  rem    ☞ 처음엔 열여섯 번 따로 잡았는데 `main` 의 지역이 언어 한도(64)를 넘었다
  rem      (`E-IR-LOCALS`). 한 번 잡아 나누면 이름도 줄고 아레나 안에서 자리도 명확하다.
  rem    ★ 크기는 호스티드 기준이다 — 합쳐 **약 1.2 MiB**. 그래서 **자라는 뿌리**(`cap heap` ·
  rem      `effects heap`, RFC-0112 D2)에서 받는다: 고정 창(64 KiB)에는 안 들어가고, 이 도구는 운영체제
  rem      위에서만 뜻이 있다. 서명이 그렇게 말하므로 `--target cortex_m --check` 는 **선언만 보고**
  rem      거절한다(E-HEAP-NOHOST) — 본문을 열지 않아도 이 도구가 호스티드 전용임을 안다.
  rem    자리표(바이트): name 0..4K · arenaA 4K..260K · arenaB 260K..516K ·
  rem      offsA 516K..549K · lensA 549K..582K · offsB 582K..614K · lensB 614K..647K ·
  rem      pend 647K..909K · poffs 909K..942K · plens 942K..975K · rel 975K..979K ·
  rem      pathA 979K..983K · pathB 983K..987K · chunkA 987K..1052K · chunkB 1052K..1118K ·
  rem      scratch 1118K..1118K+64
  let gm option mut slice u8 . . be alloc_bytes hp capacity 1145408 .
  guard is_some gm . else return 70 .
  let mem mut slice u8 . be some_value gm .
  let namebuf mut slice u8 . be subslice mem 0 4096 .
  let arenaA mut slice u8 . be subslice mem 4096 266240 .
  let arenaB mut slice u8 . be subslice mem 266240 528384 .
  let offsA mut slice u64 . be view_array u64 (subslice mem 528384 561152) .
  let lensA mut slice u64 . be view_array u64 (subslice mem 561152 593920) .
  let offsB mut slice u64 . be view_array u64 (subslice mem 593920 626688) .
  let lensB mut slice u64 . be view_array u64 (subslice mem 626688 659456) .
  let pend mut slice u8 . be subslice mem 659456 921600 .
  let poffs mut slice u64 . be view_array u64 (subslice mem 921600 954368) .
  let plens mut slice u64 . be view_array u64 (subslice mem 954368 987136) .
  let relbuf mut slice u8 . be subslice mem 987136 991232 .
  let pathA mut slice u8 . be subslice mem 991232 995328 .
  let pathB mut slice u8 . be subslice mem 995328 999424 .
  let chunkA mut slice u8 . be subslice mem 999424 1064960 .
  let chunkB mut slice u8 . be subslice mem 1064960 1130496 .
  let scratch mut slice u64 . be view_array u64 (subslice mem 1130496 1130560) .

  rem 대기 목록: 아직 안 본 **상대 경로**들. 시작은 뿌리(빈 문자열) 하나.
  var np u64 be 1 .
  var pused u64 be 0 .
  set (index poffs 0) 0 .
  set (index plens 0) 0 .

  var diffs u64 be 0 .
  var limit_hit bool be false .
  var io_bad bool be false .

  while gt np 0 . do
    rem 스택처럼 **뒤에서** 꺼낸다 — 넣을 때 역순으로 넣어 오름차순으로 나온다.
    set np (sub np 1) .
    let ro u64 be index poffs np .
    let rl u64 be index plens np .
    let rel slice u8 be subslice pend ro (add ro rl) .
    set pused ro .

    rem 이 상대 경로의 양쪽 실제 경로
    rem ★ 판정 하나를 **변수 하나**로 받는다 — `main` 의 지역이 언어 한도(64)에 닿아 있다.
    if eq (join_path rootA rel pathA scratch) false . do set limit_hit true . end .
    let la u64 be index scratch 0 .
    if eq (join_path rootB rel pathB scratch) false . do set limit_hit true . end .
    let lb u64 be index scratch 0 .

    var nA u64 be 0 .
    var nB u64 be 0 .
    if eq limit_hit false . do
      set nA (list_dir fs (subslice pathA 0 la) namebuf arenaA offsA lensA scratch) .
      if eq (index scratch 0) 3 . do set limit_hit true . end .
      if gt (index scratch 0) 3 . do set io_bad true . end .
      set nB (list_dir fs (subslice pathB 0 lb) namebuf arenaB offsB lensB scratch) .
      if eq (index scratch 0) 3 . do set limit_hit true . end .
      if gt (index scratch 0) 3 . do set io_bad true . end .
    end .

    rem ── 두 정렬 목록을 합친다.
    var ia u64 be 0 .
    var ib u64 be 0 .
    var merging bool be true .
    if limit_hit . do set merging false . end .
    while merging . do
      if ge ia nA . do
        if ge ib nB . do set merging false . end .
      end .
      if merging . do
        var side u64 be 0 .   rem 0 = 양쪽 · 1 = A 만(지워짐) · 2 = B 만(더해짐)
        if ge ia nA . do set side 2 . end .
        if ge ib nB . do set side 1 . end .
        if lt ia nA . do
          if lt ib nB . do
            if less (subslice arenaA (index offsA ia) (add (index offsA ia) (index lensA ia)))
                    (subslice arenaB (index offsB ib) (add (index offsB ib) (index lensB ib))) . do set side 1 . end .
            if less (subslice arenaB (index offsB ib) (add (index offsB ib) (index lensB ib)))
                    (subslice arenaA (index offsA ia) (add (index offsA ia) (index lensA ia))) . do set side 2 . end .
          end .
        end .

        rem 이름 하나를 고르고, 그 상대 경로를 만든다
        var nmo u64 be 0 .
        var nml u64 be 0 .
        var from_a bool be true .
        if eq side 2 . do set from_a false . end .
        if from_a . do set nmo (index offsA ia) . set nml (index lensA ia) . end .
        if eq from_a false . do set nmo (index offsB ib) . set nml (index lensB ib) . end .
        var nm slice u8 be subslice arenaA nmo (add nmo nml) .
        if eq from_a false . do set nm (subslice arenaB nmo (add nmo nml)) . end .

        let okr bool be join_path rel nm relbuf scratch .
        let rl2 u64 be index scratch 0 .
        if eq okr false . do set limit_hit true . set merging false . end .

        if merging . do
          let childrel slice u8 be subslice relbuf 0 rl2 .
          if eq (join_path rootA childrel pathA scratch) false . do set limit_hit true . end .
          let pla u64 be index scratch 0 .
          if eq (join_path rootB childrel pathB scratch) false . do set limit_hit true . end .
          let plb u64 be index scratch 0 .

          if eq side 1 . do
            set w (write_out out 1 "deleted ") .
            set w (write_out out 1 childrel) .
            set w (write_out out 1 "\n") .
            set diffs (add diffs 1) .
            set ia (add ia 1) .
          end .
          if eq side 2 . do
            set w (write_out out 1 "added ") .
            set w (write_out out 1 childrel) .
            set w (write_out out 1 "\n") .
            set diffs (add diffs 1) .
            set ib (add ib 1) .
          end .
          if eq side 0 . do
            rem ★★★ **심링크는 따라가지 않는다** (X-0030 ⓐ · WO-0210). `link_type` 은 링크 자신을
            rem   본다(3 = 심링크). 전에는 `file_type`(stat)만 있어서 링크가 **가리키는 대상**으로
            rem   보였고, 한쪽이 링크이고 다른 쪽이 같은 내용의 진짜 파일이면 «같다» 고 답했다.
            rem   ☞ 규율 셋: 양쪽 다 링크면 **견주지 않고 그렇게 말한다**(차이로 세지 않는다 —
            rem     안 그러면 같은 트리를 자기 자신과 견줄 때도 차이가 난다) · 한쪽만 링크면
            rem     그것은 **차이다**(종류가 다르다) · 링크가 가리키는 곳까지는 1 차판이 안 본다.
            let lp u64 be link_pair fs (subslice pathA 0 pla) (subslice pathB 0 plb) .
            var skip_pair bool be false .
            if eq lp 1 . do
              set w (write_out out 1 "symlink ") .
              set w (write_out out 1 childrel) .
              set w (write_out out 1 "\n") .
              set skip_pair true .
            end .
            if eq lp 2 . do
              set w (write_out out 1 "changed ") .
              set w (write_out out 1 childrel) .
              set w (write_out out 1 "\n") .
              set diffs (add diffs 1) .
              set skip_pair true .
            end .
            let ta option u64 . be files.type_of fs (subslice pathA 0 pla) .
            let tb option u64 . be files.type_of fs (subslice pathB 0 plb) .
            var ka u64 be 9 .
            var kb u64 be 9 .
            if is_some ta . do set ka (some_value ta) . end .
            if is_some tb . do set kb (some_value tb) . end .
            if skip_pair . do set ka 7 . set kb 7 . end .
            if ne ka kb . do
              set w (write_out out 1 "changed ") .
              set w (write_out out 1 childrel) .
              set w (write_out out 1 "\n") .
              set diffs (add diffs 1) .
            end .
            if eq ka kb . do
              if eq ka 1 . do
                rem 둘 다 디렉터리 — 대기 목록에 넣는다
                if ge np (max_pend) . do set limit_hit true . end .
                if lt np (max_pend) . do
                  if gt (add pused rl2) (max_pendbuf) . do set limit_hit true . end .
                  if le (add pused rl2) (max_pendbuf) . do
                    set (index poffs np) pused .
                    set (index plens np) rl2 .
                    var z u64 be 0 .
                    while lt z rl2 . do
                      set (index pend (add pused z)) (index relbuf z) .
                      set z (add z 1) .
                    end .
                    set pused (add pused rl2) .
                    set np (add np 1) .
                  end .
                end .
              end .
              if eq ka 0 . do
                let v u64 be same_file fs (subslice pathA 0 pla) (subslice pathB 0 plb) chunkA chunkB .
                if eq v 1 . do
                  set w (write_out out 1 "changed ") .
                  set w (write_out out 1 childrel) .
                  set w (write_out out 1 "\n") .
                  set diffs (add diffs 1) .
                end .
                if eq v 2 . do
                  set w (write_out out 1 "unreadable ") .
                  set w (write_out out 1 childrel) .
                  set w (write_out out 1 "\n") .
                  set diffs (add diffs 1) .
                  set io_bad true .
                end .
              end .
              if eq ka 7 . do
                rem ★ 심링크 자리 — 위에서 이미 말했다. 여기서 또 말하지 않는다.
                set ka ka .
              end .
              if eq ka 2 . do
                rem 보통 파일도 디렉터리도 아닌 것(장치·파이프 등) — 견주지 않고 **말한다**
                set w (write_out out 1 "skipped ") .
                set w (write_out out 1 childrel) .
                set w (write_out out 1 "\n") .
              end .
            end .
            set ia (add ia 1) .
            set ib (add ib 1) .
          end .
        end .
      end .
    end .
  end .

  if limit_hit . do
    set w (write_out out 2 "lowdiff: an internal limit was reached (entries per directory, path length, or pending directories) — the comparison is INCOMPLETE\n") .
    return 3 .
  end .
  if gt diffs 0 . do return 1 . end .
  if io_bad . do return 1 . end .
  return 0 .
end .
