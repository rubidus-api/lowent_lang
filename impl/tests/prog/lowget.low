rem ★★★★★ **lowget — 이 언어로 만든 두 번째 실물 도구** (백로그 X-0032)
rem
rem   `lowdiff` 가 첫 번째였다: 사람이 실제로 돌리고, 외부 표준 도구(`diff -rq`)와 답을 맞댈
rem   수 있는 프로그램. 이것은 그 기준을 잇는다 — **진짜 서버에 TLS 1.3 으로 붙어 본문을 받는다.**
rem
rem ★ **왜 이 프로그램인가.** 원장이 재는 사실 하나: 이 저장소의 암호·TLS 모듈 열 편은
rem   소비자가 **합성 프로그램뿐**이었다(우리가 만든 것을 우리가 읽는다). 클라이언트가 서면
rem   바깥의 진짜 구현이 반대편에 서고, 그때 비로소 *"규격을 같게 읽었다"* 가 확인된다.
rem
rem ★★ **이 판은 인증서를 확인한다**(X-0032 P3 이 선 뒤로): 이름(SAN·와일드카드 한 단계) ·
rem   유효기간(`cap clock` 이 지금을 준다) · 체인의 마디마다 서명 · CA 표시 · 그리고 체인이
rem   **믿는 뿌리**에 닿는가(시스템 묶음, `--cafile` 로 갈아탈 수 있다).
rem   확인을 건너뛰려면 `--insecure` 라고 **적어야** 하고, 그러면 도구가 stderr 에 그 사실을
rem   한 줄로 말한다. 검증하지 않는 클라이언트를 조용히 내놓지 않는다.
rem   ☞ 서명은 RSA(v1.5)·ECDSA 의 SHA-256/SHA-384 넷을 확인한다. 모르는 알고리즘은 **거절**한다.
rem
rem ★★ **응답은 사람이 바라는 모양으로 낸다** — 머리를 떼고 `chunked` 껍질을 벗겨 본문만
rem   흘린다(`-i` 를 주면 머리도 함께). 실측(2026-09-19): example.com · cloudflare.com ·
rem   www.wikipedia.org · api.github.com 넷에서 `curl -sS` 와 **본문 바이트가 같다**.
rem
rem   `lowget <url> [-i] [--insecure] [--cafile <path>]`
rem   종료 코드: 0 성공 · 1 HTTP 오류 상태(400 이상) · 2 사용법 · 3 연결/이름 ·
rem              4 인증서를 믿지 못한다 · 5 규약 위반
rem   ☞ 안쪽의 자세한 수(89..126 — 어디서 멈췄는가)는 **stderr 로만** 나간다. 종료 코드는
rem     위의 여섯 가지뿐이다: 부르는 쪽이 세어야 할 것을 늘리지 않는다.
rem
rem   버퍼 지도(자라는 뿌리에서 한 덩이 262144 — `cap heap`):
rem     [0      ..  20000)  msgs  전사(핸드셰이크 메시지를 이어붙인다)
rem     [20000  ..  36700)  rec   레코드 한 장(5 + 16384 + 여유)
rem     [36700  ..  53100)  inner 복호한 평문
rem     [53100  ..  54400)  w     작업 공간(tlscli 가 1216 을 요구한다)
rem     [54400  ..  55800)  xw    x25519 작업(u64 175)
rem     [55800  ..  56200)  u     레코드 작업(u64 42)
rem     [56200  ..  56400)  keys  c_hs·s_hs·hs(96) + 트래픽 키(44×2)
rem     [56400  ..  60096)  보냄 버퍼 · 인증서 자리표 · 씨에서 편 재료
rem     [70000  .. 170008)  인증서 검증(아래 `check_chain` 이 자리를 적는다)
rem     [180000 .. 196512)  응답을 푸는 자리(머리 · 길이 줄 · 상태 여덟 칸)

module lowget .

use net from "../../../lib/net.low" .
use tlscli from "../../../lib/tlscli.low" .
use tlssrv from "../../../lib/tlssrv.low" .
use tls13 from "../../../lib/tls13.low" .
use x25519 from "../../../lib/x25519.low" .
rem ☞ [http](http) 를 들이지 **않는다**. 응답의 상태 줄만 보면 되는데, 그 모듈을 함께 들이면
rem   `value_off`·`body_off` 가 [der](der)·[pem](pem) 의 같은 이름과 부딪친다 — 이름공간이
rem   평평하고 씨의 심볼 이름도 평평하기 때문이다(도구가 `E-ABI-NAME-DUP` 으로 거절한다).
rem   쓰지 않는 것을 들이지 않는 것이 여기서는 고침이기도 하다.
use verify from "../../../lib/verify.low" .
use trust from "../../../lib/trust.low" .
use x509 from "../../../lib/x509.low" .
use clock from "../../../lib/clock.low" .

rem ★ 정확히 n 바이트를 받는다. **한 번의 recv 가 전부를 준다는 보장이 없다** — 그 가정이
rem   네트워크 코드에서 가장 흔한 조용한 실패다.
proc recv_exact input k cap net . input fd u64 . input dst mut slice u8 . input n u64 .
     output u64 . effects io .
do
  guard ge (len dst) n . else return 0 .
  var got u64 be 0 .
  var spin u64 be 0 .
  while lt got n . do
    let r option u64 . be net.recv_once k fd (subslice dst got n) .
    guard is_some r . else return 0 .
    let m u64 be some_value r .
    guard gt m 0 . else return 0 .
    set got (add got m) .
    set spin (add spin 1) .
    guard le spin 8192 . else return 0 .
  end .
  return got .
end .

rem ★ 레코드 한 장을 받는다 — 머리 5 를 먼저 읽고, 적힌 만큼 더 읽는다.
rem   `rec` 에는 **머리까지** 담는다(AEAD 의 덧붙인 자료가 그 다섯 바이트다).
proc recv_rec input k cap net . input fd u64 . input rec mut slice u8 . output u64 . effects io .
do
  guard ge (len rec) 5 . else return 0 .
  guard eq (recv_exact k fd rec 5) 5 . else return 0 .
  let n u64 be tlscli.rec_len (subslice rec 0 5) .
  guard gt n 0 . else return 0 .
  guard ge (len rec) (add 5 n) . else return 0 .
  guard eq (recv_exact k fd (subslice rec 5 (add 5 n)) n) n . else return 0 .
  return add 5 n .
end .

rem ★★★★★ **핸드셰이크 한 판.** 이 op 이 끝나면 응용 트래픽 키가 서 있다.
rem
rem   차례(RFC 8446 §2): CH → SH → {EE, Cert, CV, Fin} → {우리 Fin}
rem   중괄호 안은 **암호화된** 레코드다. 그래서 SH 를 받은 직후에 키 사다리를 올라야 그 다음을
rem   읽을 수 있고, 그것이 이 프로토콜의 매듭이다.
rem
rem ★ 전사(transcript)는 **레코드가 아니라 메시지**를 이어붙인 것이다. 한 레코드에 메시지가
rem   여럿 들어올 수 있고, 한 메시지가 레코드 둘에 걸칠 수도 있다 — 그래서 레코드를 풀어
rem   메시지 단위로 모은다. 이 구별을 놓치면 Finished 검산이 **조용히** 틀린다.
proc handshake input k cap net . input fd u64 . input buf mut slice u8 . input host slice u8 .
     input priv slice u8 . input rnd slice u8 . input sid slice u8 . output u64 . effects io .
do
  guard ge (len buf) 65536 . else return 90 .
  guard eq (len priv) 32 . else return 90 .
  set (index buf 56592) 0 .  set (index buf 56593) 0 .
  set (index buf 56594) 0 .  set (index buf 56595) 0 .

  let xw mut slice u64 . be view_array u64 (subslice buf 54400 55800) .
  let u  mut slice u64 . be view_array u64 (subslice buf 55800 56200) .

  rem ── ① 우리 몫의 키를 만든다 — 공개키 = priv · 기저점 ──────────────────
  rem   기저점은 9 뒤에 0 서른하나다(RFC 7748 §5).
  var bi u64 be 0 .
  while lt bi 32 . do  set (index buf (add 56400 bi)) 0 .  set bi (add bi 1) .  end .
  set (index buf 56400) 9 .
  guard eq (x25519.agree (subslice buf 56432 56464) priv (subslice buf 56400 56432) (subslice buf 56464 56496) xw) 32 . else return 91 .

  rem ── ② ClientHello — 전사의 첫 메시지이자 첫 레코드 ────────────────────
  let chn u64 be tlscli.build_ch rnd sid (subslice buf 56432 56464) host (subslice buf 0 20000) .
  guard gt chn 0 . else return 92 .
  guard eq (tlscli.plain_hdr chn (subslice buf 20000 20005)) 5 . else return 92 .
  var ci u64 be 0 .
  while lt ci chn . do
    set (index buf (add 20005 ci)) (index buf ci) .
    set ci (add ci 1) .
  end .
  let sent option u64 . be net.send_all k fd (subslice buf 20000 (add 20005 chn)) .
  guard is_some sent . else return 93 .
  var mn u64 be chn .                       rem 전사에 쌓인 길이

  rem ── ③ ServerHello ────────────────────────────────────────────────────
  let r1 u64 be recv_rec k fd (subslice buf 20000 36700) .
  guard gt r1 0 . else return 94 .
  guard eq (tlscli.rec_type (subslice buf 20000 20005)) 22 . else return 95 .
  let shn u64 be sub r1 5 .
  guard le (add mn shn) 20000 . else return 96 .
  var si u64 be 0 .
  while lt si shn . do
    set (index buf (add mn si)) (index buf (add 20005 si)) .
    set si (add si 1) .
  end .
  let sh slice u8 be subslice buf mn (add mn shn) .
  guard tlscli.sh_usable sh . else return 97 .
  let kso u64 be tlscli.sh_key_share_off sh .
  guard eq (x25519.agree (subslice buf 56496 56528) priv (subslice sh kso (add kso 32)) (subslice buf 56528 56560) xw) 32 . else return 98 .
  set mn (add mn shn) .

  rem ── ④ 키 사다리 — 여기서부터 읽을 수 있다 ────────────────────────────
  guard eq (tlscli.hs_secrets (subslice buf 56496 56528) (subslice buf 0 mn) (subslice buf 56200 56296) (subslice buf 53100 54400)) 96 . else return 99 .
  rem c_hs = 56200..56232 · s_hs = 56232..56264 · handshake secret = 56264..56296
  guard eq (tlssrv.traffic_keys (subslice buf 56232 56264) 16 (subslice buf 56296 56340) (subslice buf 53100 54400)) 28 . else return 100 .

  rem ── ⑤ EE · Certificate · CertificateVerify · Finished 를 연다 ─────────
  var seq u64 be 0 .
  var fin_at u64 be 0 .
  var fin_len u64 be 0 .
  var rounds u64 be 0 .
  while eq fin_at 0 . do
    let rn u64 be recv_rec k fd (subslice buf 20000 36700) .
    guard gt rn 0 . else return 101 .
    let rt u64 be tlscli.rec_type (subslice buf 20000 20005) .
    rem 바뀜 신호(ChangeCipherSpec)는 1.3 에서 **뜻이 없다** — 중간 상자를 위한 장식이다. 버린다.
    if eq rt 20 . do  set rounds (add rounds 1) . end .
    if eq rt 23 . do
      let pl u64 be tls13.record_open 1 (subslice buf 56296 56312) (subslice buf 56312 56324) seq (subslice buf 20000 (add 20000 rn)) (subslice buf 36700 53100) (subslice buf 53100 53740) u .
      guard gt pl 0 . else return 102 .
      set seq (add seq 1) .
      guard eq (tls13.inner_type (subslice buf 36700 (add 36700 pl))) 22 . else return 103 .
      rem 속 평문에서 마지막 한 바이트(타입)를 뺀 자리까지가 메시지들이다.
      var at u64 be 0 .
      let body u64 be sub pl 1 .
      var walk u64 be 0 .
      while lt at body . do
        let hsz u64 be tls13.hs_size (subslice buf 36700 (add 36700 body)) at .
        guard gt hsz 0 . else return 104 .
        guard le (add at hsz) body . else return 104 .
        let ht u64 be tls13.hs_type (subslice buf 36700 (add 36700 body)) at .
        guard le (add mn hsz) 20000 . else return 96 .
        var wi u64 be 0 .
        while lt wi hsz . do
          set (index buf (add mn wi)) (index buf (add (add 36700 at) wi)) .
          set wi (add wi 1) .
        end .
        if eq ht 20 . do
          set fin_at mn .
          set fin_len hsz .
        end .
        rem ★ Certificate 메시지의 자리를 적어 둔다 — 검증이 그것을 읽는다.
        rem   자리를 버퍼에 네 바이트로 남긴다(돌려줄 자리가 없다 — 이 op 은 이미 인자가 일곱이다).
        if eq ht 11 . do
          set (index buf 56592) (narrow u8 (shr mn 24)) .
          set (index buf 56593) (narrow u8 (bit_and (shr mn 16) 255)) .
          set (index buf 56594) (narrow u8 (bit_and (shr mn 8) 255)) .
          set (index buf 56595) (narrow u8 (bit_and mn 255)) .
        end .
        set mn (add mn hsz) .
        set at (add at hsz) .
        set walk (add walk 1) .
        guard le walk 64 . else return 104 .
      end .
    end .
    set rounds (add rounds 1) .
    guard le rounds 64 . else return 105 .
  end .

  rem ── ⑥ 서버의 Finished 를 검산한다 ────────────────────────────────────
  rem   ★ 전사는 **Finished 앞까지**다 — 자기 자신은 자기 검산에 안 들어간다.
  guard tlscli.check_server_fin (subslice buf 56232 56264) (subslice buf 0 fin_at) (subslice buf fin_at (add fin_at fin_len)) (subslice buf 53100 54400) . else return 106 .

  rem ── ⑦ 우리 Finished — 전사는 **서버 Finished 까지** 포함한다 ─────────
  guard eq (tlssrv.traffic_keys (subslice buf 56200 56232) 16 (subslice buf 56340 56384) (subslice buf 53100 54400)) 28 . else return 107 .
  let fn2 u64 be tlscli.build_client_fin (subslice buf 56200 56232) (subslice buf 0 mn) (subslice buf 56400 56440) (subslice buf 53100 54400) .
  guard eq fn2 36 . else return 108 .
  let sn u64 be tlscli.seal_rec 1 (subslice buf 56340 56384) 16 0 22 (subslice buf 56400 56436) (subslice buf 20000 36700) (subslice buf 53100 54400) u .
  guard gt sn 0 . else return 109 .
  let s2 option u64 . be net.send_all k fd (subslice buf 20000 (add 20000 sn)) .
  guard is_some s2 . else return 110 .

  rem ── ⑧ 응용 트래픽 키 ─────────────────────────────────────────────────
  guard eq (tlssrv.app_secrets (subslice buf 56264 56296) (subslice buf 0 mn) (subslice buf 56440 56504) (subslice buf 53100 54400)) 64 . else return 111 .
  rem c_ap = 56440..56472 · s_ap = 56472..56504 → 트래픽 키는 56504·56548
  guard eq (tlssrv.traffic_keys (subslice buf 56440 56472) 16 (subslice buf 56504 56548) (subslice buf 53100 54400)) 28 . else return 112 .
  guard eq (tlssrv.traffic_keys (subslice buf 56472 56504) 16 (subslice buf 56548 56592) (subslice buf 53100 54400)) 28 . else return 113 .
  return 0 .
end .

rem ★ 한 판을 처음부터 끝까지 — 붙고, 핸드셰이크하고, 닫는다.
rem   ☞ 지금은 열쇠 재료를 **부르는 쪽이 준다**(`seed`). 진짜 도구는 `cap random` 에서 받아야
rem     하고(같은 열쇠를 두 번 쓰면 그 연결의 비밀이 사라진다), 그것은 아래 `main` 의 몫이다.
rem     검사는 씨를 못박아 **결정적으로** 잴 수 있어야 하므로 여기서 가르지 않는다.
rem ★ 「어디서 멈췄는가」를 한 줄로 적는다 — 수는 소스의 `return <수>` 자리를 가리킨다.
proc say_step input out cap io . input tag slice u8 . input n u64 . input d mut slice u8 . output u64 . effects io .
do
  guard ge (len d) 32 . else return 0 .
  var w u64 be write_out out 2 tag .
  guard gt w 0 . else return 0 .
  set w (write_out out 2 " (step ") .
  guard gt w 0 . else return 0 .
  var v u64 be n .
  var i u64 be 0 .
  while gt v 0 . do
    set (index d i) (narrow u8 (add 48 (mod v 10))) .
    set v (div v 10) .
    set i (add i 1) .
    guard le i 20 . else return 0 .
  end .
  if eq i 0 . do  set (index d 0) 48 .  set i 1 . end .
  var j u64 be i .
  while gt j 0 . do
    set j (sub j 1) .
    set (index d (add 21 (sub i (add j 1)))) (index d j) .
  end .
  set w (write_out out 2 (subslice d 21 (add 21 i))) .
  guard gt w 0 . else return 0 .
  set w (write_out out 2 ")\n") .
  guard gt w 0 . else return 0 .
  return 1 .
end .

proc session input k cap net . input fs cap file_system . input hp cap heap . input out cap io .
     input ip u64 . input port u64 . input host slice u8 . input path slice u8 .
     input now u64 . input bundle slice u8 . input seed u64 . input hdrs u64 . output u64 . effects heap io .
do
  rem ★★★ **자라는 뿌리에서 받는다**(`cap heap` · RFC-0112 D2). 핸드셰이크는 64 KiB 안에서
  rem   끝나지만 **인증서 검증**은 그렇지 않다: RSA-4096 뿌리 하나에 큰수 조각이 1820 개(14.5 KB)
  rem   들고, 신뢰 저장소를 흘려 읽는 창·푸는 자리·찾은 인증서가 더 필요하다. 그것을 고정 창에
  rem   우겨넣으려 창을 줄였더니 **묶음에 있는 앵커를 못 찾았다** — 자리가 모자란 것과
  rem   「믿는 뿌리가 없다」가 **같은 얼굴**로 나왔다(2026-09-18 실측).
  rem   ⇒ 이 도구는 운영체제 위에서만 뜻이 있고, **서명이 그렇게 말한다**.
  let g option mut slice u8 . . be alloc_bytes hp capacity 262144 .
  guard is_some g . else return 89 .
  let buf mut slice u8 . be some_value g .

  rem 씨에서 세 재료를 편다 — 검사에서 되풀이할 수 있게.
  var i u64 be 0 .
  while lt i 32 . do
    set (index buf (add 60000 i)) (narrow u8 (bit_and (add (mul seed 7) (add i 1)) 255)) .
    set (index buf (add 60032 i)) (narrow u8 (bit_and (add (mul seed 11) (add i 41)) 255)) .
    set (index buf (add 60064 i)) (narrow u8 (bit_and (add (mul seed 13) (add i 91)) 255)) .
    set i (add i 1) .
  end .
  rem x25519 비밀 열쇠의 다듬기(RFC 7748 §5) — 아래 셋을 깎고 위 둘을 세운다.
  set (index buf 60000) (narrow u8 (bit_and (cast u64 (index buf 60000)) 248)) .
  set (index buf 60031) (narrow u8 (bit_or (bit_and (cast u64 (index buf 60031)) 127) 64)) .

  let copt option net.conn . be net.dial k ip port .
  guard is_some copt . else return 3 .
  var c owned net.conn be some_value copt .
  let cfd u64 be net.conn_fd c .
  let st u64 be handshake k cfd buf host (subslice buf 60000 60032) (subslice buf 60032 60064) (subslice buf 60064 60096) .
  if ne st 0 . do
    let s0 result void net.net_error . be net.shut k c .
    drop s0 .
    rem ★ 안쪽의 자세한 수(89..126)는 **어디서 멈췄는지**를 말한다. 그것을 종료 코드로
    rem   내보내면 머리글이 적은 여섯 가지 약속이 깨진다 — 자세함은 stderr 로 가고,
    rem   종료 코드는 약속한 자리(5 = 규약 위반)로 간다.
    let e0 u64 be say_step out "lowget: the handshake did not hold" st (subslice buf 59900 59932) .
    guard gt e0 0 . else return 5 .
    return 5 .
  end .

  rem ★★★★★ **인증서를 확인한다 — 요청을 보내기 전에.** `now` 가 0 이면 확인하지 않는다
  rem   (`--insecure`). 그 갈래는 부르는 쪽이 **일부러** 골라야 하고, 도구가 그렇게 적는다.
  if gt now 0 . do
    let v u64 be check_chain fs buf host now bundle .
    if ne v 1 . do
      rem ★ 왜 거절했는지 **말한다**. 「인증서 오류」 한 마디는 쓰는 사람에게 아무것도 못 준다.
      var w2 u64 be 0 .
      if eq v 2 . do  set w2 (write_out out 2 "lowget: the certificate is not for this host (no matching name)\n") . end .
      if eq v 3 . do  set w2 (write_out out 2 "lowget: the certificate is outside its validity dates\n") . end .
      if eq v 4 . do  set w2 (write_out out 2 "lowget: the chain does not hold — a link failed (name, CA flag, dates, or a signature this build cannot check: this build verifies RSA-v1.5 and ECDSA with SHA-256 or SHA-384)\n") . end .
      if eq v 5 . do  set w2 (write_out out 2 "lowget: the chain does not reach a certificate in the trust store\n") . end .
      if eq v 6 . do  set w2 (write_out out 2 "lowget: the server sent no certificate this build could read\n") . end .
      let s1 result void net.net_error . be net.shut k c .
      drop s1 .
      return 4 .
    end .
    let w3 u64 be write_out out 2 "lowget: certificate checked — name, dates, chain, trust anchor\n" .
    guard gt w3 0 . else return 5 .
  end .

  let got u64 be http_get k out cfd buf host path hdrs .
  let sh result void net.net_error . be net.shut k c .
  drop sh .
  if ge got 89 . do
    let e1 u64 be say_step out "lowget: the response did not hold" got (subslice buf 59900 59932) .
    guard gt e1 0 . else return 5 .
    return 5 .
  end .
  return got .
end .

rem ★ 한 조각을 이어 붙인다 — 붙인 뒤의 자리를 낸다(0 = 자리가 모자라다).
rem   ☞ 길이를 손으로 적는 자리를 아예 없애려고 둔다.
proc put_s input dst mut slice u8 . input at u64 . input s slice u8 . output u64 . effects none .
do
  guard le (add at (len s)) (len dst) . else return 0 .
  var i u64 be 0 .
  while lt i (len s) . do
    set (index dst (add at i)) (index s i) .
    set i (add i 1) .
  end .
  return add at (len s) .
end .

rem ★★★★★ **응답을 사람이 바라는 모양으로 낸다** — 머리를 떼고, 청크 껍질을 벗긴다.
rem
rem ☞ **이것은 고침이다**(2026-09-19). 그전까지 `lowget` 은 받은 바이트를 **그대로** 흘려
rem   냈다 — 머리줄도, `Transfer-Encoding: chunked` 의 길이 줄도 함께. 우리 기계의 시험
rem   서버가 `Content-Length` 로 답했기에 그 자리에서는 드러나지 않았고, P-384 이 서면서
rem   **바깥 사이트가 열리고 나서야** 보였다(example.com: 우리 868 바이트 대 `curl` 559).
rem   ★ 가까운 곳에서만 재면 먼 곳의 모양을 못 본다.
rem
rem ★★ **한 바이트씩 상태를 이어 간다.** 머리의 `\r\n\r\n` 도, 청크의 길이 줄도 TLS 레코드
rem   경계를 **가로지를 수 있다**. 그래서 상태를 `st` 칸에 두고 레코드마다 이어받는다 —
rem   «한 레코드에 한 덩이가 온다» 는 가정이 이 자리에서 가장 흔한 조용한 실패다.
rem
rem   st: 0 판(0 머리 · 1 몸통 · 2 청크 · 3 끝) · 1 머리에 쌓인 수 · 2 남은 청크 ·
rem       3 청크 갈래(0 길이줄 · 1 자료 · 2 CRLF 넘김) · 4 길이줄에 쌓인 수 · 5 머리도 낼까

rem 대문자를 소문자로 — 머리 이름은 대소문자를 가리지 않는다(RFC 9112 §5).
fn lcase input c u64 . output u64 . do
  if ge c 65 . do  if le c 90 . do  return add c 32 . end . end .
  return c .
end .

rem 머리 안에 `Transfer-Encoding: … chunked …` 줄이 있는가.
rem ★ 머리 전체에서 "chunked" 를 찾지 **않는다** — 다른 줄(예: `Location:`)에 그 글자가
rem   들어 있을 수 있고, 그러면 없는 청크를 벗기려다 본문을 망친다. 줄을 갈라 본다.
fn hdr_chunked input h slice u8 . input n u64 . output u64 . do
  var i u64 be 0 .
  var ls u64 be 0 .
  while lt i n . do
    if eq (index h i) 10 . do
      if ge (sub i ls) 18 . do
        var m u64 be 0 .
        var same u64 be 1 .
        while lt m 18 . do
          if ne (lcase (cast u64 (index h (add ls m)))) (cast u64 (index "transfer-encoding:" m)) . do  set same 0 . end .
          set m (add m 1) .
        end .
        if eq same 1 . do
          var q u64 be add ls 18 .
          while lt q i . do
            if le (add q 7) i . do
              var t u64 be 0 .
              var s3 u64 be 1 .
              while lt t 7 . do
                if ne (lcase (cast u64 (index h (add q t)))) (cast u64 (index "chunked" t)) . do  set s3 0 . end .
                set t (add t 1) .
              end .
              if eq s3 1 . do  return 1 . end .
            end .
            set q (add q 1) .
          end .
        end .
      end .
      set ls (add i 1) .
    end .
    set i (add i 1) .
  end .
  return 0 .
end .

rem 16진 길이 줄을 읽는다 — `1a2b` 도 `1a2b;ext=1` 도 받는다. 답은 길이(0 = 끝 또는 못 읽음).
rem   ☞ `bad` 자리에 1 을 두어 «0 이라서 끝» 과 «못 읽었다» 를 가른다.
fn chunk_size input l slice u8 . input n u64 . output u64 . do
  var v u64 be 0 .
  var i u64 be 0 .
  var seen u64 be 0 .
  while lt i n . do
    let c u64 be cast u64 (index l i) .
    if eq c 59 . do  set i n . end .
    if eq c 13 . do  set i n . end .
    if lt i n . do
      var d u64 be 16 .
      if ge c 48 . do  if le c 57 . do  set d (sub c 48) . end . end .
      if ge (lcase c) 97 . do  if le (lcase c) 102 . do  set d (sub (lcase c) 87) . end . end .
      if ge d 16 . do  return 0 . end .
      if gt v 268435455 . do  return 0 . end .
      set v (add (mul v 16) d) .
      set seen 1 .
      set i (add i 1) .
    end .
  end .
  if eq seen 0 . do  return 0 . end .
  return add v 1 .
end .

rem 끝까지 쓴다 — 한 번의 `write_out` 이 전부를 쓴다는 보장이 없다(나가는 쪽의 `send_all`).
proc put_all input out cap io . input b slice u8 . output u64 . effects io .
do
  if eq (len b) 0 . do  return 1 . end .
  var wrote u64 be 0 .
  var spin u64 be 0 .
  while lt wrote (len b) . do
    let w u64 be write_out out 1 (subslice b wrote (len b)) .
    guard gt w 0 . else return 0 .
    set wrote (add wrote w) .
    set spin (add spin 1) .
    guard le spin 4096 . else return 0 .
  end .
  return 1 .
end .

rem ★ 평문 한 조각을 먹인다. 1 = 이어 간다 · 2 = 본문이 끝났다 · 0 = 규약 위반.
proc feed input out cap io . input p slice u8 . input hdr mut slice u8 . input line mut slice u8 .
     input st mut slice u64 . output u64 . effects io .
do
  var i u64 be 0 .
  while lt i (len p) . do
    if eq (index st 3) 9 . do  return 0 . end .

    rem ── 머리 ────────────────────────────────────────────────────────────
    if eq (index st 0) 0 . do
      let c u64 be cast u64 (index p i) .
      guard lt (index st 1) (len hdr) . else return 0 .
      set (index hdr (index st 1)) (narrow u8 c) .
      set (index st 1) (add (index st 1) 1) .
      set i (add i 1) .
      let n u64 be index st 1 .
      if ge n 4 . do
        if eq (index hdr (sub n 4)) 13 . do
        if eq (index hdr (sub n 3)) 10 . do
        if eq (index hdr (sub n 2)) 13 . do
        if eq (index hdr (sub n 1)) 10 . do
          if eq (index st 5) 1 . do
            guard eq (put_all out (subslice hdr 0 n)) 1 . else return 0 .
          end .
          set (index st 0) 1 .
          if eq (hdr_chunked hdr n) 1 . do
            set (index st 0) 2 .
            set (index st 3) 0 .
            set (index st 4) 0 .
          end .
        end . end . end . end .
      end .
    end .

    rem ── 길이를 안 적은 몸통: 닫힐 때까지 그대로 흘린다 ──────────────────
    if eq (index st 0) 1 . do
      guard eq (put_all out (subslice p i (len p))) 1 . else return 0 .
      set i (len p) .
    end .

    rem ── 청크 ────────────────────────────────────────────────────────────
    if eq (index st 0) 2 . do
      if lt i (len p) . do
        rem ① 길이 줄
        if eq (index st 3) 0 . do
          let c2 u64 be cast u64 (index p i) .
          set i (add i 1) .
          if eq c2 10 . do
            let sz u64 be chunk_size line (index st 4) .
            if eq sz 0 . do  set (index st 3) 9 . end .
            if gt sz 0 . do
              set (index st 2) (sub sz 1) .
              set (index st 4) 0 .
              if eq (index st 2) 0 . do
                set (index st 0) 3 .
                return 2 .
              end .
              set (index st 3) 1 .
            end .
          end .
          if ne c2 10 . do
            guard lt (index st 4) (len line) . else return 0 .
            set (index line (index st 4)) (narrow u8 c2) .
            set (index st 4) (add (index st 4) 1) .
          end .
        end .
        rem ② 자료
        if eq (index st 3) 1 . do
          var nn u64 be sub (len p) i .
          if gt nn (index st 2) . do  set nn (index st 2) . end .
          guard eq (put_all out (subslice p i (add i nn))) 1 . else return 0 .
          set i (add i nn) .
          set (index st 2) (sub (index st 2) nn) .
          if eq (index st 2) 0 . do
            set (index st 3) 2 .
            set (index st 4) 0 .
          end .
        end .
        rem ③ 자료 뒤의 CRLF 를 넘긴다
        if eq (index st 3) 2 . do
          if lt i (len p) . do
            set i (add i 1) .
            set (index st 4) (add (index st 4) 1) .
            if ge (index st 4) 2 . do
              set (index st 3) 0 .
              set (index st 4) 0 .
            end .
          end .
        end .
      end .
    end .

    if eq (index st 0) 3 . do  return 2 . end .
  end .
  return 1 .
end .

rem ★★★ **요청을 보내고 응답을 흘려 낸다.**
rem   ☞ 본문은 **모으지 않는다** — 레코드 한 장을 풀면 그만큼 바로 내보낸다. 64 KiB 아레나에서
rem     응답 전체를 들 수 없기도 하지만, 그보다 **들 필요가 없다**: 받는 대로 쓰는 것이 옳다.
rem   ☞ 핸드셰이크 뒤에도 서버는 `NewSessionTicket`(속 타입 22)을 보낼 수 있다. 그것은 우리가
rem     쓰지 않으므로 **세지 않고 버린다** — 다만 **순번은 센다**(레코드마다 올라간다).
rem     이 구별을 놓치면 그 다음 레코드가 열리지 않는다.
proc http_get input k cap net . input out cap io . input fd u64 . input buf mut slice u8 .
     input host slice u8 . input path slice u8 . input hdrs u64 . output u64 . effects io .
do
  let u mut slice u64 . be view_array u64 (subslice buf 55800 56200) .
  rem 응답을 푸는 자리 — 핸드셰이크가 끝난 뒤라 위쪽이 비어 있다.
  rem   [180000..196384) 머리 · [196384..196448) 길이 줄 · [196448..196512) 상태 여덟 칸
  let hdr mut slice u8 . be subslice buf 180000 196384 .
  let line mut slice u8 . be subslice buf 196384 196448 .
  let st mut slice u64 . be view_array u64 (subslice buf 196448 196512) .
  var zi u64 be 0 .
  while lt zi 8 . do  set (index st zi) 0 .  set zi (add zi 1) .  end .
  set (index st 5) hdrs .

  rem ── 요청 줄을 짓는다: GET <path> HTTP/1.1 ─────────────────────────────
  rem ★★★ 길이를 **손으로 세지 않는다.** 처음에 그렇게 썼다가 `"\r\nConnection: close\r\n\r\n"`
  rem   을 23 대신 21 로 세어 요청이 `\r\n\r` 로 끝났다. 자기 기계의 서버는 너그러워 통과했고,
  rem   **바깥 서버에서야** 응답이 안 오는 것으로 나타났다 — 손으로 센 수는 언젠가 틀리고,
  rem   그 틀림은 가장 먼 자리에서 드러난다. `len` 에게 세게 한다.
  var at u64 be 0 .
  set at (put_s (subslice buf 56600 58600) at "GET ") .
  set at (put_s (subslice buf 56600 58600) at path) .
  set at (put_s (subslice buf 56600 58600) at " HTTP/1.1\r\nHost: ") .
  set at (put_s (subslice buf 56600 58600) at host) .
  rem ★ `User-Agent` 와 `Accept` 를 적는다 — 없으면 **403 으로 막는 서버가 실제로 있다**
  rem   (2026-09-19 실측: api.github.com · www.wikipedia.org 가 둘 다 403 에 «User-Agent 를
  rem   적으라» 고 답했다). 자기를 밝히지 않는 손님을 안 들이는 것은 서버의 권리다.
  set at (put_s (subslice buf 56600 58600) at "\r\nUser-Agent: lowget/1.0\r\nAccept: */*\r\nConnection: close\r\n\r\n") .
  guard gt at 0 . else return 125 .

  let sn u64 be tlscli.seal_rec 1 (subslice buf 56504 56548) 16 0 23 (subslice buf 56600 (add 56600 at)) (subslice buf 20000 36700) (subslice buf 53100 54400) u .
  guard gt sn 0 . else return 120 .
  let s1 option u64 . be net.send_all k fd (subslice buf 20000 (add 20000 sn)) .
  guard is_some s1 . else return 121 .

  rem ── 응답을 받는다 ────────────────────────────────────────────────────
  var seq u64 be 0 .
  var done u64 be 0 .
  var rounds u64 be 0 .
  var status u64 be 0
 .
  while eq done 0 . do
    let rn u64 be recv_rec k fd (subslice buf 20000 36700) .
    if eq rn 0 . do  set done 1 . end .
    if eq done 0 . do
      let rt u64 be tlscli.rec_type (subslice buf 20000 20005) .
      if eq rt 23 . do
        let pl u64 be tls13.record_open 1 (subslice buf 56548 56564) (subslice buf 56564 56576) seq (subslice buf 20000 (add 20000 rn)) (subslice buf 36700 53100) (subslice buf 53100 53740) u .
        guard gt pl 0 . else return 122 .
        set seq (add seq 1) .
        let it u64 be tls13.inner_type (subslice buf 36700 (add 36700 pl)) .
        rem 21 = alert. close_notify(0) 는 정상 종료다 — 그 밖은 규약 위반으로 본다.
        if eq it 21 . do  set done 1 . end .
        if eq it 23 . do
          let body u64 be sub pl 1 .
          if eq status 0 . do
            rem 첫 조각의 머리에서 상태 코드를 읽는다: "HTTP/1.1 200 OK"
            if ge body 12 . do
              set status (add (add (mul (sub (cast u64 (index buf (add 36700 9))) 48) 100)
                                   (mul (sub (cast u64 (index buf (add 36700 10))) 48) 10))
                              (sub (cast u64 (index buf (add 36700 11))) 48)) .
            end .
          end .
          rem ★ 머리를 떼고 청크를 벗겨 낸다 — `feed` 가 상태를 레코드 너머로 이어 간다.
          rem   ☞ 끝까지 쓰는 함정(`write_out` 이 짧게 쓴다)은 `put_all` 이 진다.
          let fr u64 be feed out (subslice buf 36700 (add 36700 body)) hdr line st .
          guard gt fr 0 . else return 126 .
          if eq fr 2 . do  set done 1 . end .
        end .
      end .
      set rounds (add rounds 1) .
      guard le rounds 4096 . else return 124 .
    end .
  end .
  if eq status 0 . do  return 5 . end .
  if ge status 400 . do  return 1 . end .
  return 0 .
end .

rem ── URL 을 가른다 ────────────────────────────────────────────────────────
rem   `https://<호스트>[:<포트>]<길>` 만 받는다. 다른 스킴은 거절한다 — 받는 모양을
rem   열거하는 것이 곧 나머지를 거절하는 것이다.
rem   낸 값: 호스트가 시작하는 자리(0 = 성하지 않다). 포트와 길의 자리는 따로 묻는다.
export fn url_host_off input u slice u8 . output u64 . do
  if lt (len u) 9 . do  return 0 . end .
  var i u64 be 0 .
  while lt i 8 . do
    if ne (index u i) (index "https://" i) . do  return 0 . end .
    set i (add i 1) .
  end .
  return 8 .
end .
rem 호스트가 끝나는 자리 — `:` 나 `/` 앞까지.
export fn url_host_end input u slice u8 . output u64 . do
  let o u64 be url_host_off u .
  if eq o 0 . do  return 0 . end .
  var i u64 be o .
  while lt i (len u) . do
    if eq (index u i) 58 . do  return i . end .
    if eq (index u i) 47 . do  return i . end .
    set i (add i 1) .
  end .
  return i .
end .
rem 포트 — 안 적혔으면 443.
export fn url_port input u slice u8 . output u64 . do
  let e u64 be url_host_end u .
  if eq e 0 . do  return 0 . end .
  if ge e (len u) . do  return 443 . end .
  if ne (index u e) 58 . do  return 443 . end .
  var i u64 be add e 1 .
  var p u64 be 0 .
  var seen u64 be 0 .
  while lt i (len u) . do
    if eq (index u i) 47 . do  set i (len u) . end .
    if lt i (len u) . do
      let d u64 be cast u64 (index u i) .
      if lt d 48 . do  return 0 . end .
      if gt d 57 . do  return 0 . end .
      set p (add (mul p 10) (sub d 48)) .
      set seen 1 .
      if gt p 65535 . do  return 0 . end .
      set i (add i 1) .
    end .
  end .
  if eq seen 0 . do  return 0 . end .
  return p .
end .
rem 길이 시작하는 자리 — 없으면 0(그러면 부르는 쪽이 "/" 를 쓴다).
export fn url_path_off input u slice u8 . output u64 . do
  let o u64 be url_host_off u .
  if eq o 0 . do  return 0 . end .
  var i u64 be o .
  while lt i (len u) . do
    if eq (index u i) 47 . do  return i . end .
    set i (add i 1) .
  end .
  return 0 .
end .

rem ★★★★★ **도구의 얼굴.**
rem   `lowget <url> [--insecure]`
rem   ☞ 이 판은 **인증서를 확인하지 않는다.** 그래서 `--insecure` 없이는 거절한다(4).
rem     확인하지 않는다는 사실을 도구가 **말하지 못하는 판**은 내놓지 않는다.
proc main .
  input k  cap net .
  input fs cap file_system .
  input ck cap clock .
  input hp cap heap .
  input out cap io .
  input a  cap args .
  output u8 .
  effects heap io .
do
  var w u64 be 0 .
  let a0 option slice u8 . be arg a 0 .
  if eq (is_some a0) false . do
    set w (write_out out 2 "usage: lowget https://<host>[:<port>]/<path> [-i] [--insecure] [--cafile <path>]\n") .
    return 2 .
  end .
  let u slice u8 be some_value a0 .
  guard gt (url_host_off u) 0 . else do
    set w (write_out out 2 "lowget: only https:// is understood\n") .
    return 2 .
  end .

  rem ★ 인증서를 안 보는 판이므로 **일부러 그러겠다고 적어야** 한다.
  rem 뒤따르는 낱말들을 본다: `--insecure` 와 `--cafile <길>`.
  var ins u64 be 0 .
  var caf u64 be 0 .
  var hdrs u64 be 0 .
  var ai u64 be 1 .
  while lt ai 6 . do
    let ax option slice u8 . be arg a ai .
    if is_some ax . do
      let f slice u8 be some_value ax .
      if eq (len f) 10 . do
        var m u64 be 0 .
        var same u64 be 1 .
        while lt m 10 . do
          if ne (index f m) (index "--insecure" m) . do  set same 0 . end .
          set m (add m 1) .
        end .
        if eq same 1 . do  set ins 1 . end .
      end .
      if eq (len f) 2 . do
        if eq (index f 0) 45 . do
          if eq (index f 1) 105 . do  set hdrs 1 . end .
        end .
      end .
      if eq (len f) 8 . do
        var m2 u64 be 0 .
        var s2 u64 be 1 .
        while lt m2 8 . do
          if ne (index f m2) (index "--cafile" m2) . do  set s2 0 . end .
          set m2 (add m2 1) .
        end .
        if eq s2 1 . do  set caf (add ai 1) . end .
      end .
    end .
    set ai (add ai 1) .
  end .
  if eq ins 1 . do
    set w (write_out out 2 "lowget: --insecure — the certificate is NOT checked\n") .
  end .

  let he u64 be url_host_end u .
  let host slice u8 be subslice u (url_host_off u) he .
  guard gt (len host) 0 . else return 2 .
  let port u64 be url_port u .
  guard gt port 0 . else return 2 .
  let po u64 be url_path_off u .

  let ipo option u64 . be net.resolve k host .
  guard is_some ipo . else do
    set w (write_out out 2 "lowget: cannot resolve that name\n") .
    return 3 .
  end .

  rem ★ 지금 시각을 YYYYMMDDhhmmss 한 수로. `--insecure` 면 0 을 주어 «확인하지 않는다» 를
  rem   **한 자리에서** 말한다.
  var now u64 be 0 .
  if eq ins 0 . do
    let p u64 be clock.local_packed ck .
    set now (add (add (add (mul (clock.year_of p) 10000000000) (mul (clock.month_of p) 100000000))
                      (add (mul (clock.day_of p) 1000000) (mul (clock.hour_of p) 10000)))
                 (add (mul (clock.minute_of p) 100) (clock.second_of p))) .
    guard gt now 0 . else return 4 .
  end .
  rem 신뢰 저장소의 자리 — `--cafile` 로 갈아탈 수 있다. 여기서 「믿는다」는 곧 「이 파일을
  rem   믿는다」이므로, 그 파일이 무엇인지 쓰는 사람이 정할 수 있어야 한다.
  var cabundle slice u8 be "/etc/ssl/certs/ca-certificates.crt" .
  if gt caf 0 . do
    let cx option slice u8 . be arg a caf .
    guard is_some cx . else do
      set w (write_out out 2 "lowget: --cafile needs a path\n") .
      return 2 .
    end .
    set cabundle (some_value cx) .
  end .
  if eq po 0 . do
    return narrow u8 (session k fs hp out (some_value ipo) port host "/" now cabundle 7 hdrs) .
  end .
  return narrow u8 (session k fs hp out (some_value ipo) port host (subslice u po (len u)) now cabundle 7 hdrs) .
end .

rem ★★★★★ **인증서를 확인한다.** 핸드셰이크가 끝난 뒤의 자리(레코드·평문 버퍼)를 빌려 쓴다.
rem   1 = 믿을 만하다 · 2 = 이름이 안 맞다 · 3 = 기간 밖 · 4 = 체인이 끊겼다 ·
rem   5 = 믿는 뿌리에 닿지 못했다 · 6 = 인증서를 못 찾았다
rem
rem   자리(핸드셰이크 뒤라 레코드·평문 버퍼가 비어 있다):
rem     [70000..100000) wu(u64 3750) · [100000..104000) wb · [104000..134000) 창 ·
rem     [134000..154000) 푸는 자리 · [154000..170000) 찾은 앵커 · [170000..170008) 길이 한 칸
rem ★ 핸드셰이크가 쓰는 64 KiB **위쪽**을 쓴다 — 아래는 전사가 그대로 살아 있어야 한다
rem   (인증서가 거기 있다). 넉넉함이 여기서는 공짜다: 자라는 뿌리이기 때문이다.
rem ★ wu 가 1820 인 까닭: RSA-4096 뿌리를 만나면 큰수 조각이 (k+4)×7 = 1820 든다. 1100 을
rem   주었다가 **RSA 체인 사이트가 통째로 거절됐다**(2026-09-18 실측) — 그리고 그 거절은
rem   「체인이 안 선다」로만 보였다. 작업 공간이 모자란 것과 서명이 틀린 것이 **같은 얼굴**이다.
proc check_chain input fs cap file_system . input buf mut slice u8 . input host slice u8 .
     input now u64 . input bundle slice u8 . output u64 . effects io .
do
  let co u64 be add (add (mul (cast u64 (index buf 56592)) 16777216) (mul (cast u64 (index buf 56593)) 65536))
                    (add (mul (cast u64 (index buf 56594)) 256) (cast u64 (index buf 56595))) .
  guard gt co 0 . else return 6 .
  let msgs slice u8 be subslice buf 0 20000 .
  let l0 u64 be tlscli.cert_at msgs co 0 .
  let n0 u64 be tlscli.cert_len msgs co 0 .
  guard gt l0 0 . else return 6 .
  guard gt n0 0 . else return 6 .
  let leaf slice u8 be subslice buf l0 (add l0 n0) .

  guard verify.host_ok leaf host . else return 2 .
  guard verify.dates_ok leaf now . else return 3 .

  let wu mut slice u64 . be view_array u64 (subslice buf 70000 100000) .
  rem ★ `view_array u64` 는 길이가 여덟의 배수여야 한다 — 네 바이트를 주었다가 그 자리에서
  rem   멈췄다(panic). 한 칸(8 바이트)을 따로 준다.
  let dn mut slice u64 . be view_array u64 (subslice buf 170000 170008) .

  rem ── 받은 사슬을 위로 오른다 ─────────────────────────────────────────
  var cur_o u64 be l0 .
  var cur_n u64 be n0 .
  var idx u64 be 1 .
  var climbing u64 be 1 .
  while eq climbing 1 . do
    let uo u64 be tlscli.cert_at msgs co idx .
    let un u64 be tlscli.cert_len msgs co idx .
    if eq uo 0 . do  set climbing 0 . end .
    if eq climbing 1 . do
      let lk u64 be verify.link_ok (subslice buf cur_o (add cur_o cur_n)) (subslice buf uo (add uo un)) now (subslice buf 100000 104000) wu .
      if ne lk 1 . do  return 4 . end .
      set cur_o uo .
      set cur_n un .
      set idx (add idx 1) .
      if gt idx 8 . do  set climbing 0 . end .
    end .
  end .

  rem ── 그 꼭대기를 **믿는 뿌리**에 잇는다 ──────────────────────────────
  let top slice u8 be subslice buf cur_o (add cur_o cur_n) .
  let ao u64 be trust.find_anchor fs bundle top (x509.issuer_off top) (subslice buf 104000 134000) (subslice buf 134000 154000) (subslice buf 154000 170000) dn .
  guard gt ao 0 . else return 5 .
  let anchor slice u8 be subslice buf 154000 (add 154000 ao) .
  guard eq (verify.link_ok top anchor now (subslice buf 28800 30000) wu) 1 . else return 5 .
  return 1 .
end .
