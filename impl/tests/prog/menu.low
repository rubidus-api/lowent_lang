rem ★★★ **진짜 프로그램 — 키를 먹고 화면을 그린다** (RFC-0075 §9.3 **S1**, 2026-08-05).
rem
rem   원장의 잔량을 줄이는 세 번째 프로그램. 여기서 처음으로 실물 일을 하는 모듈:
rem     `tty`(터미널이 보낸 바이트를 **키로 읽는다**) · `term`(화면 명령을 **바이트로 만든다**)
rem
rem ★★★ **대화형인데 결정적이다 — 그것이 이 프로그램의 요점이다.**
rem   터미널 프로그램은 보통 시험하기 어렵다고들 한다. 그런데 이 언어에서는 그 어려움이
rem   **권한 쪽에만** 있다: raw 모드로 바꾸고(`cap tty`) 화면 크기를 묻는 것은 리프이지만,
rem     · 바이트열 → 키       (`tty.parse_key`)
rem     · 상태 + 키 → 새 상태 (이 파일의 `step`)
rem     · 상태 → 화면 바이트  (`term.goto`·`sgr`·`clear`)
rem   셋은 **전부 순수**다. 그래서 stdin 으로 키 바이트를 먹이면 **같은 화면 바이트**가 나온다
rem   — 골든이 그것을 그대로 대조하고, 차등 스윕이 VM ≡ native 를 지킨다.
rem   ☞ 즉 이 프로그램은 *"터미널이 필요해서 못 잰다"* 는 말이 **핑계였음**을 보이는 증인이다.
rem     RFC-0075 D3(이식 가능한 알맹이 + 권한 껍질)이 실제로 값을 내는 자리다.
rem
rem 사용:  menu < <키 바이트>       (예: `printf '\033[B\033[B\r'` = 아래·아래·확정)
rem 화면:  네 줄짜리 메뉴. 고른 줄은 반전(SGR 7)으로 그린다.
rem 종료:  0~3 = 확정한 항목 번호 · 4 = 확정 없이 입력이 끝남 · 64~ = 자원 오류

module menuprog .

use tty    from "../../../lib/tty.low" .
use term   from "../../../lib/term.low" .
use fmt    from "../../../lib/fmt.low" .
use allocs from "../../../lib/alloc.low" .

rem ── 상태는 수 하나다: 어느 줄에 커서가 있나(0..3).
rem ★ 키 하나가 상태를 어떻게 옮기는가 — **순수하고, 이것이 이 프로그램의 알맹이다.**
rem   범위 밖으로 나가지 않는다(맨 위에서 위로 = 그대로). 모르는 키는 상태를 안 바꾼다.
fn step input cur u64 . input keycode u64 . output u64 . do
  if eq keycode 1002 . do
    if lt cur 3 . do return add cur 1 . end
    return cur .
  end
  if eq keycode 1001 . do
    if gt cur 0 . do return sub cur 1 . end
    return cur .
  end
  if eq keycode 1005 . do return 0 . end
  if eq keycode 1006 . do return 3 . end
  return cur .
end

rem ★ 확정 키인가 — Enter(13) 또는 Space(32).
fn is_commit input keycode u64 . output bool . do
  if eq keycode 13 . do return true . end
  if eq keycode 32 . do return true . end
  return false .
end

rem ── 화면 한 장을 **바이트로** 만든다. 순수하다: 아무 데도 안 쓴다.
rem   `pos` 에서 시작해 새 pos 를 돌려준다(모자라면 none — 자르지 않는다).
proc render input buf mut slice u8 . input pos0 u64 . input cur u64 .
  output option u64 . effects none .
do
  let c0 be option u64 term.clear buf pos0 .
  guard is_some c0 . else return none .
  var pos be u64 some_value c0 .

  var i be u64 0 .
  while lt i 4 . do
    let g be option u64 term.goto buf pos i 0 .
    guard is_some g . else return none .
    set pos (some_value g) .

    rem 고른 줄만 반전 — 그리고 **반드시 되돌린다**(안 되돌리면 뒤가 다 반전된다).
    if eq i cur . do
      let s be option u64 term.sgr buf pos 7 .
      guard is_some s . else return none .
      set pos (some_value s) .
    end

    let t1 be option u64 fmt.put_str buf pos "item " .
    guard is_some t1 . else return none .
    let t2 be option u64 fmt.put_u64 buf (some_value t1) i .
    guard is_some t2 . else return none .
    set pos (some_value t2) .

    if eq i cur . do
      let s2 be option u64 term.sgr buf pos 0 .
      guard is_some s2 . else return none .
      set pos (some_value s2) .
    end
    set i (add i 1) .
  end
  return some pos .
end

proc main
  input in_c cap io .
  input al   cap allocator .
  output u8 .
  effects alloc io .
do
  rem ① 키 바이트를 통째로 받는다. 터미널이면 이것이 raw 모드의 산물이고,
  rem    파일/파이프면 **같은 바이트**다 — 그래서 시험이 된다.
  let ing be option mut slice u8 alloc_bytes al capacity 4096 .
  guard is_some ing . else return 70 .
  let inbuf be mut slice u8 some_value ing .
  let rn be option u64 read_in in_c 0 inbuf .
  guard is_some rn . else return 71 .
  let n be u64 some_value rn .

  let outg be option mut slice u8 alloc_bytes al capacity 8192 .
  guard is_some outg . else return 70 .
  let outbuf be mut slice u8 some_value outg .

  rem ② 키를 하나씩 먹으며 상태를 옮긴다. 확정 키를 만나면 거기서 끝이다.
  var cur be u64 0 .
  var at be u64 0 .
  var done be bool false .
  var going be bool true .
  while going . do
    if ge at n . do set going false . end
    if going . do
      let p be option u64 tty.parse_key (subslice inbuf 0 n) at .
      if eq (is_some p) false . do
        rem ★ 못 읽는 바이트는 **한 칸 건너뛴다**(멈추지 않는다 — 잘린 이스케이프가 흔하다).
        set at (add at 1) .
      end
      if is_some p . do
        let packed be u64 some_value p .
        let k be u64 tty.key_of packed .
        let used be u64 tty.len_of packed .
        if is_commit k . do
          set done true .
          set going false .
        end
        if eq done false . do set cur (step cur k) . end
        rem ★ 길이가 0 이면 영원히 돈다 — 최소 한 칸은 나아간다.
        if eq used 0 . do set at (add at 1) . end
        if gt used 0 . do set at (add at used) . end
      end
    end
  end

  rem ③ 마지막 화면을 한 번에 낸다(그리는 동안엔 한 바이트도 안 나갔다).
  let e be option u64 render outbuf 0 cur .
  guard is_some e . else return 72 .
  let w be u64 write_out in_c 1 (subslice outbuf 0 (some_value e)) .

  if done . do return narrow u8 cur . end
  return 4 .
end
