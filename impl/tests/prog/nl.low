rem ★★★ **열 번째 진짜 프로그램 — 표준입력이 들어오고 표준출력으로 나간다.**
rem   고전적인 필터다: `stdin | nl > stdout`. 줄마다 번호를 붙인다.
rem
rem ★★★ **읽기와 쓰기는 *버퍼* 를 공유하지만, 대칭은 아니다**(2026-07-19 대화에서 정리).
rem   양쪽 다 가운데 버퍼가 있고 "비운다(drain)" 가 실제 용어인 것은 맞다 — Zig 의 vtable
rem   함수 이름이 literally `drain` 이다. 그런데 **비싸고 실패할 수 있는 연산이 반대편에 있다**:
rem
rem       │ 채우기                        │ 비우기
rem   ────┼───────────────────────────────┼──────────────────────────────────────────
rem   읽기│ ★ syscall · EOF · 부분읽기    │ 포인터 전진 — 공짜, 실패 불가(take_line)
rem   쓰기│ memcpy — 공짜, 실패 불가      │ ★ syscall · ENOSPC/EPIPE · **데이터 손실**
rem
rem   ⇒ **mirror image 이지 parallel 이 아니다.** `peek`↔`take` 는 둘 다 *비우기* 쪽의 공짜
rem     구분이고, `버퍼 쓰기`↔`flush` 는 *채우기* vs *비우기* 다 — 같은 슬롯이 아니다.
rem   ★★ 그 비대칭이 곧 설계다: **flush 망각은 유명한 버그 부류인데 peek/take 혼동은 아니다.**
rem     그래서 RFC-0069 §3 은 `finish` + E-OWN-LEAK 을 **쓰기에만** 둔다.
rem   ☞ `peek` 도 순수하게 버퍼-로컬은 아니다 — 모자라면 채우기를 유발한다(Zig: `Error![]u8`).
rem
rem ★★ **이 프로그램이 그 축을 실제로 쓴다**: 출력을 줄마다 내보내지 않고 **버퍼에 모아
rem   마지막에 한 번** 낸다. `write_out` 은 호출마다 `fflush` 하므로, 줄마다 부르면 줄마다
rem   syscall 이다 — 100 줄이면 flush 100 번. 여기서는 **1 번**이다.
rem   ☞ 정직하게: 이것은 **손으로 한** 버퍼링이다. RFC-0069 §3 의 라이터는 그 뒤 A6 에서
rem     지어졌다(`lib/out.low` · `prog/emit.low`) — `w_finish` 를 안 부르면 **컴파일이 안 된다**
rem     (E-OWN-INCOMPLETE). 이 프로그램을 그것으로 바꾸지 않은 이유는, 여기서는 **입력 전체가
rem     이미 한 버퍼에 들어와 있어** 출력도 한 번에 낼 수 있기 때문이다 — 라이터가 푸는 문제
rem     (조각이 여러 번 올 때 syscall 을 줄이는 것)가 여기엔 없다. ⇒ `emit.low` 이 그 짝이다.
rem
rem ★ 안 지은 것: 입력이 버퍼보다 크면 `read_in` 이 `none` 이다(자르지 않는다) ⇒ 이 프로그램은
rem   **64 KiB 까지**의 입력만 다룬다. 진짜 스트리밍은 §6 의 스트림 표면이 열어야 한다.

module nl .

use io      from "../../../lib/io.low" .
use fmt     from "../../../lib/fmt.low" .
use allocs  from "../../../lib/alloc.low" .

rem ★ 번호를 붙여 출력 버퍼에 조립한다 — **순수하다**(effects state 는 리더 커서 때문이고,
rem   io 도 alloc 도 없다). 그래서 파일이든 stdin 이든 같은 코드가 먹는다.
rem   답은 조립된 바이트 수. 안 들어가면 none — 전량-아니면-무(fmt 와 같은 규율).
proc number_lines input src slice u8 . input dst mut slice u8 . . output option u64 .
  effects state .
do
  var r io.mem_reader be spawn actor io.mem_reader . .
  let z u64 be send r attach src .
  var pos u64 be 0 .
  var n u64 be 0 .
  var going bool be true .
  while going . do
    let l option slice u8 . be send r take_line 65536 .
    if eq (is_some l) false . do set going false . end .
    if is_some l . do
      set n (add n 1) .
      let a option u64 . be fmt.put_u64 dst pos n .
      guard is_some a . else return none .
      let b option u64 . be fmt.put_str dst (some_value a) "  " .
      guard is_some b . else return none .
      let c option u64 . be fmt.put_str dst (some_value b) (some_value l) .
      guard is_some c . else return none .
      let d option u64 . be fmt.put_nl dst (some_value c) .
      guard is_some d . else return none .
      set pos (some_value d) .
    end .
  end .
  rem 개행 없이 끝난 마지막 조각도 한 줄이다.
  let rest u64 be send r remaining .
  if gt rest 0 . do
    rem ★ `take_rest` 는 option 이 아니라 **slice** 를 낸다 — 이미 끝이면 **빈 뷰**다.
    rem   "끝났다" 와 "0 바이트 읽었다" 는 다르고 여기선 후자다(lib/io.low 의 규약).
    let tail slice u8 be send r take_rest .
    set n (add n 1) .
    let a option u64 . be fmt.put_u64 dst pos n .
    guard is_some a . else return none .
    let b option u64 . be fmt.put_str dst (some_value a) "  " .
    guard is_some b . else return none .
    let c option u64 . be fmt.put_str dst (some_value b) tail .
    guard is_some c . else return none .
    let d option u64 . be fmt.put_nl dst (some_value c) .
    guard is_some d . else return none .
    set pos (some_value d) .
  end .
  return (some pos) .
end .

proc main .
  input out cap io .
  input al  cap allocator .
  output u8 .
  effects alloc io state .
do
  rem ① 커널 → 입력 버퍼. **채우기**.
  let ing option mut slice u8 . . be alloc_bytes al capacity 16384 .
  guard is_some ing . else return 70 .
  let inbuf mut slice u8 . be some_value ing .
  let n option u64 . be read_in out 0 inbuf .
  guard is_some n . else return 71 .

  rem ② 출력 버퍼에 조립. 아직 **한 바이트도 밖으로 안 나갔다**.
  let outg option mut slice u8 . . be alloc_bytes al capacity 32768 .
  guard is_some outg . else return 72 .
  let outbuf mut slice u8 . be some_value outg .
  let w option u64 . be number_lines (subslice inbuf 0 (some_value n)) outbuf .
  guard is_some w . else return 73 .

  rem ③ **한 번 비운다.** 줄마다 불렀다면 줄마다 flush 였다.
  let put u64 be write_out out 1 (subslice outbuf 0 (some_value w)) .
  return 0 .
end .
