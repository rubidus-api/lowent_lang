rem ★★★ **진짜 프로그램 — 파일의 수를 정렬하고, 그 안에서 찾는다** (RFC-0075 §9.3 **S1**).
rem
rem   원장이 말한 잔량을 줄이는 두 번째 프로그램이다. 여기서 처음으로 **실물 일**을 하는 모듈:
rem     `sortlib`(고정 슬라이스 정렬) · `sortgen`(제네릭 정렬) · `searchlib`(이분 탐색)
rem
rem ★★★ **`vecgen` 은 여기 못 들어온다 — 그리고 그것이 이 프로그램이 찾아낸 것이다.**
rem   `vecgen.open` 과 `files.open` 이 **같은 이름을 export** 하는데 이름공간이 평평하다
rem   (RFC-0075 D6) ⇒ 두 모듈을 **한 단위에서 함께 쓸 수 없다**(E-NAME-DUP). 파일을 읽으면서
rem   자라는 벡터를 쓰는 일은 아주 평범한데, 지금은 그것이 **불가능**하다.
rem   ☞ 픽스처는 이것을 영원히 못 본다: 픽스처는 모듈을 **하나씩** 쓰기 때문이다.
rem     그래서 여기서는 **호출자가 대는 고정 버퍼**로 간다(그것이 오늘 되는 길이다).
rem
rem ★★ **그리고 이 프로그램은 자기 답을 스스로 검산한다.** 같은 입력을 두 정렬기에 넣는다:
rem     `sortlib.sort`(u64 전용, 손으로 쓴 quicksort)  vs  `sortgen.sort_by`(제네릭 틀)
rem   둘이 다른 답을 내면 **둘 중 하나가 틀린 것**이고, 그것을 종료 코드로 고발한다.
rem   ☞ 이것이 RFC-0075 §7.2 가 요구하는 *"독립 참조 오라클"* 의 가장 싼 형태다 —
rem     VM/native 일치는 오라클이 아니다(두 뒤끝이 같이 틀릴 수 있다). **두 구현의 일치**는
rem     서로 다른 코드가 같은 답을 냈다는 뜻이라 급이 다르다.
rem
rem ★ 수 파싱은 **여기 있다**(라이브러리에 없다). 그것이 이 프로그램이 드러낸 사실이다:
rem   `fmt` 는 u64 를 **내보낼** 수 있지만 **읽어들일** 수는 없다 — 쓰기/읽기 비대칭.
rem   RFC-0075 §9.3 S2 의 일감이 되게 여기 적어 둔다(지금은 프로그램이 제 몫을 한다).
rem
rem 사용:  nsort <파일> <찾을수>
rem 종료:  0 = 찾음 · 1 = 없음 · 2 = **두 정렬기가 다른 답을 냈다**(결함) · 64~ = 자원/입력

module nsortprog .

use sortlib   from "../../../lib/sort.low" .
use sortgen   from "../../../lib/sortgen.low" .
use searchlib from "../../../lib/search.low" .
use files     from "../../../lib/file.low" .
use fmt       from "../../../lib/fmt.low" .
use allocs    from "../../../lib/alloc.low" .

rem ★ 십진수 한 줄을 읽는다 — **순수하다**. 빈 줄·숫자 아닌 글자는 `none`(조용히 0 이 아니다).
fn parse_u64 input s slice u8 . output option u64 . do
  if eq (len s) 0 . do return none . end
  var acc be u64 0 .
  var i be u64 0 .
  while lt i (len s) . do
    let c be u8 index s i .
    if lt c 48 . do return none . end
    if gt c 57 . do return none . end
    rem ★ 넘침은 **트랩이 아니라 거절**이다 — 파일이 준 수가 크다고 죽을 이유가 없다.
    if gt acc 1844674407370955161 . do return none . end
    set acc (add (mul acc 10) (narrow u64 (sub c 48))) .
    set i (add i 1) .
  end
  return some acc .
end

rem ★ 다음 개행의 자리 — 없으면 none. (`io` 를 안 부른다: 줄 나누기 하나 때문에 액터를
rem   데려오면 그 모듈의 effects 까지 딸려 온다.)
fn find_nl input s slice u8 . input from u64 . output option u64 . do
  var i be u64 from .
  while lt i (len s) . do
    if eq (index s i) 10 . do return some i . end
    set i (add i 1) .
  end
  return none .
end

rem ★ 제네릭 정렬은 **타입이 비교를 들고 온다** — 스칼라 u64 는 trait 을 못 만족하므로
rem   레코드로 감싼다. 이것이 그 API 의 실제 사용감이다(픽스처가 이미 같은 모양을 쓴다).
struct keyed do
  satisfies sortgen.ordered .
  k u64 .
end
fn keyed.less input a keyed . input b keyed . output bool . do return lt (field a k) (field b k) . end

rem ★ 두 슬라이스가 원소별로 같은가 — 두 정렬기의 답을 대는 데 쓴다.
fn same_keyed input a slice u64 . input b slice keyed . output bool . do
  if ne (len a) (len b) . do return false . end
  var i be u64 0 .
  while lt i (len a) . do
    let e be keyed index b i .
    if ne (index a i) (field e k) . do return false . end
    set i (add i 1) .
  end
  return true .
end

proc main .
  input fs cap file_system .
  input al cap allocator .
  input a  cap args .
  input out cap io .
  output u8 .
  effects alloc io .
do
  let pa be option slice u8 arg a 0 .
  guard is_some pa . else return 64 .
  let pb be option slice u8 arg a 1 .
  guard is_some pb . else return 64 .
  let path be slice u8 some_value pa .
  let qq be option u64 parse_u64 (some_value pb) .
  guard is_some qq . else return 65 .
  let target be u64 some_value qq .

  let gtx be option mut slice u8 alloc_bytes al capacity 8192 .
  guard is_some gtx . else return 70 .
  let txt be mut slice u8 some_value gtx .

  let sn be result u64 files.file_error files.slurp fs path txt .
  guard is_ok sn . else return 66 .
  let n be u64 ok_value sn .

  rem ── 버퍼 둘(같은 수를 담는다: 하나는 sortlib 가, 하나는 sortgen 이 정렬한다).
  rem   ★ 고정 용량이다 — 넘치면 **거절**한다(자르지 않는다: 잘린 답은 틀린 답이다).
  let gab be option mut slice u8 alloc_bytes al capacity 4096 .
  guard is_some gab . else return 70 .
  let abytes be mut slice u8 some_value gab .
  let araw be mut slice u64 view_array u64 abytes .

  let gbb be option mut slice u8 alloc_bytes al capacity 4096 .
  guard is_some gbb . else return 70 .
  let bbytes be mut slice u8 some_value gbb .
  let braw be mut slice keyed view_array keyed bbytes .

  rem ── 줄마다 수 하나. 숫자가 아닌 줄은 **건너뛴다**(파일 끝 빈 줄이 흔하다).
  var pos be u64 0 .
  var cnt be u64 0 .
  var going be bool true .
  while going . do
    if ge pos n . do set going false . end
    if going . do
      let e be option u64 find_nl (subslice txt 0 n) pos .
      var stop be u64 n .
      if is_some e . do set stop (some_value e) . end
      let piece be slice u8 subslice txt pos stop .
      let v be option u64 parse_u64 piece .
      if is_some v . do
        guard lt cnt (len araw) . else return 71 .
        set (index araw cnt) (some_value v) .
        set (index braw cnt) (make keyed do k (some_value v) . end) .
        set cnt (add cnt 1) .
      end
      set pos (add stop 1) .
    end
  end

  let sa be mut slice u64 subslice araw 0 cnt .
  let sb be mut slice keyed subslice braw 0 cnt .

  rem ★★ 두 구현으로 같은 것을 정렬한다 — 서로가 서로의 오라클이다.
  sortlib.sort sa .
  sortgen.sort_by keyed sb .
  guard same_keyed sa sb . else return 2 .

  rem ── 정렬된 뒤에만 뜻이 있는 질문: 이분 탐색.
  let hit be option u64 searchlib.bsearch sa target .

  let go be option mut slice u8 alloc_bytes al capacity 128 .
  guard is_some go . else return 70 .
  let ob be mut slice u8 some_value go .
  let p1 be option u64 fmt.put_u64 ob 0 (len sa) .
  guard is_some p1 . else return 72 .
  let p2 be option u64 fmt.put_str ob (some_value p1) " sorted, " .
  guard is_some p2 . else return 72 .
  let p3 be option u64 fmt.put_u64 ob (some_value p2) target .
  guard is_some p3 . else return 72 .
  let p4 be option u64 fmt.put_str ob (some_value p3) " at " .
  guard is_some p4 . else return 72 .
  var p5 be option u64 none .
  if is_some hit . do set p5 (fmt.put_u64 ob (some_value p4) (some_value hit)) . end
  if eq (is_some hit) false . do set p5 (fmt.put_str ob (some_value p4) "none") . end
  guard is_some p5 . else return 72 .
  let p6 be option u64 fmt.put_nl ob (some_value p5) .
  guard is_some p6 . else return 72 .
  let w be u64 write_out out 1 (subslice ob 0 (some_value p6)) .

  if is_some hit . do return 0 . end
  return 1 .
end
