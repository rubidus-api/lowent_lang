rem ★★★ **P-384 서명 검증의 증인** — [p384](p384) 와 [verify](verify) 의 상수가 옳은가.
rem
rem ★★ **오라클은 우리가 아니다.** 아래 벡터는 `openssl`(secp384r1 · SHA-384)이 **지었고**
rem   `openssl dgst -verify` 가 **맞다고 말한** 서명이다(2026-09-19 이 기계에서 한 번 뽑아
rem   이 파일에 못박았다). 우리 쪽은 그것을 받기만 한다 — 짓고 받는 것이 같은 손이면
rem   "둘 다 같게 틀린" 경우를 못 거른다.
rem
rem ★ 그리고 **거절이 본체다**: s 한 비트 · 해시 한 비트 · s = 0. 통과 하나보다 거절 셋이
rem   증거다. 통과만 보이면 «언제나 1 을 답하는 함수» 와 구별이 안 된다.
rem
rem   낸 값: 0 = 바라던 대로 · 1 = 아니다 · 9 = 준비하다 실패했다.

module p384vec .

use p384 from "../../../lib/p384.low" .
use verify from "../../../lib/verify.low" .
use bigint from "../../../lib/bigint.low" .
use codec from "../../../lib/codec.low" .

rem 자리표 — wu: 곡선 0..96 · r 96..120 · s 120..144 · e 144..168 · 키 168..216 · 일터 216..1580
rem          buf: 16진을 푸는 자리 0..48 · r 64..112 · s 112..160 · e 160..208 · 키 208..304

proc prep input buf mut slice u8 . input wu mut slice u64 . output u64 . effects none . do
  guard ge (len wu) 1580 . else return 0 .
  guard ge (len buf) 304 . else return 0 .
  let _u0 be result u64 verify.verify_error verify.curve384 (subslice wu 0 96) (subslice buf 0 48) .
  guard is_ok _u0 . else return 0 .
  guard eq (ok_value _u0) 1 . else return 0 .
  let dr be option u64 codec.hex_dec "6ae4768089f6801184a788b4df81f008c71b7f652d0ac0cf20143a84c4dfa6e352eb9194879159892d04ff27d133d4e6" (subslice buf 64 112) .
  guard is_some dr . else return 0 .
  let ds be option u64 codec.hex_dec "95daf82a122a9cbe5dc29d099b27251c1780dc94eb9d7142efa9087b25aa8c78b7897404b7e3473caf18ec227619c2d9" (subslice buf 112 160) .
  guard is_some ds . else return 0 .
  let de be option u64 codec.hex_dec "ba5f97c70250696c963d22d00d6cb64979953edf06a80af0c258a25f18f029c0f76e10af1bbf8b3014f64fbd320f4c91" (subslice buf 160 208) .
  guard is_some de . else return 0 .
  let dx be option u64 codec.hex_dec "e376542c785dafe78338bb6afbb0f744f7c1ad99ca32bb5eacaba8d5e4a7e139bf0555020a8ed6614e6fed595d9aa1a7" (subslice buf 208 256) .
  guard is_some dx . else return 0 .
  let dy be option u64 codec.hex_dec "e28eb6f7bde42f610829f8c42bfdfe666cd29ba93cf2cb06ad97a253a4e47ce8ce4ce5b916e69113a79eea43c0df7c34" (subslice buf 256 304) .
  guard is_some dy . else return 0 .
  return 1 .
end

rem 바이트 자리를 조각 자리로 옮긴다 — 손댄 뒤에 다시 부르면 손댄 값이 들어간다.
proc fill input buf slice u8 . input wu mut slice u64 . output u64 . effects none . do
  guard eq (bigint.from_bytes (subslice buf 64 112) (subslice wu 96 120) 24) 24 . else return 0 .
  guard eq (bigint.from_bytes (subslice buf 112 160) (subslice wu 120 144) 24) 24 . else return 0 .
  guard eq (bigint.from_bytes (subslice buf 160 208) (subslice wu 144 168) 24) 24 . else return 0 .
  guard eq (bigint.from_bytes (subslice buf 208 256) (subslice wu 168 192) 24) 24 . else return 0 .
  guard eq (bigint.from_bytes (subslice buf 256 304) (subslice wu 192 216) 24) 24 . else return 0 .
  return 1 .
end

rem ★ 「자리가 모자라다」는 **9** 로 따로 답한다 — 「서명이 틀렸다」(0)와 섞지 않는다(X-0035).
proc judge input wu mut slice u64 . output u64 . effects none . do
  let jr be result u64 p384.p384_error p384.ecdsa_ok (subslice wu 96 120) (subslice wu 120 144) (subslice wu 144 168)
                           (subslice wu 168 216)
                           (subslice wu 0 24) (subslice wu 24 48)
                           (subslice wu 48 72) (subslice wu 72 96)
                           (subslice wu 216 1580) .
  guard is_ok jr . else return 9 .
  return ok_value jr .
end

rem ── 네 가지를 한 번에 잰다 ──────────────────────────────────────────────
rem   낸 값: 0 = 네 가지 모두 바라던 대로 · 1 참을 거절했다 · 2 고친 s 를 받았다 ·
rem          3 고친 해시를 받았다 · 4 s=0 을 받았다 · 9 준비하다 실패했다.

proc main input al cap allocator . output u8 . effects alloc . do
  let g be option mut slice u8 alloc_bytes al capacity 32768 .
  guard is_some g . else return 9 .
  let buf be mut slice u8 some_value g .
  let wu be mut slice u64 view_array u64 (subslice buf 8192 24192) .

  rem ✔ 참인 서명은 받는다.
  guard eq (prep buf wu) 1 . else return 9 .
  guard eq (fill buf wu) 1 . else return 9 .
  guard eq (judge wu) 1 . else return 1 .

  rem ✘ s 의 한 비트를 뒤집으면 거절되어야 한다.
  guard eq (prep buf wu) 1 . else return 9 .
  set (idx buf 159) (narrow u8 (bit_xor (cast u64 (idx buf 159)) 1)) .
  guard eq (fill buf wu) 1 . else return 9 .
  guard eq (judge wu) 0 . else return 2 .

  rem ✘ 해시의 한 비트를 뒤집어도 거절되어야 한다 — **이 메시지의 서명인가**를 묻는다.
  guard eq (prep buf wu) 1 . else return 9 .
  set (idx buf 207) (narrow u8 (bit_xor (cast u64 (idx buf 207)) 1)) .
  guard eq (fill buf wu) 1 . else return 9 .
  guard eq (judge wu) 0 . else return 3 .

  rem ✘ s = 0 은 **점 연산 이전에** 걸려야 한다. 이 갈래를 빠뜨린 검증기는 아무 서명이나 받는다.
  guard eq (prep buf wu) 1 . else return 9 .
  var i be u64 112 .
  while lt i 160 . do  set (idx buf i) 0 .  set i (add i 1) .  end
  guard eq (fill buf wu) 1 . else return 9 .
  guard eq (judge wu) 0 . else return 4 .

  return 0 .
end
