rem ★★★ **A1 — reactor 라는 자리가 생겼다. 그리고 답이 안 바뀐다** (RFC-0071 A1).
rem
rem ★★★ **이 프로그램의 요점은 "빨라졌다" 가 아니다.** A1 은 **블로킹 폴백만** 짓는다:
rem   `r_read` 는 `read_in` 과 **글자 그대로 같은 일**을 하고, 답이 **한 바이트도 달라선 안 된다.**
rem   ⇒ 그것이 A1 의 게이트이고, 뒤 단계(epoll A2 · io_uring A3)가 그 게이트를 깨면 **즉시 보인다.**
rem   **되는 것부터 세우고, 그 다음에 빠르게 만든다.**
rem
rem ★★ **reactor 는 `cap io` 에서 나온다 — 전역이 없다**(RFC-0071 D2). ambient 힙을 거절한 것과
rem   같은 논증이다: *"누가 IO 를 할 수 있는가"* 가 다시 보이지 않게 되면 capability 가 사는 이유가 없다.
rem ★★ **뒷받침 바이트는 호출자가 준다**(D3 · RFC-0043 D1). 그래서 임베디드 무할당 경로가
rem   **같은 코드로** 선다 — static 배열을 주면 된다.

module rcat .

proc main .
  input k  cap io .
  input al cap allocator .
  output u8 .
  effects alloc io .
do
  let b0 option mut slice u8 . . be alloc_bytes al capacity 4096 .
  guard is_some b0 . else return 69 .
  var buf mut slice u8 . be some_value b0 .
  rem ★★★ **reactor 의 뒷받침은 읽기 목적지와 달라야 한다**(RFC-0022 D-B, 2026-07-20 실측).
  rem   completion 백엔드는 **그 자리에** 읽고 나서 목적지로 옮긴다 — 같은 자리면 덮어쓴다.
  rem   ☞ 처음엔 `buf` 하나를 둘 다에 줬고 readiness 에선 무해했다. AIO 를 끼우자 **내용이
  rem     망가졌다** — 그래서 이제 도구가 **모든 백엔드에서** 그것을 거절한다.
  let b1 option mut slice u8 . . be alloc_bytes al capacity 4096 .
  guard is_some b1 . else return 68 .
  var rmem mut slice u8 . be some_value b1 .
  rem ★ reactor 를 만든다. 자리가 모자라면 **none** — 트랩이 아니다(OOM 은 값이다).
  let r option u64 . be reactor_new k rmem 1 .
  guard is_some r . else return 70 .
  let rh u64 be some_value r .

  var total u64 be 0 .
  var done bool be false .
  while eq done false . do
    let n option u64 . be r_read k rh 0 buf .
    rem ★ `n` 을 **한 번만** 본다 — 옵션을 두 번 묻는 판이 있었는데 상자가 재활용되며 죽었다.
    if is_some n . do
      rem `some` = 다 들어갔다(EOF). 마지막 조각을 내보내고 끝낸다.
      let g u64 be some_value n .
      set total (add total g) .
      let w u64 be write_out k 1 (subslice buf 0 g) .
      guard eq w g . else return 71 .
      set done true .
    end else do
      rem `none` = 더 남았다. 버퍼가 가득 찼으니 통째로 내보낸다.
      set total (add total (len buf)) .
      let w2 u64 be write_out k 1 buf .
      guard eq w2 (len buf) . else return 72 .
    end
  end
  return 0 .
end
