rem ★★★ **여덟 번째 진짜 프로그램 — 갭 하나를 이름으로 지목해 두고, 그것을 닫는다.**
rem
rem   `prog/greet.low`(일곱째)가 자기 주석에 이렇게 적어 뒀다:
rem     *"`cap io` 엔트리는 스크래치 버퍼를 얻을 방법이 없다. … 버퍼에 조립한 뒤 한 번에 쓰는
rem       것은 A3(할당자 cap)가 열어야 한다."*
rem   그래서 greet 은 조각마다 `write_out` 을 세 번 불렀다. **이 프로그램은 한 번 부른다.**
rem
rem ★★★ **네 권한이 한자리에 선다** — 그리고 하나라도 없으면 그만큼 못 한다:
rem     cap allocator  바이트를 얻는다      (없으면 E-ALLOC-NOCAP · 조립할 곳이 없다)
rem     cap args       무엇을 셀지 받는다   (없으면 ambient argv 가 없으므로 못 읽는다)
rem     cap env        이름을 어디서 볼지   (없으면 환경이 안 보인다)
rem     cap io         바이트를 내보낸다    (없으면 E-EFFECT-NO-CAP · 한 바이트도 못 낸다)
rem
rem ★★ **층이 셋으로 갈려 있고, 갈린 채로 시험된다**:
rem     ① 포매팅  lib/fmt.low   — `effects none`. 숨은 할당 0 · 숨은 stdout 0 (vm_fmt.low 가 검증)
rem     ② 할당    lib/alloc.low — 사용자 얼로케이터. **뿌리에서 왔든 빌렸든 안 묻는다**
rem                               (vm_allocbytes.low 가 빌린 바이트만으로 검증 — cap 없이)
rem     ③ 출력    write_out     — `cap io` 를 든 자만 (prog/greet.low 가 검증)
rem   이 프로그램은 셋을 **엮기만 한다.** 새 개념 0.
rem
rem ★ 그리고 출력은 **오라클 안**이다: VM 과 네이티브가 같은 fd 에 같은 바이트를 쓴다.
rem   할당도 마찬가지다 — 뿌리가 0 에서 시작하는 범프라 양쪽이 같은 바이트를 본다.

module report .

use strings from "../../../lib/str.low" .
use fmt     from "../../../lib/fmt.low" .
use allocs  from "../../../lib/alloc.low" .

rem ── 순수한 부분 — 출력과 무관하므로 따로 시험할 수 있다 ────────────────

rem 이름을 다듬는다. 비면 "world".
fn pick input given option slice u8 . output slice u8 . do
  guard is_some given . else return "world" .
  let t slice u8 be strings.trim_end (strings.trim_start (some_value given) " ") " " .
  guard gt (len t) 0 . else return "world" .
  return t .
end .

rem ★ **줄 하나를 버퍼에 조립한다** — `effects none` 이다. 이 op 은 출력도 할당도 하지 않고,
rem   **호출자가 준 버퍼**에만 쓴다. 안 들어가면 `none` — 잘린 줄을 내보내지 않는다(전량-아니면-무).
rem     "hello, <name>! (<n> args, <len> bytes)\n"
proc compose input buf mut slice u8 . . input name slice u8 . input nargs u64 .
  output option u64 . effects none .
do
  let a option u64 . be fmt.put_str buf 0 "hello, " .
  guard is_some a . else return none .
  let b option u64 . be fmt.put_str buf (some_value a) name .
  guard is_some b . else return none .
  let c option u64 . be fmt.put_str buf (some_value b) "! (" .
  guard is_some c . else return none .
  let d option u64 . be fmt.put_u64 buf (some_value c) nargs .
  guard is_some d . else return none .
  let e option u64 . be fmt.put_str buf (some_value d) " args, " .
  guard is_some e . else return none .
  let f option u64 . be fmt.put_u64 buf (some_value e) (len name) .
  guard is_some f . else return none .
  let g option u64 . be fmt.put_str buf (some_value f) " bytes)" .
  guard is_some g . else return none .
  return fmt.put_nl buf (some_value g) .
end .

rem ── 엔트리 — 여기서만 권한이 들어온다 ─────────────────────────────────

proc main .
  input al  cap allocator .
  input out cap io .
  input a   cap args .
  output u8 .
  effects alloc io state .
do
  rem ① **뿌리에서 바닥을 얻는다.** 못 얻으면 아무것도 안 한다 — OOM 은 값이지 트랩이 아니다.
  let root option mut slice u8 . . be alloc_bytes al capacity 256 .
  guard is_some root . else return 70 .

  rem ② 그 바닥 위에 **사용자 얼로케이터**를 세운다. 이 actor 는 바이트가 어디서 왔는지 모른다 —
  rem    빌린 버퍼를 줬어도 똑같이 돈다(vm_allocbytes.low 가 정확히 그렇게 시험한다).
  var mem allocs.bump_bytes be spawn actor allocs.bump_bytes . .
  let cap0 u64 be send mem init (some_value root) .
  guard ge cap0 128 . else return 71 .

  rem ③ 줄 버퍼를 **얼로케이터에서** 받는다.
  let line option mut slice u8 . . be send mem reserve 128 .
  guard is_some line . else return 72 .
  let buf mut slice u8 . be some_value line .

  rem ④ 조립한다 — 순수하다. 여기까지 **한 바이트도 밖으로 안 나갔다.**
  let n option u64 . be compose buf (pick (arg a 0)) (count a) .
  guard is_some n . else return 73 .

  rem ⑤ **한 번 쓴다.** greet 은 세 번 썼다 — 조립할 곳이 없어서.
  let wrote u64 be write_out out 1 (subslice buf 0 (some_value n)) .
  return (narrow u8 wrote) .
end .
