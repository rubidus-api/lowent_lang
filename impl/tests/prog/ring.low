rem ★★★★★ **실물 프로그램: 링 버퍼를 실제로 돌린다** (RFC-0075 §9 · S1 마지막 한 칸).
rem
rem   `lib/spsc.low` 은 여태 **어떤 프로그램도 부를 수 없었다** — 모든 op 이 `cap atomic` 을
rem   받는데 진입점에 줄 수 있는 권한 목록에 그것이 없어서, 사슬이 **시작될 수가 없었다.**
rem   원장은 그것을 *"안 쓰는 모듈"* 로 셌지만 실은 **쓸 수 없는** 모듈이었고, 그래서
rem   `vm_spsc.low` 는 골든에 헤더 심볼 검사로만 한 줄 나오고 **한 번도 실행되지 않았다.**
rem   ⇒ 소유자 결정(2026-08-07): **`cap atomic` 을 진입점에 준다.** 이 파일이 그 결정의 증인이다.
rem
rem   ★ 한 스레드에서 밀고 꺼낸다. `spsc` 는 **한 생산자·한 소비자**를 전제하지 두 스레드를
rem     요구하지 않는다 — 같은 스레드는 그 계약의 특수한 경우이고, 그래서 **결정적**이다
rem     (오라클 안에 있다: VM 과 네이티브가 같은 답을 내야 한다).

module ring .

use spsc from "../../../lib/spsc.low" .

proc main input al cap allocator . input k cap atomic . output u8 . effects alloc atomic . do
  rem ctl 두 칸(head·tail) · buf 여덟 칸 ⇒ 용량 7(한 칸은 비워 둔다).
  let ctlo option mut slice u8 . . be alloc_bytes al capacity 16 .
  guard is_some ctlo . else return 90 .
  var ctl mut slice u64 . be view_array u64 (some_value ctlo) .
  set (index ctl 0) 0 . set (index ctl 1) 0 .

  let bufo option mut slice u8 . . be alloc_bytes al capacity 64 .
  guard is_some bufo . else return 91 .
  var buf mut slice u64 . be view_array u64 (some_value bufo) .
  guard eq (spsc.spsc_capacity buf) 7 . else return 1 .
  guard eq (spsc.spsc_count_about k ctl buf) 0 . else return 2 .

  let outo option mut slice u8 . . be alloc_bytes al capacity 8 .
  guard is_some outo . else return 92 .
  var out mut slice u64 . be view_array u64 (some_value outo) .

  rem ── ① 용량까지 채운다 — 여덟째는 거절돼야 한다(한 칸을 비워 두는 규칙) ──
  var i u64 be 0 .
  while lt i 7 . do
    guard eq (spsc.spsc_push k ctl buf (add 200 i)) 1 . else return 3 .
    set i (add i 1) .
  end .
  guard eq (spsc.spsc_count_about k ctl buf) 7 . else return 4 .
  guard eq (spsc.spsc_push k ctl buf 999) 0 . else return 5 .

  rem ── ② 전부 꺼낸다 — **넣은 순서 그대로** 나와야 한다(FIFO) ─────────────
  var j u64 be 0 .
  while lt j 7 . do
    guard eq (spsc.spsc_pop k ctl buf out) 1 . else return 6 .
    guard eq (index out 0) (add 200 j) . else return 7 .
    set j (add j 1) .
  end .
  guard eq (spsc.spsc_count_about k ctl buf) 0 . else return 8 .
  rem 빈 큐에서 꺼내면 0 — 트랩이 아니라 값이다.
  guard eq (spsc.spsc_pop k ctl buf out) 0 . else return 9 .

  rem ── ③ 감싸기 — 인덱스가 한 바퀴 돈 뒤에도 순서가 살아 있는가 ───────────
  var r u64 be 0 .
  while lt r 5 . do
    guard eq (spsc.spsc_push k ctl buf (add 300 r)) 1 . else return 10 .
    guard eq (spsc.spsc_pop k ctl buf out) 1 . else return 11 .
    guard eq (index out 0) (add 300 r) . else return 12 .
    set r (add r 1) .
  end .
  guard eq (spsc.spsc_count_about k ctl buf) 0 . else return 13 .
  return 42 .
end .
