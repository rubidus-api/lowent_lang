rem ★★★ **랜덤 접근 — 파일의 아무 데나 읽는다** (RFC-0069 §4 read_at).
rem
rem   스트리밍(copy.low)은 **순차**였다 — 앞에서 뒤로. `seek` 은 그 벽을 없앤다:
rem   커서를 **아무 오프셋으로** 옮기고 거기서 읽는다. 이진 포맷(헤더가 오프셋 N 에 있는)·
rem   로그 꼬리·인덱스 파일이 이것을 필요로 한다.
rem
rem ★ 이 프로그램은 sample.txt("alpha\nbeta\ngamma\ndelta\n", 23 바이트)에서:
rem     · 오프셋 6 으로 건너뛰어 4 바이트 읽는다 → "beta" (앞의 "alpha\n" 을 안 읽고 건너뛴다)
rem     · 끝으로 건너뛰어(whence 2) **파일 크기**를 얻는다 → 23
rem   전부 맞으면 23 을 낸다. 한 걸음이라도 틀리면 그 자리 오류 코드를 낸다.
rem
rem ★★ **읽기는 오라클 안**이다(A4 정정) — 같은 파일이면 VM 과 네이티브가 같은 바이트를 본다.
rem   그래서 seek 도 diff 대상이다: 골든이 두 백엔드를 같은 파일에 돌려 답을 대조한다.

module seek .

use files from "../../../lib/file.low" .

proc main
  input fs cap file_system .
  input al cap allocator .
  input a  cap args .
  output u8 .
  effects alloc io .
do
  let src option slice u8 arg a. 0 . .
  guard is_some src. . else return 64 . .

  let g option mut slice u8 alloc_bytes al. capacity 8 . .
  guard is_some g. . else return 70 . .
  let buf mut slice u8 some_value g. . .

  let ri result files.handle files.file_error files.open fs. some_value src. . 0 . .
  guard is_ok ri. . else return 71 . .
  var rh owned files.handle ok_value ri. . .

  rem ★ 오프셋 6 으로 건너뛴다(whence 0 = 절대) → 새 위치 6
  let s1 result u64 files.file_error files.seek_to fs. rh. 6 0 . .
  guard is_ok s1. . else return 72 . .
  guard eq ok_value s1. . 6 . else return 73 . .

  rem 거기서 4 바이트 읽으면 "beta" 여야 한다 — "alpha\n" 을 건너뛴 증거
  let n result (option u64) files.file_error files.read fs. rh. subslice buf. 0 4 . . .
  guard is_ok n. . else return 74 . .
  let nv option u64 ok_value n. . .
  guard is_some nv. . else return 74 . .
  guard eq some_value nv. . 4 . else return 75 . .
  guard eq idx buf. 0 . 98 . else return 80 . .           rem 'b'
  guard eq idx buf. 1 . 101 . else return 81 . .          rem 'e'
  guard eq idx buf. 2 . 116 . else return 82 . .          rem 't'
  guard eq idx buf. 3 . 97 . else return 83 . .           rem 'a'

  rem ★ 끝으로 건너뛰어 파일 크기를 얻는다(offset 0, whence 2 = end)
  let sz result u64 files.file_error files.seek_to fs. rh. 0 2 . .
  guard is_ok sz. . else return 76 . .

  let c result void files.file_error files.close fs. rh. . .
  guard is_ok c. . else return 77 . .
  return narrow u8 ok_value sz. . . .                    rem sample.txt = 23
end .
