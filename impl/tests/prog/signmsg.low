rem ★★★ **실물 프로그램: 표준 입력을 서명하고 스스로 검증한다**
rem   (RFC-0075 §8 Stage 2 · RFC-0090 §N7b).
rem
rem   원장이 세는 「진짜 프로그램이 안 쓰는 모듈」의 마지막 둘 가운데 하나가
rem   `ecdsa` 였다. 기존 픽스처는 **RFC 6979 §A.2.5 의 고정 벡터**로 k·r·s 를
rem   맞댄다 — 그것은 구현이 규격대로인지를 재는 좋은 시험이다.
rem
rem   그러나 실물이 묻는 것은 다르다: **바깥에서 들어온 바이트**를 해시해
rem   서명하고, 그 서명이 **스스로 서는가**. 고정 벡터는 그것을 묻지 못한다.
rem
rem ★ 종료 상태가 곧 오라클이다.
rem     42 = 서명했고 그 서명이 검증됐다
rem     43 = 서명이 64 바이트가 아니다        ← 서명 자체가 안 섰다
rem     44 = 서명했는데 **검증이 안 된다**    ← 가장 값진 실패다
rem     45 = 변조한 서명이 **검증됐다**       ← 이러면 서명이 서명이 아니다
rem     46 = 빈 입력 · 89 = 자리를 못 얻었다
rem
rem ★★ 45 가 있는 까닭: 「맞는 것이 맞다」만 재면 **언제나 참을 내는 검증기**도
rem   통과한다. 그래서 한 비트를 뒤집고 **거절되는지**까지 본다 — 이 저장소가
rem   되풀이해 배운 「음성 검사가 없으면 그 검사는 장식이다」가 암호에서는
rem   장식이 아니라 **구멍**이 된다.

module signmsg .

use ecdsa  from "../../../lib/ecdsa.low" .
use bigint from "../../../lib/bigint.low" .
use p256   from "../../../lib/p256.low" .
use codec  from "../../../lib/codec.low" .

rem ── 곡선 상수: 규격이 정한 수다(우리가 고른 것이 아니다) ──
proc limbs_of input hexs slice u8 . input out mut slice u64 . input w mut slice u8 .
  output u64 . effects none .
do
  guard ge (len w) 32 . else return 0 .
  let d option u64 . be codec.hex_dec hexs (subslice w 0 32) .
  guard is_some d . else return 0 .
  return bigint.from_bytes (subslice w 0 32) out 16 .
end

proc curve input cw mut slice u64 . input w mut slice u8 . output u64 . effects none .
do
  guard ge (len cw) 64 . else return 0 .
  guard eq (limbs_of "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff" (subslice cw 0 16) w) 16 . else return 0 .
  guard eq (limbs_of "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551" (subslice cw 16 32) w) 16 . else return 0 .
  guard eq (limbs_of "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296" (subslice cw 32 48) w) 16 . else return 0 .
  guard eq (limbs_of "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5" (subslice cw 48 64) w) 16 . else return 0 .
  return 1 .
end

rem ★ 알맹이를 **따로 op 으로** 담는다. 처음엔 `main` 안에 전부 썼더니
rem   `W-CBE-SKIP` — 몸이 네이티브 핵심 밖이라 네이티브 빌드에서 빠진다고
rem   처리기가 **말했다**(조용히 빠지지 않는다). 가르면 양쪽에서 다 돈다.
rem   ☞ *경고가 설계를 고쳤다. 그것이 경고가 있는 까닭이다.*
export proc sign_and_check .
  input msg slice u8 .
  input rs mut slice u8 . input wb mut slice u8 . input wu mut slice u64 .
  output u64 . effects none .
do
  guard ge (len wu) 2020 . else return 89 .
  guard eq (curve (subslice wu 0 64) wb) 1 . else return 89 .

  guard eq (call_builtin sha256 msg (subslice wb 32 64)) 32 . else return 89 .

  let dh option u64 . be codec.hex_dec "c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721" (subslice wb 0 32) .
  guard is_some dh . else return 89 .

  let sg result u64 ecdsa.ecdsa_error . be ecdsa.sign (subslice wb 0 32) (subslice wb 32 64)
                       (subslice wu 0 16) (subslice wu 16 32)
                       (subslice wu 32 48) (subslice wu 48 64)
                       rs (subslice wb 64 640) (subslice wu 64 1016) .
  guard is_ok sg . else return 43 .
  guard eq (ok_value sg) 64 . else return 43 .

  guard eq (bigint.from_bytes (subslice rs 0 32) (subslice wu 1016 1032) 16) 16 . else return 89 .
  guard eq (bigint.from_bytes (subslice rs 32 64) (subslice wu 1032 1048) 16) 16 . else return 89 .
  guard eq (bigint.from_bytes (subslice wb 32 64) (subslice wu 1048 1064) 16) 16 . else return 89 .
  guard eq (limbs_of "60fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb6" (subslice wu 1064 1080) wb) 16 . else return 89 .
  guard eq (limbs_of "7903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299" (subslice wu 1080 1096) wb) 16 . else return 89 .

  let ev1 result u64 p256.p256_error . be p256.ecdsa_verify (subslice wu 1016 1032) (subslice wu 1032 1048) (subslice wu 1048 1064)
                              (subslice wu 1064 1096)
                              (subslice wu 0 16) (subslice wu 16 32)
                              (subslice wu 32 48) (subslice wu 48 64)
                              (subslice wu 1096 2020) .
  guard is_ok ev1 . else return 44 .
  guard eq (ok_value ev1) 1 . else return 44 .

  rem ── 한 비트를 뒤집으면 **거절되어야** 한다 ──
  set (index rs 0) (bit_xor (index rs 0) 1) .
  guard eq (bigint.from_bytes (subslice rs 0 32) (subslice wu 1016 1032) 16) 16 . else return 89 .
  let ev2 result u64 p256.p256_error . be p256.ecdsa_verify (subslice wu 1016 1032) (subslice wu 1032 1048) (subslice wu 1048 1064)
                              (subslice wu 1064 1096)
                              (subslice wu 0 16) (subslice wu 16 32)
                              (subslice wu 32 48) (subslice wu 48 64)
                              (subslice wu 1096 2020) .
  guard is_ok ev2 . else return 45 .
  guard ne (ok_value ev2) 1 . else return 45 .

  return 42 .
end

proc main .
  input al cap allocator .
  input k  cap io .
  output u8 .
  effects alloc io .
do
  let gi option mut slice u8 . . be alloc_bytes al capacity 4096 .
  guard is_some gi . else return 89 .
  let inbuf mut slice u8 . be some_value gi .

  let rn option u64 . be read_in k 0 inbuf .
  guard is_some rn . else return 89 .
  let got u64 be some_value rn .
  guard ne got 0 . else return 46 .

  let grs option mut slice u8 . . be alloc_bytes al capacity 64 .
  guard is_some grs . else return 89 .
  let gwb option mut slice u8 . . be alloc_bytes al capacity 1024 .
  guard is_some gwb . else return 89 .
  let gwu option mut slice u8 . . be alloc_bytes al capacity 24576 .
  guard is_some gwu . else return 89 .

  return narrow_wrap u8 (sign_and_check (subslice inbuf 0 got)
                          (some_value grs) (some_value gwb)
                          (view_array u64 (some_value gwu))) .
end
