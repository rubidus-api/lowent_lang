rem ★★★ **디렉터리를 걷으며 각 엔트리가 무엇인지 분류한다** — 미니 `find`/`ls -l`.
rem
rem   디렉터리 순회(dir_read)는 **이름**만 준다. `file_type`(stat)이 그 이름이 **파일인지
rem   디렉터리인지** 알려준다 — 그 둘이 맞물려야 재귀 도구(find·du·tree)가 선다. 이 프로그램이
rem   그 조합을 처음으로 시험한다: 나열 → 각 엔트리의 전체 경로를 조립(str_buf) → 분류.
rem
rem ★ tree/ = {f1(파일), f2(파일), sub(디렉터리)} ⇒ 파일 2 · 디렉터리 1 ⇒ **files*10 + dirs = 21**.
rem   ★ 이것이 세 라이브러리를 한 프로그램에 엮는다: `files`(dir_read·f_type) + `strbuf`(경로 조립).
rem     "라이브러리를 지으면 언어의 구멍이 나온다" — 여기선 **경로 조립**(디렉터리 + "/" + 이름)이 처음 필요해진다.

module walk .

use files from "../../../lib/file.low" .
use strbuf from "../../../lib/strbuf.low" .

proc main .
  input fs cap file_system .
  input al cap allocator .
  input a  cap args .
  output u8 .
  effects alloc io .
do
  let dp be option slice u8 arg a 0 .
  guard is_some dp . else return 64 .
  let dpath be slice u8 some_value dp .

  let gn be option mut slice u8 alloc_bytes al capacity 256 .
  guard is_some gn . else return 70 .
  let namebuf be mut slice u8 some_value gn .
  let gpth be option mut slice u8 alloc_bytes al capacity 512 .
  guard is_some gpth . else return 70 .
  let pathbuf be mut slice u8 some_value gpth .

  let di be result files.dir_handle files.file_error files.open_dir fs dpath .
  guard is_ok di . else return 71 .
  var dh be owned files.dir_handle ok_value di .

  var nfiles be u64 0 .
  var dirs be u64 0 .
  var going be bool true .
  while going . do
    rem ★ 세 자리다(2026-08-15): 실패는 `error`, **끝은 `ok none`**.
    let n be result (option u64) files.file_error files.read_dir fs dh namebuf .
    if eq (is_ok n) false . do set going false . end
    if is_ok n . do
      let nvo be option u64 ok_value n .
      if eq (is_some nvo) false . do set going false . end
      var nl be u64 0 .
      if is_some nvo . do set nl (some_value nvo) . end
      if eq nl 0 . do set going false . end
      if gt nl 0 . do
        var is_dot be bool false .
        if eq nl 1 . do
          if eq (index namebuf 0) 46 . do set is_dot true . end
        end
        if eq nl 2 . do
          if eq (index namebuf 0) 46 . do
            if eq (index namebuf 1) 46 . do set is_dot true . end
          end
        end
        if eq is_dot false . do
          rem 전체 경로 = dpath + "/" + name — str_buf 로 조립한다
          var b be strbuf.str_buf strbuf.new .
          let r1 be result void strbuf.sb_error strbuf.append b pathbuf dpath .
          guard is_ok r1 . else return 80 .
          let r2 be result void strbuf.sb_error strbuf.append b pathbuf "/" .
          guard is_ok r2 . else return 81 .
          let r3 be result void strbuf.sb_error strbuf.append b pathbuf (subslice namebuf 0 nl) .
          guard is_ok r3 . else return 82 .
          let t be option u64 files.type_of fs (strbuf.as_str b pathbuf) .
          guard is_some t . else return 83 .
          if eq (some_value t) 1 . do set dirs (add dirs 1) . end
          if eq (some_value t) 0 . do set nfiles (add nfiles 1) . end
        end
      end
    end
  end

  let c be result void files.file_error files.close_dir fs dh .
  guard is_ok c . else return 72 .
  return (narrow u8 (add (mul nfiles 10) dirs)) .   rem tree = 2 files, 1 dir → 21
end
