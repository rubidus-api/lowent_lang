fn good .
  input x u32 . input y u32 .
  output u32 .
do
  var z u32 be add x y .
  return z .
end

fn bad_var .
  output u32 .
do
  var i u32 be true .
  return i .
end

fn bad_return .
  input x u32 .
  output bool .
do
  return x .
end

fn bad_arg .
  input p bool .
  output bool .
do
  return good 1 2 .
end
