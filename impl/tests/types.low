fn good .
  output u32 . input x u32 .
  input y u32 .
do
  var z u32 be add x y .
  return z .
end .

fn bad_var .
  output u32 .
do
  var i u32 be true .
  return i .
end .

fn bad_return .
  output bool .
  input x u32 .
do
  return x .
end .

fn bad_arg .
  output bool .
  input p bool .
do
  return good 1 2 .
end .
