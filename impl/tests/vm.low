rem S5 gate fixture — MVP core on the stack-IR VM (--ir / --run).
rem fact = while/set/expr island; fib = recursion + nested calls.
fn fact
  input n u64 .
  output u64 .
do
  var acc u64 1 .
  var i u64 1 .
  while le i. n. . do
    set acc. mul acc. i. . .
    set i. expr i. + 1 . .
  end .
  return acc. .
end .

fn fib
  input n u64 .
  output u64 .
do
  if lt n. 2 . do
    return n. .
  end .
  return expr (fib expr n. - 1 . .) + (fib expr n. - 2 . .) . .
end .
