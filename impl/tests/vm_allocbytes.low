rem ★★★ **얼로케이터 — 뿌리와 그 위** (RFC-0043 A3 · lib/alloc.low).
rem
rem   여기서 시험하는 것은 op 하나가 아니라 **분할**이다:
rem     · 뿌리   `alloc_bytes <cap allocator> capacity n` — 바이트가 처음 들어오는 자리(런타임이 준다)
rem     · 그 위  `actor` 얼로케이터 — 받은 바이트를 자른다. **누가 줬는지 묻지 않는다.**
rem
rem ★★★ **`borrowed` 가 cap 없이 도는 것이 이 파일의 핵심 주장이다.** 그 op 은 `cap allocator` 를
rem   안 받고 `effects alloc` 도 안 적는데 **얼로케이터를 온전히 돌린다** — 호출자가 준 바이트
rem   위에서. 즉 RFC-0068 F4(c) 의 *"권한이 능력을 가른다"* 가 실물로 성립한다:
rem   런타임 `borrowed` 플래그도, 두 벌의 API 도 없이 **권한 없는 코드가 뿌리에 닿을 수 없다.**
rem
rem ★★ **오라클 안이다**(할당인데도): 바닥이 0 에서 시작하는 범프라 VM 과 네이티브가 **같은
rem   바이트**를 본다. 주소는 다르지만 언어가 주소를 노출하지 않는다 ⇒ diff-sweep 이 덮는다.

module vm_allocbytes .

use allocs from "../../lib/alloc.low" .

rem ── 뿌리 없이 도는 쪽 — **cap 이 없다. effects alloc 도 없다.** ──────────
rem
rem ★ 호출자가 준 버퍼(CLI 가 채운다) 위에서 사용자 얼로케이터를 돌린다.
rem   빌린 버퍼로 만든 얼로케이터는 뿌리를 **부를 수가 없다** — 그럴 권한이 없으므로.
proc borrowed input buf mut slice u8 . output u64 . effects state . do
  var a allocs.bump_bytes spawn actor allocs.bump_bytes .
  let cap0 u64 send a init buf .
  guard ge cap0 8 else return 90 .
  let p option mut slice u8 send a reserve 3 .
  guard is_some p else return 91 .
  let q option mut slice u8 send a reserve 5 .
  guard is_some q else return 92 .
  rem 자른 조각에 쓰면 **원본 버퍼가 바뀐다** — 뷰지 복사가 아니다.
  let pv mut slice u8 some_value p .
  set (idx pv 0) 65 .
  guard eq (idx buf 0) 65 else return 93 .
  rem 두 번째 조각은 첫 조각 **뒤**에서 시작한다(범프).
  let qv mut slice u8 some_value q .
  set (idx qv 0) 66 .
  guard eq (idx buf 3) 66 else return 94 .
  return send a used .                                   rem 3 + 5 = 8
end

rem ★ 같은 인터페이스, 다른 정책 — 8 로 정렬한다. 3 을 자르면 다음은 8 부터다.
proc borrowed_aligned input buf mut slice u8 . output u64 . effects state . do
  var a allocs.bump_aligned spawn actor allocs.bump_aligned .
  let cap0 u64 send a init buf .
  guard ge cap0 16 else return 90 .
  let p option mut slice u8 send a reserve 3 .
  guard is_some p else return 91 .
  let q option mut slice u8 send a reserve 1 .
  guard is_some q else return 92 .
  let qv mut slice u8 some_value q .
  set (idx qv 0) 67 .
  guard eq (idx buf 8) 67 else return 93 .           rem ★ 3 이 아니라 8 — 정렬이 실제로 있다
  return send a used .                                   rem 8 + 1 = 9
end

rem ★ OOM 은 **값**이다(RFC-0043 D5). 4 바이트 버퍼에 99 를 달라면 none — 트랩이 아니다.
proc borrowed_oom input buf mut slice u8 . output bool . effects state . do
  var a allocs.bump_bytes spawn actor allocs.bump_bytes .
  let cap0 u64 send a init (subslice buf 0 4) .
  let p option mut slice u8 send a reserve 99 .
  return is_some p .
end

rem ★ 두 얼로케이터를 **같은 코드**가 돌린다 — 갈아끼우기의 실물.
rem   `input comptime a type .` + `requires byte_allocator a .` 로 구현을 매개변수로 받는다.
rem   ★★ 단형화된다: vtable 도 간접 호출도 없다 ⇒ **갈아끼우기의 비용이 0** 이다.
proc two_from
  input comptime a type .
  using al a .
  input buf mut slice u8 .
  output u64 .
  effects state .
  requires allocs.byte_allocator a .
do
  let cap0 u64 send al init buf .
  guard ge cap0 8 else return 90 .
  let p option mut slice u8 send al reserve 3 .
  guard is_some p else return 91 .
  let q option mut slice u8 send al reserve 1 .
  guard is_some q else return 92 .
  return send al used .
end

rem ★★★ **한 코드가 두 정책을 돌리고 답이 다르다** — 인터페이스가 장식이 아니라는 증거.
rem   bump_bytes: 3 + 1 = 4 · bump_aligned: 8 + 1 = 9 (3 다음이 8 로 올라간다)
proc swap_impl input buf mut slice u8 . output u64 . effects state . do
  var b allocs.bump_bytes spawn actor allocs.bump_bytes .
  var g allocs.bump_aligned spawn actor allocs.bump_aligned .
  let x use b u64 two_from buf .
  let y use g u64 two_from (subslice buf 0 16) .
  return add (mul x 100) y .                             rem 4·100 + 9 = 409
end
