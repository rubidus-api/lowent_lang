rem ★★★ **핸들 bit 예산과 wrap 정책** — RFC-0104 §8-3(소유자 서명 §5.14, 2026-08-28).
rem   재는 것 셋(§7.3 종료 조건):
rem     ① 예산을 넘긴 구성은 **컴파일이 안 된다**(음성 픽스처 `vm_budget_over.low`)
rem     ② 세대가 한 바퀴 돌면 그 칸은 **은퇴**하고 할당은 **값으로 실패**한다
rem     ③ 32/64 비트 비용표가 있다(`docs/bench/capacity.md` §④ · 여기서 그 수를 잰다)
module vm_budget .

use budget from "../../lib/budget.low" .

rem ★ 권고 기본값이 실제로 그 수인가 — 문서가 아니라 **도구가** 답한다.
proc defaults output u64 . effects none . do
  let p64 budget.plan be budget.default64 .
  let p32 budget.plan be budget.default32 .
  guard eq (field p64 slot_bits) 32 . else return 91 .
  guard eq (field p64 shard_bits) 8 . else return 92 .
  guard eq (field p64 gen_bits) 24 . else return 93 .
  guard eq (field p32 slot_bits) 16 . else return 94 .
  guard eq (field p32 shard_bits) 4 . else return 95 .
  guard eq (field p32 gen_bits) 12 . else return 96 .
  rem 합이 한 word 다 — 그것이 이 배분의 전부다.
  guard eq (add (add 32 8) 24) 64 . else return 97 .
  guard eq (add (add 16 4) 12) 32 . else return 98 .
  return 1 .
end .

rem ★★ **넣고 되꺼내면 그대로 나온다** — 64 비트 배분에서.
proc roundtrip output u64 . effects none . do
  let ho option u64 . be budget.pack 32 8 24 1234567 200 99 .
  guard is_some ho . else return 90 .
  let h u64 be some_value ho .
  guard eq (budget.slot_of 32 h) 1234567 . else return 91 .
  guard eq (budget.shard_of 32 8 h) 200 . else return 92 .
  guard eq (budget.gen_of 32 8 h) 99 . else return 93 .
  return 2 .
end .

rem ★★ 32 비트 배분에서도 같다.
proc roundtrip32 output u64 . effects none . do
  let ho option u64 . be budget.pack 16 4 12 65535 15 4000 .
  guard is_some ho . else return 90 .
  let h u64 be some_value ho .
  guard eq (budget.slot_of 16 h) 65535 . else return 91 .
  guard eq (budget.shard_of 16 4 h) 15 . else return 92 .
  guard eq (budget.gen_of 16 4 h) 4000 . else return 93 .
  rem ★ 자기 칸에 안 들어가는 값은 **조용히 잘리지 않는다** — none 이다.
  let over option u64 . be budget.pack 16 4 12 65536 0 0 .
  guard eq (is_some over) false . else return 94 .
  return 3 .
end .

rem ★★★ **세대가 한 바퀴 돌면 그 칸은 은퇴한다** — 조용한 부활이 없다는 것이 요점이다.
proc wrap_retires output u64 . effects none . do
  rem gen_bits 가 4 면 세대는 0..15 이고 15 가 마지막이다.
  guard eq (budget.retired 4 14) false . else return 91 .
  guard eq (budget.retired 4 15) true . else return 92 .

  rem 마지막 직전에는 다음 세대가 있다
  let n1 option u64 . be budget.next_gen 4 14 .
  guard is_some n1 . else return 93 .
  guard eq (some_value n1) 15 . else return 94 .

  rem ★ 마지막에 닿으면 **없다** — 트랩이 아니라 값이다(RFC-0043 D5 와 같은 규율).
  let n2 option u64 . be budget.next_gen 4 15 .
  guard eq (is_some n2) false . else return 95 .
  return 4 .
end .

rem 담을 수 있는 수 — 비용표의 그 수다.
proc capacities output u64 . effects none . do
  let p budget.plan be budget.default64 .
  let s option u64 . be budget.slots p .
  let h option u64 . be budget.shards p .
  let g option u64 . be budget.lives p .
  guard is_some s . else return 91 .
  guard is_some h . else return 92 .
  guard is_some g . else return 93 .
  guard eq (some_value s) 4294967296 . else return 94 .
  guard eq (some_value h) 256 . else return 95 .
  guard eq (some_value g) 16777216 . else return 96 .
  rem ★ 셀 수 없는 폭은 **값으로** 거절된다 — 조용히 음수를 내지 않는다.
  let wide budget.plan be make budget.plan do slot_bits 63 . shard_bits 0 . gen_bits 0 . end .
  let w option u64 . be budget.slots wide .
  guard eq (is_some w) false . else return 97 .
  return 5 .
end .
