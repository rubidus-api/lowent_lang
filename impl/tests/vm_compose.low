rem ★★★ **합성 축** — 값이 **op 경계를 넘을 때**.
rem
rem 세 번째 진짜 프로그램이 그 부류를 드러냈다: `slice u32` 를 다른 op 에 넘기면
rem 진입 래핑이 **두 번** 걸려 깨졌다. 픽스처가 전부 **CLI 에서 직접 받기만** 해서
rem 아무도 못 봤다. ⇒ **값의 모든 종류를 op 사이로 넘겨 본다.** 그리고 되돌려 받는다.
rem
rem (교훈 6: 픽스처에 없는 모양은 아무도 검사하지 않는다. 그래서 이 축을 **고정한다.**)

module vm_compose .

enum e do
  bad .
end .

struct pt do
  x u8 .
  y u8 .
end .

rem ── 넘기기 ──────────────────────────────────────────────────────────────
fn take_view output u8 . input p pt . do return field p x . end .

fn pass_view output u8 . input s slice u8 . do
  let v be view pt s . .
  return take_view v .                  rem 구조체 **뷰**를 넘긴다
end .

fn pass_record output u8 . do
  var q pt be make pt do x 9 . y 8 . end .
  return take_view q .                  rem **레코드**를 넘긴다(뷰와 같은 자리에서 받는다)
end .

fn mk_result output result u8 e . input a u8 . do return ok a . end .
fn take_result output bool . input r result u8 e . . do return is_ok r . end .
fn pass_result output bool . input a u8 . do
  return take_result (mk_result a) .    rem **result** 를 넘긴다
end .

fn take_option output bool . input o option u8 . . do return is_some o . end .
fn pass_option output bool . input a u8 . do
  return take_option (nonzero_of a) .   rem **option** 을 넘긴다
end .

fn take_vec output u32 . input v vec u32 4 . . do return reduce_add v . end .
fn pass_vec output u32 . input xs slice u32 . do
  var v vec u32 4 . be load xs 0 .
  return take_vec v .                   rem **vec** 를 넘긴다
end .

fn take_typed output u64 . input s slice u32 . do return len s . end .
fn pass_typed output u64 . input s slice u32 . do
  return take_typed s .                 rem ★ **타입 있는 슬라이스** — 여기가 깨지던 자리다
end .

rem ── 되돌려 받기 ─────────────────────────────────────────────────────────
fn give_view output pt . input s slice u8 . do return view pt s . end .
fn get_view output u8 . input s slice u8 . do
  let v be give_view s . .              rem 구조체 뷰를 **반환**받는다
  return field v x .
end .

fn give_typed output slice pt . input s slice pt . do return s . end .
fn get_typed output u64 . input s slice pt . do
  let t be give_typed s . .             rem 타입 있는 슬라이스를 **반환**받는다
  return len t .
end .

test values_cross_op_boundaries do
  expect eq (pass_view "ab") 97 .
  expect eq (pass_record) 9 .
  expect eq (pass_result 5) 1 .
  expect eq (pass_option 5) 1 .
  expect eq (pass_typed "abcdefgh") 2 .
  expect eq (get_view "ab") 97 .
  expect eq (get_typed "abcd") 2 .
end .
