module vm_copyrest .
rem ★★ RFC-0132 P3 — 내용 복사 `copy <받는 쪽> <주는 쪽> .`(겹쳐도 옳게) · 구조체 값의 나머지 `lit T do <칸> <값> . _ <값> . end`.
export fn copied input a u8 . output u64 . do
  var buf lit array u8 6 1 2 3 4 5 6 . .
  var dst lit array u8 3 _ . .
  copy dst. subslice buf. 0 3 . .
  copy subslice buf. 1 6 . subslice buf. 0 5 . .
  set idx dst. 0 . a. .
  var s u64 0 .
  for x buf. do
    set s. add mul s. 10 . widen u64 x. . . .
  end .
  return add mul s. 1000 . add mul widen u64 idx dst. 0 . . 100 . widen u64 idx dst. 2 . . . . .
end .

def struct pt do
  x u32 .
  y u64 .
  z u8 .
end .
export fn rested input a u64 . output u64 . do
  let p pt lit pt do y a. . _ 7 . end . .
  let q pt lit pt do _ 0 . end . .
  return add add widen u64 field p. x . . field p. y . . add widen u64 field p. z . . mul field q. y . 100 . . . .
end .
