rem ★★ 커버리지 픽스처 — **차등 훑기가 한 번도 안 건드린 옵코드**를 덮는다.
rem
rem `scripts/oracle-coverage.py` 를 만들자마자 알아낸 것: 스윕이 도는 151 픽스처의 IR 에
rem 121/165 옵코드만 등장했다(73%). 안 덮인 44개 중 io·net·file·atomic·asm 류는 **스윕 밖**
rem 픽스처(cap 엔트리·extern)라 설명이 되지만, 다섯은 **순수 계산인데 아무도 안 재고 있었다**:
rem
rem   or          — 논리 or 는 보통 **단축 평가**(brz+not)로 낮아진다. `or` 옵코드가 실제로
rem                 나오는 자리는 **match 의 or-패턴** 하나다(low_ir.c:3965).
rem   switch      — match 가 **6가지 이상 + 값이 촘촘할 때만** 계산 점프로 낮아진다(narm<6 → 선형).
rem                 그 임계를 넘는 match 가 픽스처에 없었다.
rem   reduce.mul  — reduce_add 는 있었고 mul 은 없었다. 항등원이 **1** 이라 0 과 갈리는 자리다.
rem   rotr        — rotl 은 있었고 rotr 은 없었다.
rem   wrap.shr    — wrap_shl 은 있었고 shr 은 없었다.
rem
rem ⇒ 이 파일의 값은 기능이 아니라 **측정된 빈칸을 메우는 것**이다. 그래서 이름이 기능이 아니라
rem   `vm_coverage` 다. 옵코드 하나에 op 하나 — 무엇을 재는지 이름이 말한다.
rem   ★ 짝(rotl/rotr · shl/shr · add/mul)에서 **한쪽만** 덮여 있었다는 것이 이 계측의 첫 수확이다.
rem     결함이 나오는 자리는 "아무도 안 쓰는 기능" 이 아니라 **짝의 안 쓰이는 쪽**이다.

rem `bytes` 는 이 저장소의 관용 별칭이다 — 픽스처가 자기 타입을 스스로 선언한다.
type bytes slice u8 . .

export fn cov_orpat output u64 . input a u64 . do
  match a do
    case 1 or 2 or 3 . do return 7 . end .
    case 9 or 10 . do return 8 . end .
    case _ . do return 0 . end .
  end .
end .

rem ★ 여섯 가지 + 촘촘(0..5) ⇒ IRW_SWITCH 로 낮아진다. 다섯 가지면 선형으로 남는다.
export fn cov_switch output u64 . input a u64 . do
  match a do
    case 0 . do return 10 . end .
    case 1 . do return 11 . end .
    case 2 . do return 12 . end .
    case 3 . do return 13 . end .
    case 4 . do return 14 . end .
    case 5 . do return 15 . end .
    case _ . do return 99 . end .
  end .
end .

rem ★ `reduce_*` 는 **슬라이스가 아니라 벡터**(SIMD 레인)를 먹는다 — 처음에 `slice f64` 로 적었고
rem   `E-VM-TYPE: reduce needs a vector` 로 배웠다. 짝의 안 쓰이는 쪽은 **쓰는 법조차 안 굳어 있다.**
rem   항등원이 갈리는 자리다: 같은 레인에 대해 add 는 합, mul 은 곱 — 0 과 1 이 갈린다.
export fn cov_reduce_mul output f64 . input b bytes . do
  var xs slice f32 . be view_array f32 b .
  var v vec f32 4 . be load xs 0 .
  return reduce_mul v .
end .

export fn cov_rotr output u32 . input a u32 . do
  return rotr a 3 .
end .

export fn cov_wrap_shr output u64 . input a u64 . do
  return wrap_shr a 3 .
end .
