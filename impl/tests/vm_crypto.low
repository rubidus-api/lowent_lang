rem ★★★ **암호 프리미티브 — 표준 벡터로 증언한다** (RFC-0090 N7a).
rem
rem   HMAC-SHA256(RFC 4231) · HKDF(RFC 5869) · ChaCha20(RFC 8439 §2.3.2) ·
rem   Poly1305(§2.5.2) · ChaCha20-Poly1305 AEAD(§2.8.2) · X25519(RFC 7748 §5.2·§6.1).
rem
rem ★★ **왜 이 픽스처는 entry 가 아닌가:** entry 가 아니어야 차분 스윕(VM≡native)이 이것을
rem   돌린다. 암호는 **두 뒤끝이 같은 답을 내는 것**이 특히 중요하다 — 한쪽만 맞으면
rem   "내 기계에서는 통했다" 가 되고, 그것은 여기서 실패의 이름이다.
rem
rem ★ 이 파일이 답을 **적어 두지 않는** 이유: 답은 골든이 RFC 값과 맞댄다. 여기 있는 것은
rem   계산뿐이고, 정답은 **밖에서 온다**. 손으로 적은 정답표는 구현과 함께 틀린다.

module vm_crypto .

rem ☞ 의존을 **파일이 스스로 적는다** — 그래야 골든의 단독 검사와 차분 스윕이
rem   이 픽스처를 다른 것과 똑같이 다룬다. 예외를 만드는 대신 관용을 따른다.
use hmac from "../../lib/hmac.low" .
use chacha from "../../lib/chacha.low" .
use poly from "../../lib/poly.low" .
use aead from "../../lib/aead.low" .
use x25519 from "../../lib/x25519.low" .

rem 결과 앞 8 바이트를 하나의 수로 — 골든이 한 줄로 대조할 수 있게.
fn head8 input d slice u8 . output u64 . do
  var acc u64 be 0 .
  var i u64 be 0 .
  while lt i 8 . do
    set acc (add (shl acc 8) (cast u64 (index d i))) .
    set i (add i 1) .
  end
  return acc .
end

rem RFC 4231 case 1 — key 20×0x0b, msg "Hi There".
proc t_hmac input key slice u8 . input msg slice u8 . input scratch mut slice u8 . input out mut slice u8 . output u64 . effects none . do
  let _u6 result u64 hmac.hmac_error . be hmac.mac key msg scratch out .
  guard is_ok _u6 . else return 0 .
  guard eq (ok_value _u6) 32 . else return 0 .
  return head8 out .
end

rem RFC 5869 case 1 — PRK = HKDF-Extract(salt, IKM).
proc t_hkdf input salt slice u8 . input ikm slice u8 . input scratch mut slice u8 . input prk mut slice u8 . output u64 . effects none . do
  let _u5 result u64 hmac.hmac_error . be hmac.extract salt ikm scratch prk .
  guard is_ok _u5 . else return 0 .
  guard eq (ok_value _u5) 32 . else return 0 .
  return head8 prk .
end

rem RFC 8439 §2.3.2 — ChaCha20 블록 함수. 첫 워드를 낸다.
proc t_chacha input key slice u8 . input nonce slice u8 . input st mut slice u64 . input work mut slice u64 . output u64 . effects none . do
  guard eq (chacha.prep key nonce 1 st) 16 . else return 0 .
  let _u4 result u64 chacha.chacha_error . be chacha.rounds st work .
  guard is_ok _u4 . else return 0 .
  guard eq (ok_value _u4) 16 . else return 0 .
  return index work 0 .
end

rem RFC 8439 §2.5.2 — Poly1305 태그.
proc t_poly input key slice u8 . input msg slice u8 . input st mut slice u64 . input pad mut slice u8 . input tag mut slice u8 . output u64 . effects none . do
  guard eq (poly.setup key st) 1 . else return 0 .
  var off u64 be 0 .
  while le (add off 16) (len msg) . do
    let z u64 be poly.block st (subslice msg off (add off 16)) 1 .
    set off (add off 16) .
  end
  if lt off (len msg) . do
    var i u64 be 0 .
    while lt i 16 . do  set (index pad i) 0 .  set i (add i 1) .  end
    var j u64 be 0 .
    while lt (add off j) (len msg) . do
      set (index pad j) (index msg (add off j)) .
      set j (add j 1) .
    end
    set (index pad j) 1 .
    let z2 u64 be poly.block st pad 0 .
  end
  guard eq (poly.emit st key tag) 16 . else return 0 .
  return head8 tag .
end

rem RFC 8439 §2.8.2 — AEAD 봉인. 암호문 앞 8 바이트를 낸다(태그는 out 으로 나간다).
proc t_seal input key slice u8 . input nonce slice u8 . input aad slice u8 . input msg slice u8 .
     input ct mut slice u8 . input tag mut slice u8 . input otk mut slice u8 . input pst mut slice u64 .
     input st mut slice u64 . input work mut slice u64 . input ks mut slice u8 . input pad mut slice u8 .
     output u64 . effects none . do
  let _u3 result u64 aead.aead_error . be aead.seal key nonce aad msg ct tag otk pst st work ks pad .
  guard is_ok _u3 . else return 0 .
  guard eq (ok_value _u3) 16 . else return 0 .
  return head8 ct .
end

rem ★★ 변조는 거절돼야 한다 — AEAD 가 하는 약속의 전부다. 1 이면 거절했다.
proc t_tamper input key slice u8 . input nonce slice u8 . input aad slice u8 . input msg slice u8 .
     input ct mut slice u8 . input tag mut slice u8 . input outp mut slice u8 . input otk mut slice u8 .
     input pst mut slice u64 . input st mut slice u64 . input work mut slice u64 . input ks mut slice u8 .
     input pad mut slice u8 . input want mut slice u8 . output u64 . effects none . do
  let _u0 result u64 aead.aead_error . be aead.seal key nonce aad msg ct tag otk pst st work ks pad .
  guard is_ok _u0 . else return 90 .
  guard eq (ok_value _u0) 16 . else return 90 .
  let _u1 result u64 aead.aead_error . be aead.unseal key nonce aad ct tag outp otk pst st work ks pad want .
  guard is_ok _u1 . else return 91 .
  guard eq (ok_value _u1) 1 . else return 91 .
  set (index ct 0) (cast u8 (bit_xor (cast u64 (index ct 0)) 1)) .
  let _u2 result u64 aead.aead_error . be aead.unseal key nonce aad ct tag outp otk pst st work ks pad want .
  guard is_ok _u2 . else return 92 .
  guard eq (ok_value _u2) 0 . else return 92 .
  return 1 .
end

rem RFC 7748 §5.2 / §6.1 — X25519 스칼라 곱.
proc t_x25519 input n slice u8 . input pt slice u8 . input q mut slice u8 . input z mut slice u8 .
     input fa mut slice u64 . input fb mut slice u64 . input fc mut slice u64 . input fd mut slice u64 .
     input fe mut slice u64 . input ff mut slice u64 . input fg mut slice u64 . input fx mut slice u64 .
     input fs mut slice u64 . input t mut slice u64 . output u64 . effects none . do
  guard eq (x25519.scalarmult q n pt z fa fb fc fd fe ff fg fx fs t) 32 . else return 0 .
  return head8 q .
end
