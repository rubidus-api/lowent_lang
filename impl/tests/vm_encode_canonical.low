module vm_encode_canonical .
rem ★ W-20261116-1800 D1 (정본 §6.2.13 (4a)) — 정규 바이트: 틈 없음 · LE · −0 → +0 · NaN 한 꼴. 기대값은 골든 ㉛ 가 적는다.
struct in3 do
  a u8 .
  b u32 .
  c u8 .
end .
struct r do
  h u16 .
  x f64 .
  y f32 .
  n in3 .
  t bool .
end .
export fn f input xb u64 . input yb u32 . output u64 . do
  let b slice u8 encode_canonical r lit r do h 513 . x bit_cast f64 xb. . . y bit_cast f32 yb. . . n lit in3 do a 1 . b 2 . c 3 . end . . t true . end . . .
  var acc u64 cast u64 len b. . . .
  for z b. do set acc. wrap_add wrap_mul acc. 257 . widen u64 z. . . . end .
  return acc. .
end .
