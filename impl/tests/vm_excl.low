rem V1 dynamic-EXCL fixture — two_mut: static E-EXCL ∧ dynamic E-VM-EXCL twin.
rem owner_read: with liveness-v2 statics BOTH ops are rejected statically AND
rem trapped dynamically — full static≡dynamic twins (v2 closed the lexical gap).
fn two_mut
  output u64 .
do
  var x u64 0 .
  var a mut_ref u64 mut_ref x .
  var b mut_ref u64 mut_ref x .
  set a 1 .
  set b 2 .
  return x .
end

fn owner_read
  output u64 .
do
  var x u64 7 .
  var r mut_ref u64 mut_ref x .
  let y u64 x .
  set r 5 .
  return x .
end
