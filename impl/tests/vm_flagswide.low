rem ★★★ **64 자리를 넘는 설정** — 정수 하나에서 바이트 배열로 (RFC-0107 §7.6 단계 5 · D2 나).
rem
rem   경계가 요점이다: 64 까지는 정수 하나(`flags.has`)고, 그 위는 배열(`flags.wide_has`)이다.
rem   **두 구현을 한 이름 뒤에 숨기지 않는다** — 이름이 다르고, 명령 수 차이를 매뉴얼이 적는다.
rem
rem 증인 넷:
rem   ① 배열 판이 «켜고 · 묻고 · 끄고 · 뒤집는» 일을 손으로 쓴 바이트 연산과 같이 한다.
rem   ② 범위 밖은 **값으로** 답한다(없는 자리는 서 있지 않고, 쓰기는 «안 했다»=0 이다).
rem   ③ 선 자리 훑기(`wide_next`)가 빈 바이트를 통째로 건너뛴다.
rem   ④ 64 번과 65 번 자리가 **다른 바이트**에 산다 — 경계가 진짜 경계다.
module vm_flagswide .

use flags from "../../lib/flags.low" .

rem ★ 저장은 **부르는 쪽의 것**이다(RFC-0075 의 caller-backed). 라이브러리는 얼로케이터를
rem   모르고, 이 픽스처도 모른다 — 32 바이트(=256 자리)를 골든이 넘겨준다.
proc wide_roundtrip input buf mut slice u8 . output u64 . effects none . do
  guard eq (flags.wide_bits buf) 256 . else return 90 .

  rem ① 켜고 묻기 — 64·65·255 는 서로 다른 바이트다
  guard eq (flags.wide_with buf 64) 1 . else return 91 .
  guard eq (flags.wide_with buf 65) 1 . else return 91 .
  guard eq (flags.wide_with buf 255) 1 . else return 91 .
  guard flags.wide_has buf 64 . else return 92 .
  guard flags.wide_has buf 65 . else return 92 .
  guard flags.wide_has buf 255 . else return 92 .
  guard not (flags.wide_has buf 63) . else return 92 .

  rem 손으로 본 것과 같은가 — 64 번 자리는 8 번 바이트의 0 번 비트다
  guard eq (widen u64 (idx buf 8)) 3 . else return 93 .        rem 64·65 → 0b11
  guard eq (widen u64 (idx buf 31)) 128 . else return 93 .     rem 255 → 맨 위 비트

  rem ② 범위 밖은 값으로
  guard not (flags.wide_has buf 256) . else return 94 .
  guard eq (flags.wide_with buf 256) 0 . else return 94 .

  rem ③ 훑기 — 처음 선 자리는 64, 그다음은 65, 그다음은 255, 그다음은 «끝»(256)
  guard eq (flags.wide_next buf 0) 64 . else return 95 .
  guard eq (flags.wide_next buf 65) 65 . else return 95 .
  guard eq (flags.wide_next buf 66) 255 . else return 95 .
  guard eq (flags.wide_next buf 256) 256 . else return 95 .
  guard eq (flags.wide_ones buf) 3 . else return 96 .

  rem 끄고 뒤집기
  guard eq (flags.wide_without buf 64) 1 . else return 97 .
  guard not (flags.wide_has buf 64) . else return 97 .
  guard eq (flags.wide_toggle buf 64) 1 . else return 97 .
  guard flags.wide_has buf 64 . else return 97 .
  guard eq (flags.wide_ones buf) 3 . else return 97 .

  return 42 .
end

rem ④ 경계의 두 판 — 골든이 이 짝의 **명령 수**를 세어 문서의 수와 견준다.
fn narrow_has input s u64 . output bool . do return flags.has s 63 . end
fn wide_has1  input s slice u8 . output bool . do return flags.wide_has s 64 . end

rem ★ `test` 블록은 인자를 못 준다 — 이 증인은 골든이 32 바이트를 넘겨 부른다(§증인 ①~③).
rem   여기 남기는 시험은 **인자 없는 것**뿐이다.
rem ★ 소스에서 바이트 열을 적는 방법은 **문자열 리터럴**이다(`[…]` 는 명령줄 인자의 문법이지
rem   소스의 문법이 아니다 — 이 픽스처를 쓰다 배웠다). `\x00` 은 0 바이트다.
fn four_zero output slice u8 . do return "\x00\x00\x00\x00" . end
fn one_at_18 output slice u8 . do return "\x00\x00\x04\x00" . end   rem 18 번 자리
fn nine_ones output slice u8 . do return "\xff\x01\x00\x00" . end

test wide_flags do
  expect eq (flags.wide_bits (four_zero)) 32 .
  expect eq (flags.wide_next (one_at_18) 0) 18 .
  expect eq (flags.wide_next (four_zero) 0) 32 .
  expect eq (flags.wide_ones (nine_ones)) 9 .
  expect eq (flags.wide_has (one_at_18) 18) true .
  expect eq (flags.wide_has (one_at_18) 19) false .
  expect eq (flags.wide_has (one_at_18) 99) false .
end
