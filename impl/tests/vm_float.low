rem float core fixture — literals, IEEE arith (div0 → inf), compare, cast (G2).
fn favg .
  output f64 .
  input a u64 .
  input b u64 .
do
  return expr ((cast f64 a) + (cast f64 b)) / 2.0 .
end .

fn fcmp output bool . do return lt 1.5 2.25 . end .
fn fdiv0 output f64 . do return expr 1.0 / 0.0 . . end .
fn ftrunc output u64 . do return cast u32 7.9 . end .
fn fmixed output f64 . do return expr 1.5 + 2.25 . . end .
