rem float struct fields (f32/f64 layout, be) + float SIMD lanes (RFC-0040 f32).
def type bytes slice u8 .

def struct sample do
  layout packed .
  temp f32 big .
  scale f64 .
  tag u8 .
end

fn mk_sample
  output sample .
do
  return lit sample do
    temp 1.5 .
    scale 2.25 .
    tag 3 .
  end .
end

fn f_roundtrip
  output f64 .
do
  let h be sample view sample encode sample mk_sample .
  return expr ((field h temp)) + ((field h scale)) .
end

fn f_len output u64 . do return len encode sample mk_sample . end

fn fdot
  input b bytes .
  output f64 .
do
  let xs be slice f32 view_array f32 b .
  let va be vec f32 4 load xs 0 .
  let vb be vec f32 4 load xs 4 .
  return reduce_add mul va vb .
end

fn fmax
  input b bytes .
  output f64 .
do
  let xs be slice f32 view_array f32 b .
  let v be vec f32 4 load xs 0 .
  return reduce_max v .
end
