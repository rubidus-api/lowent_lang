rem float struct fields (f32/f64 layout, be) + float SIMD lanes (RFC-0040 f32).
type bytes slice u8 . .

struct sample .
  layout packed .
  temp f32 big .
  scale f64 .
  tag u8 .
end .

fn mk_sample .
  output sample .
do
  return make sample do
    temp 1.5 .
    scale 2.25 .
    tag 3 .
  end .
end .

fn f_roundtrip .
  output f64 .
do
  var h sample . be view sample encode sample mk_sample . .
  return expr ((field h temp)) + ((field h scale)) . .
end .

fn f_len output u64 . do return len encode sample mk_sample . . end .

fn fdot .
  input b bytes .
  output f64 .
do
  var xs slice f32 . be view_array f32 b .
  var va vec f32 4 . be load xs 0 .
  var vb vec f32 4 . be load xs 4 .
  return reduce_add mul va vb .
end .

fn fmax .
  input b bytes .
  output f64 .
do
  var xs slice f32 . be view_array f32 b .
  var v vec f32 4 . be load xs 0 .
  return reduce_max v .
end .
