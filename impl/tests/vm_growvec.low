rem ★★★ **자가성장 컨테이너 검증** (RFC-0075 §2.2 한계 해소 · lib/growvec.low).
rem   `vecs` 는 부를 때마다 얼로케이터·버퍼를 받는다. 여기서는 컨테이너가 **셋을 한 값에** 들고
rem   스스로 자란다 — 그래도 얼로케이터는 누가 넣어 준 것이고, 만드는 데는 `cap allocator` 가 든다.

module vm_growvec .

use growvec .
use allocs .

rem 용량 2 로 열고 8개를 민다 — 자라야 통과한다. 내용도 살아남아야 한다.
proc grows input al cap allocator . output u64 . effects state alloc . do
  let memo option mut slice u8 alloc_bytes al. capacity 512 . .
  guard is_some memo. . else return 89 . .
  var bump allocs.bump_bytes spawn actor allocs.bump_bytes . .
  let c u64 send bump. init some_value memo. . . .
  let go use bump. option growvec.gvec growvec.open 2 . .
  guard is_some go. . else return 1 . .
  var g growvec.gvec some_value go. . .
  guard eq growvec.cap_of g. . 2 . else return 2 . .
  var i u64 0 .
  while lt i. 8 . do
    let okv bool growvec.add_byte g. narrow u8 add 65 i. . . . .
    guard okv. else return add 10 i. . . .
    set i. add i. 1 . .
  end .
  guard eq growvec.count_of g. . 8 . else return 3 . .
  rem ★ 자랐다: 용량이 처음의 2 보다 커야 한다.
  guard gt growvec.cap_of g. . 2 . else return 4 . .
  rem ★ 옮기면서 내용을 잃지 않았다: 'A'(65) … 'H'(72).
  let v slice u8 growvec.view_of g. . .
  guard eq len v. . 8 . else return 5 . .
  guard eq idx v. 0 . 65 . else return 6 . .
  guard eq idx v. 7 . 72 . else return 7 . .
  return 42 .
end .

rem 바이트열 통째로 밀기 · 미리 확보하기.
proc bulk input al cap allocator . output u64 . effects state alloc . do
  let memo option mut slice u8 alloc_bytes al. capacity 512 . .
  guard is_some memo. . else return 89 . .
  var bump allocs.bump_bytes spawn actor allocs.bump_bytes . .
  let c u64 send bump. init some_value memo. . . .
  let go use bump. option growvec.gvec growvec.open 1 . .
  guard is_some go. . else return 1 . .
  var g growvec.gvec some_value go. . .
  rem 미리 확보하면 도중에 안 죽는다("전량 아니면 무" 를 원하면 이 순서다).
  let r bool growvec.reserve_more g. 16 . .
  guard r. else return 2 . .
  let okv bool growvec.add_all g. "hello" . .
  guard okv. else return 3 . .
  let ok2 bool growvec.add_all g. " world" . .
  guard ok2. else return 4 . .
  guard eq growvec.count_of g. . 11 . else return 5 . .
  let v slice u8 growvec.view_of g. . .
  guard eq idx v. 0 . 104 . else return 6 . .
  guard eq idx v. 10 . 100 . else return 7 . .
  return 42 .
end .

rem ★ cap 은 CLI 인자로 못 넘긴다 — 엔트리가 받아서 넘긴다(vecgrow 와 같은 꼴).
proc main input al cap allocator . output u8 . effects state alloc . do
  let a u64 grows al. . .
  guard eq a. 42 . else return narrow u8 a. . . .
  let b u64 bulk al. . .
  guard eq b. 42 . else return narrow u8 b. . . .
  return 42 .
end .
