rem ★★★ **라이브러리 보안 검토의 증인 — 메모리·컨테이너 열한 모듈** (2026-09-04).
rem
rem   고친 자리마다 op 하나다. 각 op 은 **고친 행동이면 작은 수**(1·2·3…)를, 틀리면 **90 대**를 답한다.
rem   옛 코드에서는 이들 대부분이 값이 아니라 **트랩**이었다(E-VM-BOUNDS · E-VM-OVERFLOW · E-VM-SHIFT) —
rem   그래서 "값이 나온다" 자체가 증인이다. 라이브러리 규율(정본 §9.2): **실패는 값이다, 호출자 입력에
rem   트랩하지 않는다, 조용히 자르거나 바꾸지 않는다.**
rem
rem   cap 이 필요한 넷(vecgen · mapgen · lifeatom · 개수 산술)은 `main` 이 받아서 넘긴다(vm_vecgen 과 같은 꼴).

module vm_libreview_mem .

use strbuf    from "../../lib/strbuf.low" .
use budget    from "../../lib/budget.low" .
use nodelist  from "../../lib/nodelist.low" .
use soa       from "../../lib/soa.low" .
use pool      from "../../lib/pool.low" .
use mapgen    from "../../lib/mapgen.low" .
use hashmap   from "../../lib/hashmap.low" .
use allocs    from "../../lib/alloc.low" .
use vecgen    from "../../lib/vecgen.low" .
use pagecache from "../../lib/pagecache.low" .
use segarena  from "../../lib/segarena.low" .
use lifeatom  from "../../lib/lifeatom.low" .
use lifemode  from "../../lib/lifemode.low" .

newtype pf u8 .
newtype pc u8 .
newtype sg u8 .

rem ── strbuf: 빈 버퍼 · 꽉 찬 str_buf 에서 `append_trunc`/`room` 은 0 이다 (전에는 밑으로 감겨 경계 밖 쓰기) ──
proc t_sb output u64 . input buf mut slice u8 . . effects none . do
  guard ge (len buf) 4 . else return 90 .
  var b strbuf.str_buf be strbuf.new .
  let n0 u64 be strbuf.append_trunc b (subslice buf 0 0) "abc" .
  guard eq n0 0 . else return 91 .
  guard eq (field b len) 0 . else return 92 .
  guard eq (strbuf.room b (subslice buf 0 0)) 0 . else return 93 .
  rem 낡은 str_buf(len 3)를 3 바이트 버퍼에 댄다 — 자리 0, 한 바이트도 안 쓴다
  let r result void strbuf.sb_error . be strbuf.append b (subslice buf 0 4) "abc" .
  guard is_ok r . else return 94 .
  guard eq (strbuf.room b (subslice buf 0 3)) 0 . else return 95 .
  let n1 u64 be strbuf.append_trunc b (subslice buf 0 3) "x" .
  guard eq n1 0 . else return 96 .
  guard eq (field b len) 3 . else return 97 .
  rem 정상 경로는 그대로다: 4 바이트 버퍼(내용 3 + 널)에 len 3 → 자리 0, 봉인은 산다
  guard eq (strbuf.room b (subslice buf 0 4)) 0 . else return 98 .
  guard eq (index buf 3) 0 . else return 99 .
  return 1 .
end .

rem ── budget: gen_bits = 64(slot 0 · shard 0)는 계약을 통과하는 구성이다 — `shl 1 64` 트랩이 아니라 값 ──
proc t_budget output u64 . effects none . do
  let a option u64 . be budget.pack 0 0 64 0 0 5 .
  guard is_some a . else return 91 .
  guard eq (some_value a) 5 . else return 92 .
  let big u64 be bit_not 0 .
  let b option u64 . be budget.pack 0 0 64 0 0 big .
  guard is_some b . else return 93 .
  guard eq (some_value b) big . else return 94 .
  rem 좁은 칸은 여전히 값으로 거절한다
  let c option u64 . be budget.pack 0 0 4 0 0 16 .
  guard eq (is_some c) false . else return 95 .
  return 2 .
end .

rem ── nodelist: 머리를 자르며 돌아도 셈은 고리의 크기다 (전에는 len nx + 1) ──
proc t_nl output u64 . input nx mut slice u64 . . input pv mut slice u64 . . effects none . do
  guard ge (len nx) 8 . else return 90 .
  guard nodelist.nl_solo nx pv 0 . else return 91 .
  guard nodelist.nl_after nx pv 0 1 . else return 92 .
  guard nodelist.nl_after nx pv 1 2 . else return 93 .
  guard nodelist.nl_after nx pv 2 3 . else return 94 .
  guard eq (nodelist.nl_count nx 0) 4 . else return 95 .
  rem ★ 머리(0)를 자르며 돈다 — 넷을 훑고 셋이 남는다
  guard eq (nodelist.nl_walk_cut nx pv 0 0) 4 . else return 96 .
  guard eq (nodelist.nl_count nx 1) 3 . else return 97 .
  guard eq (index nx 0) 0 . else return 98 .
  rem 혼자인 머리를 자르면 1
  guard nodelist.nl_solo nx pv 5 . else return 81 .
  guard eq (nodelist.nl_walk_cut nx pv 5 5) 1 . else return 82 .
  rem 머리가 아닌 노드를 자르는 옛 길은 그대로다 — 셋을 훑고 둘이 남는다
  guard eq (nodelist.nl_walk_cut nx pv 1 2) 3 . else return 83 .
  guard eq (nodelist.nl_count nx 1) 2 . else return 84 .
  return 3 .
end .

rem ── soa: `xoff > voff` 인 기하에서 경계 밖 대신 멈춘 자리 i 를 답한다 ──
proc t_soa output u64 . input rows mut slice u64 . . effects none . do
  guard eq (len rows) 3 . else return 90 .
  set (index rows 0) 1 .
  set (index rows 1) 10 .
  set (index rows 2) 2 .
  rem 보폭 2 · xoff 1 · voff 0: 둘째 줄의 x 자리(3)가 경계 밖 — 1 에서 멈춘다
  guard eq (soa.step_x_aos rows 2 1 0 2) 1 . else return 91 .
  guard eq (index rows 1) 11 . else return 92 .        rem 첫 줄은 처리됐다: x(10) += v(1)
  return 4 .
end .

rem ── pool: 지어 낸 핸들 — 부풀린 len 은 풀의 블록 크기로 잘리고, 안 나간 블록은 거절된다 ──
proc t_pool output u64 . input mem mut slice u8 . . input gens mut slice u64 . . effects none . do
  let po option (pool.block_pool pf) . be pool.init pf mem gens 16 .
  guard is_some po . else return 89 .
  var p pool.block_pool pf . be some_value po .
  guard ge (pool.blocks pf p) 4 . else return 90 .
  let h0 option (pool.handle pf) . be pool.take pf p .
  guard is_some h0 . else return 91 .
  rem ① 뷰의 길이는 풀이 아는 블록 크기(16)다 — 핸들의 `len` 칸은 더 이상 읽지 않는다.
  rem   (그 칸을 Lowent 소스에서 고쳐 쓰는 길은 없다 — `len` 은 빌트인 이름이라 `field`/`make` 가 거절한다.
  rem    그래도 뷰 길이를 호출자 값에 걸어 두지 않는 것이 옳다: 봉인은 풀의 수로 한다.)
  let real pool.handle pf . be some_value h0 .
  let bv option mut slice u8 . . be pool.bytes pf p real .
  guard is_some bv . else return 92 .
  guard eq (len (some_value bv)) 16 . else return 93 .
  rem ② 한 번도 안 나간 블록(세대 1 그대로)의 핸들 — 놓기·닿기·살았나 전부 거절
  var ghost pool.handle pf . be some_value h0 .
  set (field ghost blk) 1 .
  guard eq (pool.release pf p ghost) false . else return 94 .
  let gb option mut slice u8 . . be pool.bytes pf p ghost .
  guard eq (is_some gb) false . else return 95 .
  guard eq (pool.alive pf p ghost) false . else return 96 .
  rem ③ 그래서 블록 1 은 한 번만 나간다(전에는 자유 목록과 순차 커서가 같은 블록을 두 번 냈다)
  let h1 option (pool.handle pf) . be pool.take pf p .
  guard is_some h1 . else return 97 .
  guard eq (field (some_value h1) blk) 1 . else return 98 .
  let h2 option (pool.handle pf) . be pool.take pf p .
  guard is_some h2 . else return 99 .
  guard eq (field (some_value h2) blk) 2 . else return 80 .
  guard eq (pool.outstanding pf p) 3 . else return 81 .
  guard eq (pool.alive pf p real) true . else return 82 .
  return 5 .
end .

rem ── hashmap: 빈칸의 `key_at` 은 0 이다 (전에는 `sub 0 1`) ──
proc t_hm output u64 . input b mut slice u64 . . effects none . do
  guard ge (len b) 8 . else return 90 .
  var i u64 be 0 .
  while lt i (len b) . do
    set (index b i) 0 .
    set i (add i 1) .
  end .
  guard eq (hashmap.key_at b 0) 0 . else return 91 .
  guard eq (hashmap.occupied_at b 0) false . else return 92 .
  guard eq (hashmap.put b 10 100) true . else return 93 .
  var slot u64 be 0 .
  var total u64 be 0 .
  while lt slot (hashmap.size b) . do
    if hashmap.occupied_at b slot . do
      set total (add total (hashmap.key_at b slot)) .
    end .
    set slot (add slot 1) .
  end .
  guard eq total 10 . else return 94 .
  return 7 .
end .

rem ── alloc: 큰 n 의 `reserve`/`grow` 는 none 이다 (전에는 `add off n` 이 넘쳐 트랩) ──
proc t_alloc output u64 . input buf mut slice u8 . . effects state . do
  guard ge (len buf) 16 . else return 90 .
  var a allocs.bump_bytes be spawn actor allocs.bump_bytes . .
  let c u64 be send a init buf .
  let big u64 be bit_not 0 .
  let r0 option mut slice u8 . . be send a reserve big .
  guard eq (is_some r0) false . else return 91 .
  let r1 option mut slice u8 . . be send a reserve 4 .
  guard is_some r1 . else return 92 .
  let r1v mut slice u8 . be some_value r1 .
  let g0 option mut slice u8 . . be send a grow r1v big .
  guard eq (is_some g0) false . else return 93 .
  rem ★ RFC-0112 D10 — 길이만 같은 **남의** 조각(버퍼의 다른 네 바이트)은 늘려 주지 않는다(F13 의 증인)
  let g1 option mut slice u8 . . be send a grow (subslice buf 8 12) 8 .
  guard eq (is_some g1) false . else return 94 .
  let g2 option mut slice u8 . . be send a grow r1v 8 .
  guard is_some g2 . else return 95 .
  guard eq (send a used) 8 . else return 96 .
  rem 정렬판: 패딩이 끝을 넘는 자리에서도 값이다
  var al allocs.bump_aligned be spawn actor allocs.bump_aligned . .
  let c2 u64 be send al init (subslice buf 0 3) .
  let q0 option mut slice u8 . . be send al reserve 3 .
  guard is_some q0 . else return 97 .
  let q1 option mut slice u8 . . be send al reserve 1 .       rem at = 8 > 3
  guard eq (is_some q1) false . else return 98 .
  let q2 option mut slice u8 . . be send al reserve big .
  guard eq (is_some q2) false . else return 99 .
  let q0v mut slice u8 . be some_value q0 .
  let q3 option mut slice u8 . . be send al grow q0v big .
  guard eq (is_some q3) false . else return 80 .
  return 8 .
end .

rem ── pagecache: 2^64 근처의 id 도 `slot_of` 가 값으로 답한다 (전에는 `add id epoch` 가 넘쳐 트랩) ──
proc t_page output u64 . effects none . do
  var c owned pagecache.cache pc . be pagecache.open pc 16 .
  var c2 owned pagecache.cache pc . be pagecache.evict pc c .
  let big u64 be bit_not 0 .
  let s option u64 . be pagecache.slot_of pc c2 big .        rem (2^64−1 + 1) mod 16 = 0
  guard is_some s . else return 91 .
  guard eq (some_value s) 0 . else return 92 .
  let t option u64 . be pagecache.slot_of pc c2 41 .         rem (41 + 1) mod 16 = 10
  guard is_some t . else return 93 .
  guard eq (some_value t) 10 . else return 94 .
  return 10 .
end .

rem ── segarena: 큰 s 의 `sum_global` 은 0 이다 (전에는 `mul s width` 가 넘쳐 트랩) ──
proc t_seg output u64 . input dir mut slice u64 . . input mem slice u64 . . effects none . do
  var a segarena.arena sg . be segarena.open sg 2 .
  let b0 option u64 . be segarena.grow sg a dir 32 .
  guard is_some b0 . else return 91 .
  let big u64 be bit_not 0 .
  guard eq (segarena.sum_global sg a dir mem big) 0 . else return 92 .
  guard eq (segarena.sum_global sg a dir mem 1) 0 . else return 93 .
  guard eq (segarena.sum_global sg a dir mem 0) (segarena.sum_seg sg a dir mem 0) . else return 94 .
  return 11 .
end .
