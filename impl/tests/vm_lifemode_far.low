rem ★ 짝 — 같은 일을 **원자 모드**로 한다 (RFC-0104 §8-9).
rem   이쪽 바이너리에는 `lock` 접두 명령이 **있어야** 한다. 없으면 원자가 원자가 아니다.

module vm_lifemode_far .

use lifemode .
use lifeatom .
use allocs .

proc main input al cap allocator . input k cap atomic . output u8 . effects alloc atomic . do
  let mb option mut slice u8 . . be alloc_bytes al capacity 32 .
  guard is_some mb . else return 89 .
  var c mut slice u64 . be view_array u64 (some_value mb) .
  guard eq (lifeatom.rc_open k c) 1 . else return 1 .
  guard eq (lifeatom.rc_share k c) 2 . else return 2 .
  guard eq (lifeatom.rc_release k c) 1 . else return 3 .
  return 42 .
end
