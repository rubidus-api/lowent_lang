module vm_litalloc .
rem ★★ RFC-0132 §13.7 — 고른 할당자에서 받는 나열 `var bo using al be option lit array T N … .`: 받으면 본으로 채워 `some`,
rem   못 받으면 `none`. 뒤받침이 틀 안 배열인 범프 할당자 · 힙. VM 과 네이티브가 같은 답인가를 잰다.
use allocs .

fn sum input s slice u64 . output u64 . do
  var t u64 0 .
  for x s. do
    set t. add t. x. . .
  end .
  return t. .
end .

export proc heap_list input h cap heap . input a u64 . output u64 . effects heap state . do
  var hb allocs.heap_bytes spawn actor allocs.heap_bytes . .
  var b use hb. mut slice u64 lit array u64 8 do 0 a. . 7 mul a. 3 . . _ 1 . end . else return 0 . .
  set idx b. 1 . 100 .
  return sum b. . .
end .

export proc bump_list input a u64 . output u64 . effects state . do
  var back lit array u8 64 _ . .
  var bb allocs.bump_bytes spawn actor allocs.bump_bytes . .
  let got u64 send bb. init back. . .
  let s1 use bb. mut slice u32 lit array u32 4 1 2 3 narrow u32 a. . . else return 1 . .
  let s2 use bb. mut slice u64 lit slice u64 5 6 . else return 2 . .
  let x3 use bb. option mut slice u64 lit array u64 8 _ . .
  guard is_none x3. . else return 3 . .
  return add add widen u64 idx s1. 3 . . idx s2. 1 . . len s2. . . .
end .
