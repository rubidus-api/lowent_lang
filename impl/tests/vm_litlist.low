rem ★★ RFC-0132 T2b-1 — 상수 원소 나열 리터럴(§13.2 ⓑ): `lit array T N v… [_] .` · `lit slice T v… .`.
rem   원소는 T 의 폭으로 작은 끝에 싸여 읽기 전용 자리에 놓인다(문자열 리터럴과 같은 상수 풀). 차등 훑기가
rem   VM 과 네이티브가 같은 답을 내는지 잰다 — 부호 있는 원소 · 64 비트 끝값 · 부동 · `_` 채움 · 한가운데 자리.
module vm_litlist .

fn sum32 input xs slice u32 . output u64 . do
  var s be u64 0 .
  for x xs do
    set s (add s (widen u64 x)) .
  end
  return s .
end

fn pick16 input xs slice i16 . input i u64 . output i64 . do
  guard lt i (len xs) . else return 0 .
  return widen i64 (index xs i) .
end

rem 배열 리터럴을 `let` 에 묶는다 — 선언 타입은 리터럴이 보인다(`lit` 뒤의 타입).
export fn lit_sum output u64 . do
  let t be lit array u32 4 10 20 30 40 . .
  return sum32 t .
end

rem 슬라이스 리터럴을 인자로 — 길이는 원소 수다.
export fn lit_arg output u64 . do
  return sum32 lit slice u32 1 2 3 . .
end

rem 한가운데 자리: 나열은 제 점으로 닫히고 다음 인자 `i` 가 이어진다. 부호 있는 원소.
export fn lit_mid input i u64 . output i64 . do
  return pick16 lit array i16 3 -5 7 -9 . i .
end

rem 끝의 `_` = 나머지 칸은 0.
export fn lit_fill input i u64 . output u64 . do
  let z be lit array u8 6 1 2 _ . .
  guard lt i (len z) . else return 99 .
  return widen u64 (index z i) .
end

rem 64 비트 끝값.
export fn lit_u64max input i u64 . output u64 . do
  let t be lit array u64 2 18446744073709551615 3 . .
  guard lt i (len t) . else return 0 .
  return index t i .
end

rem 부동 원소.
export fn lit_f64 input i u64 . output f64 . do
  let t be lit array f64 3 1.5 2.25 -3.0 . .
  guard lt i (len t) . else return 0.0 .
  return index t i .
end
