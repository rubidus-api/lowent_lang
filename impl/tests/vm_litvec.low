module vm_litvec .
rem ★★ RFC-0132 T2b-3 — SIMD 값 리터럴 `lit vec N T v… [_] .`: 상수(읽기 전용 줄에서 레인을 싣는다) · 실행 중 원소 ·
rem   부호 · 부동 · 묶는 자리의 `vec N T` 과 정확히 맞는가. VM 과 네이티브가 같은 답인가를 잰다.

export fn v_sum input a u32 . output u64 . do
  let v lit vec 4 u32 1 2 a. 4 . .
  let w vec 4 u32 splat 10 . .
  let s vec 4 u32 add v. w. . .
  return widen u64 reduce_add s. . . .
end .

export fn v_const input i u64 . output u64 . do
  let v lit vec 4 u32 10 20 _ . .
  let w vec 4 u32 lit vec 4 u32 1 1 1 1 . .
  return widen u64 reduce_max add v. w. . . . .
end .

export fn v_signed output i64 . do
  let v lit vec 8 i16 -1 -2 -3 -4 _ . .
  return widen i64 reduce_min v. . . .
end .

export fn v_float input x f64 . output f64 . do
  let v lit vec 2 f64 x. 1.5 . .
  return reduce_add v. . .
end .
