module vm_localop .
rem ★★ RFC-0121 P3·P4 — 캡처 없는 **로컬 op**: op 의 몸 바로 아래에 적은 `fn`/`proc` 은 그 op 안에서만 보이는 보통 op 이다.
rem   바깥의 인자·지역을 몰래 읽지 않는다(값은 인자로 건넨다). 선언 앞에서 불러도 되고, 형제끼리 서로 부르고 되돌아 불러도 된다.
rem   다른 바깥 op 은 같은 로컬 이름을 따로 쓴다. `pipe` 의 단계 op 과 `with` 문맥이 함께 선다(RFC-0121 §6.7 의 예).
export fn count_selected input xs slice u8 . input mask u8 . output u64 .
do
  fn has_bits input x u8 . input bits u8 . output bool .
  do
    return eq (bit_and x bits) bits .
  end
  return pipe xs do
    filter has_bits with mask .
    count .
  end .
end

export fn parity input n u64 . output u64 .
do
  let r u64 twice (is_even n) .
  fn is_even input k u64 . output u64 .
  do
    if eq k 0 do
      return 1 .
    end
    return is_odd (sub k 1) .
  end
  fn is_odd input k u64 . output u64 .
  do
    if eq k 0 do
      return 0 .
    end
    return is_even (sub k 1) .
  end
  fn twice input v u64 . output u64 .
  do
    return add v v .
  end
  return r .
end

export fn other output u64 .
do
  fn twice input v u64 . output u64 .
  do
    return mul v 3 .
  end
  return twice 5 .
end

actor counter do
  state do
    n u64 .
  end
  proc bump input by u64 . output u64 . effects state . do
    fn double input v u64 . output u64 . do
      return add v v .
    end
    set n (add n (double by)) .
    return n .
  end
end

export proc go output u64 . effects state . do
  var c counter spawn actor counter .
  let a u64 send c bump 2 .
  return send c bump 3 .
end
