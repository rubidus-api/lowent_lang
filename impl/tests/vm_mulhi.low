rem RFC-0151 Q1 ⓐ — 곱의 윗말. 부호 없는 64×64 비트 곱의 위쪽 64 비트(아래쪽은 `wrap_mul`).
rem 경계값은 안에서 만든다 — 2^63 이상은 명령줄의 `u64` 인자로 넘길 수 없다(경계 계약).
module mulhi .
use bigint64 from "../../lib/bigint64.low" .
fn hi_max output u64 . do
  let m u64 bit_not 0 . .
  return call_builtin mul_hi m. m. . .
end .
fn hi_two output u64 . do
  let m u64 bit_not 0 . .
  return call_builtin mul_hi m. 2 . .
end .
fn hi_word output u64 . do
  return call_builtin mul_hi 4294967296 4294967296 . .
end .
fn hi_of input a u64 . input b u64 . output u64 . do
  return bigint64.mul_hi a. b. . .
end .
