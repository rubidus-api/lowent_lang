rem ★★ **소유 칸 안의 소유 칸** (2026-11-02 · W-20261102-0024 O4) — `pagecache.pin2` 의 모양: 바깥 구조체가 안쪽 구조체를 소유하고, 안쪽이
rem   다시 셋째 구조체를 소유한다. VM 은 `make` 때 안쪽 값을 베끼고, 빠른 경로는 안쪽 레코드의 소유 칸 자리를 평행 칸으로 함께 나른다.
rem   아래 op 들이 세 겹을 짓고 · 바깥에서 안쪽을 꺼내 그 안의 수를 읽고 · 태그 경로에 남는 op 이 빠른 op 에 넘기고 돌려받는다.
rem   차등 스윕이 VM 과 네이티브를 견준다.

module vm_ownown .

struct tok do
  pages u64 .
  epoch u64 .
end .

struct pin do
  id u64 .
  held owned tok .
end .

struct pin2 do
  id u64 .
  under owned pin .
end .

fn mk1 input t owned tok . input id u64 . output pin . do
  return lit pin do id id. . held t. . end . .
end .

fn mk2 input p owned pin . input id u64 . output pin2 . do
  return lit pin2 do id id. . under p. . end . .
end .

fn back input q owned pin2 . output u64 . do
  let qid u64 field q. id . .
  var u pin field q. under . .
  let uid u64 field u. id . .
  let h tok field u. held . .
  return add add mul field h. pages . 1000 . field h. epoch . . add mul uid. 100 . qid. . . .
end .

export fn three input a u64 . output u64 . do
  var t tok lit tok do pages a. . epoch 7 . end . .
  var p pin mk1 t. 3 . .
  var q pin2 mk2 p. 5 . .
  return back q. . .
end .

rem 태그 경로에 남는 op(128 비트 지역)이 빠른 op 셋을 부른다 — 소유 칸 자리가 경계를 두 번 건넌다
export fn crossing input a u64 . output u64 . do
  let big u128 widen u128 1 . .
  var t tok lit tok do pages a. . epoch 2 . end . .
  var p pin mk1 t. 4 . .
  var q pin2 mk2 p. 6 . .
  return add back q. . cast u64 big. . . .
end .
