rem ★★★ **PEM 봉투와 PKCS#8 키 파싱** — `lib/pem.low` + `lib/der.low` 의 골든.
rem
rem   목표가 공개 웹 HTTPS 서버가 되면서 생긴 자리다: 인증서는 **밖에서 받고**(certbot),
rem   서버가 할 일은 **그 파일을 읽는 것**이다. ACME 는 안 짓는다.
rem
rem ★★★★★ **개인키를 저장소에 넣지 않는다.** 처음엔 openssl 이 낸 진짜 키를 벡터로 박았고
rem   `check-docs` 가 그것을 **키 패턴으로 잡았다** — 게이트가 옳았다. 시험용이든 아니든
rem   저장소에 붙여넣을 수 있는 개인키를 두지 않는 것이 이 저장소의 규칙이다.
rem   ⇒ 벡터의 **스칼라를 합성값 `01 02 … 20` 으로 바꿨다.** 구조는 openssl 이 낸 그대로이고,
rem     `openssl asn1parse` 가 그 DER 을 여전히 읽으며 스칼라가 **자리 36** 임을 말한다.
rem     ☞ 그리고 이 편이 **더 나은 벡터**다: 명백히 비밀이 아니므로 오해할 여지가 없다.
rem   ☞ PEM 쪽 벡터는 **인증서**(공개)를 쓴다 — 봉투 벗기기를 재는 데는 그것으로 족하다.

module vm_pem .
use pem from "../../lib/pem.low" .
use der from "../../lib/der.low" .

rem 정답(openssl 대조):
rem   CERTIFICATE → DER 375 바이트 · PKCS#8 스칼라 자리 36 · 길이 32 · 값 01 02 03 04 …

export proc der_len_cert input sc mut slice u8 . input out mut slice u8 . output u64 . effects none . do
  let d_r be result (option u64) pem.pem_error pem.unwrap "-----BEGIN CERTIFICATE-----\nMIIBczCCARmgAwIBAgIUX6WueNvc/EadMquZRpJ1A2RVHskwCgYIKoZIzj0EAwIw\nDzENMAsGA1UEAwwEdGVzdDAeFw0yNjA4MjEwODEwMTRaFw0yNjA4MjIwODEwMTRa\nMA8xDTALBgNVBAMMBHRlc3QwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAATnCveE\nEuf+Ru42Zbqdd07/2LXyz4D8O/Uc8oTYlWuLMMXtOqD+Nmv2Al3KxC8t7sFqFC5J\nzB99M2gcV1hSh4Q9o1MwUTAdBgNVHQ4EFgQUCcDDbPSKfzGMLzxuhZIqMpQ6S78w\nHwYDVR0jBBgwFoAUCcDDbPSKfzGMLzxuhZIqMpQ6S78wDwYDVR0TAQH/BAUwAwEB\n/zAKBggqhkjOPQQDAgNIADBFAiEA1fF1CX7llQYCzs/3BojBzHRHUC7/B6HVxYlW\nV5VKuQ0CIAl3oXevj8n54P0rrWT3aUiRIXWMw8PLf9drZaSwJUdK\n-----END CERTIFICATE-----" "CERTIFICATE" sc out .
  guard is_ok d_r . else return 0 .
  let d be option u64 ok_value d_r .
  guard is_some d . else return 0 .
  return some_value d .
end

rem ✔ PKCS#8 안의 스칼라 — **자리**를 낸다(openssl asn1parse 가 36 이라 했다).
export fn priv_at input b slice u8 . output u64 . do
  let inner be u64 der.p8_inner_off b .
  if eq inner 0 . do return 0 . end
  return der.ec_priv_off b inner .
end

rem ✔ 그 길이 — P-256 이면 32 다.
export fn priv_size input b slice u8 . output u64 . do
  let inner be u64 der.p8_inner_off b .
  if eq inner 0 . do return 0 . end
  return der.ec_priv_len b inner .
end

rem ✔ 스칼라의 첫 4 바이트를 한 수로 — 합성값이므로 0x01020304 = 16909060 이어야 한다.
export fn priv_head input b slice u8 . output u64 . do
  let inner be u64 der.p8_inner_off b .
  if eq inner 0 . do return 0 . end
  let s be u64 der.ec_priv_off b inner .
  if eq s 0 . do return 0 . end
  if ne (der.ec_priv_len b inner) 32 . do return 0 . end
  var acc be u64 0 .
  var i be u64 0 .
  while lt i 4 . do
    set acc (bit_or (shl acc 8) (cast u64 (idx b (add s i)))) .
    set i (add i 1) .
  end
  return acc .
end

rem ✘ 라벨이 다르면 못 연다 — 한 파일에 여러 개가 있는 것이 정상이므로 중요하다.
export proc wrong_label input sc mut slice u8 . input out mut slice u8 . output u64 . effects none . do
  let d_r be result (option u64) pem.pem_error pem.unwrap "-----BEGIN CERTIFICATE-----\nMIIBczCCARmgAwIBAgIUX6WueNvc/EadMquZRpJ1A2RVHskwCgYIKoZIzj0EAwIw\nDzENMAsGA1UEAwwEdGVzdDAeFw0yNjA4MjEwODEwMTRaFw0yNjA4MjIwODEwMTRa\nMA8xDTALBgNVBAMMBHRlc3QwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAATnCveE\nEuf+Ru42Zbqdd07/2LXyz4D8O/Uc8oTYlWuLMMXtOqD+Nmv2Al3KxC8t7sFqFC5J\nzB99M2gcV1hSh4Q9o1MwUTAdBgNVHQ4EFgQUCcDDbPSKfzGMLzxuhZIqMpQ6S78w\nHwYDVR0jBBgwFoAUCcDDbPSKfzGMLzxuhZIqMpQ6S78wDwYDVR0TAQH/BAUwAwEB\n/zAKBggqhkjOPQQDAgNIADBFAiEA1fF1CX7llQYCzs/3BojBzHRHUC7/B6HVxYlW\nV5VKuQ0CIAl3oXevj8n54P0rrWT3aUiRIXWMw8PLf9drZaSwJUdK\n-----END CERTIFICATE-----" "EC PARAMETERS" sc out .
  guard is_ok d_r . else return 0 .
  let d be option u64 ok_value d_r .
  if is_some d . do return 1 . end
  return 0 .
end

rem ✘ 봉투가 없으면 못 연다.
export proc no_envelope input sc mut slice u8 . input out mut slice u8 . output u64 . effects none . do
  let d_r be result (option u64) pem.pem_error pem.unwrap "hello world" "CERTIFICATE" sc out .
  guard is_ok d_r . else return 0 .
  let d be option u64 ok_value d_r .
  if is_some d . do return 1 . end
  return 0 .
end

proc main output u8 . effects none . do
  return 0 .
end
