rem RFC-0150 §8-11 — 진입 op 의 가장 깊은 부름 길이 풀에 남길 수 있는 값의 상한(만드는 자리의 수를 더한다). 프리스탠딩 대상(풀 64)에서 넘으면 거절한다.
module poolbound .
fn one input k u64 . output u64 . do
  let o option u64 some k. . .
  return value_or o. 0 . .
end .
fn many output u64 . do
  var acc u64 0 .
  set acc. add acc. one 0 . . .
  set acc. add acc. one 1 . . .
  set acc. add acc. one 2 . . .
  set acc. add acc. one 3 . . .
