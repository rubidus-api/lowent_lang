  set acc. add acc. one 64 . . .
  set acc. add acc. one 65 . . .
  set acc. add acc. one 66 . . .
  set acc. add acc. one 67 . . .
  set acc. add acc. one 68 . . .
  set acc. add acc. one 69 . . .
  return acc. .
end .
