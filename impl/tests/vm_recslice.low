rem ★★ **슬라이스 칸을 가진 레코드를 빠른 함수끼리 넘긴다** (2026-10-31 · W-20261031-2053).
rem   범프 할당기(`allocs.bump_bytes`)의 상태는 바이트 슬라이스 칸 `mem` 을 가진다. 그 상태를 **두 번째 매개변수**로 받는 op 이
rem   핸들러(`init`)를 불러 칸을 바꾸고, 한 겹 위의 호출자가 그 칸을 다시 읽는다 — 슬라이스 칸은 부른 뒤 호출자의 집으로 되받는다.
rem   차등 스윕이 아래 op 을 VM 과 네이티브에 같은 인자로 돌려 견준다.

module vm_recslice .

use allocs from "../../lib/alloc.low" .

rem 받침 바이트를 거는 일을 남에게 맡긴다 — 할당기는 두 번째 매개변수
proc setup input back mut slice u8 . input bb mut allocs.bump_bytes . output usize . effects state . do
  return send bb. init back. . .
end .

rem 자리를 받아 첫 바이트에 표시를 남기고 그 길이를 돌려준다
proc grab input k usize . input bb mut allocs.bump_bytes . output usize . effects state . do
  let p option mut slice u8 send bb. reserve k. . .
  guard is_some p. . else return 0 . .
  let s mut slice u8 some_value p. . .
  if gt len s. . 0 . do set idx s. 0 . 9 . end .
  return len s. . .
end .

rem 한 겹 더 — 받은 할당기를 다시 넘긴다
proc grab2 input k usize . input bb mut allocs.bump_bytes . output usize . effects state . do
  let a usize grab k. bb. . .
  let b usize grab k. bb. . .
  return add a. b. . .
end .

rem 걸고(남의 손) · 두 번 받고(두 겹 아래) · 쓴 양을 묻는다 — 받은 길이 × 1000 + 쓴 양 + 첫 바이트
export proc run input k usize . output u64 . effects state . do
  var back lit array 64 u8 _ . .
  var bb allocs.bump_bytes spawn actor allocs.bump_bytes . .
  let c usize setup back. bb. . .
  guard eq c. 64 . else return 1 . .
  let x usize grab2 k. bb. . .
  let u usize send bb. used . .
  return add add mul cast u64 x. . 1000 . cast u64 u. . . widen u64 idx back. 0 . . . .
end .

rem 걸지 않은 할당기 — 칸이 빈 슬라이스(0)로 시작한다: 받을 자리가 없다
export proc unset input k usize . output usize . effects state . do
  var bb allocs.bump_bytes spawn actor allocs.bump_bytes . .
  return grab2 k. bb. . .
end .
