rem S-impl-4 V1 fixture — runtime references: cross-frame mut_ref write-through
rem (green path) + shared-ref write (E-VM-READONLY, statics currently miss it).
rem ★ `proc` 다 — 호출자의 저장소에 쓰기 때문이다(2026-09-16, 결함 노트 #8: 순수한 `fn` 이
rem   `mut_ref` 에 이름으로 쓰는 것을 순수성 검사가 못 봤다. 이제 `E-EFFECT-PURITY` 다).
proc bump .
  input p mut_ref u64 . .
  output u64 .
  effects state .
do
  set p expr (deref p) + 1 . .
  return deref p .
end

proc bump42 .
  input n u64 .
  output u64 .
  effects state .
do
  var x be u64 n .
  var r be mut_ref u64 mut_ref x .
  bump r .
  return x .
end

fn ro_write .
  input n u64 .
  output u64 .
do
  let x be u64 n .
  var r be ref u64 ref x .
  set r 9 .
  return x .
end
