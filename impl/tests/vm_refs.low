rem S-impl-4 V1 fixture — runtime references: cross-frame mut_ref write-through
rem (green path) + shared-ref write (E-VM-READONLY, statics currently miss it).
fn bump .
  input p mut_ref u64 . .
  output u64 .
do
  set p expr (deref p) + 1 . .
  return deref p .
end .

fn bump42 .
  input n u64 .
  output u64 .
do
  var x u64 be n .
  var r mut_ref u64 . be mut_ref x .
  bump r .
  return x .
end .

fn ro_write .
  input n u64 .
  output u64 .
do
  var x u64 be n .
  var r ref u64 . be ref x .
  set r 9 .
  return x .
end .
