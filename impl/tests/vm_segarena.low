rem ★★★ **고정 크기 세그먼트 아레나** — RFC-0104 §8-5(소유자 서명 §5.15, 2026-08-28).
rem   재는 것:
rem     ① 조각을 늘리고 전역 색인으로 읽으면 **같은 자리**가 나온다
rem     ② 조각을 한 번 빌려 도는 합과 전역 색인으로 도는 합이 **같다**
rem     ③ 그런데 **비용은 다르다** — 골든이 IR 에서 루프 안 directory load 를 센다
module vm_segarena .

use segarena from "../../lib/segarena.low" .

rem ★ 브랜드는 **저장소마다 하나**다(§8-2) — 프로시저 셋이 각자 아레나를 여니 셋이다.
newtype grid u8 .
newtype grid2 u8 .
newtype grid3 u8 .

rem 조각 4 칸(kbits 2) 짜리로 세 조각을 연다 — dir 은 조각마다 시작 자리.
proc build input dir mut slice u64 . . input cap0 u64 . output u64 . effects none . do
  var a segarena.arena grid . be segarena.open grid 2 .
  guard eq (segarena.seg_slots grid a) 4 . else return 91 .

  let b0 option u64 . be segarena.grow grid a dir cap0 .
  let b1 option u64 . be segarena.grow grid a dir cap0 .
  let b2 option u64 . be segarena.grow grid a dir cap0 .
  guard is_some b0 . else return 92 .
  guard is_some b1 . else return 93 .
  guard is_some b2 . else return 94 .
  guard eq (some_value b0) 0 . else return 95 .
  guard eq (some_value b1) 4 . else return 96 .
  guard eq (some_value b2) 8 . else return 97 .

  rem 색인 분해 — 9 번 칸은 셋째 조각(2)의 첫 자리(1)다
  guard eq (segarena.seg_of grid a 9) 2 . else return 98 .
  guard eq (segarena.slot_of grid a 9) 1 . else return 99 .
  return 1 .
end .

rem ★★ 두 순회가 **같은 답**을 낸다 — 비용만 다르다.
proc same_answer input dir mut slice u64 . . input mem slice u64 . . input cap0 u64 .
  output u64 . effects none .
do
  var a segarena.arena grid2 . be segarena.open grid2 2 .
  let b0 option u64 . be segarena.grow grid2 a dir cap0 .
  let b1 option u64 . be segarena.grow grid2 a dir cap0 .
  guard is_some b0 . else return 91 .
  guard is_some b1 . else return 92 .

  let s0 u64 be segarena.sum_seg grid2 a dir mem 0 .
  let g0 u64 be segarena.sum_global grid2 a dir mem 0 .
  let s1 u64 be segarena.sum_seg grid2 a dir mem 1 .
  let g1 u64 be segarena.sum_global grid2 a dir mem 1 .
  guard eq s0 g0 . else return 93 .
  guard eq s1 g1 . else return 94 .
  return add s0 s1 .
end .

rem 열지 않은 조각은 **없다고 답한다** — 트랩이 아니다.
proc beyond input dir mut slice u64 . . input mem slice u64 . . input cap0 u64 .
  output u64 . effects none .
do
  var a segarena.arena grid3 . be segarena.open grid3 2 .
  let b0 option u64 . be segarena.grow grid3 a dir cap0 .
  guard is_some b0 . else return 91 .
  rem 조각 하나(4 칸)만 열었으므로 4 번 칸은 아직 없다
  let v option u64 . be segarena.at grid3 a dir mem 4 .
  guard eq (is_some v) false . else return 92 .
  let w option u64 . be segarena.at grid3 a dir mem 3 .
  guard is_some w . else return 93 .
  return 2 .
end .
