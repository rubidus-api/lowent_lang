rem ★★★★★ **`segments T` — 조각 여럿을 한 값으로** (RFC-0104 §8-8, 소유자 서명 2026-08-29).
rem
rem   왜 언어가 아는가: 오늘 `slice (slice u8)` 은 선언만 되고 **원소를 못 꺼낸다**
rem   (`E-TYPE-LET`). 그래서 흩어진 조각을 하나의 값으로 못 들고, 밖으로 나갈 때는
rem   조각마다 한 번씩 나가야 한다 — 64 KiB 를 64 조각으로:
rem     `writev` 1 회 = 11.98 ms   ·   `write` 64 회 = 339.38 ms   → **28.3 배**.
rem
rem ☞ 그런데 **새 옵코드는 0** 이다. 뷰는 백업 슬라이스와 (at, n) 서술자 슬라이스 두 칸이고,
rem   그 둘을 드는 그릇(슬라이스 필드를 든 구조체)은 이미 있었다. 세 op 은 하강에서
rem   `make`·`field`·`len`·`index`·`subslice` 로 탈설탕된다.
rem   그러므로 이 파일이 지키는 것은 §7.3 열 10 의 네 출구다:
rem     ① 평평한 슬라이스 의미 불변  ② 조각 순회 무복사  ③ coalesce 만 명시 O(n)
rem     ④ FFI 서술자 대조(= (at,n) 쌍 그대로)

module vm_segments .

use segview .

rem 조각 둘을 실은 뷰를 짓는다 — back[0..4] 와 back[8..4].
rem   서술자는 `slice u64` 에 (at, n) 쌍이다. **새 구조체 타입은 없다.**
proc counts input al cap allocator . output u64 . effects alloc . do
  let mb be option mut slice u8 alloc_bytes al capacity 64 .
  guard is_some mb . else return 89 .
  let md be option mut slice u8 alloc_bytes al capacity 32 .
  guard is_some md . else return 88 .
  var back be slice u8 some_value mb .
  var d be mut slice u64 view_array u64 (some_value md) .
  set (index d 0) 0 .  set (index d 1) 4 .
  set (index d 2) 8 .  set (index d 3) 4 .
  let ss be segments u8 view_segments back d .
  guard eq (segs ss) 2 . else return 1 .
  return 42 .
end

rem ✔ ② 조각을 꺼내도 **복사가 없다** — back 에 쓴 값이 조각으로 그대로 보인다.
proc reads input al cap allocator . output u64 . effects alloc . do
  let mb be option mut slice u8 alloc_bytes al capacity 64 .
  guard is_some mb . else return 89 .
  let md be option mut slice u8 alloc_bytes al capacity 32 .
  guard is_some md . else return 88 .
  var back be mut slice u8 some_value mb .
  var d be mut slice u64 view_array u64 (some_value md) .
  set (index d 0) 0 .  set (index d 1) 4 .
  set (index d 2) 8 .  set (index d 3) 4 .
  set (index back 9) 77 .
  let ss be segments u8 view_segments back d .
  let p be slice u8 seg ss 1 .
  guard eq (len p) 4 . else return 1 .
  guard eq (widen u64 (index p 1)) 77 . else return 2 .
  return 42 .
end

rem ✔ ① 조각 길이의 합 = 평평한 의미. 서술자만 읽고 바이트는 안 만진다.
proc totals input al cap allocator . output u64 . effects alloc . do
  let mb be option mut slice u8 alloc_bytes al capacity 64 .
  guard is_some mb . else return 89 .
  let md be option mut slice u8 alloc_bytes al capacity 32 .
  guard is_some md . else return 88 .
  var back be slice u8 some_value mb .
  var d be mut slice u64 view_array u64 (some_value md) .
  set (index d 0) 0 .  set (index d 1) 4 .
  set (index d 2) 8 .  set (index d 3) 6 .
  let ss be segments u8 view_segments back d .
  var i be u64 0 .
  var acc be u64 0 .
  while lt i (segs ss) . do
    set acc (add acc (len (seg ss i))) .
    set i (add i 1) .
  end
  guard eq acc 10 . else return 1 .
  return 42 .
end


rem ✔ ③ **`coalesce` 만 명시적으로 O(n)** 이다 — 라이브러리에 있고, 부른 자리에 비용이 보인다.
rem   커서·총길이도 라이브러리다(표면 추가 0). 여기서 그 셋이 실제로 선다는 것을 문다.
proc library input al cap allocator . output u64 . effects alloc . do
  let mb be option mut slice u8 alloc_bytes al capacity 16 .
  guard is_some mb . else return 89 .
  let md be option mut slice u8 alloc_bytes al capacity 32 .
  guard is_some md . else return 88 .
  let mo be option mut slice u8 alloc_bytes al capacity 16 .
  guard is_some mo . else return 87 .
  var back be mut slice u8 some_value mb .
  var d be mut slice u64 view_array u64 (some_value md) .
  var out be mut slice u8 some_value mo .
  set (index d 0) 0 .  set (index d 1) 4 .
  set (index d 2) 8 .  set (index d 3) 4 .
  set (index back 1) 11 .
  set (index back 9) 77 .
  let ss be segments u8 view_segments back d .
  guard eq (segview.total_len ss) 8 . else return 1 .
  rem 평평한 자리 5 = 둘째 조각의 1 번 = back[9] — **커서가 경계를 넘어 센다**.
  let bo be option u8 segview.byte_at ss 5 .
  guard is_some bo . else return 2 .
  guard eq (widen u64 (some_value bo)) 77 . else return 3 .
  rem 끝 너머는 커서가 없다 — 없는 자리를 가리키는 커서를 만들지 않는다.
  let so be option segview.cursor segview.seek ss 8 .
  guard not (is_some so) . else return 4 .
  let wo be option u64 segview.coalesce ss out .
  guard is_some wo . else return 5 .
  guard eq (some_value wo) 8 . else return 6 .
  guard eq (widen u64 (index out 1)) 11 . else return 7 .
  guard eq (widen u64 (index out 5)) 77 . else return 8 .
  return 42 .
end

rem ✔ 범위 밖 조각은 **기존 안전망이 잡는다** — 새 진단을 만들지 않았다.
rem   서술자 슬라이스의 색인이 그대로 범위 검사를 받으므로 `seg ss 9` 는 실행 중 죽는다.
rem   ★ 이 op 만 CLI 로 부를 수 있게 저장을 밖에서 받는다(cap 은 인자로 못 넘긴다).
proc beyond input back slice u8 . . input d slice u64 . . input i u64 .
  output u64 . effects none .
do
  let ss be segments u8 view_segments back d .
  return len (seg ss i) .
end

rem ★ cap 은 CLI 인자로 못 넘긴다 — 엔트리가 받아서 넘긴다.
proc main input al cap allocator . output u8 . effects alloc . do
  let a be u64 counts al .
  guard eq a 42 . else return narrow u8 a .
  let b be u64 reads al .
  guard eq b 42 . else return narrow u8 b .
  let c be u64 totals al .
  guard eq c 42 . else return narrow u8 c .
  let e be u64 library al .
  guard eq e 42 . else return narrow u8 e .
  return 42 .
end
