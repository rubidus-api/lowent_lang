rem ★★★ **SHA-256** (RFC-0090 N3c, 2026-08-11).
rem
rem   비-진입점 op 으로 리프를 쓴다(시계·해시·난수에서 배운 것: cap 진입 프로그램만 있으면
rem   차등 훑기가 통째로 건너뛴다).
rem
rem ★★ 오라클은 **표준 테스트 벡터**다 — 이 축에서 가장 강한 종류이고, RFC-0090 D3 이
rem   N3 을 N2 보다 먼저 하라고 한 이유이기도 하다. 값을 우리가 고르지 않았다:
rem     SHA-256("")    = e3b0c44298fc1c14 9afbf4c8996fb924 …
rem     SHA-256("abc") = ba7816bf8f01cfea 414140de5dae2223 …
rem   앞 8 바이트만 접어서 견준다(u64 하나로 비교하기 위해서다 — 뒤 24 바이트도 같은
rem   압축 함수가 낸 것이므로, 앞이 맞으면서 뒤가 틀릴 여지는 사실상 없다).

module vm_sha256 .

rem 앞 8 바이트를 u64 로 접는다.
fn head8 input src slice u8 . input dst mut slice u8 . output u64 . do
  let n u64 be call_builtin sha256 src dst .
  guard eq n 32 . else return 0 .
  var acc u64 be 0 .
  var i u64 be 0 .
  while lt i 8 . do
    set acc (add (shl acc 8) (cast u64 (index dst i))) .
    set i (add i 1) .
  end .
  return acc .
end .

rem "abc" 의 표준 값.
fn t_abc input src slice u8 . input dst mut slice u8 . output u64 . do
  guard eq (head8 src dst) 13436514500253700074 . else return 90 .
  return 1 .
end .

rem 빈 입력의 표준 값 — 경계는 따로 센다(패딩만 도는 경로다).
fn t_empty input src slice u8 . input dst mut slice u8 . output u64 . do
  guard eq (len src) 0 . else return 89 .
  guard eq (head8 src dst) 16406829232824261652 . else return 90 .
  return 1 .
end .

rem ★ 버퍼가 짧으면 **0 을 답하고 아무것도 안 쓴다** — 조용히 덜 쓰는 것이 이 축에서
rem   가장 위험한 실패다(짧은 다이제스트는 맞아 보인다).
fn t_short input src slice u8 . input dst mut slice u8 . output u64 . do
  guard lt (len dst) 32 . else return 89 .
  guard eq (call_builtin sha256 src dst) 0 . else return 90 .
  return 1 .
end .
