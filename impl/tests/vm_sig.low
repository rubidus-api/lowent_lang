rem ★★★ **서명 검증** — RSA-PSS 와 ECDSA P-256.
rem
rem ★ 값 대조는 게이트가 한다(참조 구현과 실제 서명이 필요하다). 여기서는 이 축의
rem   **음성**을 본다: 잘못된 것을 거절하는가. 서명 검증에서 양성만 보이면
rem   *"언제나 참"* 을 반환하는 구현과 구별이 안 된다 — 그것이 이 축의 가장 큰 위험이다.

module vm_sig .

use bigint from "../../lib/bigint.low" .
use rsa from "../../lib/rsa.low" .
use p256 from "../../lib/p256.low" .
use ed25519 from "../../lib/ed25519.low" .
use x25519 from "../../lib/x25519.low" .

rem s ≥ n 인 서명은 **거절돼야** 한다(안 그러면 같은 값에 서명이 여럿 생긴다).
proc t_rsa_big input sig slice u8 . input nb slice u8 . input mhash slice u8 .
     input em mut slice u8 . input w mut slice u8 .
     input sw mut slice u64 . input nw mut slice u64 . input ow mut slice u64 .
     input r2 mut slice u64 . input acc mut slice u64 . input tw mut slice u64 . input mw mut slice u64 .
     output u64 . effects none . do
  let _u6 be result u64 rsa.rsa_error rsa.verify_pss sig nb 65537 mhash 32 em w sw nw ow r2 acc tw mw .
  guard is_ok _u6 . else return 0 .
  guard eq (ok_value _u6) 0 . else return 0 .
  return 1 .
end

rem r 또는 s 가 0 인 ECDSA 서명은 **거절돼야** 한다.
proc t_ec_zero input v mut slice u64 . input w mut slice u64 . output u64 . effects none . do
  guard ge (len v) 144 . else return 0 .
  var i be u64 0 .
  while lt i 144 . do  set (idx v i) 0 .  set i (add i 1) .  end
  rem 전부 0 이면 r = 0 이고 n = 0 이다 — 어느 쪽이든 거절이 옳다.
  let _u5 be result u64 p256.p256_error p256.ecdsa_verify (subslice v 0 16) (subslice v 16 32) (subslice v 32 48) (subslice v 48 80) (subslice v 80 96) (subslice v 96 112) (subslice v 112 128) (subslice v 128 144) w .
  guard is_ok _u5 . else return 0 .
  guard eq (ok_value _u5) 0 . else return 0 .
  return 1 .
end

rem MGF1 은 카운터를 **돌려야** 한다: 32 바이트를 넘게 달라고 하면 뒷부분이 앞과 달라야 한다.
proc t_mgf_extends input seed slice u8 . input out mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  let _u4 be result u64 rsa.rsa_error rsa.mgf1 seed 64 out w .
  guard is_ok _u4 . else return 0 .
  guard eq (ok_value _u4) 64 . else return 0 .
  var diff be u64 0 .
  var i be u64 0 .
  while lt i 32 . do
    set diff (bit_or diff (bit_xor (cast u64 (idx out i)) (cast u64 (idx out (add 32 i))))) .
    set i (add i 1) .
  end
  if eq diff 0 . do  return 0 .  end
  return 1 .
end

rem ★★★ **[L]B 가 항등원인가** — 옮겨 적을 수밖에 없던 위수 L 을 **성질로** 검사한다.
rem   틀리게 적으면 이 검사가 깨진다: 옮겨 적은 것을 *믿지 않고 재는* 방법이다.
rem   항등원의 압축은 0x01 다음 0 이 31 개다.
proc t_order input out mut slice u8 . input bb mut slice u8 . input w mut slice u64 . output u64 . effects none . do
  guard eq (ed25519.make_l (subslice bb 0 32)) 32 . else return 0 .
  let _u0 be result u64 ed25519.ed25519_error ed25519.make_d (subslice w 0 16) (subslice w 16 144) .
  guard is_ok _u0 . else return 0 .
  guard eq (ok_value _u0) 1 . else return 0 .
  let _u1 be result u64 ed25519.ed25519_error ed25519.make_base (subslice w 144 208) (subslice w 0 16) (subslice w 208 768) (subslice bb 32 192) .
  guard is_ok _u1 . else return 0 .
  guard eq (ok_value _u1) 1 . else return 0 .
  let _u2 be result u64 ed25519.ed25519_error ed25519.esmul (subslice w 768 832) (subslice bb 0 32) (subslice w 144 208) (subslice w 0 16) (subslice w 208 608) .
  guard is_ok _u2 . else return 0 .
  guard eq (ok_value _u2) 1 . else return 0 .
  let _u3 be result u64 ed25519.ed25519_error ed25519.compress out (subslice w 768 832) (subslice w 832 960) (subslice bb 192 256) .
  guard is_ok _u3 . else return 0 .
  guard eq (ok_value _u3) 32 . else return 0 .
  guard eq (cast u64 (idx out 0)) 1 . else return 0 .
  var i be u64 1 .
  while lt i 32 . do
    guard eq (cast u64 (idx out i)) 0 . else return 0 .
    set i (add i 1) .
  end
  return 1 .
end
