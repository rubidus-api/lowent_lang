module vm_simd .

def type bytes slice u8 .

rem ★★★ **여백(margin) 증인** — WO-0056 P1·P2 (2026-08-16).
rem
rem   재는 것은 속도가 아니라 **판정**이다: 계약이 있으면 벡터 로드의 경계 검사가 사라지고,
rem   계약이 없으면 **남는다**. 두 op 이 그 두 짝이다 — *거절과 성립은 두 짝*이라는 이 저장소의
rem   규율대로, 지워지는 쪽만 두면 "언제나 지운다"(=불건전)와 구별이 안 된다.
rem
rem ☞ 두 op 의 **본문은 한 글자도 다르지 않다.** 다른 것은 `requires` 두 줄뿐이다.
rem   그래야 차이의 원인이 계약임이 증인 자체로 드러난다.

rem ── 계약이 있다: len(a) ≥ n · len(b) ≥ n · 루프가 `le (add i 4) n` ────────────
rem    ⇒ i + 4 ≤ n ≤ len(a)  ⇒ 네 레인을 읽어도 안전하다 (R-VLOAD-MARGIN)
export proc dot_c
  input a slice u32 .
  input b slice u32 .
  input n u64 .
  output u64 .
  effects none .
  requires ge (len a) n .
  requires ge (len b) n .
do
  var acc vec u32 4 splat 0 .
  var i u64 0 .
  while le (add i 4) n do
    let va vec u32 4 load a i .
    let vb vec u32 4 load b i .
    let vp vec u32 4 mul va vb .
    let vs vec u32 4 add acc vp .
    set acc vs .
    set i (add i 4) .
  end
  return reduce_add acc .
end

rem ── 계약이 없다: 같은 본문, `requires` 만 뺐다 ──────────────────────────────
rem    ⇒ len(a) 와 n 사이에 아무 사실도 없다 ⇒ 검사는 **남아야 한다**.
export proc dot_u
  input a slice u32 .
  input b slice u32 .
  input n u64 .
  output u64 .
  effects none .
do
  var acc vec u32 4 splat 0 .
  var i u64 0 .
  while le (add i 4) n do
    let va vec u32 4 load a i .
    let vb vec u32 4 load b i .
    let vp vec u32 4 mul va vb .
    let vs vec u32 4 add acc vp .
    set acc vs .
    set i (add i 4) .
  end
  return reduce_add acc .
end

rem ── 부르는 자리 — 바이트 하나를 두 슬라이스로 나눠 실제로 돌린다 ─────────────
rem    VM 과 방출 네이티브가 **같은 답**을 내야 한다(diff-sweep). 계약이 있는 판과 없는 판이
rem    같은 수를 내는 것도 요점이다: **검사를 지워도 답은 그대로다.**
fn run_c input b bytes . output u64 . do
  var xs slice u32 view_array u32 b .
  return dot_c xs xs (len xs) .
end

fn run_u input b bytes . output u64 . do
  var xs slice u32 view_array u32 b .
  return dot_u xs xs (len xs) .
end

rem ── 쓰는 커널 — `store` 도 빠른 경로에 든다 (SIMD-0001, 2026-08-17) ─────────────
rem  ★ 2026-08-17 전에는 벡터를 **쓰는** op 이 종류 시뮬레이터를 못 통과해 통째로 태그
rem    경로로 떨어졌고, 그러면 **내보낸 C 진입점이 아예 안 생겼다**(`long long dbl(...)` 없음).
rem    즉 그 커널은 느린 것이 아니라 **C 에서 부를 수 없었다.** 속도보다 큰 구멍이었다.
rem  ☞ 여기도 계약 있는 판/없는 판 두 짝을 둔다 — 쓰기에서 경계를 잘못 지우면 남의 바이트를
rem    밟으므로, *지워지는 쪽만* 재면 불건전과 구별이 안 된다.
export proc dbl_c
  input a mut slice u32 .
  input n u64 .
  output u64 .
  effects none .
  requires ge (len a) n .
do
  var i u64 0 .
  while le (add i 4) n do
    let v vec u32 4 load a i .
    var t vec u32 4 add v v .
    store a i t .
    set i (add i 4) .
  end
  return 0 .
end

export proc dbl_u
  input a mut slice u32 .
  input n u64 .
  output u64 .
  effects none .
do
  var i u64 0 .
  while le (add i 4) n do
    let v vec u32 4 load a i .
    var t vec u32 4 add v v .
    store a i t .
    set i (add i 4) .
  end
  return 0 .
end

rem 부르는 자리 — 바이트를 두 배로 만들고 합을 낸다(VM≡native 가 이 변경의 오라클이다).
fn run_w input b bytes . output u64 . do
  var xs slice u32 view_array u32 b .
  let z u64 dbl_c xs (len xs) .
  var s u64 0 .
  var k u64 0 .
  while lt k (len xs) do
    set s (add s (idx xs k)) .
    set k (add k 1) .
  end
  return add s z .
end
