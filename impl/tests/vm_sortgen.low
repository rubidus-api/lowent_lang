rem ★★★ **제네릭 정렬 — 비교는 타입이 들고 온다** (RFC-0021 · 2026-07-26).
rem
rem   비교 함수를 값으로 넘기는 길은 이 언어에 없다(일급 함수 없음). 있어도 **간접 호출**이
rem   생겨 P2(비용 가시)를 깬다. 대신 comptime 타입 파라미터 + trait 경계를 쓴다: 호출마다
rem   구체 op 이 만들어지고(단형화) 비교는 **직접 호출**로 박힌다.
rem
rem   ★ 이 파일이 vm_sort.low 와 갈라진 이유: 단형화 픽스처는 **flat/tree 대조에서 빠진다**
rem     (평평한 채로는 호출 자리를 못 찾아 인스턴스가 안 생긴다 — vm_generic 과 같은 이유).
rem     u64 quicksort 의 오라클 덮개를 그대로 두려고 파일을 나눴다.

module vm_sortgen .

use sortgen from "../../lib/sortgen.low" .

rem ── 제네릭 정렬(2026-07-26): 비교는 **타입이 들고 온다**(comptime 타입 + trait 경계) ──
rem   레코드 하나로 감싼 u64 를 정렬한다 — 정렬 대상이 스칼라가 아니어도 같은 op 이 돈다.

struct keyed .
  satisfies sortgen.ordered .
  k u64 .
end .
fn keyed.less output bool . input a keyed . input b keyed . do return lt (field a k) (field b k) . end .

rem [3,1,2] → 123. 자릿수로 순서를 통째로 확인한다(첫 원소만 보면 뒤가 틀려도 모른다).
proc generic_sorted output u64 . input s mut slice keyed . . effects none . do
  guard ge (len s) 3 . else return 90 .
  sortgen.sort_by keyed s .
  let f0 keyed be index s 0 .
  let f1 keyed be index s 1 .
  let f2 keyed be index s 2 .
  return add (mul 100 (field f0 k)) (add (mul 10 (field f1 k)) (field f2 k)) .
end .

rem ★ `swap` 은 원소 타입을 몰라도 된다 — u64 슬라이스에서도 같은 낱말이다.
proc swap_scalar output u64 . input s mut slice u64 . . effects none . do
  guard ge (len s) 2 . else return 90 .
  swap s 0 1 .
  return add (mul 10 (index s 0)) (index s 1) .
end .

rem ★★★ **부분 정렬을 잡는 픽스처** — 3원소·단일 키로는 한 번의 스왑으로도 답이 맞아
rem   버그가 숨는다(실제로 숨었다). 여기서는 ① 원소를 여섯 개로 늘리고 ② **다중 키**를 쓴다.
rem   다중 키가 중요한 이유: 같은 1차 키가 여럿이면 2차 키로 **여러 칸을 내려가야** 하는데,
rem   비교를 두 번 하는 구현은 한 칸만 내려가고 멈춘다.

struct score .
  satisfies sortgen.ordered .
  grade u64 .
  point u64 .
end .
fn score.less output bool . input a score . input b score . do
  if lt (field a grade) (field b grade) . do return true . end .
  if gt (field a grade) (field b grade) . do return false . end .
  return lt (field a point) (field b point) .
end .

rem 입력 (1,5) (1,2) (0,9) → 정렬 (0,9) (1,2) (1,5) → point 자릿수 925.
proc multikey output u64 . input s mut slice score . . effects none . do
  guard ge (len s) 3 . else return 90 .
  sortgen.sort_by score s .
  let a score be index s 0 .
  let b score be index s 1 .
  let c score be index s 2 .
  return add (mul 100 (field a point)) (add (mul 10 (field b point)) (field c point)) .
end .

rem 여섯 원소 역순 [6,5,4,3,2,1] → 정렬 후 자릿수로 654321 이 아니라 123456 이어야 한다.
proc six_reversed output u64 . input s mut slice keyed . . effects none . do
  guard ge (len s) 6 . else return 90 .
  sortgen.sort_by keyed s .
  var acc u64 be 0 .
  var i u64 be 0 .
  while lt i 6 . do
    let e keyed be index s i .
    set acc (add (mul acc 10) (field e k)) .
    set i (add i 1) .
  end .
  return acc .
end .

rem ★★ 제네릭 quicksort — 같은 답을 **O(n log n)** 으로. 적대적 입력(역순·이미정렬)도 본다.
proc fast_six output u64 . input s mut slice keyed . . effects none . do
  guard ge (len s) 6 . else return 90 .
  sortgen.sort_fast keyed s .
  var acc u64 be 0 .
  var i u64 be 0 .
  while lt i 6 . do
    let e keyed be index s i .
    set acc (add (mul acc 10) (field e k)) .
    set i (add i 1) .
  end .
  return acc .
end .

rem 정렬 결과가 **순서 + 합** 둘 다 맞는지 자기검사한다(원소를 잃거나 복제하면 합이 틀린다).
proc fast_verify output u64 . input s mut slice keyed . . effects none . do
  var before u64 be 0 .
  var i u64 be 0 .
  while lt i (len s) . do
    let e keyed be index s i .
    set before (add before (field e k)) .
    set i (add i 1) .
  end .
  sortgen.sort_fast keyed s .
  var after u64 be 0 .
  var sorted_ok bool be true .
  set i 0 .
  while lt i (len s) . do
    let e keyed be index s i .
    set after (add after (field e k)) .
    if gt i 0 . do
      let prev keyed be index s (sub i 1) .
      if gt (field prev k) (field e k) . do set sorted_ok false . end .
    end .
    set i (add i 1) .
  end .
  if eq sorted_ok false . do return 1 . end .
  if ne before after . do return 2 . end .
  return 42 .
end .

rem ★★ 제네릭 이진 탐색 — 정렬한 뒤 찾는다. 없는 값은 none, 중복은 가장 왼쪽.
proc search_after_sort output u64 . input s mut slice keyed . . effects none . do
  guard ge (len s) 6 . else return 90 .
  sortgen.sort_fast keyed s .
  rem 정렬 후 [1,2,3,4,5,6] 이라고 보고 3 을 찾으면 자리 2.
  let k3 keyed be make keyed do k 3 . end .
  let f option u64 . be sortgen.find_by keyed s k3 .
  guard is_some f . else return 1 .
  guard eq (some_value f) 2 . else return 2 .
  rem 없는 값은 none — 트랩이 아니라 값으로 답한다.
  let k9 keyed be make keyed do k 99 . end .
  let g option u64 . be sortgen.find_by keyed s k9 .
  guard is_some g . else do
    rem lower_by 는 삽입점을 준다: 99 는 전부보다 커서 len(=6).
    let at u64 be sortgen.lower_by keyed s k9 .
    guard eq at 6 . else return 3 .
    return 42 .
  end .
  return 4 .
end .
