rem ★★★★ **lock-free SPSC 링 버퍼**(`lib/spsc.low`, RFC-0018 §8-3)의 시험.
rem
rem 무엇을 재나 — 자료구조의 **계약 세 줄**이다:
rem   ① 빈 것에서 꺼내면 실패한다(0)         · ② 가득 찬 것에 넣으면 실패한다(0)
rem   ③ 넣은 순서대로 나온다(FIFO)           · ④ 링을 **한 바퀴 넘겨도** 그대로다
rem
rem ★ 이 시험은 **단일 스레드**다. VM 이 단일 스레드이기 때문이다(RFC-0018 §6.5 — VM 에서
rem   atomic 은 관찰적으로 seq_cst 와 같다). 진짜 두 스레드는 네이티브에서만 뜻이 있고,
rem   그때 필요한 **동기화의 정당성**은 실행이 아니라 **증명**이 준다(`LowentIRC11.v`).
rem   ⇒ 즉 여기서 재는 것은 **알고리즘의 논리**이고, 메모리 순서의 정당성은 증명이 맡는다.
rem     그 둘을 섞지 않는 것이 이 파일의 규칙이다.

use spsc .

module vm_spsc .

rem 넣고 꺼낸다 — 한 번.
export proc roundtrip input k cap atomic . input ctl mut slice u64 . input buf mut slice u64 .
  input out mut slice u64 .
  output u64 . effects atomic .
  requires ge (len ctl) 2 .
  requires ge (len buf) 2 .
  requires ge (len out) 1 .
do
  let a be u64 spsc.spsc_push k ctl buf 7 .
  let b be u64 spsc.spsc_pop k ctl buf out .
  rem 넣기 성공(1) · 꺼내기 성공(1) · 값이 7 이면 → 7 을 돌려준다.
  guard eq a 1 . else return 90 .
  guard eq b 1 . else return 91 .
  return idx out 0 .
end

rem 빈 것에서 꺼내면 0.
export proc pop_empty input k cap atomic . input ctl mut slice u64 . input buf slice u64 .
  input out mut slice u64 .
  output u64 . effects atomic .
  requires ge (len ctl) 2 .
  requires ge (len buf) 2 .
  requires ge (len out) 1 .
do
  return spsc.spsc_pop k ctl buf out .
end

rem 용량 = len buf − 1 (한 칸은 늘 비워 둔다).
export fn cap_is_len_minus_one input buf slice u64 . output u64 .
  requires ge (len buf) 2 .
do
  return spsc.spsc_capacity buf .
end

rem ★★ 가득 채우고 한 번 더 넣어 본다 — 마지막 넣기는 **실패해야** 한다(0).
export proc fill_then_overflow input k cap atomic . input ctl mut slice u64 .
  input buf mut slice u64 .
  output u64 . effects atomic .
  requires ge (len ctl) 2 .
  requires ge (len buf) 2 .
do
  var i be u64 0 .
  var okc be u64 0 .
  let capn be u64 spsc.spsc_capacity buf .
  while lt i capn . do
    set okc (add okc (spsc.spsc_push k ctl buf i)) .
    set i (add i 1) .
  end
  rem 여기서 한 번 더 — 가득 찼으므로 0 이어야 한다.
  let extra be u64 spsc.spsc_push k ctl buf 999 .
  guard eq extra 0 . else return 90 .
  rem 성공한 넣기 수 = 용량이어야 한다.
  return okc .
end

rem ★★★ 링을 **한 바퀴 넘겨** 돌린다: 넣고 꺼내기를 용량보다 여러 번.
rem   색인이 `mod` 로 감기는 것이 맞는지 — 그리고 FIFO 가 유지되는지.
export proc wrap_around input k cap atomic . input ctl mut slice u64 . input buf mut slice u64 .
  input out mut slice u64 .
  output u64 . effects atomic .
  requires ge (len ctl) 2 .
  requires ge (len buf) 2 .
  requires ge (len out) 1 .
do
  var i be u64 0 .
  var bad be u64 0 .
  while lt i 20 . do
    let p be u64 spsc.spsc_push k ctl buf i .
    guard eq p 1 . else return 90 .
    let q be u64 spsc.spsc_pop k ctl buf out .
    guard eq q 1 . else return 91 .
    rem 넣은 것이 그대로 나와야 한다(SPSC 는 FIFO 다).
    rem ★ `guard … else` 는 **반드시 떠나야** 한다(E-GUARD-FALLTHROUGH) — 세기만 할 때는 `if`.
    if ne (idx out 0) i . do set bad (add bad 1) . end
    set i (add i 1) .
  end
  return bad .
end
