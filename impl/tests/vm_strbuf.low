rem ★★★ **`str_buf` — 넘칠 때 무엇을 할지는 호출자가 이름으로 고른다** (RFC-0068 S5).
rem
rem   `sb_append`        전량-아니면-무    안 들어가면 **한 바이트도 안 쓴다**
rem   `sb_append_trunc`  되는 만큼          쓴 개수를 낸다 — 잘렸음이 **값으로** 나온다
rem   `sb_append_grow`   키운다             더 큰 자리를 **호출자가 준다**
rem
rem ★★ 이것은 새 개념이 아니라 RFC-0052(`wrap_add`/`sat_add`/`chk_add`)의 규율을 문자열이
rem   물려받은 것이다. **한 op 이 "상황 봐서 알아서" 하지 않는다.**
rem ★ 이 파일이 재는 것은 "쓰인다" 가 아니라 **세 범주가 서로 다르게 행동한다** 는 것이다 —
rem   같게 행동하면 이름이 셋일 이유가 없다(§2.5 동의어 금지).

module vm_strbuf .

use strbuf from "../../lib/strbuf.low" .

rem ★ 들어가는 경우 — 셋 다 성공한다.
proc fits output u64 . input buf mut slice u8 . . effects none . do
  var b strbuf.str_buf be strbuf.new .
  let r result void strbuf.sb_error . be strbuf.append b buf "ab" .
  guard is_ok r . else return 90 .
  guard eq (field b len) 2 . else return 91 .
  let v slice u8 be strbuf.as_str b buf .
  guard eq (len v) 2 . else return 92 .
  guard eq (index v 0) 97 . else return 93 .            rem 'a'
  rem ★★★ **F3=(a) 봉인**: len 자리에 널이 봉인돼 있다 — cstr 수출이 O(1)인 이유(D2).
  guard eq (index buf 2) 0 . else return 94 .           rem buf[len] == 0 (봉인)
  return 1 .
end .

rem ★★★ **핵심 ①: 안 들어가면 한 바이트도 안 쓴다.**
rem   내용 용량 4(버퍼 5 − 널 1) 인데 5 를 넣으려 한다 — 거절되고 **버퍼가 안 더럽혀진다**.
proc atomic_refuses output u64 . input buf mut slice u8 . . effects none . do
  var b strbuf.str_buf be strbuf.new .
  rem 먼저 2 를 넣어 둔다 (버퍼 5 = 내용 4 + 널 1)
  let r1 result void strbuf.sb_error . be strbuf.append b (subslice buf 0 5) "ab" .
  guard is_ok r1 . else return 90 .
  rem 남은 자리는 2 인데 3 을 넣으려 한다 → 거절 (2 + 3 + 널 1 > 5)
  let r2 result void strbuf.sb_error . be strbuf.append b (subslice buf 0 5) "xyz" .
  guard is_error r2 . else return 91 .
  rem ★ 길이도 안 늘고, 그 뒤 바이트도 안 건드려졌다
  guard eq (field b len) 2 . else return 92 .
  guard eq (index buf 2) 0 . else return 93 .
  guard eq (index buf 3) 0 . else return 94 .
  return 1 .
end .

rem ★★★ **핵심 ②: 자르되 잘랐다고 말한다.** 같은 상황에서 trunc 는 2 를 쓰고 2 를 돌려준다.
rem   ⇒ ①과 **다른 답**이다. 그래서 이름이 둘일 값이 있다.
proc trunc_writes_part output u64 . input buf mut slice u8 . . effects none . do
  var b strbuf.str_buf be strbuf.new .
  let r1 result void strbuf.sb_error . be strbuf.append b (subslice buf 0 5) "ab" .
  guard is_ok r1 . else return 90 .
  let n u64 be strbuf.append_trunc b (subslice buf 0 5) "xyz" .
  guard eq n 2 . else return 91 .                       rem 3 을 달랬는데 2 를 썼다(내용 4 − 2 = 2) — 값으로 안다
  guard eq (field b len) 4 . else return 92 .
  guard eq (index buf 2) 120 . else return 93 .          rem 'x'
  guard eq (index buf 3) 121 . else return 94 .          rem 'y'
  return 1 .
end .

rem ★★★ **핵심 ③: 키운다 — 더 큰 자리는 호출자가 준다.**
rem   라이브러리가 몰래 할당하지 않는다(RFC-0043 D1). 옛 내용이 옮겨지고 새 것이 이어진다.
proc grow_moves output u64 . input small mut slice u8 . . input big mut slice u8 . .
  effects none .
do
  var b strbuf.str_buf be strbuf.new .
  let r1 result void strbuf.sb_error . be strbuf.append b small "ab" .
  guard is_ok r1 . else return 90 .
  rem 작은 자리에는 "xyz" 가 안 들어간다
  let r2 result void strbuf.sb_error . be strbuf.append b small "xyz" .
  guard is_error r2 . else return 91 .
  rem 큰 자리를 주면 들어간다 — 옛 내용 "ab" 가 앞에 옮겨져 있어야 한다
  let r3 result void strbuf.sb_error . be strbuf.append_grow b small big "xyz" .
  guard is_ok r3 . else return 92 .
  guard eq (field b len) 5 . else return 93 .
  guard eq (index big 0) 97 . else return 94 .           rem 'a' — 옮겨졌다
  guard eq (index big 1) 98 . else return 95 .           rem 'b'
  guard eq (index big 2) 120 . else return 96 .          rem 'x' — 이어졌다
  guard eq (index big 4) 122 . else return 97 .          rem 'z'
  return 1 .
end .

rem ★ 성장도 **원자적**이다: 새 자리조차 모자라면 아무것도 안 옮긴다.
proc grow_atomic output u64 . input small mut slice u8 . . input big mut slice u8 . .
  effects none .
do
  var b strbuf.str_buf be strbuf.new .
  let r1 result void strbuf.sb_error . be strbuf.append b small "ab" .
  guard is_ok r1 . else return 90 .
  rem 새 자리를 3 으로 좁혀 준다 — 2 + 3 = 5 가 안 들어간다
  let r2 result void strbuf.sb_error . be strbuf.append_grow b small (subslice big 0 3) "xyz" .
  guard is_error r2 . else return 91 .
  guard eq (field b len) 2 . else return 92 .            rem 길이 불변
  guard eq (index big 0) 0 . else return 93 .            rem 새 자리도 안 건드려졌다
  return 1 .
end .
