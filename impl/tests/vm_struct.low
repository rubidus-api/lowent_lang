rem struct first-class fixture — make + all access surfaces (field / to / in /
rem glued s.f), nested records; surfaces normalize to one IR (hash-invariant).
struct pairr do
  a u64 .
  b u64 .
end

struct outerr do
  q pairr .
  tag u64 .
end

fn mk2 .
  output pairr .
do
  return lit pairr do a 3 . b 9 . end .
end

fn mko .
  output outerr .
do
  return lit outerr do
    q lit pairr do a 1 . b 2 . end .
    tag 7 .
  end .
end

fn geta output u64 . do var p be pairr mk2 . return field p a . end
fn getb output u64 . do var p be pairr mk2 . return (field p b) . end
fn getg output u64 . do var p be pairr mk2 . return (field p a) . end
fn getin output u64 . do var p be pairr mk2 . return (field p b) . end
fn nest output u64 . do var o be outerr mko . return expr (field o q b) + (field o q a) + (field o tag) . . end


rem ★ **붙임 점 인덱스** — `s.1` 은 `index s 1` 이다(식별자 뒤의 빈칸 없는 `.` 은 접근이고,
rem   뒤 마디가 **숫자면 인덱스**다). 전엔 `s.1` 이 `s` · **닫는 점** · `1` 로 렉싱돼서
rem   `return s.1 .` 이 **슬라이스를 그대로 냈다** — 접근의 네 철자 중 하나만 다르게 굴렀다.
fn glued_index input s slice u8 . output u8 . do
  return expr (field s 0) + (field s 1) . .
end
