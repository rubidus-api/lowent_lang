rem ★★★ **부호형 SIMD 레인 증인** (2026-07-23, 사용자 결정 — 결정2 "완전 지원").
rem
rem   레인은 폭 안에서 **두 보수**로 저장된다. 그런데 vec 표현에 **부호 태그가 없어** 접기(reduce)와
rem   비교가 전부 무부호였다: `reduce_add (vec i16 {-3,5,-100,200})` 가 102 가 아니라 131174
rem   (65533+5+65436+200) 였고, `gt` 는 -1 을 가장 큰 수로 봤다. 양쪽 백엔드가 **일치하게 틀려서**
rem   diff-sweep 이 못 잡는 부류다.
rem   ⇒ vec 에 `sign` 을 실어(load/splat/load_masked 가 `vec iN` 문맥에서 IR_SGN_BIT 로 받는다)
rem     생성·파생(avg/select/reverse/rotate/shuffle/레인산술)에 전파하고, **접기와 비교에서
rem     부호확장 후 부호로** 계산한다. 레인 산술(add/sub/mul)은 두 보수라 값이 같아 태그만 물려받는다.
module m .
def type bytes slice u8 .

rem i16 레인 {-3, 5, -100, 200} — LE 바이트.
rem reduce_add = 102 (무부호면 131174)
fn sred input b bytes . output i64 . do
  let xs be slice i16 view_array i16 b .
  let v be vec i16 4 load xs 0 .
  return widen i64 (reduce_add v) .
end

rem 부호 비교: 모든 레인이 0 보다 큰가 → 음수가 있으니 **거짓**(무부호면 참으로 잘못 본다).
fn sall input b bytes . output u64 . do
  let xs be slice i16 view_array i16 b .
  let v be vec i16 4 load xs 0 .
  let z be vec i16 4 splat 0 .
  let m be mask 4 gt v z .
  guard lane_all m . else return 0 .
  return 1 .
end

rem 부호 최솟값 = -100 (무부호면 5).
fn smin input b bytes . output i64 . do
  let xs be slice i16 view_array i16 b .
  let v be vec i16 4 load xs 0 .
  return widen i64 (reduce_min v) .
end

rem 무부호 대조 — 같은 바이트를 u16 으로 보면 131174 그대로여야(불변).
fn ured input b bytes . output i64 . do
  let xs be slice u16 view_array u16 b .
  let v be vec u16 4 load xs 0 .
  return widen i64 (reduce_add v) .
end
