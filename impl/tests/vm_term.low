rem ★★★ **term 표준 라이브러리 검증** (RFC-0075 3차 슬라이스 3 · lib/term.low 순수 렌더러).
rem   시퀀스 바이트를 **정확히** 대조한다 — 이스케이프는 한 바이트만 어긋나도 화면이 깨진다.
rem   성공=42, 실패=단계 번호.

module vm_term .

use term as t .

rem t_goto (0-기준→1-기준): (2,4) → ESC[3;5H = 27 91 51 59 53 72.
proc goto_seq output u64 . input buf mut slice u8 . . effects none . do
  guard ge (len buf) 16 . else return 90 .
  let p option u64 . be t.goto buf 0 2 4 .
  guard is_some p . else return 1 .
  guard eq (some_value p) 6 . else return 2 .
  guard eq (index buf 0) 27 . else return 3 .
  guard eq (index buf 1) 91 . else return 4 .
  guard eq (index buf 2) 51 . else return 5 .
  guard eq (index buf 3) 59 . else return 6 .
  guard eq (index buf 4) 53 . else return 7 .
  guard eq (index buf 5) 72 . else return 8 .
  rem 전량-아니면-무: 5칸 버퍼엔 아예 안 쓴다.
  var tiny mut slice u8 . be subslice buf 0 5 .
  let f option u64 . be t.goto tiny 0 2 4 .
  guard is_some f . else return 42 .
  return 9 .
end .

rem 스타일: t_sgr 0 → ESC[0m · t_color256 196 전경 → ESC[38;5;196m (11 바이트).
proc style_seq output u64 . input buf mut slice u8 . . effects none . do
  guard ge (len buf) 16 . else return 90 .
  let p option u64 . be t.sgr buf 0 0 .
  guard is_some p . else return 1 .
  guard eq (some_value p) 4 . else return 2 .
  guard eq (index buf 2) 48 . else return 3 .
  guard eq (index buf 3) 109 . else return 4 .
  let q option u64 . be t.color256 buf 0 196 false .
  guard is_some q . else return 5 .
  guard eq (some_value q) 11 . else return 6 .
  guard eq (index buf 2) 51 . else return 7 .
  guard eq (index buf 3) 56 . else return 8 .
  guard eq (index buf 7) 49 . else return 9 .
  guard eq (index buf 10) 109 . else return 10 .
  return 42 .
end .

rem ★ diff: 폭 5·두 행에서 둘째 행의 연속 두 셀만 바뀜 → goto(1,1) + 두 바이트 = 8 바이트.
proc diff_run output u64 . input out mut slice u8 . . effects none . do
  guard ge (len out) 32 . else return 90 .
  let prev slice u8 be "aaaaaaaaaa" .
  let nxt slice u8 be "aaaaaaxyaa" .
  let p option u64 . be t.diff prev nxt 5 out 0 .
  guard is_some p . else return 1 .
  rem ESC[2;2H = 27 91 50 59 50 72, 그리고 'x' 'y'.
  guard eq (some_value p) 8 . else return 2 .
  guard eq (index out 0) 27 . else return 3 .
  guard eq (index out 2) 50 . else return 4 .
  guard eq (index out 4) 50 . else return 5 .
  guard eq (index out 5) 72 . else return 6 .
  guard eq (index out 6) 120 . else return 7 .
  guard eq (index out 7) 121 . else return 8 .
  return 42 .
end .

rem diff 무변경 = 0 바이트("화면 건드리지 마라"가 값이다) · 행 경계는 구간을 가른다.
proc diff_edges output u64 . input out mut slice u8 . . effects none . do
  guard ge (len out) 48 . else return 90 .
  let same slice u8 be "abcabc" .
  let p option u64 . be t.diff same same 3 out 0 .
  guard is_some p . else return 1 .
  guard eq (some_value p) 0 . else return 2 .
  rem 행 끝~다음 행 처음이 바뀌면 **구간 둘**(goto 둘): "ab|cd" 폭 2 에서 b 와 c 가 바뀜.
  let prev slice u8 be "abcd" .
  let nxt slice u8 be "aXYd" .
  let q option u64 . be t.diff prev nxt 2 out 0 .
  guard is_some q . else return 3 .
  rem goto(0,1)+X = 6+1, goto(1,0)+Y = 6+1 → 14 바이트.
  guard eq (some_value q) 14 . else return 4 .
  guard eq (index out 6) 88 . else return 5 .
  guard eq (index out 13) 89 . else return 6 .
  rem 길이 불일치·폭 0 은 값으로 거절.
  let bad option u64 . be t.diff "ab" "abc" 2 out 0 .
  guard is_some bad . else do
    let bad2 option u64 . be t.diff "ab" "cd" 0 out 0 .
    guard is_some bad2 . else return 42 .
    return 8 .
  end .
  return 7 .
end .

rem ★★ UTF-8 셀(슬라이스 5): 열은 **바이트가 아니라 코드포인트 번째**다 — 터미널 커서가 그렇게 센다.
proc utf8_cells output u64 . input out mut slice u8 . . effects none . do
  guard ge (len out) 32 . else return 90 .
  rem "한글" = 6바이트지만 2셀.
  let c option u64 . be t.row_cells "한글" .
  guard is_some c . else return 1 .
  guard eq (some_value c) 2 . else return 2 .
  rem "a한b": 셀 2번째('b')의 바이트 오프셋 = 1+3 = 4.
  let o option u64 . be t.col_off "a한b" 2 .
  guard is_some o . else return 3 .
  guard eq (some_value o) 4 . else return 4 .
  rem 셀 수보다 먼 열은 값으로 거절된다(none) — 화면 밖을 가리키는 커서는 만들지 않는다.
  let far option u64 . be t.col_off "a한b" 9 .
  guard is_some far . else return 42 .
  return 5 .
end .

rem ★ UTF-8 행 diff: 같으면 0바이트 · 둘째 셀만 바뀌면 goto(0,1)+3바이트 = 9바이트.
proc utf8_diff output u64 . input out mut slice u8 . . effects none . do
  guard ge (len out) 32 . else return 90 .
  let z option u64 . be t.diff_row_utf8 "가나다" "가나다" 0 out 0 .
  guard is_some z . else return 1 .
  guard eq (some_value z) 0 . else return 2 .
  let d option u64 . be t.diff_row_utf8 "가나다" "가라다" 0 out 0 .
  guard is_some d . else return 3 .
  guard eq (some_value d) 9 . else return 4 .
  rem ESC[1;2H = 27 91 49 59 50 72 그리고 '라' 의 첫 바이트(0xEB=235).
  guard eq (index out 0) 27 . else return 5 .
  guard eq (index out 4) 50 . else return 6 .
  guard eq (index out 5) 72 . else return 7 .
  guard eq (index out 6) 235 . else return 8 .
  return 42 .
end .

rem ★★ 표시 폭(슬라이스 9): 셀 하나가 늘 한 칸은 아니다 — 한글·CJK 는 **두 칸**을 먹는다.
proc widths output u64 . input out mut slice u8 . . effects none . do
  guard ge (len out) 32 . else return 90 .
  rem "한글" = 2글자지만 **4칸**이다. 코드포인트 수와 칸 수는 다른 값이다.
  let c option u64 . be t.row_cells "한글" .
  guard is_some c . else return 1 .
  guard eq (some_value c) 2 . else return 2 .
  let w option u64 . be t.row_width "한글" .
  guard is_some w . else return 3 .
  guard eq (some_value w) 4 . else return 4 .
  rem ASCII 는 글자 수 = 칸 수.
  let wa option u64 . be t.row_width "abc" .
  guard is_some wa . else return 5 .
  guard eq (some_value wa) 3 . else return 6 .
  rem 섞이면 각자 센다: "a한b" = 1+2+1 = 4칸.
  let wm option u64 . be t.row_width "a한b" .
  guard is_some wm . else return 7 .
  guard eq (some_value wm) 4 . else return 8 .
  return 42 .
end .

rem ★ 칸 수로 자를 때 **글자 한가운데를 자르지 않는다** — 자르면 뒤 바이트가 쓰레기가 된다.
proc fitting output u64 . input out mut slice u8 . . effects none . do
  guard ge (len out) 32 . else return 90 .
  rem "한글" 을 3칸에 맞추면 "한"(2칸)까지 = 3바이트. 4칸이면 둘 다 = 6바이트.
  let f3 option u64 . be t.fit_width "한글" 3 .
  guard is_some f3 . else return 1 .
  guard eq (some_value f3) 3 . else return 2 .
  let f4 option u64 . be t.fit_width "한글" 4 .
  guard is_some f4 . else return 3 .
  guard eq (some_value f4) 6 . else return 4 .
  rem 한 칸도 못 넣으면 0 바이트 — 반 글자를 내놓지 않는다.
  let f1 option u64 . be t.fit_width "한" 1 .
  guard is_some f1 . else return 5 .
  guard eq (some_value f1) 0 . else return 6 .
  return 42 .
end .

rem ★★ 사람이 세는 "한 글자" = grapheme cluster. 코드포인트 수와 다르다.
proc clusters output u64 . effects none . do
  rem "e" + U+0301 = 코드포인트 2, 뭉치 1, 칸 1.
  let c option u64 . be t.row_cells "é" .
  guard is_some c . else return 1 .
  guard eq (some_value c) 2 . else return 2 .
  let g option u64 . be t.row_clusters "é" .
  guard is_some g . else return 3 .
  guard eq (some_value g) 1 . else return 4 .
  let w option u64 . be t.row_width "é" .
  guard is_some w . else return 5 .
  guard eq (some_value w) 1 . else return 6 .
  let n option u64 . be t.cluster_len "é" 0 .
  guard is_some n . else return 7 .
  guard eq (some_value n) 3 . else return 8 .
  let g2 option u64 . be t.row_clusters "é̈" .
  guard is_some g2 . else return 9 .
  guard eq (some_value g2) 1 . else return 10 .
  let g3 option u64 . be t.row_clusters "a한b" .
  guard is_some g3 . else return 11 .
  guard eq (some_value g3) 3 . else return 12 .
  return 42 .
end .
