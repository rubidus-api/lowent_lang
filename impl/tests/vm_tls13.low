rem ★★★ **TLS 1.3 키 스케줄 — 따로 구현한 것과 맞댄다** (RFC 8446 §7.1 · N7b 첫 칸).
rem
rem ★ 이 픽스처는 답을 적어 두지 않는다. 정답은 골든이 밖에서 가져온다.

module vm_tls13 .

use hmac from "../../lib/hmac.low" .
use tls13 from "../../lib/tls13.low" .

fn head8 input d slice u8 . output u64 . do
  var acc u64 be 0 .
  var i u64 be 0 .
  while lt i 8 . do
    set acc (add (shl acc 8) (cast u64 (index d i))) .
    set i (add i 1) .
  end .
  return acc .
end .

rem Expand-Label 한 번 — 라벨과 문맥과 길이를 그대로 받는다.
proc t_expand input secret slice u8 . input label slice u8 . input ctx slice u8 . input outlen u64 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output u64 . effects none . do
  guard eq (tls13.expand_label secret label ctx outlen info scratch out) outlen . else return 0 .
  return head8 out .
end .

rem 사다리 한 칸: prev 에서 "derived" 를 뽑아 ikm 을 Extract 한다.
proc t_advance input prev slice u8 . input ikm slice u8 . input ehash slice u8 . input derived mut slice u8 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output u64 . effects none . do
  guard eq (tls13.advance prev ikm ehash derived info scratch out) 32 . else return 0 .
  return head8 out .
end .

rem 레코드 키와 IV.
proc t_key input secret slice u8 . input klen u64 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output u64 . effects none . do
  guard eq (tls13.traffic_key secret klen info scratch out) klen . else return 0 .
  return head8 out .
end .

proc t_iv input secret slice u8 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output u64 . effects none . do
  guard eq (tls13.traffic_iv secret info scratch out) 12 . else return 0 .
  return head8 out .
end .

rem Finished — 키를 뽑고 전사에 서명한다.
proc t_finished input secret slice u8 . input thash slice u8 . input info mut slice u8 . input scratch mut slice u8 . input fkey mut slice u8 . input out mut slice u8 . output u64 . effects none . do
  guard eq (tls13.finished_key secret info scratch fkey) 32 . else return 0 .
  guard eq (tls13.verify_data fkey thash scratch out) 32 . else return 0 .
  return head8 out .
end .

rem ★★ 레코드 nonce — 시퀀스 번호가 IV 의 **뒤쪽 8 바이트**와 XOR 된다.
proc t_nonce input iv slice u8 . input seq u64 . input out mut slice u8 . output u64 . effects none . do
  guard eq (tls13.record_nonce iv seq out) 12 . else return 0 .
  var acc u64 be 0 .
  var i u64 be 4 .
  while lt i 12 . do
    set acc (add (shl acc 8) (cast u64 (index out i))) .
    set i (add i 1) .
  end .
  return acc .
end .

rem HKDF-Extract 한 번 — RFC 8448 이 사다리의 각 칸에 salt/IKM/secret 을 적어 둔다.
proc t_extract input salt slice u8 . input ikm slice u8 . input scratch mut slice u8 . input prk mut slice u8 . output u64 . effects none . do
  guard eq (hmac.extract salt ikm scratch prk) 32 . else return 0 .
  return head8 prk .
end .

rem ★ 레코드 헤더 — 겉은 언제나 23 ‖ 0x0303 ‖ 길이다.
proc t_header input n u64 . input out mut slice u8 . output u64 . effects none . do
  return tls13.record_header n out .
end .

rem ★★ 속 평문의 **끝**에서 진짜 내용 타입을 읽는다(0 패딩을 건너뛴다).
proc t_inner_type input inner slice u8 . output u64 . effects none . do
  return tls13.inner_type inner .
end .

rem ★★ 레코드 봉인 → 개봉 왕복. 1 이면 원문이 돌아왔다.
proc t_record input suite u64 . input key slice u8 . input iv slice u8 . input seq u64 . input inner slice u8 .
     input rec mut slice u8 . input back mut slice u8 . input w mut slice u8 . input u mut slice u64 . output u64 . effects none . do
  let n u64 be tls13.record_seal suite key iv seq inner rec w u .
  guard eq n (add 5 (add (len inner) 16)) . else return 90 .
  let m u64 be tls13.record_open suite key iv seq (subslice rec 0 n) back w u .
  guard eq m (len inner) . else return 91 .
  var i u64 be 0 .
  while lt i (len inner) . do
    guard eq (index back i) (index inner i) . else return 92 .
    set i (add i 1) .
  end .
  return 1 .
end .

rem ★★ 시퀀스 번호가 틀리면 개봉은 **거절해야** 한다 — nonce 가 달라지기 때문이다.
proc t_record_seq input suite u64 . input key slice u8 . input iv slice u8 . input inner slice u8 .
     input rec mut slice u8 . input back mut slice u8 . input w mut slice u8 . input u mut slice u64 . output u64 . effects none . do
  let n u64 be tls13.record_seal suite key iv 7 inner rec w u .
  guard gt n 0 . else return 90 .
  guard eq (tls13.record_open suite key iv 8 (subslice rec 0 n) back w u) 0 . else return 91 .
  guard eq (tls13.record_open suite key iv 7 (subslice rec 0 n) back w u) (len inner) . else return 92 .
  return 1 .
end .

rem ★★★ **정본의 레코드를 그대로 만든다** — RFC 8448 §3 의 암호문·태그까지.
rem   inner 는 정본의 payload 에 내용 타입 한 바이트를 붙인 것이고, 그 결과가 정본의
rem   complete record 와 **바이트까지** 같아야 한다.
proc t_record_exact input suite u64 . input key slice u8 . input iv slice u8 . input seq u64 . input inner slice u8 .
     input rec mut slice u8 . input w mut slice u8 . input u mut slice u64 . output u64 . effects none . do
  return tls13.record_seal suite key iv seq inner rec w u .
end .

rem ★ 전사 해시 — 버퍼 앞 n 바이트.
proc t_transcript input buf slice u8 . input n u64 . input out mut slice u8 . output u64 . effects none . do
  return tls13.transcript buf n out .
end .

rem ★ 핸드셰이크 메시지 걷기 — 타입 · 크기 · 개수.
fn t_hs_type input buf slice u8 . input off u64 . output u64 . do  return tls13.hs_type buf off . end .
fn t_hs_size input buf slice u8 . input off u64 . output u64 . do  return tls13.hs_size buf off . end .
fn t_hs_count input buf slice u8 . output u64 . do  return tls13.hs_count buf . end .

rem ★★ 서버 Finished 가 우리가 본 전사와 맞는가. 1 이면 맞다.
proc t_check_finished input secret slice u8 . input thash slice u8 . input got slice u8 .
     input info mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  return tls13.check_finished secret thash got info w .
end .

rem ── ★ 라이브러리 보안 점검 증인 (2026-09-04, libreview) ─────────────────────
rem ✘ Finished 의 verify_data 는 **정확히 32 바이트**다(RFC 8446 §4.4.4). 전에는 `ge` 라서
rem   뒤에 쓰레기 8 바이트가 붙은 40 바이트도 통과했다. 1 = 32 는 받고 40 은 거절한다.
proc t_fin_exact input secret slice u8 . input thash slice u8 . input info mut slice u8 . input w mut slice u8 . input got mut slice u8 . output u64 . effects none . do
  guard ge (len got) 40 . else return 0 .
  guard ge (len w) 1152 . else return 0 .
  guard eq (tls13.finished_key secret info (subslice w 576 1152) (subslice w 0 32)) 32 . else return 0 .
  guard eq (tls13.verify_data (subslice w 0 32) thash (subslice w 576 1152) (subslice got 0 32)) 32 . else return 0 .
  var i u64 be 32 .
  while lt i 40 . do  set (index got i) 255 .  set i (add i 1) .  end .
  guard eq (tls13.check_finished secret thash (subslice got 0 32) info (subslice w 0 576)) 1 . else return 91 .
  guard eq (tls13.check_finished secret thash (subslice got 0 40) info (subslice w 0 576)) 0 . else return 92 .
  return 1 .
end .
