rem ★★★★★ **TLS 1.3 서버 핸드셰이크 — 메시지 층과 상태** (RFC 8446 · RFC-0090 §N7b)
rem
rem   `tls13` 이 규격의 **계산**을 갖고 있고, 이 파일이 그것을 **순서대로 부르는 층**을 잰다.
rem
rem ★ 오라클은 **RFC 8448 §3 의 실제 핸드셰이크**다. 정본의 ClientHello 를 읽고, 정본의
rem   서버 랜덤·공개키로 ServerHello 를 지어 **정본과 바이트로 맞댄다.**
rem   ☞ 필드를 눈으로 확인하는 검사는 검사가 아니다. **지어서 정본과 같은지**가 검사다.

module vm_tlssrv .
use tlssrv from "../../lib/tlssrv.low" .
use tls13 from "../../lib/tls13.low" .
use codec from "../../lib/codec.low" .
use x25519 from "../../lib/x25519.low" .

rem RFC 8448 §3 의 ClientHello (196 바이트)
fn ch_hex output slice u8 . . do
  return "" .
end .
rem 그 핸드셰이크의 ServerHello (90 바이트)
fn sh_hex output slice u8 . . do
  return "020000560303a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e2692800130100002e00330024001d0020c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f002b00020304" .
end .

proc ch_bytes input out mut slice u8 . . output u64 . effects none . do
  let d option u64 . be codec.hex_dec (ch_hex) out .
  guard is_some d . else return 0 .
  return some_value d .
end .

rem ── ClientHello 를 읽는다 ────────────────────────────────────────────────
export proc ch_is_ok input w mut slice u8 . . output u64 . effects none . do
  guard eq (ch_bytes (subslice w 0 196)) 196 . else return 0 .
  if tlssrv.ch_ok (subslice w 0 196) . do  return 1 . end .
  return 0 .
end .

rem 정본의 session_id 는 **비었다**(0) · suites 는 6 바이트(세 개).
export proc ch_shape input w mut slice u8 . . output u64 . effects none . do
  guard eq (ch_bytes (subslice w 0 196)) 196 . else return 0 .
  let b slice u8 . be subslice w 0 196 .
  return add (mul (tlssrv.ch_sid_len b) 1000) (tlssrv.ch_suites_len b) .
end .

rem ✔ AES-128-GCM(0x1301)·ChaCha20(0x1303) 둘 다 있다 · 없는 것(0x9999)은 없다.
export proc ch_suites input w mut slice u8 . . output u64 . effects none . do
  guard eq (ch_bytes (subslice w 0 196)) 196 . else return 0 .
  let b slice u8 . be subslice w 0 196 .
  var acc u64 be 0 .
  if tlssrv.ch_has_suite b 4865 . do  set acc (add acc 100) . end .
  if tlssrv.ch_has_suite b 4867 . do  set acc (add acc 10) . end .
  if tlssrv.ch_has_suite b 39321 . do  set acc (add acc 1) . end .
  return acc .
end .

rem ✔ x25519 공개키 자리 — 정본에서 그 32 바이트의 첫 4 바이트는 0x99381de5 다.
export proc ch_keyshare input w mut slice u8 . . output u64 . effects none . do
  guard eq (ch_bytes (subslice w 0 196)) 196 . else return 0 .
  let b slice u8 . be subslice w 0 196 .
  let o u64 be tlssrv.ch_x25519_off b .
  guard gt o 0 . else return 0 .
  var acc u64 be 0 .
  var i u64 be 0 .
  while lt i 4 . do
    set acc (bit_or (shl acc 8) (cast u64 (index b (add o i)))) .
    set i (add i 1) .
  end .
  return acc .
end .

rem ✔ SNI(0)·supported_versions(43) 는 있고, ALPN(16) 은 이 정본에 없다.
export proc ch_exts input w mut slice u8 . . output u64 . effects none . do
  guard eq (ch_bytes (subslice w 0 196)) 196 . else return 0 .
  let b slice u8 . be subslice w 0 196 .
  var acc u64 be 0 .
  if gt (tlssrv.ch_ext_find b 0) 0 . do  set acc (add acc 100) . end .
  if gt (tlssrv.ch_ext_find b 43) 0 . do  set acc (add acc 10) . end .
  if gt (tlssrv.ch_ext_find b 16) 0 . do  set acc (add acc 1) . end .
  return acc .
end .

rem ── ★★★ ServerHello 를 지어 정본과 맞댄다 ──────────────────────────────
rem   같으면 90(길이), 다르면 그 **첫 다른 자리 + 1000** 을 낸다 — 어디서 갈렸는지 말한다.
export proc sh_build input w mut slice u8 . . output u64 . effects none . do
  guard ge (len w) 512 . else return 0 .
  let dr option u64 . be codec.hex_dec "a6af06a4121860dc5e6e60249cd34c95930c8ac5cb1434dac155772ed3e26928" (subslice w 0 32) .
  guard is_some dr . else return 0 .
  let dk option u64 . be codec.hex_dec "c9828876112095fe66762bdbf7c672e156d6cc253b833df1dd69b1b04e751f0f" (subslice w 32 64) .
  guard is_some dk . else return 0 .
  let n u64 be tlssrv.build_sh (subslice w 0 32) (subslice w 64 64) 4865 (subslice w 32 64) (subslice w 128 320) .
  guard eq n 90 . else return 0 .
  let dw option u64 . be codec.hex_dec (sh_hex) (subslice w 320 410) .
  guard is_some dw . else return 0 .
  var i u64 be 0 .
  while lt i 90 . do
    if ne (index w (add 128 i)) (index w (add 320 i)) . do  return add 1000 i . end .
    set i (add i 1) .
  end .
  return n .
end .

rem ── 상태 ─────────────────────────────────────────────────────────────────
rem ✔ START 에서 ClientHello 만 받는다 · WAIT_FINISHED 에서 Finished 만 받는다.
export fn state_ok output u64 . do
  var acc u64 be 0 .
  if tlssrv.next_ok 0 1 . do  set acc (add acc 1000) . end     rem START ← CH  ✔ . .
  if tlssrv.next_ok 0 20 . do  set acc (add acc 100) . end      rem START ← Finished ✘ . .
  if tlssrv.next_ok 4 20 . do  set acc (add acc 10) . end       rem WAIT ← Finished ✔ . .
  if tlssrv.next_ok 4 1 . do  set acc (add acc 1) . end         rem WAIT ← CH ✘ . .
  return acc .
end .
rem ✔ 못 옮기면 **같은 자리에 머문다** — 조용히 건너뛰지 않는다.
export fn state_advance output u64 . do
  return add (mul (tlssrv.step 0 1) 100) (tlssrv.step 0 20) .
end .

rem ── 나머지 세 메시지와 Finished — 정본과 **바이트로** 맞댄다 ─────────────
rem   같으면 길이, 다르면 **첫 다른 자리 + 10000** 을 낸다(어디서 갈렸는지 말한다).
proc cmp_hex input got slice u8 . input n u64 . input want_hex slice u8 . input w mut slice u8 . . output u64 . effects none . do
  guard ge (len w) n . else return 1 .
  let d option u64 . be codec.hex_dec want_hex (subslice w 0 n) .
  guard is_some d . else return 2 .
  guard eq (some_value d) n . else return 3 .
  var i u64 be 0 .
  while lt i n . do
    if ne (index got i) (index w i) . do  return add 10000 i . end .
    set i (add i 1) .
  end .
  return n .
end .

rem ✔ EncryptedExtensions — 정본의 확장 블록(34 B)을 감싸면 40 B 가 나온다.
export proc ee_build input w mut slice u8 . . output u64 . effects none . do
  guard ge (len w) 512 . else return 0 .
  let d option u64 . be codec.hex_dec "000a00140012001d00170018001901000101010201030104001c0002400100000000" (subslice w 0 34) .
  guard is_some d . else return 0 .
  let n u64 be tlssrv.build_ee (subslice w 0 34) (subslice w 64 128) .
  guard eq n 40 . else return add 20000 n .
  return cmp_hex (subslice w 64 128) 40 "080000240022000a00140012001d00170018001901000101010201030104001c0002400100000000" (subslice w 192 448) .
end .

rem ✔ Certificate — 정본의 DER(432 B)을 감싸면 445 B.
export proc cert_build input w mut slice u8 . . output u64 . effects none . do
  guard ge (len w) 1400 . else return 0 .
  let d option u64 . be codec.hex_dec "" (subslice w 0 432) .
  guard is_some d . else return 0 .
  let n u64 be tlssrv.build_cert (subslice w 0 432) (subslice w 448 896) .
  guard eq n 445 . else return add 20000 n .
  return cmp_hex (subslice w 448 896) 445 "" (subslice w 900 1400) .
end .

rem ✔ CertificateVerify — 정본은 RSA-PSS(0x0804) 다. 알고리즘과 서명을 감싸면 136 B.
rem   ☞ 우리 서명기는 ECDSA(0x0403)이지만 **틀은 같다** — 여기서 재는 것은 틀이다.
export proc cv_build input w mut slice u8 . . output u64 . effects none . do
  guard ge (len w) 512 . else return 0 .
  let d option u64 . be codec.hex_dec "5a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3" (subslice w 0 128) .
  guard is_some d . else return 0 .
  let n u64 be tlssrv.build_cv 2052 (subslice w 0 128) (subslice w 128 300) .
  guard eq n 136 . else return add 20000 n .
  return cmp_hex (subslice w 128 300) 136 "0f000084080400805a747c5d88fa9bd2e55ab085a61015b7211f824cd484145ab3ff52f1fda8477b0b7abc90db78e2d33a5c141a078653fa6bef780c5ea248eeaaa785c4f394cab6d30bbe8d4859ee511f602957b15411ac027671459e46445c9ea58c181e818e95b8c3fb0bf3278409d3be152a3da5043e063dda65cdf5aea20d53dfacd42f74f3" (subslice w 300 500) .
end .

rem ✔ Finished — verify_data 32 B 를 감싸면 36 B.
export proc fin_build input w mut slice u8 . . output u64 . effects none . do
  guard ge (len w) 256 . else return 0 .
  let d option u64 . be codec.hex_dec "9b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718" (subslice w 0 32) .
  guard is_some d . else return 0 .
  let n u64 be tlssrv.build_fin (subslice w 0 32) (subslice w 64 128) .
  guard eq n 36 . else return add 20000 n .
  return cmp_hex (subslice w 64 128) 36 "140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718" (subslice w 128 256) .
end .

rem ✔★★ **CertificateVerify 가 서명하는 내용** (RFC 8446 §4.4.3) — 130 B.
rem   앞 64 바이트가 전부 0x20 이고, 65 번째부터 문맥 문자열, 그 뒤 0x00, 그 뒤 전사해시.
rem   ☞ 그 공백과 문맥 문자열이 없으면 이 서명이 **다른 문맥으로 재활용**될 수 있다.
export proc cv_content_shape input w mut slice u8 . . output u64 . effects none . do
  guard ge (len w) 256 . else return 0 .
  var z u64 be 0 .
  while lt z 32 . do  set (index w z) (narrow u8 z) .  set z (add z 1) . end .
  let n u64 be tlssrv.cv_content (subslice w 0 32) (subslice w 64 200) .
  guard eq n 130 . else return 0 .
  var acc u64 be 0 .
  rem ① 앞 64 가 전부 0x20 인가
  var sp u64 be 1 .
  var i u64 be 0 .
  while lt i 64 . do
    if ne (index w (add 64 i)) 32 . do  set sp 0 . end .
    set i (add i 1) .
  end .
  if eq sp 1 . do  set acc (add acc 1000) . end .
  rem ② 문맥 문자열의 첫 글자가 'T'(84) 이고 ③ 97 번째가 0x00 인가 ④ 그 뒤가 전사해시인가
  if eq (index w (add 64 64)) 84 . do  set acc (add acc 100) . end .
  if eq (index w (add 64 97)) 0 . do  set acc (add acc 10) . end .
  if eq (index w (add 64 98)) 0 . do
    if eq (index w (add 64 99)) 1 . do  set acc (add acc 1) . end .
  end .
  return acc .
end .

rem ── ★★★★★ 구동부: ECDHE 에서 서버 Finished 까지 ─────────────────────────
rem   정본의 값으로 **한 줄로 엮어** 서버 Finished 를 낸다. 정본과 같으면 36.
rem   ☞ 이 한 수가 **전사 자르는 자리 · 키 스케줄 · finished_key · verify_data** 를 한꺼번에 건다.
export proc flight input w mut slice u8 . . input v mut slice u8 . . output u64 . effects none . do
  guard ge (len w) 2048 . else return 0 .
  guard ge (len v) 2048 . else return 0 .
  let de option u64 . be codec.hex_dec "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d" (subslice v 0 32) .
  guard is_some de . else return 0 .
  let d1 option u64 . be codec.hex_dec "" (subslice v 32 318) .
  guard is_some d1 . else return 0 .
  let d2 option u64 . be codec.hex_dec "" (subslice v 318 1225) .
  guard is_some d2 . else return 0 .
  let n_r result u64 tlssrv.tlssrv_error . be tlssrv.server_finished (subslice v 0 32) (subslice v 32 318) (subslice v 318 1225) (subslice v 1225 1261) w .
  guard is_ok n_r . else return 0 .
  let n u64 be ok_value n_r .
  guard eq n 36 . else return add 20000 n .
  return cmp_hex (subslice v 1225 1261) 36 "140000209b9b141d906337fbd2cbdce71df4deda4ab42c309572cb7fffee5454b78f0718" (subslice v 1269 1333) .
end .

rem ✔ **ECDHE 도 우리가 낸다** — 정본의 서버 개인키와 클라이언트 공개키로.
rem ☞ `x25519.agree` 의 작업 공간은 **조각(u64)** 175 개다 — 바이트가 아니다.
rem   처음에 바이트 슬라이스를 넘겨 0 을 받았다. 같은 이름(`w`)이 두 뜻을 나르면 이런다.
export proc ecdhe_ok input wu mut slice u64 . input v mut slice u8 . . output u64 . effects none . do
  guard ge (len v) 512 . else return 0 .
  guard ge (len wu) 175 . else return 0 .
  let dp option u64 . be codec.hex_dec "b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e" (subslice v 0 32) .
  guard is_some dp . else return 0 .
  let dc option u64 . be codec.hex_dec "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c" (subslice v 32 64) .
  guard is_some dc . else return 0 .
  let _u2 result u64 x25519.x25519_error . be x25519.agree (subslice v 64 96) (subslice v 0 32) (subslice v 32 64) (subslice v 96 128) (subslice wu 0 175) .
  guard is_ok _u2 . else return 0 .
  guard eq (ok_value _u2) 32 . else return 0 .
  return cmp_hex (subslice v 64 96) 32 "8bd4054fb55b9d63fdfbacf9f04b9f0d35e6d63f537563efd46272900f89492d" (subslice v 128 256) .
end .

rem ── ★★★★★ 응용 트래픽 비밀 · 클라이언트 Finished ─────────────────────────
rem   전사가 **또 다르다**: 응용 비밀과 클라이언트 Finished 는 **서버 Finished 까지**의
rem   해시 위에 선다(클라이언트 Finished 는 **자기 자신을 포함하지 않는다**).
rem ★ 이름이 `setup` 이 아닌 이유: `poly.setup` 과 부딪힌다(aead 를 타고 딸려 온다).
rem   이름공간이 평면이라 `--ops` 가 `setup` 을 **두 모양으로** 내고, 차등 퍼저가 맞는 인자를
rem   못 만들어 **이 op 을 아예 못 돌린다** — 골든의 `0 not reachable` 이 그것을 잡았다.
rem   ☞ *못 도는 op 은 아무도 검증하지 않는다.* 오늘 세 번째 같은 충돌이다(decode · advance · setup).
proc lay_msgs input v mut slice u8 . . output u64 . effects none . do
  rem ★ 길이 가드 — 없으면 짧은 인자에서 `subslice` 가 **트랩**한다. 그러면 차등 퍼저가
  rem   이 op 을 **아예 못 돌리고**(`0 not reachable` 이 1 이 된다), 골든이 그것을 잡는다.
  rem   ☞ 퍼저가 닿는 것은 덤이고, 이 줄은 **원래 있어야 했다** — 이 파일의 다른 op 은 전부
  rem     길이를 먼저 본다. *못 재는 op 은 아무도 검증하지 않는다.*
  guard ge (len v) 1171 . else return 0 .
  let d3 option u64 . be codec.hex_dec "" (subslice v 0 943) .
  guard is_some d3 . else return 0 .
  return 1 .
end .

rem ✔ c/s 응용 트래픽 비밀 — 각각의 첫 4 바이트를 한 수로 낸다.
export proc ap_secrets input w mut slice u8 . . input v mut slice u8 . . output u64 . effects none . do
  guard ge (len v) 2048 . else return 0 .
  guard ge (len w) 1024 . else return 0 .
  guard eq (lay_msgs v) 1 . else return 0 .
  let dh option u64 . be codec.hex_dec "1dc826e93606aa6fdc0aadc12f741b01046aa6b99f691ed221a9f0ca043fbeac" (subslice v 1107 1171) .
  guard is_some dh . else return 0 .
  let _u1 result u64 tlssrv.tlssrv_error . be tlssrv.app_secrets (subslice v 1107 (add 1107 32)) (subslice v 0 943) (subslice v 943 1007) w .
  guard is_ok _u1 . else return 0 .
  guard eq (ok_value _u1) 64 . else return 0 .
  rem 두 비밀의 첫 4 바이트를 한 수로 접는다(클라 전부 · 서버는 하위 4비트만 — u64 안에 들게).
  var a u64 be 0 .
  var i u64 be 0 .
  while lt i 4 . do
    set a (bit_or (shl a 8) (cast u64 (index v (add 943 i)))) .
    set i (add i 1) .
  end .
  var b u64 be 0 .
  var j u64 be 0 .
  while lt j 4 . do
    set b (bit_or (shl b 8) (cast u64 (index v (add 975 j)))) .
    set j (add j 1) .
  end .
  return add (mul a 10) (bit_and b 15) .
end .

rem ✔ 클라이언트 Finished 를 **다시 계산해** 맞춘다 — 맞으면 1.
export proc client_fin_ok input w mut slice u8 . . input v mut slice u8 . . output u64 . effects none . do
  guard ge (len v) 2048 . else return 0 .
  guard ge (len w) 1024 . else return 0 .
  guard eq (lay_msgs v) 1 . else return 0 .
  let dc option u64 . be codec.hex_dec "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21" (subslice v 1107 (add 1107 32)) .
  guard is_some dc . else return 0 .
  let df option u64 . be codec.hex_dec "14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61" (subslice v 1007 1043) .
  guard is_some df . else return 0 .
  let _rr result u64 tlssrv.tlssrv_error . be tlssrv.check_client_finished (subslice v 1107 (add 1107 32)) (subslice v 0 943) (subslice v 1007 1043) w .
  guard is_ok _rr . else return 0 .
  return ok_value _rr .
end .

rem ✘ **한 비트만 바꾸면 거절돼야 한다** — 성립만 보면 "언제나 참" 을 못 거른다.
export proc client_fin_bad input w mut slice u8 . . input v mut slice u8 . . output u64 . effects none . do
  guard ge (len v) 2048 . else return 0 .
  guard eq (lay_msgs v) 1 . else return 0 .
  let dc option u64 . be codec.hex_dec "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21" (subslice v 1107 (add 1107 32)) .
  guard is_some dc . else return 0 .
  let df option u64 . be codec.hex_dec "14000020a8ec436d677634ae525ac1fcebe11a039ec17694fac6e98527b642f2edd5ce61" (subslice v 1007 1043) .
  guard is_some df . else return 0 .
  set (index v (add 1007 35)) (cast u8 (bit_xor (cast u64 (index v (add 1007 35))) 1)) .
  let _rr result u64 tlssrv.tlssrv_error . be tlssrv.check_client_finished (subslice v 1107 (add 1107 32)) (subslice v 0 943) (subslice v 1007 1043) w .
  guard is_ok _rr . else return 0 .
  return ok_value _rr .
end .

rem ── ★★★★★ 응용 데이터 레코드 — 정본과 바이트로 ──────────────────────────
rem   비밀 → 키·IV → 레코드. 방향마다 **다른 비밀·다른 시퀀스**이고, 시퀀스는
rem   **키 세대마다 0 부터**다(핸드셰이크 키에서 응용 키로 넘어갈 때 이어지지 않는다).

rem ✔ 키뭉치 — 서버 쓰기(s ap traffic) → 키 16 ‖ IV 12. 정본과 같으면 28.
export proc app_keys input w mut slice u8 . . input v mut slice u8 . . output u64 . effects none . do
  guard ge (len v) 512 . else return 0 .
  guard ge (len w) 1024 . else return 0 .
  let ds option u64 . be codec.hex_dec "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643" (subslice v 0 32) .
  guard is_some ds . else return 0 .
  let _u0 result u64 tlssrv.tlssrv_error . be tlssrv.traffic_keys (subslice v 0 32) 16 (subslice v 32 60) w .
  guard is_ok _u0 . else return 0 .
  guard eq (ok_value _u0) 28 . else return 0 .
  return cmp_hex (subslice v 32 60) 28 "9f02283b6c9c07efc26bb9f2ac92e356cf782b88dd83549aadf1e984" (subslice v 64 256) .
end .

rem ✔ 봉인 — 정본의 평문 50 B 를 시퀀스 0 으로 봉하면 **72 B 레코드**가 나와야 한다.
export proc app_seal input w mut slice u8 . . input v mut slice u8 . . input u mut slice u64 . output u64 . effects none . do
  guard ge (len v) 1024 . else return 0 .
  guard ge (len w) 2048 . else return 0 .
  let dk option u64 . be codec.hex_dec "9f02283b6c9c07efc26bb9f2ac92e356cf782b88dd83549aadf1e984" (subslice v 0 28) .
  guard is_some dk . else return 0 .
  let dp option u64 . be codec.hex_dec "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f3031" (subslice v 32 82) .
  guard is_some dp . else return 0 .
  let n_r result u64 tlssrv.tlssrv_error . be tlssrv.seal_app 1 (subslice v 0 28) 16 1 (subslice v 32 82) (subslice v 128 256) w u .
  guard is_ok n_r . else return 0 .
  let n u64 be ok_value n_r .
  guard eq n 72 . else return add 20000 n .
  return cmp_hex (subslice v 128 256) 72 "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d" (subslice v 256 512) .
end .

rem ✔ 개봉 — 정본의 레코드를 열면 속 평문 51 B(평문 50 + 타입 1)이고 타입이 23 이다.
export proc app_open input w mut slice u8 . . input v mut slice u8 . . input u mut slice u64 . output u64 . effects none . do
  guard ge (len v) 1024 . else return 0 .
  guard ge (len w) 2048 . else return 0 .
  let dk option u64 . be codec.hex_dec "9f02283b6c9c07efc26bb9f2ac92e356cf782b88dd83549aadf1e984" (subslice v 0 28) .
  guard is_some dk . else return 0 .
  let dr option u64 . be codec.hex_dec "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d" (subslice v 32 104) .
  guard is_some dr . else return 0 .
  let nr result u64 tlssrv.tlssrv_error . be tlssrv.open_app 1 (subslice v 0 28) 16 1 (subslice v 32 104) (subslice v 128 256) w u .
  guard is_ok nr . else return 0 .
  let n u64 be ok_value nr .
  guard eq n 51 . else return add 20000 n .
  rem 속 타입이 23(application_data) 인가 · 평문 첫 4 바이트가 00 01 02 03 인가
  var acc u64 be 0 .
  if eq (tls13.inner_type (subslice v 128 179)) 23 . do  set acc (add acc 100) . end .
  if eq (cast u64 (index v 128)) 0 . do
    if eq (cast u64 (index v 131)) 3 . do  set acc (add acc 10) . end .
  end .
  if eq (cast u64 (index v 177)) 49 . do  set acc (add acc 1) . end   rem 평문 마지막 = 0x31 . .
  return acc .
end .

rem ✘ **한 비트만 바꾸면 열리면 안 된다** — AEAD 의 태그가 그 일을 한다.
export proc app_open_bad input w mut slice u8 . . input v mut slice u8 . . input u mut slice u64 . output u64 . effects none . do
  guard ge (len v) 1024 . else return 0 .
  guard ge (len w) 2048 . else return 0 .
  let dk option u64 . be codec.hex_dec "9f02283b6c9c07efc26bb9f2ac92e356cf782b88dd83549aadf1e984" (subslice v 0 28) .
  guard is_some dk . else return 0 .
  let dr option u64 . be codec.hex_dec "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d" (subslice v 32 104) .
  guard is_some dr . else return 0 .
  set (index v 40) (cast u8 (bit_xor (cast u64 (index v 40)) 1)) .
  let _rr result u64 tlssrv.tlssrv_error . be tlssrv.open_app 1 (subslice v 0 28) 16 1 (subslice v 32 104) (subslice v 128 256) w u .
  guard is_ok _rr . else return 0 .
  return ok_value _rr .
end .

rem ✘ **시퀀스가 틀리면 열리면 안 된다** — 논스가 달라지므로 태그가 안 맞는다.
rem   ☞ 이것이 재전송·재배열을 막는 자리다.
export proc app_open_seq input w mut slice u8 . . input v mut slice u8 . . input u mut slice u64 . output u64 . effects none . do
  guard ge (len v) 1024 . else return 0 .
  guard ge (len w) 2048 . else return 0 .
  let dk option u64 . be codec.hex_dec "9f02283b6c9c07efc26bb9f2ac92e356cf782b88dd83549aadf1e984" (subslice v 0 28) .
  guard is_some dk . else return 0 .
  let dr option u64 . be codec.hex_dec "17030300432e937e11ef4ac740e538ad36005fc4a46932fc3225d05f82aa1b36e30efaf97d90e6dffc602dcb501a59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d" (subslice v 32 104) .
  guard is_some dr . else return 0 .
  let _rr result u64 tlssrv.tlssrv_error . be tlssrv.open_app 1 (subslice v 0 28) 16 0 (subslice v 32 104) (subslice v 128 256) w u .
  guard is_ok _rr . else return 0 .
  return ok_value _rr .
end .

rem ✔ **경보도 같은 레코드다** — 정본의 경보(24 B)를 열면 속이 2 B + 타입이고 타입은 21 이다.
rem   ☞ 겉만 보면 응용 데이터와 구별이 안 된다. 그것이 설계다 — 그리고 그래서
rem     **속 타입을 안 보면 경보를 데이터로 읽는다.**
export proc alert_open input w mut slice u8 . . input v mut slice u8 . . input u mut slice u64 . output u64 . effects none . do
  guard ge (len v) 1024 . else return 0 .
  guard ge (len w) 2048 . else return 0 .
  let dk option u64 . be codec.hex_dec "9f02283b6c9c07efc26bb9f2ac92e356cf782b88dd83549aadf1e984" (subslice v 0 28) .
  guard is_some dk . else return 0 .
  let dr option u64 . be codec.hex_dec "1703030013b58fd67166ebf599d24720cfbe7efa7a8864a9" (subslice v 32 56) .
  guard is_some dr . else return 0 .
  rem ★ 정본의 서버 응용 키 시퀀스: **NewSessionTicket 0 · 응용 데이터 1 · 경보 2**.
  rem   ☞ 처음에 0·1 로 적었다가 안 열렸다 — 시퀀스는 **레코드마다** 오르고, 핸드셰이크 뒤
  rem     첫 응용-키 레코드는 티켓이다. *세는 것은 레코드이지 "내가 보낸 데이터" 가 아니다.*
  let nr2 result u64 tlssrv.tlssrv_error . be tlssrv.open_app 1 (subslice v 0 28) 16 2 (subslice v 32 56) (subslice v 128 256) w u .
  guard is_ok nr2 . else return 0 .
  let n u64 be ok_value nr2 .
  guard eq n 3 . else return add 20000 n .
  return add (mul (tls13.inner_type (subslice v 128 131)) 100) (cast u64 (index v 128)) .
end .

proc main output u8 . effects none . do
  return 0 .
end .

rem ── ★ 라이브러리 보안 점검 증인 (2026-09-04, libreview) ─────────────────────
rem ✘ **작은 위수 점과의 합의는 0 이어야 한다** (RFC 7748 §6.1 · RFC 8446 §7.4.2 MUST).
rem   u=0 · u=1 · 위수 8 점은 공유 비밀이 전부 0 이 되어 상대가 키를 **미리 안다**.
rem   셋을 거절하고, 정본의 클라이언트 공개키와는 여전히 32 를 낸다. 1 = 전부 옳다.
export proc t_x25519_smallorder input v mut slice u8 . . input wu mut slice u64 . output u64 . effects none . do
  guard ge (len v) 512 . else return 0 .
  guard ge (len wu) 175 . else return 0 .
  let dp option u64 . be codec.hex_dec "b1580eeadf6dd589b8ef4f2d5652578cc810e9980191ec8d058308cea216a21e" (subslice v 0 32) .
  guard is_some dp . else return 0 .
  var i u64 be 0 .
  while lt i 32 . do  set (index v (add 32 i)) 0 .  set i (add i 1) .  end .
  let _ag0 result u64 x25519.x25519_error . be x25519.agree (subslice v 64 96) (subslice v 0 32) (subslice v 32 64) (subslice v 96 128) (subslice wu 0 175) .
  guard is_ok _ag0 . else return 0 .
  if ne (ok_value _ag0) 0 . do  return 91 . end .
  set (index v 32) 1 .
  let _ag1 result u64 x25519.x25519_error . be x25519.agree (subslice v 64 96) (subslice v 0 32) (subslice v 32 64) (subslice v 96 128) (subslice wu 0 175) .
  guard is_ok _ag1 . else return 0 .
  if ne (ok_value _ag1) 0 . do  return 92 . end .
  let d8 option u64 . be codec.hex_dec "e0eb7a7c3b41b8ae1656e3faf19fc46ada098deb9c32b1fd866205165f49b800" (subslice v 32 64) .
  guard is_some d8 . else return 0 .
  let _ag2 result u64 x25519.x25519_error . be x25519.agree (subslice v 64 96) (subslice v 0 32) (subslice v 32 64) (subslice v 96 128) (subslice wu 0 175) .
  guard is_ok _ag2 . else return 0 .
  if ne (ok_value _ag2) 0 . do  return 93 . end .
  let dc option u64 . be codec.hex_dec "99381de560e4bd43d23d8e435a7dbafeb3c06e51c13cae4d5413691e529aaf2c" (subslice v 32 64) .
  guard is_some dc . else return 0 .
  let _ag3 result u64 x25519.x25519_error . be x25519.agree (subslice v 64 96) (subslice v 0 32) (subslice v 32 64) (subslice v 96 128) (subslice wu 0 175) .
  guard is_ok _ag3 . else return 0 .
  if ne (ok_value _ag3) 32 . do  return 94 . end .
  return 1 .
end .

rem ✘ `server_finished` 도 전부 0 인 ECDHE 를 **스스로** 거절해야 한다 — x25519 를 안 거친
rem   호출자(다른 그룹·다른 구현)가 줄 수도 있는 값이다. 1 = 거절했다.
export proc t_sf_zero_ecdhe input w mut slice u8 . . input v mut slice u8 . . output u64 . effects none . do
  guard ge (len w) 1024 . else return 0 .
  guard ge (len v) 2048 . else return 0 .
  var i u64 be 0 .
  while lt i 32 . do  set (index v i) 0 .  set i (add i 1) .  end .
  guard eq (ch_bytes (subslice v 32 228)) 196 . else return 0 .
  let ds option u64 . be codec.hex_dec (sh_hex) (subslice v 228 318) .
  guard is_some ds . else return 0 .
  let _sf4 result u64 tlssrv.tlssrv_error . be tlssrv.server_finished (subslice v 0 32) (subslice v 32 318) (subslice v 32 318) (subslice v 1225 1261) w .
  guard is_ok _sf4 . else return 0 .
  if ne (ok_value _sf4) 0 . do  return 95 . end .
  return 1 .
end .

rem ✘ **성하지 않은 ClientHello 는 `ch_ok` 가 거짓이어야 한다** — 전에는 sid_len·suites_len 의
rem   0 이 「비었다」와 「틀렸다」를 겸해 하류가 틀린 자리에서 다시 읽고 **받아들였다**.
rem   비튼 것 여덟: sid_len 0xff · sid_len 33 · 홀수 suites 길이 · 압축 [1] · 압축 길이 0 ·
rem   supported_versions 없음(종류를 모르는 확장으로 바꿈) · 같은 확장 둘 · key_share 에 같은 그룹 둘.
rem   그리고 정본 그대로는 여전히 참이다. 1 = 전부 옳다, 9x = x 번째가 틀렸다.
export proc t_ch_bad input w mut slice u8 . . output u64 . effects none . do
  guard ge (len w) 256 . else return 0 .
  guard eq (ch_bytes (subslice w 0 196)) 196 . else return 0 .
  if eq (tlssrv.ch_ok (subslice w 0 196)) false . do  return 90 . end .
  set (index w 38) 255 .
  if tlssrv.ch_ok (subslice w 0 196) . do  return 91 . end .
  set (index w 38) 33 .
  if tlssrv.ch_ok (subslice w 0 196) . do  return 92 . end .
  set (index w 38) 0 .
  set (index w 40) 7 .
  if tlssrv.ch_ok (subslice w 0 196) . do  return 93 . end .
  set (index w 40) 6 .
  set (index w 48) 1 .
  if tlssrv.ch_ok (subslice w 0 196) . do  return 94 . end .
  set (index w 48) 0 .
  set (index w 47) 0 .
  if tlssrv.ch_ok (subslice w 0 196) . do  return 95 . end .
  set (index w 47) 1 .
  rem ★ 아래 자리 수는 **재서 얻은 것**이다(RFC 8448 hello 를 걸어 본 값):
  rem   supported_versions(002b) 값 145 → 종류 두 바이트는 141·142 · signature_algorithms(000d)
  rem   값 152 → 종류 낮은 바이트 149 · key_share 의 x25519 키 109 → 길이 낮은 바이트 108.
  rem   ☞ 손으로 센 수를 적어 두면 그 수가 틀렸을 때 **시험이 조용히 통과**한다(여기서 열한 자리
  rem     어긋나 있었다) — 그래서 그 자리를 op 에게 되물어 `guard` 로 **못 박는다**.
  rem 종류를 0x7a7a 로 바꾼다(길이는 그대로) → supported_versions 가 없는 hello 가 된다.
  guard eq (tlssrv.ch_ext_find (subslice w 0 196) 43) 145 . else return 0 .
  set (index w 141) 122 .   set (index w 142) 122 .
  if tlssrv.ch_ok (subslice w 0 196) . do  return 96 . end .
  set (index w 141) 0 .   set (index w 142) 43 .
  rem signature_algorithms(000d) 의 종류를 SNI(0000) 로 → 같은 확장이 둘.
  guard eq (tlssrv.ch_ext_find (subslice w 0 196) 13) 152 . else return 0 .
  set (index w 149) 0 .
  if tlssrv.ch_ok (subslice w 0 196) . do  return 97 . end .
  set (index w 149) 13 .
  rem key_share 본문: 0024 001d 0020 <32> → 0024 001d 000e <14> 001d 000e <14> (같은 group 둘).
  guard eq (tlssrv.ch_x25519_off (subslice w 0 196)) 109 . else return 0 .
  set (index w 108) 14 .
  set (index w 123) 0 .   set (index w 124) 29 .
  set (index w 125) 0 .   set (index w 126) 14 .
  if tlssrv.ch_ok (subslice w 0 196) . do  return 98 . end .
  return 1 .
end .
