rem ★★ **`try_view` 가 제약 있는 칸을 잰다** (RFC-0150 §8-31, 2026-10-18 · 정본 §6.2.7 (2d) · §6.2.13 (9)).
rem
rem   `bool` 칸의 바이트는 0 이나 1 이어야 하고, 폭을 적은 열거(`layout u8 .`) 칸의 번호는 그 열거의 어느 갈래의 번호여야 한다.
rem   아니면 `try_view` 는 `none` 이다. 안에 든 구조체의 칸도 잰다. 바이트에는 번호가 들고, 읽으면 갈래, 쓰면 번호다.
rem   이 파일의 답은 VM 과 네이티브가 같아야 한다(골든이 둘을 맞댄다).

module vm_trycheck .

enum kind do
  layout u8 .
  ping .
  data 7 .
  close .
end .

struct hdr do
  layout packed .
  k kind .
  len u16 big .
end .

struct inner do
  on2 bool .
  k2 u8 .
end .

struct flags do
  active bool .
  n u8 .
  sub inner .
end .

fn code input k kind . output u64 . do
  match k. do
    case ping do return 1 . end .
    case data do return 2 . end .
    case close do return 3 . end .
  end .
end .

rem 바이트 0 이 갈래의 번호(1 · 7 · 8)가 아니면 99 — 맞으면 갈래 · 길이
export fn read input b slice u8 . output u64 . do
  let o option hdr try_view hdr b. . .
  guard is_some o. . else return 99 . .
  let h hdr some_value o. . .
  let c u64 code field h. k . . .
  return add mul c. 1000 . cast u64 field h. len . . . .
end .

rem 갈래를 바이트에 쓰면 그 번호(close = 8)가 든다
export proc write input b mut slice u8 . output u8 . effects none . do
  let o option hdr try_view hdr b. . .
  guard is_some o. . else return 99 . .
  var h hdr some_value o. . .
  set field h. k . close. .
  return idx b. 0 . .
end .

rem encode 는 번호(data = 7)를 적는다
export fn enc output u8 . do
  let r hdr lit hdr do k data. . len 5 . end . .
  let bs slice u8 encode hdr r. . .
  return idx bs. 0 . .
end .

rem bool 칸 둘(바깥 · 안쪽)이 0 · 1 이 아니면 99
export fn flag input b slice u8 . output u64 . do
  let o option flags try_view flags b. . .
  guard is_some o. . else return 99 . .
  let h flags some_value o. . .
  if field h. active . do return add 10 cast u64 field h. n . . . . end .
  return cast u64 field h. n . . .
end .
