rem ★★★ **UTF-16 — 서로게이트 짝이 맞는가** (RFC-0068 S6. 2026-07-20).
rem
rem ★★★ **S6 가 요구한 새 타입은 안 만들었다.** `u16str`/`u32str` 를 언어 타입으로 달라고
rem   했는데, 재 보니 **`slice u16`·`slice u32` 가 이미 완벽히 된다.** 리프 규칙의 두 질문에
rem   둘 다 아니오다(capability 불필요 · 표현은 이미 있음) ⇒ **새 타입 0 · 빌트인 op 0.**
rem   ★ 남는 것은 **서로게이트 산술** 하나뿐이고, 그것이 `lib/utf16.low` 이다.
rem
rem ★★ 이 파일이 재는 것은 "된다" 가 아니라 **틀린 것을 거절하는가** 이다.
rem   짝 없는 서로게이트를 조용히 통과시키면 그 뒤의 모든 것이 틀린다.

module vm_utf16 .

use utf16 from "../../lib/utf16.low" .

rem ── ① BMP 는 한 칸, 그 밖은 두 칸 ────────────────────────────────────
fn unit_counts output u64 . do
  guard eq (utf16.units 65) 1 . else return 90 .         rem 'A'
  guard eq (utf16.units 44032) 1 . else return 91 .      rem '가' — 한글은 BMP 안이다
  guard eq (utf16.units 65535) 1 . else return 92 .      rem U+FFFF — BMP 의 끝
  guard eq (utf16.units 65536) 2 . else return 93 .      rem U+10000 — 여기부터 짝
  guard eq (utf16.units 128169) 2 . else return 94 .     rem U+1F4A9 — 이모지
  return 1 .
end .

rem ── ② 왕복 — 써 넣고 다시 읽으면 같은 코드포인트 ─────────────────────
rem ★ 이것이 이 라이브러리의 핵심 주장이다. 짝을 만들고, 그 짝을 다시 하나로 읽는다.
proc round_trip output u64 . input buf mut slice u16 . . effects none . do
  rem BMP 문자 — 한 칸
  let a option u64 . be utf16.put buf 0 44032 .
  guard is_some a . else return 90 .
  guard eq (some_value a) 1 . else return 91 .    rem 위치 0 → 1 (한 칸)
  let ra option u64 . be utf16.decode buf 0 .
  guard is_some ra . else return 92 .
  guard eq (some_value ra) 44032 . else return 93 .

  rem 이모지 — 두 칸(서로게이트 짝)
  let b option u64 . be utf16.put buf 1 128169 .
  guard is_some b . else return 94 .
  guard eq (some_value b) 3 . else return 95 .    rem 위치 1 → 3 (서로게이트 짝은 두 칸)
  rem ★★ 정말 짝이 만들어졌는지 **칸을 직접 본다** — 추상 뒤에 숨지 않는다
  guard eq (index buf 1) 55357 . else return 96 .  rem 0xD83D
  guard eq (index buf 2) 56489 . else return 97 .  rem 0xDCA9
  let rb option u64 . be utf16.decode buf 1 .
  guard is_some rb . else return 98 .
  guard eq (some_value rb) 128169 . else return 99 .
  return 1 .
end .

rem ── ③ ★★★ 짝이 안 맞으면 거절한다 — 이 파일의 진짜 값 ────────────────
rem
rem   세 가지 망가짐을 **전부** 만들어 보고, 셋 다 `none` 인지 잰다.
rem   조용히 통과하면 그 뒤의 모든 것이 틀린다 — 거절이 곧 이 라이브러리의 값이다.
proc rejects_broken output u64 . input buf mut slice u16 . . effects none . do
  rem ⓐ 상위 서로게이트 뒤에 **하위가 안 온다**(평범한 문자가 온다)
  set (index buf 0) 55357 .                       rem 0xD83D — 상위
  set (index buf 1) 65 .                          rem 'A' — 하위가 아니다
  let a option u64 . be utf16.decode buf 0 .
  guard eq (is_some a) false . else return 90 .

  rem ⓑ 하위 서로게이트가 **혼자** 온다
  set (index buf 2) 56489 .                       rem 0xDCA9 — 하위인데 앞이 없다
  let b option u64 . be utf16.decode buf 2 .
  guard eq (is_some b) false . else return 91 .

  rem ⓒ 상위 서로게이트로 **끝난다**(잘렸다)
  set (index buf 3) 55357 .
  let c option u64 . be utf16.decode (subslice buf 0 4) 3 .
  guard eq (is_some c) false . else return 92 .

  rem ★ 그리고 **온전한 짝은 여전히 통과한다** — 거절이 과하지 않다는 것도 재야 한다
  set (index buf 4) 55357 .
  set (index buf 5) 56489 .
  let d option u64 . be utf16.decode buf 4 .
  guard is_some d . else return 93 .
  guard eq (some_value d) 128169 . else return 94 .
  return 1 .
end .

rem ── ④ 서로게이트는 **코드포인트가 아니다** ────────────────────────────
rem ★ `lib/utf8.low` 이 UTF-8 안의 서로게이트를 거절하므로, 서로게이트는 **오직 UTF-16
rem   안에서만, 오직 짝으로만** 존재한다. 두 라이브러리가 함께 그 불변을 지킨다.
fn surrogates_are_not_codepoints output u64 . do
  guard eq (utf16.cp_valid 55357) false . else return 90 .   rem 상위를 코드포인트로 못 쓴다
  guard eq (utf16.cp_valid 56489) false . else return 91 .   rem 하위도 마찬가지
  guard eq (utf16.cp_valid 1114112) false . else return 92 . rem > U+10FFFF
  guard utf16.cp_valid 128169 . else return 93 .             rem 진짜 코드포인트는 통과
  guard utf16.cp_valid 65 . else return 94 .
  return 1 .
end .

rem ── ⑤ 전체 훑기 — 망가진 자리를 만나면 **수를 안 낸다** ────────────────
proc counts_and_validates output u64 . input buf mut slice u16 . . effects none . do
  rem 'A' + 이모지(짝) + '가' = 문자 셋, 칸 넷
  set (index buf 0) 65 .
  set (index buf 1) 55357 .
  set (index buf 2) 56489 .
  set (index buf 3) 44032 .
  let n option u64 . be utf16.count_chars (subslice buf 0 4) .
  guard is_some n . else return 90 .
  guard eq (some_value n) 3 . else return 91 .        rem 칸은 4, 문자는 3
  guard utf16.is_valid (subslice buf 0 4) . else return 92 .

  rem ★ 짝을 깨뜨리면 — 수를 못 낸다. **틀린 수를 내느니 안 낸다.**
  set (index buf 2) 65 .
  let m option u64 . be utf16.count_chars (subslice buf 0 4) .
  guard eq (is_some m) false . else return 93 .
  guard eq (utf16.is_valid (subslice buf 0 4)) false . else return 94 .
  return 1 .
end .

rem ── ⑥ 자리가 모자라면 **한 칸도 안 쓴다** (전량-아니면-무) ─────────────
rem ★ `lib/strbuf.low` 의 `sb_append` 와 같은 규율이다 — 반쯤 쓰인 버퍼는 조용히 틀린 내용이다.
proc put_is_atomic output u64 . input buf mut slice u16 . . effects none . do
  rem 두 칸짜리를 **마지막 한 칸**에 넣으려 한다 → 거절, 그리고 그 칸은 안 더럽혀진다
  let last u64 be sub (len buf) 1 .
  set (index buf last) 7 .
  let r option u64 . be utf16.put buf last 128169 .
  guard eq (is_some r) false . else return 90 .
  guard eq (index buf last) 7 . else return 91 .      rem 손대지 않았다
  return 1 .
end .
