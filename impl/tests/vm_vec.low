rem RFC-0040 portable SIMD fixture — lanes are comptime (from `vec t n` binding
rem types); arith/compare lift lanewise (compare → mask); dot product & clamp.
def type bytes slice u8 .

fn dot4
  input b bytes .
  output u64 .
do
  let xs slice u32 view_array u32 b .
  let va vec u32 4 load xs 0 .
  let vb vec u32 4 load xs 4 .
  return reduce_add mul va vb .
end

fn clamp_sum
  input b bytes .
  output u64 .
do
  let xs slice u32 view_array u32 b .
  let v vec u32 4 load xs 0 .
  let lim vec u32 4 splat 10 .
  let m mask 4 gt v lim .        rem ★ 마스크는 정수가 아니다(레인마다 하나씩)
  let cc vec u32 4 lane_select m lim v .
  return reduce_add cc .
end

fn over
  input b bytes .
  output bool .
do
  let xs slice u32 view_array u32 b .
  let v vec u32 4 load xs 0 .
  let lim vec u32 4 splat 10 .
  return lane_any gt v lim .
end

fn vmax
  input b bytes .
  output u64 .
do
  let xs slice u32 view_array u32 b .
  let v vec u32 4 load xs 0 .
  return reduce_max v .
end
