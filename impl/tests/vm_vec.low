rem RFC-0040 portable SIMD fixture — lanes are comptime (from `vec n t` binding
rem types); arith/compare lift lanewise (compare → mask); dot product & clamp.

fn dot4
  input b slice u8 .
  output u64 .
do
  let xs slice u32 view_array u32 b. . .
  let va vec 4 u32 load xs. 0 . .
  let vb vec 4 u32 load xs. 4 . .
  return reduce_add mul va. vb. . . .
end .

fn clamp_sum
  input b slice u8 .
  output u64 .
do
  let xs slice u32 view_array u32 b. . .
  let v vec 4 u32 load xs. 0 . .
  let lim vec 4 u32 splat 10 . .
  let m mask 4 gt v. lim. . .        rem ★ 마스크는 정수가 아니다(레인마다 하나씩)
  let cc vec 4 u32 lane_select m. lim. v. . .
  return reduce_add cc. . .
end .

fn over
  input b slice u8 .
  output bool .
do
  let xs slice u32 view_array u32 b. . .
  let v vec 4 u32 load xs. 0 . .
  let lim vec 4 u32 splat 10 . .
  return lane_any gt v. lim. . . .
end .

fn vmax
  input b slice u8 .
  output u64 .
do
  let xs slice u32 view_array u32 b. . .
  let v vec 4 u32 load xs. 0 . .
  return reduce_max v. . .
end .
