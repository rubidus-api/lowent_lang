rem RFC-0040 portable SIMD fixture — lanes are comptime (from `vec t n` binding
rem types); arith/compare lift lanewise (compare → mask); dot product & clamp.
type bytes slice u8 . .

fn dot4 .
  input b bytes .
  output u64 .
do
  var xs slice u32 . be view_array u32 b .
  var va vec u32 4 . be load xs 0 .
  var vb vec u32 4 . be load xs 4 .
  return reduce_add mul va vb .
end .

fn clamp_sum .
  input b bytes .
  output u64 .
do
  var xs slice u32 . be view_array u32 b .
  var v vec u32 4 . be load xs 0 .
  var lim vec u32 4 . be splat 10 .
  var m mask 4 . be gt v lim .        rem ★ 마스크는 정수가 아니다(레인마다 하나씩)
  var cc vec u32 4 . be select m lim v .
  return reduce_add cc .
end .

fn over .
  input b bytes .
  output bool .
do
  var xs slice u32 . be view_array u32 b .
  var v vec u32 4 . be load xs 0 .
  var lim vec u32 4 . be splat 10 .
  return any gt v lim . .
end .

fn vmax .
  input b bytes .
  output u64 .
do
  var xs slice u32 . be view_array u32 b .
  var v vec u32 4 . be load xs 0 .
  return reduce_max v .
end .
