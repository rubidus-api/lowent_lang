rem ★★★ **이식 가능한 SIMD 커널이 자기 폭을 한 번만 적는다** (2026-08-18, RFC-0040 D5 · §9-3/4).
rem
rem D5 는 *"타깃에게 최적 폭을 물어 **한 번만** 쓰라"* 고 했다. 그런데 폭 자리는
rem `vec u32 4`(리터럴) · `vec u32 scalable` · `vec u32 (native_lanes u32)` 만 받았고,
rem **이름을 안 받았다** — 그래서 같은 식을 `vec` 마다 되풀이해야 했다. 정확히 반대였다.
rem
rem ★ 이제 **comptime 으로 접힌 `let` 이름**을 폭으로 받는다. 그리고 그 자격은 좁다:
rem   · `var` 는 안 된다 — 나중에 `set` 으로 바뀌면 타입 자리의 상수가 낡는다.
rem     **불변인 것만 타입이 될 수 있다.**
rem   · comptime 에 안 접히는 `let`(런타임 값)도 안 된다 — 폭은 컴파일 시에 정해져야
rem     VM 과 C 가 **같은 값을 굽는다**(오라클 안전).

module vm_veclanes .

rem ① 성립 — 폭을 **한 번만** 적는다. 두 뒤끝이 같은 답을 낸다.
export fn dot input a slice u32 . input b slice u32 . output u32 . do
  let L u64 native_lanes u32 .
  var acc vec u32 L splat 0 .
  var i u64 0 .
  let n u64 len a .
  while le (add i L) n do
    let x vec u32 L load a i .
    let y vec u32 L load b i .
    set acc (add acc (mul x y)) .
    set i (add i L) .
  end
  return reduce_add acc .
end

rem ② 성립 — 같은 커널을 **리터럴 폭**으로 적으면 같은 답이다(이름이 뜻을 안 바꾼다).
export fn dot4 input a slice u32 . input b slice u32 . output u32 . do
  var acc vec u32 4 splat 0 .
  var i u64 0 .
  let n u64 len a .
  while le (add i 4) n do
    let x vec u32 4 load a i .
    let y vec u32 4 load b i .
    set acc (add acc (mul x y)) .
    set i (add i 4) .
  end
  return reduce_add acc .
end

rem ★★★ **마스크 적재·저장 — 빠른 경로가 받는 모양** (2026-08-18).
rem   `vm_vmask.low` 는 대상이 **바이트 슬라이스**(`mut slice u8`)인데 레인은 u32 라, 빠른 경로가
rem   `vector.store` 부터 이미 안 받는다(원소 폭이 안 맞는다). 그건 그 픽스처의 뜻이고 그대로 둔다.
rem   여기서는 **폭이 맞는** 모양을 증인으로 둔다: 양쪽 다 `view_array u32` 를 지난다.
rem ★ 마스크 적재의 존재 이유는 **꺼진 레인은 안 읽는다**는 것이다 — 그래서 경계 검사도
rem   **켜진 레인마다** 한다. 꺼진 레인이 경계 밖이어도 트랩하지 않아야 맞다.
export fn masked input b slice u8 . input o mut slice u8 . output u32 . do
  let xs slice u32 view_array u32 b .
  var ys mut slice u32 view_array u32 o .
  let v vec u32 4 load xs 0 .
  let lim vec u32 4 splat 2 .
  var m mask 4 gt v lim .
  let pass vec u32 4 splat 100 .
  var r vec u32 4 load_masked xs 0 m pass .
  store_masked ys 0 r m .
  return reduce_add r .
end
