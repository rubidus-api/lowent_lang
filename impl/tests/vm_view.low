rem RFC-0025 §6.6/6.7 view/try_view fixture — packed wire header with be fields;
rem zero-copy struct views over a byte slice, endian decoded at field access.

struct wire_header do
  layout packed .
  magic u32 big .
  length u16 big .
  kind u8 .
end .

fn hdr_kind
  input b slice u8 .
  output u64 .
do
  let o option wire_header try_view wire_header b. . .
  guard is_some o. . else return 999 . .
  let h wire_header some_value o. . .
  return field h. kind . .
end .

fn hdr_summary
  input b slice u8 .
  output u64 .
do
  let h wire_header view wire_header b. . .
  rem RFC-0148 S2 — 칸은 제 폭을 안다: `length` 는 u16 이라 258 × 1000 은 u16 에서 넘친다. u64 로 옮겨서 셈한다.
  return expr (cast u64 field h. length . .) * 1000 + (cast u64 field h. kind . .) . .
end .

fn hdr_magic
  input b slice u8 .
  output u64 .
do
  let h wire_header view wire_header b. . .
  return field h. magic . .
end .

fn mk_hdr
  output wire_header .
do
  return lit wire_header do
    magic 3735928559 .
    length 258 .
    kind 7 .
  end . .
end .

fn wire_bytes
  output slice u8 .
do
  return encode wire_header mk_hdr. . .
end .

fn hdr_roundtrip
  output u64 .
do
  let h wire_header view wire_header encode wire_header mk_hdr. . . .
  return field h. magic . .
end .
