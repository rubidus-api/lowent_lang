rem ★★ **부르는 쪽이 이미 아는 겹침 검사는 건너뛴다** (2026-11-04 · W-20261104-1345 · 소유자 «건너뛰기 설계 들어가고»).
rem   REQ-0036 은 op 이 들어설 때 슬라이스 짝을 견준다(정본 §8.12(7b)). 그런데 부르는 쪽이 답을 이미 아는 부름이 많다 —
rem   같은 칸의 두 상수 구간(`subslice w. 0 4` 와 `subslice w. 4 8`), 그리고 부르는 op 의 두 입력을 그대로 넘기는 부름(그 op 의
rem   입구가 이미 견주었다). 단위 안의 **모든** 부름 자리가 그렇게 보증하는 짝은 검사를 지운다. 하나라도 모르면 남긴다 — 그래서
rem   멈춰야 할 부름은 여전히 멈춘다. C 가 부르는 입구는 지운 짝을 거기서 견준다(골든 «xskip»).

module vm_xskip .

rem 두 조각에 쓴다 — 아래 두 자리(그대로 넘기기 · 상수 구간)만 부른다 ⇒ 검사가 지워진다
export proc put2 input a mut slice u8 . input b mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 1 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 2 .  end .
  if gt len a. . 0 . do  return cast u64 idx a. 0 . . .  end .
  return 0 .
end .

rem 쓰기 · 읽기 — 같은 구간을 허락한다. 상수로 같은 구간 · 그대로 넘기기만 부른다 ⇒ 지워진다
proc bump_in input o mut slice u8 . input r slice u8 . output u64 . effects none . inplace o r . do
  var i usize 0 .
  while lt i. len o. . . do
    set idx o. i. . add idx r. i. . 1 . .
    set i. add i. 1 . .
  end .
  return 1 .
end .

rem 같은 모양이지만 동적 구간 자리가 하나 섞였다 ⇒ 검사가 남는다
proc put2b input a mut slice u8 . input b mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 1 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 2 .  end .
  if gt len a. . 0 . do  return cast u64 idx a. 0 . . .  end .
  return 0 .
end .

rem ① 그대로 넘기기 — `via` 의 입구가 s · t 를 견주었다(부름 자리가 없는 op 이라 그 검사는 남는다)
export proc via input s mut slice u8 . input t mut slice u8 . output u64 . effects none . do
  return put2 s. t. . .
end .

rem ② 같은 칸의 상수 구간 — 안 겹친다
export proc halves input s mut slice u8 . output u64 . effects none . do
  guard ge len s. . 8 . else return 9 . .
  return put2 subslice s. 0 4 . subslice s. 4 8 . . .
end .

rem ③ 같은 칸의 같은 상수 구간을 `inplace` 짝에 — 지난다
export proc inpl input s mut slice u8 . output u64 . effects none . do
  guard ge len s. . 4 . else return 9 . .
  return bump_in subslice s. 0 4 . subslice s. 0 4 . . .
end .

rem ④ 입력 둘을 그대로 `inplace` 짝에
export proc inpl2 input s mut slice u8 . input r slice u8 . output u64 . effects none . do
  return bump_in s. r. . .
end .

rem ⑤ 상수 구간(보증) — 같은 op 의 다른 자리가 동적이라 검사는 남아 있다
export proc fixed2b input s mut slice u8 . output u64 . effects none . do
  guard ge len s. . 8 . else return 9 . .
  return put2b subslice s. 0 4 . subslice s. 4 8 . . .
end .

rem ⑥ 동적 같은 구간 — 남은 검사가 멈춘다
export proc same2b input s mut slice u8 . input k usize . output u64 . effects none . do
  return put2b subslice s. 0 k. . subslice s. 0 k. . . .
end .

rem ★★ 2026-11-05 (W-20261105-2304 · 소유자 «위에 하지 않은 것들 다 처리해 주세요») — 보증을 넓혔다. 아래 다섯 꼴도 검사가 지워진다:
rem   ⑦ `let` 별칭(`let X slice u8 subslice s. 0 4 .`)을 넘긴다 — 그 `let` 이 가리키는 조각으로 견준다(별칭 칸이 한 번만 묶일 때),
rem   ⑧ 실행 중 한 점에서 맞닿는 조각(`[0, k)` 와 `[k, len s.)` · `[0, n)` · `[n, 2n)` · `[2n, 3n)`) — 끝을 `k + m·v` 로 읽는다,
rem   ⑨ 짝이 64 를 넘는 op(입력 12 개 · 66 짝),
rem   ⑩ 문자열 리터럴을 읽는 자리에 — 쓸 수 있는 자리는 리터럴을 가리키지 못한다(E-TYPE-ARGMUT).
rem   그리고 남는 꼴: 두 번 묶인 별칭(⑪ — 그 사이에 가리키는 것이 바뀔 수 있다), 한 바이트 겹치는 맞닿기(⑫ — 멈춘다).

proc put3 input a mut slice u8 . input b mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 31 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 2 .  end .
  return 0 .
end .

rem ⑦ `let` 별칭 둘 — 한 칸의 안 겹치는 상수 구간이다
export proc alias2 input s mut slice u8 . output u64 . effects none . do
  guard ge len s. . 8 . else return 9 . .
  let x mut slice u8 subslice s. 0 4 . .
  let y mut slice u8 subslice s. 4 8 . .
  let r u64 put3 x. y. . .
  return add cast u64 idx s. 0 . . cast u64 idx s. 4 . . . .
end .

proc put4 input a mut slice u8 . input b mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 41 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 2 .  end .
  return 0 .
end .

rem ⑪ 같은 이름을 두 블록에서 묶은 별칭 — 칸 하나를 두 번 묶으므로 보증하지 않는다(검사가 남는다 · 답은 같다)
export proc rebound input s mut slice u8 . input c u64 . output u64 . effects none . do
  guard ge len s. . 8 . else return 9 . .
  if eq c. 0 . do
    let x mut slice u8 subslice s. 0 4 . .
    return put4 x. subslice s. 4 8 . . .
  end .
  let x mut slice u8 subslice s. 0 4 . .
  return put4 x. subslice s. 4 8 . . .
end .

proc put5 input a mut slice u8 . input b mut slice u8 . output usize . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 51 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 2 .  end .
  return add len a. . len b. . . .
end .

rem ⑧ 실행 중 한 점 k 에서 맞닿는다 — 앞 조각의 끝이 뒤 조각의 시작이다
export proc ends input s mut slice u8 . input k usize . output usize . effects none . do
  return put5 subslice s. 0 k. . subslice s. k. len s. . . . .
end .

proc put3w input a mut slice u8 . input b mut slice u8 . input c mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 61 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 2 .  end .
  if gt len c. . 0 . do  set idx c. 0 . 3 .  end .
  return 0 .
end .

rem ⑧ 배로 늘어나는 끝 — `[0, n)` · `[n, 2n)` · `[2n, 3n)` (맞닿지 않은 짝도 n 의 배수로 견준다)
export proc thirds input s mut slice u8 . output u64 . effects none . do
  let n usize div len s. . 3 . .
  let r u64 put3w subslice s. 0 n. . subslice s. n. mul n. 2 . . subslice s. mul n. 2 . mul 3 n. . . . .
  return add add cast u64 idx s. 0 . . cast u64 idx s. n. . . . cast u64 idx s. mul n. 2 . . . . .
end .

proc put5b input a mut slice u8 . input b mut slice u8 . output usize . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 53 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 2 .  end .
  return add len a. . len b. . . .
end .

rem ⑫ 맞닿는 자리 하나와 한 바이트 겹치는 자리 하나 — 검사가 남고, 겹치는 부름은 멈춘다
export proc ends_ok input s mut slice u8 . input k usize . output usize . effects none . do
  return put5b subslice s. 0 k. . subslice s. k. len s. . . . .
end .
export proc ends_bad input s mut slice u8 . input k usize . output usize . effects none . do
  return put5b subslice s. 0 add k. 1 . . subslice s. k. len s. . . . .
end .

rem ⑨ 짝이 66 — 상수 구간 열둘
proc wide12 input a0 mut slice u8 . input a1 mut slice u8 . input a2 mut slice u8 . input a3 mut slice u8 . input a4 mut slice u8 . input a5 mut slice u8 . input a6 mut slice u8 . input a7 mut slice u8 . input a8 mut slice u8 . input a9 mut slice u8 . input a10 mut slice u8 . input a11 mut slice u8 . output u64 . effects none . do
  if gt len a0. . 0 . do  set idx a0. 0 . 1 .  end .
  if gt len a1. . 0 . do  set idx a1. 0 . 2 .  end .
  if gt len a2. . 0 . do  set idx a2. 0 . 3 .  end .
  if gt len a3. . 0 . do  set idx a3. 0 . 4 .  end .
  if gt len a4. . 0 . do  set idx a4. 0 . 5 .  end .
  if gt len a5. . 0 . do  set idx a5. 0 . 6 .  end .
  if gt len a6. . 0 . do  set idx a6. 0 . 7 .  end .
  if gt len a7. . 0 . do  set idx a7. 0 . 8 .  end .
  if gt len a8. . 0 . do  set idx a8. 0 . 9 .  end .
  if gt len a9. . 0 . do  set idx a9. 0 . 10 .  end .
  if gt len a10. . 0 . do  set idx a10. 0 . 11 .  end .
  if gt len a11. . 0 . do  set idx a11. 0 . 12 .  end .
  return 0 .
end .
export proc twelve input s mut slice u8 . output u64 . effects none . do
  guard ge len s. . 12 . else return 99 . .
  let r u64 wide12 subslice s. 0 1 . subslice s. 1 2 . subslice s. 2 3 . subslice s. 3 4 . subslice s. 4 5 . subslice s. 5 6 . subslice s. 6 7 . subslice s. 7 8 . subslice s. 8 9 . subslice s. 9 10 . subslice s. 10 11 . subslice s. 11 12 . . .
  return cast u64 idx s. 11 . . .
end .

proc lit_rd input a mut slice u8 . input b slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . idx b. 0 . .  end .
  return cast u64 idx b. 0 . . .
end .

rem ⑩ 문자열 리터럴을 읽는 자리에
export proc litr input s mut slice u8 . output u64 . effects none . do
  return lit_rd s. "abc" . .
end .

rem ★★ 2026-11-06 (W-20261106-2120 · 소유자 «추천대로 해 주세요») — ⑬ op 이 스스로 지은 배열(`var … lit array …`)은 제 틀 바이트를 갖는다 —
rem   다른 자리의 나열과도, 부름 전부터 있던 입력과도 겹칠 수 없다. 그 배열을 옮겨 담은 이름(⑭)은 같은 바이트다 — 검사가 남고 겹치면 멈춘다.
rem   입력 칸을 그 배열로 다시 묶는 글(`set s. x.`)은 검사층이 거절한다(E-LIT-ESCAPE) — 그래도 건너뛰기는 몸이 다시 쓴 입력을 믿지 않는다.
proc put6 input a mut slice u8 . input b mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 71 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 72 .  end .
  return add cast u64 idx a. 0 . . cast u64 idx b. 0 . . . .
end .
export proc own2 input s mut slice u8 . output u64 . effects none . do
  guard ge len s. . 4 . else return 99 . .
  var x lit array 8 u8 _ . .
  var y lit array 8 u8 _ . .
  let r1 u64 put6 x. y. . .
  let r2 u64 put6 subslice x. 0 4 . s. . .
  return add add r1. r2. . cast u64 idx s. 0 . . . .
end .
proc put7 input a mut slice u8 . input b mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 81 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 82 .  end .
  return add cast u64 idx a. 0 . . cast u64 idx b. 0 . . . .
end .
export proc ownsame input k usize . output u64 . effects none . do
  var x lit array 8 u8 _ . .
  var z mut slice u8 x. .
  return put7 subslice x. 0 4 . subslice z. k. 8 . . .
end .

rem ⑯ 할당기 바이트(여기서는 입력)를 상수 끝으로 잘라 다른 원소로 본 조각 — `view_array` 는 같은 바이트다 · 안 겹치는 구간이다
proc put9 input a mut slice u64 . input b mut slice u64 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 101 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 102 .  end .
  return add idx a. 0 . idx b. 0 . . .
end .
export proc viewed input mem mut slice u8 . input k usize . output u64 . effects none . do
  guard ge len mem. . 32 . else return 99 . .
  let x mut slice u64 view_array u64 subslice mem. 0 16 . . .
  let y mut slice u64 view_array u64 subslice mem. 16 32 . . .
  let r1 u64 put9 x. y. . .
  return add r1. put9b subslice x. 0 1 . subslice y. k. 2 . . . .
end .
rem ⑰ 본 것을 또 자르면 끝이 원소 단위다 — 바이트 구간과 견주지 않지만, 본 바이트 안에 있다(W-20261107-0001 — 감싸는 구간이 갈리므로 검사가 지워진다)
proc put9b input a mut slice u64 . input b mut slice u64 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 111 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 112 .  end .
  return add idx a. 0 . idx b. 0 . . .
end .
rem ⑱ 서로 다른 `alloc_bytes` 의 답은 겹칠 수 없다(뿌리는 준 바이트를 다시 주지 않는다 · 되감기는 영역이 끝날 때뿐) — put10 은 검사가 지워진다.
rem   같은 답을 두 이름에 꺼내 담으면 같은 바이트다 — put7 의 검사가 남고, 겹치는 부름은 멈춘다.
proc put10 input a mut slice u8 . input b mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 91 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 92 .  end .
  return add cast u64 idx a. 0 . . cast u64 idx b. 0 . . . .
end .
export proc twoalloc input k usize . output u64 . effects heap . do
  var out u64 99 .
  region r heap do
    let g1 option mut slice u8 alloc_bytes r. capacity 8 . .
    let g2 option mut slice u8 alloc_bytes r. capacity 8 . .
    if and is_some g1. . is_some g2. . . do
      let m1 mut slice u8 some_value g1. . .
      let m2 mut slice u8 some_value g2. . .
      let m3 mut slice u8 some_value g2. . .
      let r1 u64 put10 m1. m2. . .
      let r2 u64 put7 subslice m2. 0 4 . subslice m3. k. 8 . . .
      set out. add r1. r2. . .
    end .
  end .
  return out. .
end .
rem ⑲ 담는 값이 언제나 문자열 리터럴인 `var`(해시마다 머리가 다른 DigestInfo 꼴)는 리터럴과 같다 — 읽기 전용 바이트라 쓰는 조각과 안 겹친다.
proc put12 input a slice u8 . input b mut slice u8 . output u64 . effects none . do
  set idx b. 0 . idx a. 0 . .
  return cast u64 idx b. 0 . . .
end .
export proc litvar input k u64 . output u64 . effects none . do
  var wb lit array 8 u8 _ . .
  var di slice u8 "ab" .
  if eq k. 1 . do  set di. "cd" .  end .
  return put12 di. wb. . .
end .
rem ⑳ 상수 끝의 조각을 실행 중 길이로 다시 자른 조각은 그 안에 있다(`subslice` 는 밖이면 멈춘다) — 감싸는 구간이 갈리면 안 겹친다(put13 · 검사가 지워진다).
rem   감싸는 구간이 겹치면 검사가 남고(put14), 실제로 겹치는 부름은 멈춘다.
proc put13 input a mut slice u8 . input b mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 61 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 62 .  end .
  return add cast u64 idx b. 0 . . cast u64 len a. . . . .
end .
proc put14 input a mut slice u8 . input b mut slice u8 . output u64 . effects none . do
  if gt len a. . 0 . do  set idx a. 0 . 71 .  end .
  if gt len b. . 0 . do  set idx b. 0 . 72 .  end .
  return add cast u64 idx b. 0 . . cast u64 len a. . . . .
end .
export proc encl input s mut slice u8 . input k usize . output u64 . effects none . do
  guard ge len s. . 16 . else return 99 . .
  let head mut slice u8 subslice s. 0 8 . .
  let r2 u64 put14 subslice subslice s. 0 12 . 0 k. . subslice s. 8 16 . . .
  let r1 u64 put13 subslice head. 0 k. . subslice s. 8 16 . . .
  return add r1. r2. . .
end .
