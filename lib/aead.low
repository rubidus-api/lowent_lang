rem ★★★ **ChaCha20-Poly1305 AEAD** (RFC 8439 §2.8) — Lowent 로 쓴다.
rem
rem   ChaCha20 로 흐름을 만들고, Poly1305 로 그 흐름과 부가데이터를 한꺼번에 증언한다.
rem   TLS 1.3 의 기본 암호 스위트(TLS_CHACHA20_POLY1305_SHA256)가 쓰는 바로 그것이다.
rem
rem ★ 오라클은 **RFC 8439 §2.8.2 테스트 벡터**다.
rem
rem ★★ MAC 이 먹는 것은 다음 배열이다 —
rem       AAD ‖ pad16(AAD) ‖ CT ‖ pad16(CT) ‖ le64(|AAD|) ‖ le64(|CT|)
rem   pad16 이 있으므로 **모든 블록이 꽉 찬 16 바이트**다. 그래서 아래 호출은 전부
rem   `addhi = 1` 이다 — 짧은 마지막 블록이 없다. 이것을 여기 적어 두는 이유는,
rem   패딩의 목적이 바로 *"경우를 하나로 줄이는 것"* 이기 때문이다.
rem
rem ☞ 안 지은 것: **상수시간 태그 비교**는 `hash.digest_ok` 와 같은 자리에서 해야 한다.
rem   `unseal` 은 XOR 누적으로 비교한다(조기 반환 없음). 그러나 경계 검사와 트랩이 있는
rem   언어에서 타이밍을 *약속*할 수는 없다 — 약속하지 못하는 것을 약속하지 않는다.

module aead .

rem ★★★★ **「자리가 모자라다」와 「답이 아니다」는 다른 사실이다** (X-0035, 소유자 결정 2026-09-20).
rem   그전에는 둘 다 0 이었다 — 재지 못한 것과 재고 나서 «아니다» 하는 것이 **같은 값**이었고,
rem   그래서 작업 공간을 잘못 준 판이 «답이 틀렸다» 로 보였다. 이제 모자람은 값이 아니라 **실패**다.
export enum aead_error do
  short_workspace .
end .


rem 이 모듈은 혼자 서지 않는다 — 흐름은 chacha 가, 증언은 poly 가 만든다.
use chacha from "chacha.low" .
use poly from "poly.low" .

rem ★ 한 조각을 16 바이트 블록들로 잘라 Poly1305 에 먹인다. 남는 꼬리는 0 으로 채워
rem   **꽉 찬 블록**으로 만든다(pad16). `pad` 는 16 바이트 작업 공간.
rem
rem ★★★ **`pad` 를 잘라서 넘긴다** (2026-09-21). `poly.block` 은 «최대 16 바이트» 를 받고
rem   더 길면 **0 을 내고 아무것도 누적하지 않는다**. 위쪽 guard 는 `ge (len pad) 16` 이라
rem   17 바이트짜리를 받아들였고, 그러면 꼬리 블록이 **말없이 사라져** 태그가 틀렸다 —
rem   자리가 남아서 생긴 오답이라 «모자란다» 로도 안 보인다. 이 저장소가 두 번 밟은 모양이다
rem   (`hash.digest_ok` 의 정확 길이 규칙과 같은 자리). 잘라 넘기면 경우가 하나로 준다.
proc feed input pst mut slice u64 . input data slice u8 . input pad mut slice u8 . output u64 . effects none . do
  var off u64 be 0 .
  while le (add off 16) (len data) . do
    let z u64 be poly.block pst (subslice data off (add off 16)) 1 .
    set off (add off 16) .
  end .
  if lt off (len data) . do
    var i u64 be 0 .
    while lt i 16 . do
      set (index pad i) 0 .
      set i (add i 1) .
    end .
    var j u64 be 0 .
    while lt (add off j) (len data) . do
      set (index pad j) (index data (add off j)) .
      set j (add j 1) .
    end .
    let z2 u64 be poly.block pst (subslice pad 0 16) 1 .
  end .
  return 1 .
end .

rem ★ 길이 블록: le64(|AAD|) ‖ le64(|CT|) — 꽉 찬 16 바이트 한 블록.
proc feed_lens input pst mut slice u64 . input alen u64 . input clen u64 . input pad mut slice u8 . output u64 . effects none . do
  var b u64 be 0 .
  while lt b 8 . do
    set (index pad b) (cast u8 (bit_and (shr alen (mul b 8)) 255)) .
    set (index pad (add 8 b)) (cast u8 (bit_and (shr clen (mul b 8)) 255)) .
    set b (add b 1) .
  end .
  return poly.block pst (subslice pad 0 16) 1 .
end .

rem ★ 일회용 Poly1305 키: ChaCha20 블록 0 의 앞 32 바이트(RFC 8439 §2.6).
export proc key_gen input key slice u8 . input nonce slice u8 . input otk mut slice u8 . input st mut slice u64 . input work mut slice u64 . input ks mut slice u8 . output result u64 aead_error . effects none .
errors short_workspace . do
  guard ge (len otk) 32 . else return ok 0 .
  guard eq (chacha.prep key nonce 0 st) 16 . else return ok 0 .
  let _u2 result u64 chacha.chacha_error . be chacha.keystream st work ks .
  guard is_ok _u2 . else return error short_workspace .
  guard eq (ok_value _u2) 64 . else return ok 0 .
  var i u64 be 0 .
  while lt i 32 . do
    set (index otk i) (index ks i) .
    set i (add i 1) .
  end .
  return ok 32 .
end .

rem ★★ 봉인: 평문 → 암호문 + 16 바이트 태그.
rem   작업 공간은 전부 호출자가 든다 — otk 32 · pst 10 · st 16 · work 16 · ks 64 · pad 16.
export proc seal input key slice u8 . input nonce slice u8 . input aad slice u8 . input msg slice u8 . input ct mut slice u8 . input tag mut slice u8 . input otk mut slice u8 . input pst mut slice u64 . input st mut slice u64 . input work mut slice u64 . input ks mut slice u8 . input pad mut slice u8 . output result u64 aead_error . effects none .
errors short_workspace . do
  guard ge (len ct) (len msg) . else return ok 0 .
  guard ge (len tag) 16 . else return ok 0 .
  guard ge (len pad) 16 . else return ok 0 .
  let _u1 result u64 aead_error . be key_gen key nonce otk st work ks .
  guard is_ok _u1 . else return error short_workspace .
  guard eq (ok_value _u1) 32 . else return ok 0 .
  rem ★ 카운터는 **1** 부터다 — 0 은 위에서 Poly1305 키로 이미 썼다.
  let n_r result u64 chacha.chacha_error . be chacha.stream key nonce 1 msg ct st work ks .
  guard is_ok n_r . else return error short_workspace .
  let n u64 be ok_value n_r .
  guard eq n (len msg) . else return ok 0 .
  guard eq (poly.setup otk pst) 1 . else return ok 0 .
  let a1 u64 be feed pst aad pad .
  let a2 u64 be feed pst (subslice ct 0 (len msg)) pad .
  let a3 u64 be feed_lens pst (len aad) (len msg) pad .
  return ok (poly.emit pst otk tag) .
end .

rem ★★ 개봉: 태그를 먼저 확인하고, 맞을 때만 평문을 낸다.
rem   ☞ 비교는 XOR 누적이다 — 조기 반환이 없다는 뜻이고, 그것이 여기서 할 수 있는 최선이다.
rem   ☞ `tag` 는 **정확히 16** 이어야 한다. 전엔 `ge 16` 이어서 17 바이트 태그의 앞 16 만 보고
rem     나머지를 말없이 지나쳤다 — `hash.digest_ok`(정확 길이)와 갈라져 있던 자리다
rem     (2026-09-04 검토 RU). `gcm.decrypt` 도 같은 규칙으로 맞췼다.
export proc unseal input key slice u8 . input nonce slice u8 . input aad slice u8 . input ct slice u8 . input tag slice u8 . input msg mut slice u8 . input otk mut slice u8 . input pst mut slice u64 . input st mut slice u64 . input work mut slice u64 . input ks mut slice u8 . input pad mut slice u8 . input want mut slice u8 . output result u64 aead_error . effects none .
errors short_workspace . do
  guard ge (len msg) (len ct) . else return ok 0 .
  guard eq (len tag) 16 . else return ok 0 .
  guard ge (len want) 16 . else return ok 0 .
  guard ge (len pad) 16 . else return ok 0 .
  let _u0 result u64 aead_error . be key_gen key nonce otk st work ks .
  guard is_ok _u0 . else return error short_workspace .
  guard eq (ok_value _u0) 32 . else return ok 0 .
  guard eq (poly.setup otk pst) 1 . else return ok 0 .
  let a1 u64 be feed pst aad pad .
  let a2 u64 be feed pst ct pad .
  let a3 u64 be feed_lens pst (len aad) (len ct) pad .
  guard eq (poly.emit pst otk want) 16 . else return ok 0 .
  var diff u64 be 0 .
  var i u64 be 0 .
  while lt i 16 . do
    set diff (bit_or diff (bit_xor (cast u64 (index want i)) (cast u64 (index tag i)))) .
    set i (add i 1) .
  end .
  guard eq diff 0 . else return ok 0 .
  let n_r result u64 chacha.chacha_error . be chacha.stream key nonce 1 ct msg st work ks .
  guard is_ok n_r . else return error short_workspace .
  let n u64 be ok_value n_r .
  guard eq n (len ct) . else return ok 0 .
  return ok 1 .
end .
