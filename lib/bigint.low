rem ★★★ **큰수 모듈러 산술** — RSA 검증에 필요한 만큼만.
rem
rem   RSA **검증**은 `s^e mod n` 하나다(e 는 보통 65537). 서명은 **안 짓는다** —
rem   개인키를 다루지 않으면 개인키를 흘릴 수도 없다. 이 저장소가 필요로 하는 것은
rem   상대의 CertificateVerify 를 확인하는 것뿐이다.
rem
rem ★★ **표현**: 16 비트 조각(limb)을 u64 에 담고, **리틀엔디언 순서**로 늘어놓는다.
rem   곱은 16×16 = 32 비트이고 128 조각까지 더해도 2^39 — u64 안에서 안전하다.
rem   ☞ 32 비트 조각을 쓰면 곱이 2^64 에 닿아 누산이 넘친다. 조각 폭은 **누산이 정한다.**
rem
rem ★★★ **몽고메리 곱**을 쓴다(CIOS). 이유: 나눗셈 없이 `a·b·R^-1 mod n` 을 낸다 —
rem   큰수 나눗셈을 안 지어도 된다는 뜻이고, 안 지은 것은 틀릴 수도 없다.
rem   R = 2^(16k) 이고, `R^2 mod n` 은 **1 을 2·16k 번 배로 늘려** 얻는다(뺄셈만 쓴다).
rem
rem ☞ 안 지은 것: 상수시간 보장 · 서명 생성 · 큰수 나눗셈 · e 가 아주 큰 경우.
rem   ☞ 검증은 **공개** 정보만 다루므로 상수시간이 필요한 자리가 아니다 — 이 축에서는
rem     그 사실이 변명이 아니라 근거다.

module bigint .

rem k 조각짜리 수를 0 으로.
export proc zero input a mut slice u64 . input k u64 . output u64 . effects none . do
  guard ge (len a) k . else return 0 .
  var i be u64 0 .
  while lt i k . do  set (index a i) 0 .  set i (add i 1) .  end
  return 1 .
end

rem 빅엔디언 바이트열 → 16비트 조각 리틀엔디언. 조각 수 k 를 돌려준다.
export proc from_bytes input src slice u8 . input a mut slice u64 . input k u64 . output u64 . effects none . do
  guard eq (mul k 2) (len src) . else return 0 .
  guard ge (len a) k . else return 0 .
  var i be u64 0 .
  while lt i k . do
    let hi be u64 cast u64 (index src (mul (sub (sub k 1) i) 2)) .
    let lo be u64 cast u64 (index src (add (mul (sub (sub k 1) i) 2) 1)) .
    set (index a i) (bit_or (shl hi 8) lo) .
    set i (add i 1) .
  end
  return k .
end

rem 조각 → 빅엔디언 바이트열.
export proc to_bytes input a slice u64 . input k u64 . input out mut slice u8 . output u64 . effects none . do
  guard ge (len out) (mul k 2) . else return 0 .
  var i be u64 0 .
  while lt i k . do
    set (index out (mul (sub (sub k 1) i) 2)) (cast u8 (bit_and (shr (index a i) 8) 255)) .
    set (index out (add (mul (sub (sub k 1) i) 2) 1)) (cast u8 (bit_and (index a i) 255)) .
    set i (add i 1) .
  end
  return mul k 2 .
end

rem **리틀엔디언** 바이트열 → 조각.
export proc from_bytes_le input src slice u8 . input a mut slice u64 . output u64 . effects none . do
  guard ge (len src) 32 . else return 0 .
  guard ge (len a) 16 . else return 0 .
  var i be u64 0 .
  while lt i 16 . do
    set (index a i) (bit_or (cast u64 (index src (mul i 2))) (shl (cast u64 (index src (add (mul i 2) 1))) 8)) .
    set i (add i 1) .
  end
  return 16 .
end

rem 조각 → **리틀엔디언** 바이트열. (Ed25519 의 스칼라가 이 순서다.)
export proc to_bytes_le input out mut slice u8 . input a slice u64 . output u64 . effects none . do
  guard ge (len out) 32 . else return 0 .
  var i be u64 0 .
  while lt i 16 . do
    set (index out (mul i 2)) (cast u8 (bit_and (index a i) 255)) .
    set (index out (add (mul i 2) 1)) (cast u8 (bit_and (shr (index a i) 8) 255)) .
    set i (add i 1) .
  end
  return 32 .
end

rem a >= n 인가 (둘 다 k 조각).
export fn ge_mod input a slice u64 . input n slice u64 . input k u64 . output u64 . do
  var i be u64 k .
  var res be u64 1 .
  var done be u64 0 .
  while eq done 0 . do
    if eq i 0 . do  set done 1 .  end
    if eq done 0 . do
      set i (sub i 1) .
      if gt (index a i) (index n i) . do  set res 1 .  set done 1 .  end
      if eq done 0 . do
        if lt (index a i) (index n i) . do  set res 0 .  set done 1 .  end
      end
    end
  end
  return res .
end

rem a ← a − n (a >= n 일 때만 부른다).
proc sub_mod input a mut slice u64 . input n slice u64 . input k u64 . output u64 . effects none . do
  var borrow be u64 0 .
  var i be u64 0 .
  while lt i k . do
    let d be u64 wrap_sub (wrap_sub (index a i) (index n i)) borrow .
    set (index a i) (bit_and d 65535) .
    rem 빌림은 **비트로 읽는다** — wrap_sub 이 감기면 상위가 전부 1 이 된다.
    set borrow (bit_and (shr d 63) 1) .
    set i (add i 1) .
  end
  return 1 .
end

rem ★ a ← 2a mod n. 나눗셈 없이 R 이나 R^2 를 만드는 도구다.
export proc dbl_mod input a mut slice u64 . input n slice u64 . input k u64 . output u64 . effects none . do
  var carry be u64 0 .
  var i be u64 0 .
  while lt i k . do
    let v be u64 add (shl (index a i) 1) carry .
    set (index a i) (bit_and v 65535) .
    set carry (shr v 16) .
    set i (add i 1) .
  end
  rem 넘친 비트가 있거나 n 이상이면 한 번 뺀다. (2a < 2n 이므로 한 번이면 족하다.)
  if eq carry 1 . do
    let z1 be u64 sub_mod a n k .
    return 1 .
  end
  if eq (ge_mod a n k) 1 . do
    let z2 be u64 sub_mod a n k .
  end
  return 1 .
end

rem ★★ 몽고메리 곱 (CIOS): out ← a·b·R^-1 mod n.  `t` 는 k+2 조각 작업 공간.
rem   n0inv = −n[0]^-1 mod 2^16.
export proc mont_mul input out mut slice u64 . input a slice u64 . input b slice u64 . input n slice u64 .
     input k u64 . input n0inv u64 . input t mut slice u64 . output u64 . effects none . inplace out a . inplace out b . do
  guard ge (len t) (add k 2) . else return 0 .
  var z be u64 0 .
  while lt z (add k 2) . do  set (index t z) 0 .  set z (add z 1) .  end
  var i be u64 0 .
  while lt i k . do
    rem t ← t + a[i]·b
    var carry be u64 0 .
    var j be u64 0 .
    while lt j k . do
      let s be u64 add (add (index t j) (mul (index a i) (index b j))) carry .
      set (index t j) (bit_and s 65535) .
      set carry (shr s 16) .
      set j (add j 1) .
    end
    let s1 be u64 add (index t k) carry .
    set (index t k) (bit_and s1 65535) .
    set (index t (add k 1)) (add (index t (add k 1)) (shr s1 16)) .
    rem m = t[0]·n0inv mod 2^16,  t ← (t + m·n) / 2^16
    let m be u64 bit_and (mul (index t 0) n0inv) 65535 .
    let s2 be u64 add (index t 0) (mul m (index n 0)) .
    var carry2 be u64 shr s2 16 .
    var q be u64 1 .
    while lt q k . do
      let s3 be u64 add (add (index t q) (mul m (index n q))) carry2 .
      set (index t (sub q 1)) (bit_and s3 65535) .
      set carry2 (shr s3 16) .
      set q (add q 1) .
    end
    let s4 be u64 add (index t k) carry2 .
    set (index t (sub k 1)) (bit_and s4 65535) .
    set (index t k) (add (index t (add k 1)) (shr s4 16)) .
    set (index t (add k 1)) 0 .
    set i (add i 1) .
  end
  var c be u64 0 .
  while lt c k . do  set (index out c) (index t c) .  set c (add c 1) .  end
  rem t[k] 가 서 있거나 n 이상이면 한 번 뺀다.
  if gt (index t k) 0 . do
    let z3 be u64 sub_mod out n k .
    return 1 .
  end
  if eq (ge_mod out n k) 1 . do
    let z4 be u64 sub_mod out n k .
  end
  return 1 .
end

rem ★ n0inv = −n[0]^-1 mod 2^16 — 뉴턴 반복 네 번이면 16 비트가 찬다.
export fn n0inv16 input n0 u64 . output u64 . do
  var x be u64 bit_and n0 65535 .
  var inv be u64 1 .
  var i be u64 0 .
  while lt i 5 . do
    rem ☞ `2 − x·inv` 는 **음수를 지난다**(뉴턴 반복은 2 의 보수 위에서 돈다).
    rem   `sub` 는 트랩하므로 랩을 이름으로 말하고, **곱하기 전에 16 비트로 자른다** —
    rem   안 자르면 u64 곱이 넘친다.
    let d16 be u64 bit_and (wrap_sub 2 (bit_and (mul x inv) 65535)) 65535 .
    set inv (bit_and (mul inv d16) 65535) .
    set i (add i 1) .
  end
  rem −inv mod 2^16
  return bit_and (wrap_sub 0 inv) 65535 .
end

rem ★★★ RSA 검증의 전부: out ← base^e mod n.  e 는 작은 지수(3 · 65537 …).
rem   작업 공간: r2·acc·bse·t 각각 k+2 조각 이상.
export proc mod_exp input out mut slice u64 . input bse slice u64 . input e u64 . input n slice u64 .
     input k u64 . input r2 mut slice u64 . input acc mut slice u64 . input tmp mut slice u64 .
     input t mut slice u64 . output u64 . effects none . do
  guard gt k 0 . else return 0 .
  guard gt e 0 . else return 0 .
  let n0i be u64 n0inv16 (index n 0) .

  rem R^2 mod n — 1 을 2·16k 번 배로 늘린다. 나눗셈이 필요 없다.
  let z0 be u64 zero r2 k .
  set (index r2 0) 1 .
  var d be u64 0 .
  while lt d (mul 32 k) . do
    let zz be u64 dbl_mod r2 n k .
    set d (add d 1) .
  end

  rem acc ← 1 을 몽고메리 형태로(= R mod n) · tmp ← base 를 몽고메리 형태로
  let z1 be u64 zero acc k .
  set (index acc 0) 1 .
  let m1 be u64 mont_mul acc acc r2 n k n0i t .
  let m2 be u64 mont_mul tmp bse r2 n k n0i t .

  rem e 의 비트를 **위에서부터** 훑는다.
  var hb be u64 63 .
  var found be u64 0 .
  while eq found 0 . do
    if eq (bit_and (shr e hb) 1) 1 . do  set found 1 .  end
    if eq found 0 . do  set hb (sub hb 1) .  end
  end
  var bi be u64 hb .
  var done be u64 0 .
  while eq done 0 . do
    let sq be u64 mont_mul acc acc acc n k n0i t .
    if eq (bit_and (shr e bi) 1) 1 . do
      let mu be u64 mont_mul acc acc tmp n k n0i t .
    end
    if eq bi 0 . do  set done 1 .  end
    if eq done 0 . do  set bi (sub bi 1) .  end
  end

  rem 몽고메리 형태를 벗긴다: ×1
  let z2 be u64 zero tmp k .
  set (index tmp 0) 1 .
  return mont_mul out acc tmp n k n0i t .
end
