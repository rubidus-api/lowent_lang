rem ★★★ **큰수 모듈러 산술 — 32 비트 조각** (`bigint32`). 셋 가운데 가운데 폭이고, 표준 라이브러리의 곡선 모듈(`p256` · `p384` · `ecdsa` · `ed25519`)이 이것을 쓴다.
rem
rem   같은 이름 · 같은 입력의 모듈이 셋 있다 — `bigint16` · `bigint32` · `bigint64`(RFC-0151 §9.5, 소유자 2026-10-22).
rem   부르는 쪽은 `use` 한 줄만 바꿔 폭을 고른다. 32×32 → 64 비트 곱을 명령 하나로 하는 기계(32 비트 마이크로컨트롤러를 포함)의 기본 폭이다.
rem   ☞ 2026-10-22 까지는 `bigint` 라는 이름의 한 모듈이었다(16 비트 조각 → 같은 날 32 비트 조각).
rem   ☞ 세 파일은 한 틀에서 나온다 — 한 파일만 고치면 틀과의 대조가 실패한다.
rem
rem ★★ **크기는 바이트로 말한다**: 모든 op 이 조각 수가 아니라 수의 바이트 수 `nb` 를 받는다(RSA-2048 = 256 · P-256 = 32 · P-384 = 48).
rem   조각 수는 모듈 안에서만 안다 — `limbs nb.` 가 그 수(= ⌈nb / 4⌉)다. 그래서 폭을 바꿔도 부르는 글이 안 깨진다.
rem   담는 칸: 수 하나는 `limbs nb.` 칸, 작업 공간 `t` 는 그보다 2 칸 더. **⌈nb / 2⌉ + 2 칸을 잡으면 세 폭 어디에나 맞는다.**
rem
rem ★★ **표현**: 32 비트 조각(limb)을 u64 에 담고, **리틀엔디언 순서**로 늘어놓는다.
rem   곱은 32×32 = 64 비트다. 몽고메리 곱은 곱 하나마다 바로 올림을 넘기므로 한 칸의 합은
rem   (2^32−1) + (2^32−1)² + (2^32−1) = 2^64 − 1 — u64 에 든다(`add` 가 넘치면 멈추므로 틀렸다면 그 자리에서 드러난다).
rem
rem ★★★ **몽고메리 곱**을 쓴다(CIOS). 이유: 나눗셈 없이 `a·b·R^-1 mod n` 을 낸다 —
rem   큰수 나눗셈을 안 지어도 된다는 뜻이고, 안 지은 것은 틀릴 수도 없다.
rem   R = 2^(32k) 이고, `R^2 mod n` 은 **1 을 2·32k 번 배로 늘려** 얻는다(뺄셈만 쓴다).
rem
rem ☞ 안 지은 것: 상수시간 보장 · 큰수 나눗셈 · e 가 아주 큰 경우.
rem   ☞ RSA 검증은 **공개** 정보만 다루므로 상수시간이 필요한 자리가 아니다 — 곡선 서명은 이 모듈 위에서 따로 짓는다.

module bigint32 .

rem 바이트 nb 개짜리 수가 차지하는 조각 수 — ⌈nb / 4⌉. 더해서 나누지 않는다(`nb + 3` 은 맨 위에서 넘친다) — 몫에 나머지가 있으면 1 을 더한다.
export fn limbs input nb usize . output usize . do
  return add shr nb. 2 . cast usize ne bit_and nb. 3 . 0 . . . .
end .

rem nb 바이트짜리 수를 0 으로.
export proc zero input a mut slice u64 . input nb usize . output u64 . effects none . do
  let k usize limbs nb. . .
  guard ge len a. . k. . else return 0 . .
  var i usize 0 .
  while lt i. k. . do  set idx a. i. . 0 .  set i. add i. 1 . .  end .
  return 1 .
end .

rem 빅엔디언 바이트열 → 조각 리틀엔디언. 바이트 수는 nb 이하 — 모자란 위쪽은 0 이다. nb 를 돌려준다(못 하면 0).
export proc from_bytes input src slice u8 . input a mut slice u64 . input nb usize . output usize . effects none . do
  let k usize limbs nb. . .
  guard le len src. . nb. . else return 0 . .
  guard ge len a. . k. . else return 0 . .
  rem 바이트열 앞에 0 이 pad 개 있다고 본다(조각 경계까지 채운다).
  let pad usize sub mul k. 4 . len src. . . .
  var i usize 0 .
  while lt i. k. . do
    let b usize mul sub sub k. 1 . i. . 4 . .
    var v u64 0 .
    var j usize 0 .
    while lt j. 4 . do
      if ge add b. j. . pad. . do
        set v. bit_or shl v. 8 . cast u64 idx src. sub add b. j. . pad. . . . . .
      end .
      if lt add b. j. . pad. . do  set v. shl v. 8 . .  end .
      set j. add j. 1 . .
    end .
    set idx a. i. . v. .
    set i. add i. 1 . .
  end .
  return nb. .
end .

rem 조각 → 빅엔디언 바이트열 — `out` 의 길이만큼(nb 이하) 아래 바이트를 쓴다. 쓴 바이트 수를 돌려준다.
export proc to_bytes input a slice u64 . input nb usize . input out mut slice u8 . output usize . effects none . do
  guard le len out. . nb. . else return 0 . .
  let n usize len out. . .
  var q usize 0 .
  while lt q. n. . do
    rem 끝에서 q 번째 바이트 = 조각 q/4 의 (q mod 4) 번째 바이트
    let limb u64 idx a. shr q. 2 . . .
    set idx out. sub sub n. 1 . q. . . cast u8 bit_and shr limb. mul bit_and cast u64 q. . 3 . 8 . . 255 . . .
    set q. add q. 1 . .
  end .
  return n. .
end .

rem **리틀엔디언** 바이트열 32 → 조각. 32 를 돌려준다. (Ed25519 의 스칼라가 이 순서다.)
export proc from_bytes_le input src slice u8 . input a mut slice u64 . output u64 . effects none . do
  guard ge len src. . 32 . else return 0 . .
  guard ge len a. . 8 . else return 0 . .
  var i usize 0 .
  while lt i. 8 . do
    var v u64 0 .
    var j usize 4 .
    while gt j. 0 . do
      set j. sub j. 1 . .
      set v. bit_or shl v. 8 . cast u64 idx src. add mul i. 4 . j. . . . . .
    end .
    set idx a. i. . v. .
    set i. add i. 1 . .
  end .
  return 32 .
end .

rem 조각 → **리틀엔디언** 바이트열 32. 32 를 돌려준다.
export proc to_bytes_le input out mut slice u8 . input a slice u64 . output u64 . effects none . do
  guard ge len out. . 32 . else return 0 . .
  var q usize 0 .
  while lt q. 32 . do
    set idx out. q. . cast u8 bit_and shr idx a. shr q. 2 . . mul bit_and cast u64 q. . 3 . 8 . . 255 . . .
    set q. add q. 1 . .
  end .
  return 32 .
end .

rem a >= n 인가 (둘 다 nb 바이트).
export fn ge_mod input a slice u64 . input n slice u64 . input nb usize . output u64 . do
  var i usize limbs nb. . .
  var res u64 1 .
  var done u64 0 .
  while eq done. 0 . do
    if eq i. 0 . do  set done. 1 .  end .
    if eq done. 0 . do
      set i. sub i. 1 . .
      if gt idx a. i. . idx n. i. . . do  set res. 1 .  set done. 1 .  end .
      if eq done. 0 . do
        if lt idx a. i. . idx n. i. . . do  set res. 0 .  set done. 1 .  end .
      end .
    end .
  end .
  return res. .
end .

rem a ← a − n (a >= n 일 때만 부른다). k 는 조각 수.
proc sub_mod input a mut slice u64 . input n slice u64 . input k usize . output u64 . effects none . do
  var borrow u64 0 .
  var i usize 0 .
  while lt i. k. . do
    let d u64 wrap_sub wrap_sub idx a. i. . idx n. i. . . borrow. . .
    set idx a. i. . bit_and d. 4294967295 . .
    rem 빌림은 **비트로 읽는다** — wrap_sub 이 감기면 상위가 전부 1 이 된다.
    set borrow. bit_and shr d. 63 . 1 . .
    set i. add i. 1 . .
  end .
  return 1 .
end .

rem ★ a ← 2a mod n. 나눗셈 없이 R 이나 R^2 를 만드는 도구다.
export proc dbl_mod input a mut slice u64 . input n slice u64 . input nb usize . output u64 . effects none . do
  let k usize limbs nb. . .
  var carry u64 0 .
  var i usize 0 .
  while lt i. k. . do
    let v u64 add shl idx a. i. . 1 . carry. . .
    set idx a. i. . bit_and v. 4294967295 . .
    set carry. shr v. 32 . .
    set i. add i. 1 . .
  end .
  rem 넘친 비트가 있거나 n 이상이면 한 번 뺀다. (2a < 2n 이므로 한 번이면 족하다.)
  if eq carry. 1 . do
    let z1 u64 sub_mod a. n. k. . .
    return 1 .
  end .
  if eq ge_mod a. n. nb. . 1 . do
    let z2 u64 sub_mod a. n. k. . .
  end .
  return 1 .
end .

rem ★★ 몽고메리 곱 (CIOS): out ← a·b·R^-1 mod n.  `t` 는 `limbs nb.` + 2 칸 작업 공간.
rem   ninv = −n[0]^-1 mod 2^32 — `n0inv n.` 이 낸다.
export proc mont_mul input out mut slice u64 . input a slice u64 . input b slice u64 . input n slice u64 .
     input nb usize . input ninv u64 . input t mut slice u64 . output u64 . effects none . inplace out a . inplace out b . do
  let k usize limbs nb. . .
  guard ge len t. . add k. 2 . . else return 0 . .
  var z usize 0 .
  while lt z. add k. 2 . . do  set idx t. z. . 0 .  set z. add z. 1 . .  end .
  var i usize 0 .
  while lt i. k. . do
    rem t ← t + a[i]·b
    var carry u64 0 .
    var j usize 0 .
    while lt j. k. . do
      let s u64 add add idx t. j. . mul idx a. i. . idx b. j. . . . carry. . .
      set idx t. j. . bit_and s. 4294967295 . .
      set carry. shr s. 32 . .
      set j. add j. 1 . .
    end .
    let s1 u64 add idx t. k. . carry. . .
    set idx t. k. . bit_and s1. 4294967295 . .
    set idx t. add k. 1 . . add idx t. add k. 1 . . shr s1. 32 . . .
    rem m = t[0]·n0inv mod 2^32,  t ← (t + m·n) / 2^32
    let m u64 bit_and mul idx t. 0 . ninv. . 4294967295 . .
    let s2 u64 add idx t. 0 . mul m. idx n. 0 . . . .
    var carry2 u64 shr s2. 32 . .
    var q usize 1 .
    while lt q. k. . do
      let s3 u64 add add idx t. q. . mul m. idx n. q. . . . carry2. . .
      set idx t. sub q. 1 . . bit_and s3. 4294967295 . .
      set carry2. shr s3. 32 . .
      set q. add q. 1 . .
    end .
    let s4 u64 add idx t. k. . carry2. . .
    set idx t. sub k. 1 . . bit_and s4. 4294967295 . .
    set idx t. k. . add idx t. add k. 1 . . shr s4. 32 . . .
    set idx t. add k. 1 . . 0 .
    set i. add i. 1 . .
  end .
  var c usize 0 .
  while lt c. k. . do  set idx out. c. . idx t. c. . .  set c. add c. 1 . .  end .
  rem t[k] 가 서 있거나 n 이상이면 한 번 뺀다.
  if gt idx t. k. . 0 . do
    let z3 u64 sub_mod out. n. k. . .
    return 1 .
  end .
  if eq ge_mod out. n. nb. . 1 . do
    let z4 u64 sub_mod out. n. k. . .
  end .
  return 1 .
end .

rem ★ n0inv = −n[0]^-1 mod 2^32 (n 은 홀수) — 뉴턴 반복은 맞는 비트를 배로 늘린다(1 → 32 에 5 번, 하나 더 돈다).
export fn n0inv input n slice u64 . output u64 . do
  let x u64 bit_and idx n. 0 . 4294967295 . .
  var inv u64 1 .
  var i u64 0 .
  while lt i. 6 . do
    rem ☞ `2 − x·inv` 는 **음수를 지난다**(뉴턴 반복은 2 의 보수 위에서 돈다).
    rem   `sub` 는 트랩하므로 랩을 이름으로 말하고, **곱하기 전에 32 비트로 자른다** —
    rem   안 자르면 u64 곱이 넘친다.
    let d u64 bit_and wrap_sub 2 bit_and mul x. inv. . 4294967295 . . 4294967295 . .
    set inv. bit_and mul inv. d. . 4294967295 . .
    set i. add i. 1 . .
  end .
  rem −inv mod 2^32
  return bit_and wrap_sub 0 inv. . 4294967295 . .
end .

rem ★★★ RSA 검증의 전부: out ← base^e mod n.  e 는 작은 지수(3 · 65537 …).
rem   작업 공간: r2 · acc · tmp · t 각각 `limbs nb.` + 2 칸 이상.
export proc mod_exp input out mut slice u64 . input bse slice u64 . input e u64 . input n slice u64 .
     input nb usize . input r2 mut slice u64 . input acc mut slice u64 . input tmp mut slice u64 .
     input t mut slice u64 . output u64 . effects none . do
  guard gt nb. 0 . else return 0 . .
  guard gt e. 0 . else return 0 . .
  let k usize limbs nb. . .
  let n0i u64 n0inv n. . .

  rem R^2 mod n — 1 을 2·32k 번 배로 늘린다. 나눗셈이 필요 없다.
  let z0 u64 zero r2. nb. . .
  set idx r2. 0 . 1 .
  var d usize 0 .
  while lt d. mul 64 k. . . do
    let zz u64 dbl_mod r2. n. nb. . .
    set d. add d. 1 . .
  end .

  rem acc ← 1 을 몽고메리 형태로(= R mod n) · tmp ← base 를 몽고메리 형태로
  let z1 u64 zero acc. nb. . .
  set idx acc. 0 . 1 .
  let m1 u64 mont_mul acc. acc. r2. n. nb. n0i. t. . .
  let m2 u64 mont_mul tmp. bse. r2. n. nb. n0i. t. . .

  rem e 의 비트를 **위에서부터** 훑는다.
  var hb u64 63 .
  var found u64 0 .
  while eq found. 0 . do
    if eq bit_and shr e. hb. . 1 . 1 . do  set found. 1 .  end .
    if eq found. 0 . do  set hb. sub hb. 1 . .  end .
  end .
  var bi u64 hb. .
  var done u64 0 .
  while eq done. 0 . do
    let sq u64 mont_mul acc. acc. acc. n. nb. n0i. t. . .
    if eq bit_and shr e. bi. . 1 . 1 . do
      let mu u64 mont_mul acc. acc. tmp. n. nb. n0i. t. . .
    end .
    if eq bi. 0 . do  set done. 1 .  end .
    if eq done. 0 . do  set bi. sub bi. 1 . .  end .
  end .

  rem 몽고메리 형태를 벗긴다: ×1
  let z2 u64 zero tmp. nb. . .
  set idx tmp. 0 . 1 .
  return mont_mul out. acc. tmp. n. nb. n0i. t. . .
end .
