rem ★★★ **ChaCha20** (RFC 8439 §2.4) — Lowent 로 쓴다.
rem
rem   32비트 덧셈·xor·회전만 쓰는 순수 계산이고 **이 언어로 표현된다** — 아래 `qround`·`rounds`·
rem   `keystream` 이 그 글이다. 그것이 이 모듈이 말하는 **뜻의 정의**이고, 지우지 않는다.
rem
rem ★★★★ **다만 흐름은 낱말이 판다** (RFC-0122, 2026-09-24, 소유자 지시 «chacha 의 simd 낱말»).
rem   언어로 쓴 판은 실측 **89 MB/s** 였다. 모자란 것은 알고리즘이 아니라 **폭**이다: ChaCha 의
rem   블록들은 서로 독립이므로(카운터만 다르다) 넷·여덟을 한 레지스터의 레인에 나란히 실으면
rem   그대로 넷·여덟 배가 된다. 그 폭이 이 언어에 없다.
rem   ⇒ `stream` 은 이제 낱말 `chacha20` 을 부른다. **답은 같다** — 골든이 낱말과 위의 정의를
rem     같은 입력으로 맞댄다(`impl/tests/vm_chacha.low` 의 `same`). `gmul128` 과 잎 `ghash` 가
rem     선 자리와 같은 자리다.
rem   ☞ VM 은 언제나 셈 판을 돈다 ⇒ 오라클(VM ≡ 네이티브)이 SIMD 경로의 차등 시험이다.
rem
rem ★ 오라클은 **RFC 8439 의 테스트 벡터**다(§2.3.2 블록 함수 · §2.4.2 암호화).
rem
rem ★★ **32비트 산술을 u64 위에서 한다.** 이 언어의 `add` 는 오버플로를 트랩하므로,
rem   랩어라운드가 필요한 자리는 **마스크를 명시**한다(`bit_and … 4294967295`).
rem   그것이 곧 *"랩을 원하면 이름으로 말하라"* 는 이 언어의 규율과 같은 자리다.

module chacha .

rem ★★★★ **「자리가 모자라다」와 「답이 아니다」는 다른 사실이다** (X-0035, 소유자 결정 2026-09-20).
rem   그전에는 둘 다 0 이었다 — 재지 못한 것과 재고 나서 «아니다» 하는 것이 **같은 값**이었고,
rem   그래서 작업 공간을 잘못 준 판이 «답이 틀렸다» 로 보였다. 이제 모자람은 값이 아니라 **실패**다.
export enum chacha_error do
  short_workspace .
end .


let mask32 u64 be 4294967295 .

rem 32비트 왼쪽 회전.
fn rotl32 input x u64 . input n u64 . output u64 . do
  let a u64 be bit_and (shl x n) 4294967295 .
  let b u64 be shr (bit_and x 4294967295) (sub 32 n) .
  return bit_or a b .
end .

rem 32비트 덧셈(랩).
fn add32 input a u64 . input b u64 . output u64 . do
  return bit_and (add (bit_and a 4294967295) (bit_and b 4294967295)) 4294967295 .
end .

rem ★ 쿼터라운드 하나를 상태 슬라이스 위에서 제자리로 돈다.
rem   `st` 는 원소 16 개(각 32비트 값을 u64 로 담는다).
proc qround input st mut slice u64 . input a u64 . input b u64 . input c u64 . input d u64 . output u64 . effects none . do
  set (index st a) (add32 (index st a) (index st b)) .
  set (index st d) (rotl32 (bit_xor (index st d) (index st a)) 16) .
  set (index st c) (add32 (index st c) (index st d)) .
  set (index st b) (rotl32 (bit_xor (index st b) (index st c)) 12) .
  set (index st a) (add32 (index st a) (index st b)) .
  set (index st d) (rotl32 (bit_xor (index st d) (index st a)) 8) .
  set (index st c) (add32 (index st c) (index st d)) .
  set (index st b) (rotl32 (bit_xor (index st b) (index st c)) 7) .
  return 1 .
end .

rem ★ 블록 함수: 상태 16 워드를 20 라운드 돌리고 원래 상태를 더한다.
rem   `st` 에는 호출자가 초기 상태를 채워 둔다. `work` 는 16 원소 작업 공간.
export proc rounds input st slice u64 . input work mut slice u64 . output result u64 chacha_error . effects none .
errors short_workspace . do
  guard ge (len st) 16 . else return ok 0 .
  guard ge (len work) 16 . else return error short_workspace .
  var i u64 be 0 .
  while lt i 16 . do
    set (index work i) (index st i) .
    set i (add i 1) .
  end .
  var r u64 be 0 .
  while lt r 10 . do
    rem 열(column) 라운드
    let z1 u64 be qround work 0 4 8 12 .
    let z2 u64 be qround work 1 5 9 13 .
    let z3 u64 be qround work 2 6 10 14 .
    let z4 u64 be qround work 3 7 11 15 .
    rem 대각(diagonal) 라운드
    let z5 u64 be qround work 0 5 10 15 .
    let z6 u64 be qround work 1 6 11 12 .
    let z7 u64 be qround work 2 7 8 13 .
    let z8 u64 be qround work 3 4 9 14 .
    set r (add r 1) .
  end .
  var j u64 be 0 .
  while lt j 16 . do
    set (index work j) (add32 (index work j) (index st j)) .
    set j (add j 1) .
  end .
  return ok 16 .
end .

rem ★ 상태를 세운다: 상수 4 · 키 8 · 카운터 1 · nonce 3 = 16 워드.
rem   상수는 "expand 32-byte k" 를 리틀엔디언 32비트 넷으로 읽은 것이다(RFC 8439 §2.3).
rem   ☞ 키는 **정확히 32**, nonce 는 **정확히 12** 바이트다. 전엔 `ge` 여서 24 바이트 nonce
rem     (XChaCha 모양)를 주면 앞 12 만 쓰고 16 을 답했다 — *성공한 척한 다른 암호*다
rem     (2026-09-04 검토 A2). 이 모듈은 RFC 8439 의 ChaCha20 뿐이므로 다른 길이는 거절한다.
export proc prep input key slice u8 . input nonce slice u8 . input counter u64 . input st mut slice u64 . output u64 . effects none . do
  guard eq (len key) 32 . else return 0 .
  guard eq (len nonce) 12 . else return 0 .
  guard ge (len st) 16 . else return 0 .
  set (index st 0) 1634760805 .
  set (index st 1) 857760878 .
  set (index st 2) 2036477234 .
  set (index st 3) 1797285236 .
  var i u64 be 0 .
  while lt i 8 . do
    var w u64 be 0 .
    var b u64 be 0 .
    while lt b 4 . do
      set w (bit_or w (shl (cast u64 (index key (add (mul i 4) b))) (mul b 8))) .
      set b (add b 1) .
    end .
    set (index st (add 4 i)) w .
    set i (add i 1) .
  end .
  set (index st 12) (bit_and counter 4294967295) .
  var j u64 be 0 .
  while lt j 3 . do
    var v u64 be 0 .
    var c u64 be 0 .
    while lt c 4 . do
      set v (bit_or v (shl (cast u64 (index nonce (add (mul j 4) c))) (mul c 8))) .
      set c (add c 1) .
    end .
    set (index st (add 13 j)) v .
    set j (add j 1) .
  end .
  return 16 .
end .

rem ★ 키스트림 한 블록(64 바이트)을 `ks` 에 리틀엔디언으로 편다.
export proc keystream input st slice u64 . input work mut slice u64 . input ks mut slice u8 . output result u64 chacha_error . effects none .
errors short_workspace . do
  guard ge (len ks) 64 . else return ok 0 .
  let _u1 result u64 chacha_error . be rounds st work .
  guard is_ok _u1 . else return error short_workspace .
  guard eq (ok_value _u1) 16 . else return ok 0 .
  var i u64 be 0 .
  while lt i 16 . do
    var b u64 be 0 .
    while lt b 4 . do
      set (index ks (add (mul i 4) b)) (cast u8 (bit_and (shr (index work i) (mul b 8)) 255)) .
      set b (add b 1) .
    end .
    set i (add i 1) .
  end .
  return ok 64 .
end .

rem ★★ 스트림 암·복호(같은 연산이다). `counter` 는 시작 블록 번호.
rem   `st`·`work` 16 원소, `ks` 64 바이트를 호출자가 준다 — 이 언어에서 할당은
rem   **호출자의 몫**이다. 그래서 이 프로시저는 effects none 이다.
export proc stream input key slice u8 . input nonce slice u8 . input counter u64 . input inp slice u8 . input out mut slice u8 . input st mut slice u64 . input work mut slice u64 . input ks mut slice u8 . output result u64 chacha_error . effects none .
errors short_workspace . do
  guard ge (len out) (len inp) . else return ok 0 .
  guard eq (len key) 32 . else return ok 0 .
  guard eq (len nonce) 12 . else return ok 0 .
  guard ge (len st) 16 . else return ok 0 .
  guard ge (len work) 16 . else return error short_workspace .
  guard ge (len ks) 64 . else return ok 0 .
  rem ★ 카운터 블록을 `ks` 의 앞 16 바이트에 세운다 — 앞 4 는 블록 번호(리틀엔디언),
  rem   뒤 12 는 nonce. 이 언어에서 뒷받침은 **호출자의 몫**이므로 새 버퍼를 얻지 않고
  rem   이미 받은 작업 공간을 쓴다(`ks` 는 이 부름 동안 낱말이 채우지 않는다).
  var b u64 be 0 .
  while lt b 4 . do
    set (index ks b) (cast u8 (bit_and (shr counter (mul b 8)) 255)) .
    set b (add b 1) .
  end .
  var j u64 be 0 .
  while lt j 12 . do
    set (index ks (add 4 j)) (index nonce j) .
    set j (add j 1) .
  end .
  let n u64 be call_builtin chacha20 key (subslice ks 0 16) inp out .
  guard eq n (len inp) . else return ok 0 .
  return ok (len inp) .
end .
