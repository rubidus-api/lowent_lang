rem ★★★ **열일곱 번째 표준 라이브러리 — 바이트 코덱 (hex · base64)** (RFC-0075 §5 · 3차 슬라이스 1).
rem
rem ★ 순수 L0 다: effects none · 숨은 할당 0 · **출력 버퍼는 호출자의 것**(strbuf 과 같은 판단 —
rem   버퍼를 마련하는 비용과 정책은 호출자만 안다). 언어는 아무것도 안 늘었다: index·set·shl·shr·
rem   bit_and·bit_or·guard·while 만 썼다.
rem
rem ★★ **잘못된 입력은 값으로 답한다** — `none` 하나다: 홀수 길이 hex · hex 아닌 글자 ·
rem   base64 아닌 글자 · 어긋난 패딩 · **모자란 출력 버퍼** 전부. 트랩도 잘림도 아니다 —
rem   잘라 주면 그 뒤의 모든 층이 "다 썼다" 는 거짓 전제 위에 선다.
rem   성공은 `some <쓴 바이트 수>` — 호출자가 subslice 로 정확한 결과를 얻는다.
rem
rem ★ 확정: hex 인코딩은 **소문자**를 낸다(디코드는 대소 둘 다 받는다 — 관대한 수신, 보수적 송신).
rem   base64 는 표준 알파벳(+/)과 `=` 패딩이다. url-safe 변형·개행 접기는 **안 지었다**(필요가
rem   생기면 그때 별도 op 으로 — 한 op 에 모드 인자를 다는 것이 곧 엔트로피다).

module codec .

rem 한 니블(0~15)을 소문자 hex 글자로. **15 를 넘으면 '?'(63)** 를 낸다 — hex 글자가 아닌 것을
rem   내서 그 출력이 hex 로 다시 읽히지 않게 한다(`hex_val '?'` = none).
rem   ☞ 전엔 검사 없이 `narrow u8 (add 87 v)` 여서 `hex_digit 200` 이 E-VM-CAST 로 **트랩**했다
rem     (2026-09-04 검토). 출력이 u8 이라 option 을 낼 자리가 없으므로 실패는 *값*으로 —
rem     그리고 마스크해서 조용히 다른 글자를 내지 않는다(그건 "조용히 다르게" 다).
export fn hex_digit output u8 . input v u64 . do
  guard lt v 16 . else return 63 .
  if lt v 10 . do return narrow u8 (add 48 v) . end .
  return narrow u8 (add 87 v) .
end .

rem hex 글자 하나의 값. 0~9 a~f A~F 밖이면 none.
export fn hex_val output option u64 . input c u8 . do
  if ge c 48 . do if le c 57 . do return some (sub (widen u64 c) 48) . end end .
  if ge c 97 . do if le c 102 . do return some (sub (widen u64 c) 87) . end end .
  if ge c 65 . do if le c 70 . do return some (sub (widen u64 c) 55) . end end .
  return none .
end .

rem ★ src 를 소문자 hex 로 dst 에 쓴다. 성공 = some (2×len src). dst 가 모자라면 none.
export proc hex_enc output option u64 . input src slice u8 . input dst mut slice u8 . . effects none . do
  let need u64 be mul 2 (len src) .
  guard le need (len dst) . else return none .
  var i u64 be 0 .
  while lt i (len src) . do
    let b u64 be widen u64 (index src i) .
    set (index dst (mul 2 i)) (hex_digit (shr b 4)) .
    set (index dst (add (mul 2 i) 1)) (hex_digit (bit_and b 15)) .
    set i (add i 1) .
  end .
  return some need .
end .

rem ★ hex 를 바이트로. 홀수 길이·hex 아닌 글자·모자란 dst = none. 성공 = some (len src / 2).
export proc hex_dec output option u64 . input src slice u8 . input dst mut slice u8 . . effects none . do
  guard eq (mod (len src) 2) 0 . else return none .
  let need u64 be div (len src) 2 .
  guard le need (len dst) . else return none .
  var i u64 be 0 .
  while lt i need . do
    let hv option u64 . be hex_val (index src (mul 2 i)) .
    guard is_some hv . else return none .
    let lv option u64 . be hex_val (index src (add (mul 2 i) 1)) .
    guard is_some lv . else return none .
    set (index dst i) (narrow u8 (bit_or (shl (some_value hv) 4) (some_value lv))) .
    set i (add i 1) .
  end .
  return some need .
end .

rem base64 표준 알파벳의 i(0~63)번째 글자.
export fn b64_digit output u8 . input v u64 . do
  if lt v 26 . do return narrow u8 (add 65 v) . end .
  if lt v 52 . do return narrow u8 (add 71 v) . end .
  if lt v 62 . do return narrow u8 (sub v 4) . end .
  if eq v 62 . do return 43 . end .
  return 47 .
end .

rem base64 글자 하나의 값. 알파벳 밖이면 none. (`=` 도 none — 패딩은 디코더 본문이 다룬다.)
export fn b64_val output option u64 . input c u8 . do
  if ge c 65 . do if le c 90 . do return some (sub (widen u64 c) 65) . end end .
  if ge c 97 . do if le c 122 . do return some (sub (widen u64 c) 71) . end end .
  if ge c 48 . do if le c 57 . do return some (add (widen u64 c) 4) . end end .
  if eq c 43 . do return some 62 . end .
  if eq c 47 . do return some 63 . end .
  return none .
end .

rem ★ src 를 base64 로 dst 에 쓴다(`=` 패딩 포함). 성공 = some (4×⌈len/3⌉). dst 모자라면 none.
export proc b64_enc output option u64 . input src slice u8 . input dst mut slice u8 . . effects none . do
  let full u64 be div (len src) 3 .
  let tail u64 be mod (len src) 3 .
  var groups u64 be full .
  if gt tail 0 . do set groups (add groups 1) . end .
  let need u64 be mul 4 groups .
  guard le need (len dst) . else return none .
  var i u64 be 0 .
  var o u64 be 0 .
  while lt i (mul 3 full) . do
    let w u64 be bit_or (shl (widen u64 (index src i)) 16) (bit_or (shl (widen u64 (index src (add i 1))) 8) (widen u64 (index src (add i 2)))) .
    set (index dst o) (b64_digit (shr w 18)) .
    set (index dst (add o 1)) (b64_digit (bit_and (shr w 12) 63)) .
    set (index dst (add o 2)) (b64_digit (bit_and (shr w 6) 63)) .
    set (index dst (add o 3)) (b64_digit (bit_and w 63)) .
    set i (add i 3) .
    set o (add o 4) .
  end .
  if eq tail 1 . do
    let w u64 be shl (widen u64 (index src i)) 16 .
    set (index dst o) (b64_digit (shr w 18)) .
    set (index dst (add o 1)) (b64_digit (bit_and (shr w 12) 63)) .
    set (index dst (add o 2)) 61 .
    set (index dst (add o 3)) 61 .
  end .
  if eq tail 2 . do
    let w u64 be bit_or (shl (widen u64 (index src i)) 16) (shl (widen u64 (index src (add i 1))) 8) .
    set (index dst o) (b64_digit (shr w 18)) .
    set (index dst (add o 1)) (b64_digit (bit_and (shr w 12) 63)) .
    set (index dst (add o 2)) (b64_digit (bit_and (shr w 6) 63)) .
    set (index dst (add o 3)) 61 .
  end .
  return some need .
end .

rem ★ base64 를 바이트로. 길이 4의 배수가 아니거나·알파벳 밖 글자·어긋난 패딩·모자란 dst = none.
rem   성공 = some <쓴 바이트 수> (패딩만큼 줄어든 정확한 길이).
rem ★ 마지막 그룹의 **남는 비트는 0 이어야 한다**(RFC 4648 §3.5) — `QR==` 는 `QQ==` 와 같은
rem   바이트를 내지만 정규 인코딩이 아니므로 none 이다. 받아 주면 같은 바이트열에 인코딩이
rem   여럿이 되어, 인코딩된 문자열을 맞대는 자리(PEM 본문 고정·중복 제거)가 속는다
rem   (2026-09-04 검토 A2). 이 모듈의 다른 어긋남과 같이 **값으로** 거절한다.
export proc b64_dec output option u64 . input src slice u8 . input dst mut slice u8 . . effects none . do
  guard eq (mod (len src) 4) 0 . else return none .
  guard gt (len src) 0 . else return some 0 .
  var pad u64 be 0 .
  if eq (index src (sub (len src) 1)) 61 . do set pad 1 .
    if eq (index src (sub (len src) 2)) 61 . do set pad 2 . end .
  end .
  let need u64 be sub (mul 3 (div (len src) 4)) pad .
  guard le need (len dst) . else return none .
  var i u64 be 0 .
  var o u64 be 0 .
  while lt i (len src) . do
    let last bool be eq (add i 4) (len src) .
    let v0 option u64 . be b64_val (index src i) .
    guard is_some v0 . else return none .
    let v1 option u64 . be b64_val (index src (add i 1)) .
    guard is_some v1 . else return none .
    var w u64 be bit_or (shl (some_value v0) 18) (shl (some_value v1) 12) .
    var nb u64 be 3 .
    let c2 u8 be index src (add i 2) .
    let c3 u8 be index src (add i 3) .
    if eq c2 61 . do
      rem `==` 은 마지막 그룹에서만, 그리고 c3 도 `=` 여야 한다.
      guard last . else return none .
      guard eq c3 61 . else return none .
      rem 1 바이트만 실렸다: 비트 16..23 이 자료, 아래 16 비트(v1 의 하위 4 비트)는 0 이어야 한다.
      guard eq (bit_and w 65535) 0 . else return none .
      set nb 1 .
    end .
    if ne c2 61 . do
      let v2 option u64 . be b64_val c2 .
      guard is_some v2 . else return none .
      set w (bit_or w (shl (some_value v2) 6)) .
      if eq c3 61 . do
        guard last . else return none .
        rem 2 바이트가 실렸다: 비트 8..23 이 자료, 아래 8 비트(v2 의 하위 2 비트)는 0 이어야 한다.
        guard eq (bit_and w 255) 0 . else return none .
        set nb 2 .
      end .
      if ne c3 61 . do
        let v3 option u64 . be b64_val c3 .
        guard is_some v3 . else return none .
        set w (bit_or w (some_value v3)) .
      end .
    end .
    set (index dst o) (narrow u8 (shr w 16)) .
    if ge nb 2 . do set (index dst (add o 1)) (narrow u8 (bit_and (shr w 8) 255)) . end .
    if ge nb 3 . do set (index dst (add o 2)) (narrow u8 (bit_and w 255)) . end .
    set i (add i 4) .
    set o (add o nb) .
  end .
  return some need .
end .
