rem ★★★ **DER 최소 파서** — X.509 에서 **공개키만** 꺼낸다 (RFC-0090 N7c).
rem
rem   N7c 결정: **PKI 를 안 짓는다.** 체인 검증도, CA 신뢰 저장소도, 이름 대조도 없다.
rem   호출자가 상대의 공개키를 **고정(pinning)** 하거나, 인증서에서 꺼낸 키를 자기 규칙으로
rem   판단한다. ⇒ 여기가 하는 일은 단 하나: **SubjectPublicKeyInfo 를 찾아 준다.**
rem
rem ★★ **길이는 상대가 쓴 것이다.** DER 의 모든 길이 필드는 공격자가 정한다.
rem   그래서 이 파서는 세 가지를 지킨다:
rem     ① 어떤 길이도 **버퍼를 넘으면 즉시 실패**한다(0 을 답한다).
rem        ★ 그 검사는 `value_len` **한 곳**에 있다(2026-09-04) — 전엔 `next_off` 만 봤고,
rem          `spki_key_len`·`rsa_n_len` 같은 길이 접근자는 상대가 쓴 수를 **그대로** 돌려줬다.
rem          그 수로 복사하는 호출자는 경계에서 트랩했다(원격 DoS). 길이를 내는 길은
rem          전부 `value_len` 을 지나므로, 거기서 한 번 막으면 접근자 다섯이 같이 막힌다.
rem     ② 긴 형식 길이는 **4 바이트까지만** 받는다(그 이상은 이 세상 인증서가 아니다).
rem     ③ 재귀를 안 한다 — 깊이는 호출자가 정하는 반복이다.
rem     ④ 길이는 **최소 형식만** 받는다(X.690 §10.1) — 그것이 BER 아닌 DER 이다.
rem   ☞ *"보통은 괜찮다"* 가 파서에서 실패의 이름이다.
rem
rem ★ 오라클은 **RFC 8448 §3 의 실제 인증서**다. 그리고 검사는 파싱 결과를 눈으로 보는 게
rem   아니라 **끝까지 써 본다**: 꺼낸 공개키로 그 핸드셰이크의 CertificateVerify 서명을
rem   검증한다. 파싱이 한 바이트라도 틀리면 서명이 안 맞는다.
rem
rem ☞ 안 지은 것: 체인·유효기간·이름·확장·폐기 — 전부 N7c 가 안 짓기로 한 것이다.
rem   ☞ **안 지었으므로 지은 척하지 않는다**: 이 모듈은 *"이 인증서가 믿을 만한가"* 에
rem     아무 답도 하지 않는다. 그것은 호출자의 물음이다.

module der .

rem ── 한 요소의 겉모습 ────────────────────────────────────────────────────
rem   DER 요소 = tag(1) ‖ length ‖ value.  길이는 짧은 형식(<128)이거나
rem   긴 형식(0x80|n 다음 n 바이트 빅엔디언)이다.

rem 요소의 tag. 버퍼 밖이면 256.
export fn tag_at input b slice u8 . input off u64 . output u64 . do
  guard lt off (len b) else return 256 .
  return cast u64 (idx b off) .
end

rem ★★ 긴 형식 길이(0x80|n 뒤 n 바이트)가 **DER 로 적법한가**. 1 = 적법, 0 = 거절.
rem   `value_off` 와 `value_len` 이 같은 판단을 하므로 한 곳에 둔다.
rem   ☞ X.690 §10.1: DER 은 길이를 **가능한 가장 짧은 형식**으로만 적는다 —
rem       · 128 미만은 짧은 형식이어야 한다(`81 03` 은 `03` 이어야 했다),
rem       · 긴 형식의 첫 바이트는 0 이 아니다(`82 00 03` 도 `03` 이어야 했다),
rem       · `80`(부정 길이)은 DER 에 없다.
rem     그 셋을 받아 주면 BER 이다: **같은 구조에 바이트열이 여럿**이 되고, 고정(pinning)이나
rem     서명 대조처럼 *바이트가 곧 신원*인 자리에서 한 인증서가 여러 얼굴을 갖는다. 거절한다.
fn long_ok input b slice u8 . input off u64 . input n u64 . output u64 . do
  guard gt n 0 else return 0 .
  guard le n 4 else return 0 .
  guard le (add (add off 2) n) (len b) else return 0 .
  let b0 u64 cast u64 (idx b (add off 2)) .
  guard gt b0 0 else return 0 .
  if eq n 1 do
    if lt b0 128 do  return 0 .  end
  end
  return 1 .
end

rem 값이 시작하는 자리(= 머리 길이 뒤). 실패면 0.
export fn value_off input b slice u8 . input off u64 . output u64 . do
  guard lt (add off 1) (len b) else return 0 .
  let l0 u64 cast u64 (idx b (add off 1)) .
  if lt l0 128 do  return add off 2 .  end
  let n u64 sub l0 128 .
  guard eq (long_ok b off n) 1 else return 0 .
  return add (add off 2) n .
end

rem 값의 길이. 실패면 0 을 답하되, **길이 0 인 요소와 구별이 필요하면 value_off 를 먼저 본다**.
rem ★ **값이 버퍼를 넘으면 0** — 상대가 쓴 길이는 버퍼 안에 다 있을 때만 길이다(머리 ①).
rem   이 한 줄이 `alg_oid_len`·`spki_key_len`·`rsa_n_len`·`p8_inner_len`·`ec_priv_len` 을 전부 지킨다.
export fn value_len input b slice u8 . input off u64 . output u64 . do
  guard lt (add off 1) (len b) else return 0 .
  let l0 u64 cast u64 (idx b (add off 1)) .
  if lt l0 128 do
    guard le (add (add off 2) l0) (len b) else return 0 .
    return l0 .
  end
  let n u64 sub l0 128 .
  guard eq (long_ok b off n) 1 else return 0 .
  var v u64 0 .
  var i u64 0 .
  while lt i n do
    set v (add (shl v 8) (cast u64 (idx b (add (add off 2) i)))) .
    set i (add i 1) .
  end
  rem n ≤ 4 이므로 v < 2^32 — 이 덧셈은 넘치지 않는다.
  guard le (add (add (add off 2) n) v) (len b) else return 0 .
  return v .
end

rem ★ 요소 하나를 통째로 건너뛴 다음 자리. **버퍼를 넘으면 0** — 길이를 믿지 않는다.
export fn next_off input b slice u8 . input off u64 . output u64 . do
  let vo u64 value_off b off .
  guard gt vo 0 else return 0 .
  let vl u64 value_len b off .
  let e u64 add vo vl .
  guard le e (len b) else return 0 .
  return e .
end

rem ── SubjectPublicKeyInfo 찾기 ────────────────────────────────────────────
rem
rem ★★ **자리로 세지 않고 모양으로 찾는다.** X.509 의 tbsCertificate 안에서 SPKI 는
rem   버전 필드([0] EXPLICIT)가 있느냐에 따라 여섯째이거나 일곱째다. 자리로 세면
rem   **버전 없는 옛 인증서에서 조용히 어긋난다.** ⇒ 모양으로 본다:
rem     SEQUENCE { SEQUENCE { OID … }, BIT STRING }
rem   그것이 SPKI 다.

rem 요소가 SPKI 모양인가.
export fn is_spki input b slice u8 . input off u64 . output u64 . do
  guard eq (tag_at b off) 48 else return 0 .
  let vo u64 value_off b off .
  guard gt vo 0 else return 0 .
  rem 첫 자식이 SEQUENCE 이고 그 첫 자식이 OID(6) 인가
  guard eq (tag_at b vo) 48 else return 0 .
  let ao u64 value_off b vo .
  guard gt ao 0 else return 0 .
  guard eq (tag_at b ao) 6 else return 0 .
  rem 둘째 자식이 BIT STRING(3) 인가
  let n2 u64 next_off b vo .
  guard gt n2 0 else return 0 .
  guard eq (tag_at b n2) 3 else return 0 .
  return 1 .
end

rem ★★ 인증서(DER)에서 SPKI 의 자리를 찾는다. 못 찾으면 0.
rem   Certificate ::= SEQUENCE { tbsCertificate, … } 이므로 tbs 의 자식들을 훑는다.
export fn find_spki input b slice u8 . output u64 . do
  guard eq (tag_at b 0) 48 else return 0 .
  let co u64 value_off b 0 .
  guard gt co 0 else return 0 .
  rem 첫 자식 = tbsCertificate
  guard eq (tag_at b co) 48 else return 0 .
  let tbo u64 value_off b co .
  guard gt tbo 0 else return 0 .
  let tend u64 add tbo (value_len b co) .
  guard le tend (len b) else return 0 .
  var p u64 tbo .
  var found u64 0 .
  var done u64 0 .
  while eq done 0 do
    if ge p tend do  set done 1 .  end
    if eq done 0 do
      if eq (is_spki b p) 1 do
        set found p .
        set done 1 .
      end
      if eq done 0 do
        let nx u64 next_off b p .
        if eq nx 0 do  set done 1 .  end
        if gt nx 0 do  set p nx .  end
      end
    end
  end
  return found .
end

rem ★ SPKI 안의 알고리즘 OID 자리(값 시작)와 길이.
export fn alg_oid_off input b slice u8 . input spki u64 . output u64 . do
  let vo u64 value_off b spki .
  guard gt vo 0 else return 0 .
  let ao u64 value_off b vo .
  guard gt ao 0 else return 0 .
  return ao .
end

export fn alg_oid_len input b slice u8 . input spki u64 . output u64 . do
  let vo u64 value_off b spki .
  guard gt vo 0 else return 0 .
  return value_len b vo .
end

rem ★★ SPKI 의 BIT STRING 안쪽(= 키 바이트) 자리와 길이.
rem   ☞ BIT STRING 의 첫 바이트는 **사용하지 않는 비트 수**다. 키에서는 언제나 0 이고,
rem     그 한 바이트를 건너뛰는 것을 잊으면 키가 통째로 밀린다.
rem
rem ★★★★ **이름이 「어느 자리를 받는가」를 말한다**(X-0038, 2026-09-20). 이 둘은 **SPKI 의
rem   자리**를 받고, 바로 아래 `rsa_*` 는 **키의 자리**를 받는다. 그전에는 이름이 그것을
rem   말하지 않아서 둘을 바꿔 넣었고 — 도구는 수를 수로 받으므로 아무 말도 안 했다 —
rem   **진짜 ECDSA 인증서가 전부 거절됐다**(2026-09-18). 증상은 「서명이 틀렸다」 하나뿐이라
rem   틀린 자리를 가리키지 않는다. ⇒ 접두사가 그 물음에 답한다: `spki_…` 와 `rsa_…`.
export fn spki_key_off input b slice u8 . input spki u64 . output u64 . do
  let vo u64 value_off b spki .
  guard gt vo 0 else return 0 .
  let bs u64 next_off b vo .
  guard gt bs 0 else return 0 .
  guard eq (tag_at b bs) 3 else return 0 .
  let ko u64 value_off b bs .
  guard gt ko 0 else return 0 .
  guard lt ko (len b) else return 0 .
  guard eq (cast u64 (idx b ko)) 0 else return 0 .
  return add ko 1 .
end

export fn spki_key_len input b slice u8 . input spki u64 . output u64 . do
  let vo u64 value_off b spki .
  guard gt vo 0 else return 0 .
  let bs u64 next_off b vo .
  guard gt bs 0 else return 0 .
  let n u64 value_len b bs .
  guard gt n 0 else return 0 .
  return sub n 1 .
end

rem ★★ RSA 공개키를 편다: BIT STRING 안은 SEQUENCE { modulus INTEGER, exponent INTEGER }.
rem   modulus 의 자리·길이를 낸다. INTEGER 는 앞에 0x00 이 붙을 수 있다(부호 자리) —
rem   ☞ 그 0 을 안 벗기면 계수가 한 바이트 길어져 **모듈러 산술이 통째로 어긋난다**.
export fn rsa_n_off input b slice u8 . input ko u64 . output u64 . do
  guard eq (tag_at b ko) 48 else return 0 .
  let so u64 value_off b ko .
  guard gt so 0 else return 0 .
  guard eq (tag_at b so) 2 else return 0 .
  let no u64 value_off b so .
  guard gt no 0 else return 0 .
  guard lt no (len b) else return 0 .
  if eq (cast u64 (idx b no)) 0 do  return add no 1 .  end
  return no .
end

export fn rsa_n_len input b slice u8 . input ko u64 . output u64 . do
  guard eq (tag_at b ko) 48 else return 0 .
  let so u64 value_off b ko .
  guard gt so 0 else return 0 .
  guard eq (tag_at b so) 2 else return 0 .
  let nl u64 value_len b so .
  guard gt nl 0 else return 0 .
  let no u64 value_off b so .
  guard gt no 0 else return 0 .
  rem ★ `rsa_n_off` 와 같은 가드 — 이것이 빠져서 값 없는 INTEGER 머리가 버퍼 끝에 오면
  rem   `index b no` 가 트랩했다(2026-09-04 검토 A2). 형제가 가진 가드는 형제도 가져야 한다.
  guard lt no (len b) else return 0 .
  if eq (cast u64 (idx b no)) 0 do  return sub nl 1 .  end
  return nl .
end

rem ★ RSA 공개 지수(작은 수이므로 u64 로 낸다). 65537 이 거의 전부다.
export fn rsa_e input b slice u8 . input ko u64 . output u64 . do
  guard eq (tag_at b ko) 48 else return 0 .
  let so u64 value_off b ko .
  guard gt so 0 else return 0 .
  let eo u64 next_off b so .
  guard gt eo 0 else return 0 .
  guard eq (tag_at b eo) 2 else return 0 .
  let vo u64 value_off b eo .
  guard gt vo 0 else return 0 .
  let vl u64 value_len b eo .
  guard le vl 8 else return 0 .
  guard le (add vo vl) (len b) else return 0 .
  var v u64 0 .
  var i u64 0 .
  while lt i vl do
    set v (add (shl v 8) (cast u64 (idx b (add vo i)))) .
    set i (add i 1) .
  end
  return v .
end

rem ── PKCS#8 개인키 (RFC 5208 · RFC 5915) ────────────────────────────────────
rem ★★★ **2026-08-20 에 목표가 바뀌어 생긴 자리다.** 서버는 `CertificateVerify` 를 자기
rem   개인키로 서명하고, 그 키는 밖에서 온다(certbot 이 PEM 으로 놓아준다).
rem   ⇒ [pem](pem) 이 봉투를 벗기고, 여기서 **스칼라를 꺼낸다**.
rem
rem   PrivateKeyInfo ::= SEQUENCE {
rem     version           INTEGER,
rem     algorithm         AlgorithmIdentifier,        -- ecPublicKey + prime256v1
rem     privateKey        OCTET STRING                -- 안에 ECPrivateKey 가 또 있다
rem   }
rem   ECPrivateKey ::= SEQUENCE {
rem     version           INTEGER (1),
rem     privateKey        OCTET STRING (32 바이트)     -- ★ 이것이 우리가 원하는 것
rem     [0] parameters, [1] publicKey                  -- 선택
rem   }
rem
rem ☞ 여기서도 **길이는 상대가 쓴 것**이다. 다만 이 바이트는 *우리* 파일에서 왔으므로
rem   위협 모델이 다르다 — 그렇다고 검사를 빼지는 않는다. 파일도 바뀔 수 있다.

rem 알고리즘 SEQUENCE 의 자리. 0 = 성하지 않다.
export fn p8_alg_off input b slice u8 . output u64 . do
  if ne (tag_at b 0) 48 do return 0 . end
  let v u64 value_off b 0 .
  if eq v 0 do return 0 . end
  if ne (tag_at b v) 2 do return 0 . end        rem version INTEGER . .
  let a u64 next_off b v .
  if eq a 0 do return 0 . end
  if ne (tag_at b a) 48 do return 0 . end
  return a .
end

rem `privateKey` OCTET STRING 의 **내용** 자리. 0 = 성하지 않다.
export fn p8_inner_off input b slice u8 . output u64 . do
  let a u64 p8_alg_off b .
  if eq a 0 do return 0 . end
  let k u64 next_off b a .
  if eq k 0 do return 0 . end
  if ne (tag_at b k) 4 do return 0 . end        rem OCTET STRING . .
  return value_off b k .
end

rem 그 내용의 길이.
export fn p8_inner_len input b slice u8 . output u64 . do
  let a u64 p8_alg_off b .
  if eq a 0 do return 0 . end
  let k u64 next_off b a .
  if eq k 0 do return 0 . end
  if ne (tag_at b k) 4 do return 0 . end
  return value_len b k .
end

rem ★★★★ **ECPrivateKey 안의 32 바이트 스칼라** 자리. 0 = 성하지 않다.
rem   `off` 는 ECPrivateKey SEQUENCE 가 시작하는 자리다(= `p8_inner_off` 가 낸 값).
export fn ec_priv_off input b slice u8 . input off u64 . output u64 . do
  if ne (tag_at b off) 48 do return 0 . end
  let v u64 value_off b off .
  if eq v 0 do return 0 . end
  if ne (tag_at b v) 2 do return 0 . end        rem version INTEGER (1) . .
  let s u64 next_off b v .
  if eq s 0 do return 0 . end
  if ne (tag_at b s) 4 do return 0 . end        rem OCTET STRING . .
  return value_off b s .
end

rem 그 스칼라의 길이. **P-256 이면 32 여야 한다** — 부르는 쪽이 그것을 확인한다.
rem ☞ 여기서 32 를 강제하지 않는 이유: 이 파서는 곡선을 모른다. 곡선을 아는 쪽이 판단한다.
export fn ec_priv_len input b slice u8 . input off u64 . output u64 . do
  if ne (tag_at b off) 48 do return 0 . end
  let v u64 value_off b off .
  if eq v 0 do return 0 . end
  let s u64 next_off b v .
  if eq s 0 do return 0 . end
  if ne (tag_at b s) 4 do return 0 . end
  return value_len b s .
end
