rem ★★★ **Ed25519 서명 검증** (RFC 8032 §5.1.7) — TLS 1.3 의 `ed25519`.
rem
rem   같은 소수 p = 2^255 − 19 위의 **비틀린 에드워즈** 곡선:
rem     −x² + y² = 1 + d·x²y²,   d = −121665/121666
rem   ⇒ `lib/x25519.low` 의 체 산술(16 조각 × 16 비트)을 **그대로 재사용**한다.
rem   ☞ 새 산술을 또 짓지 않는다 — 같은 소수면 같은 체다.
rem
rem ★★ 확장 좌표 (X:Y:Z:T), xy = T/Z. 에드워즈 덧셈 공식은 **완비(complete)** 다:
rem   예외가 없다. 몽고메리 사다리나 야코비와 달리 *"같은 점이면 다른 식"* 이 없다 —
rem   그래서 P-256 에서 따로 다뤄야 했던 갈래가 여기엔 아예 없다.
rem
rem ★ 검증식: [S]B = R + [k]A,  k = SHA-512(R ‖ A ‖ M) mod L.
rem   ☞ RFC 8032 는 **비-가법적(non-canonical) 인코딩과 작은 위수 점**을 어떻게 다룰지
rem     구현마다 달라도 된다고 둔다. 여기서는 **거절하는 쪽**을 고른다: S < L 을 강제하고
rem     (안 하면 같은 메시지에 서명이 여럿), 압축 해제가 실패하면 거절한다.
rem
rem ☞ 안 지은 것: 서명 생성 · 상수시간(검증은 공개 정보다) · ed25519ph/ctx 변종 · ed448.

module ed25519 .

rem ★★★★ **「자리가 모자라다」와 「답이 아니다」는 다른 사실이다** (X-0035, 소유자 결정 2026-09-20).
rem   그전에는 둘 다 0 이었다 — 재지 못한 것과 재고 나서 «아니다» 하는 것이 **같은 값**이었고,
rem   그래서 작업 공간을 잘못 준 판이 «답이 틀렸다» 로 보였다. 이제 모자람은 값이 아니라 **실패**다.
export def enum ed25519_error do
  short_workspace .
end .


use x25519 from "x25519.low" .
use bigint from "bigint.low" .

rem ── 곡선 상수를 계산으로 낸다(리터럴 표를 안 적는다) ─────────────────────
rem   d = −121665/121666 mod p.  분모의 역원은 페르마로 낸다.
rem   ☞ 32 바이트 상수 두 개를 손으로 옮겨 적는 것은 이 저장소가 이미 세 번 데인 자리다.

rem a^(p−2) mod p — 체 역원(x25519.finv 를 그대로 쓴다).
rem   `c`·`t` 는 x25519 가 요구하는 작업 공간.

rem ★ d 를 만든다: fe 하나에 −121665/121666.
export proc make_d input d mut slice u64 . input w mut slice u64 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len w. . 128 . else return error short_workspace . . .
  rem num ← −121665,  den ← 121666
  guard eq x25519.fzero subslice w. 0 16 . . 1 . else return ok 0 . . .
  set idx w. 0 . 121665 .
  guard eq x25519.fzero subslice w. 16 32 . . 1 . else return ok 0 . . .
  set idx w. 16 . 121666 .
  guard eq x25519.fzero subslice w. 32 48 . . 1 . else return ok 0 . . .
  rem num = 0 − 121665
  guard eq x25519.fsub subslice w. 48 64 . subslice w. 32 48 . subslice w. 0 16 . . 1 . else return ok 0 . . .
  guard eq x25519.finv subslice w. 64 80 . subslice w. 16 32 . subslice w. 80 96 . subslice w. 96 128 . . 1 . else return ok 0 . . .
  return ok x25519.fmul d. subslice w. 48 64 . subslice w. 64 80 . subslice w. 96 128 . . . .
end .

rem ★ 확장 좌표 점 하나 = fe 넷 = 조각 64. (X, Y, Z, T)
rem   완비 덧셈 공식(RFC 8032 §5.1.4). `w` 는 조각 작업 공간(≥ 200).
export proc eadd input o mut slice u64 . input pa slice u64 . input pb slice u64 . input d slice u64 .
     input w mut slice u64 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len w. . 200 . else return error short_workspace . . .
  let T slice u64 subslice w. 160 191 . .
  rem A = (Y1−X1)(Y2−X2) · B = (Y1+X1)(Y2+X2)
  guard eq x25519.fsub subslice w. 0 16 . subslice pa. 16 32 . subslice pa. 0 16 . . 1 . else return ok 0 . . .
  guard eq x25519.fsub subslice w. 16 32 . subslice pb. 16 32 . subslice pb. 0 16 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 32 48 . subslice w. 0 16 . subslice w. 16 32 . subslice w. 160 191 . . 1 . else return ok 0 . . .
  guard eq x25519.fadd subslice w. 0 16 . subslice pa. 16 32 . subslice pa. 0 16 . . 1 . else return ok 0 . . .
  guard eq x25519.fadd subslice w. 16 32 . subslice pb. 16 32 . subslice pb. 0 16 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 48 64 . subslice w. 0 16 . subslice w. 16 32 . subslice w. 160 191 . . 1 . else return ok 0 . . .
  rem C = 2·d·T1·T2 · D = 2·Z1·Z2
  guard eq x25519.fmul subslice w. 64 80 . subslice pa. 48 64 . subslice pb. 48 64 . subslice w. 160 191 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 64 80 . subslice w. 64 80 . d. subslice w. 160 191 . . 1 . else return ok 0 . . .
  guard eq x25519.fadd subslice w. 64 80 . subslice w. 64 80 . subslice w. 64 80 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 80 96 . subslice pa. 32 48 . subslice pb. 32 48 . subslice w. 160 191 . . 1 . else return ok 0 . . .
  guard eq x25519.fadd subslice w. 80 96 . subslice w. 80 96 . subslice w. 80 96 . . 1 . else return ok 0 . . .
  rem E = B−A · F = D−C · G = D+C · H = B+A
  guard eq x25519.fsub subslice w. 96 112 . subslice w. 48 64 . subslice w. 32 48 . . 1 . else return ok 0 . . .
  guard eq x25519.fsub subslice w. 112 128 . subslice w. 80 96 . subslice w. 64 80 . . 1 . else return ok 0 . . .
  guard eq x25519.fadd subslice w. 128 144 . subslice w. 80 96 . subslice w. 64 80 . . 1 . else return ok 0 . . .
  guard eq x25519.fadd subslice w. 144 160 . subslice w. 48 64 . subslice w. 32 48 . . 1 . else return ok 0 . . .
  rem X3 = E·F · Y3 = G·H · Z3 = F·G · T3 = E·H  — **읽기를 다 끝낸 뒤** o 에 쓴다.
  guard eq x25519.fmul subslice w. 0 16 . subslice w. 96 112 . subslice w. 112 128 . subslice w. 160 191 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 16 32 . subslice w. 128 144 . subslice w. 144 160 . subslice w. 160 191 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 32 48 . subslice w. 112 128 . subslice w. 128 144 . subslice w. 160 191 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 48 64 . subslice w. 96 112 . subslice w. 144 160 . subslice w. 160 191 . . 1 . else return ok 0 . . .
  var i u64 0 .
  while lt i. 64 . do  set idx o. i. . idx w. i. . .  set i. add i. 1 . .  end .
  return ok 1 . .
end .

rem ★ 스칼라 곱 acc ← k·P. k 는 32 바이트(리틀엔디언). `w` 는 조각 작업 공간(≥ 400).
export proc esmul input acc mut slice u64 . input k slice u8 . input pt slice u64 . input d slice u64 .
     input w mut slice u64 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len w. . 400 . else return error short_workspace . . .
  rem 항등원 (0, 1, 1, 0)
  guard eq x25519.fzero subslice acc. 0 16 . . 1 . else return ok 0 . . .
  guard eq x25519.fone subslice acc. 16 32 . . 1 . else return ok 0 . . .
  guard eq x25519.fone subslice acc. 32 48 . . 1 . else return ok 0 . . .
  guard eq x25519.fzero subslice acc. 48 64 . . 1 . else return ok 0 . . .
  var bi u64 256 .
  var done u64 0 .
  while eq done. 0 . do
    set bi. sub bi. 1 . .
    let _u12 result u64 ed25519_error eadd subslice w. 0 64 . acc. acc. d. subslice w. 128 328 . . .
    guard is_ok _u12. . else return error short_workspace . . .
    guard eq ok_value _u12. . 1 . else return ok 0 . . .
    var c u64 0 .
    while lt c. 64 . do  set idx acc. c. . idx w. c. . .  set c. add c. 1 . .  end .
    let byte u64 cast u64 idx k. shr bi. 3 . . . .
    if eq bit_and shr byte. bit_and bi. 7 . . 1 . 1 . do
      let _u13 result u64 ed25519_error eadd subslice w. 64 128 . acc. pt. d. subslice w. 128 328 . . .
      guard is_ok _u13. . else return error short_workspace . . .
      guard eq ok_value _u13. . 1 . else return ok 0 . . .
      var c2 u64 0 .
      while lt c2. 64 . do  set idx acc. c2. . idx w. add 64 c2. . . .  set c2. add c2. 1 . .  end .
    end .
    if eq bi. 0 . do  set done. 1 .  end .
  end .
  return ok 1 . .
end .

rem ★★ **점 압축 해제** (RFC 8032 §5.1.3): 32 바이트에서 y 와 x 의 부호 한 비트를 읽고
rem   x = ±√((y²−1)/(d·y²+1)) 을 낸다. p ≡ 5 (mod 8) 이므로
rem     x = u·v³·(u·v⁷)^((p−5)/8),   (p−5)/8 = 2^252 − 3
rem   이고, 그것이 안 맞으면 √(−1) = 2^((p−1)/4) 를 한 번 곱해 다시 본다.
rem   ☞ **두 지수 모두 구성으로 만든다**(`pow2_minus`) — 적을 상수가 없다.
rem   ☞ 여전히 안 맞으면 **곡선 위의 점이 아니다**: 거절한다. 곡선 밖 점을 받아들이면
rem     서명이 뜻을 잃는다.
rem   `w` 는 조각 ≥ 420, `bb` 는 바이트 ≥ 128.
export proc decompress input o mut slice u64 . input enc slice u8 . input d slice u64 .
     input w mut slice u64 . input bb mut slice u8 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len w. . 420 . else return error short_workspace . . .
  guard ge len bb. . 128 . else return ok 0 . . .
  guard ge len enc. . 32 . else return ok 0 . . .

  guard eq x25519.funpack subslice w. 0 16 . enc. . 1 . else return ok 0 . . .
  let sign u64 bit_and shr cast u64 idx enc. 31 . . 7 . 1 . .

  rem u = y² − 1 ,  v = d·y² + 1
  guard eq x25519.fmul subslice w. 16 32 . subslice w. 0 16 . subslice w. 0 16 . subslice w. 384 415 . . 1 . else return ok 0 . . .
  guard eq x25519.fone subslice w. 32 48 . . 1 . else return ok 0 . . .
  guard eq x25519.fsub subslice w. 48 64 . subslice w. 16 32 . subslice w. 32 48 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 64 80 . subslice w. 16 32 . d. subslice w. 384 415 . . 1 . else return ok 0 . . .
  guard eq x25519.fadd subslice w. 64 80 . subslice w. 64 80 . subslice w. 32 48 . . 1 . else return ok 0 . . .

  rem v³ · v⁷ · u·v³ · u·v⁷
  guard eq x25519.fmul subslice w. 80 96 . subslice w. 64 80 . subslice w. 64 80 . subslice w. 384 415 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 96 112 . subslice w. 80 96 . subslice w. 64 80 . subslice w. 384 415 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 112 128 . subslice w. 48 64 . subslice w. 96 112 . subslice w. 384 415 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 128 144 . subslice w. 96 112 . subslice w. 96 112 . subslice w. 384 415 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 128 144 . subslice w. 128 144 . subslice w. 64 80 . subslice w. 384 415 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 144 160 . subslice w. 48 64 . subslice w. 128 144 . subslice w. 384 415 . . 1 . else return ok 0 . . .

  rem (u·v⁷)^((p−5)/8) — 지수는 2^252 − 3
  guard eq pow2_minus subslice bb. 0 32 . 252 3 . 32 . else return ok 0 . . .
  let _u10 result u64 ed25519_error fpow subslice w. 160 176 . subslice w. 144 160 . subslice bb. 0 32 . subslice w. 240 320 . . .
  guard is_ok _u10. . else return error short_workspace . . .
  guard eq ok_value _u10. . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 176 192 . subslice w. 112 128 . subslice w. 160 176 . subslice w. 384 415 . . 1 . else return ok 0 . . .

  rem v·x² == u 인가
  guard eq x25519.fmul subslice w. 192 208 . subslice w. 176 192 . subslice w. 176 192 . subslice w. 384 415 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 192 208 . subslice w. 192 208 . subslice w. 64 80 . subslice w. 384 415 . . 1 . else return ok 0 . . .
  let okx_r result u64 ed25519_error feq subslice w. 192 208 . subslice w. 48 64 . subslice w. 320 384 . subslice bb. 64 128 . . .
  guard is_ok okx_r. . else return error short_workspace . . .
  var okx u64 ok_value okx_r. . .
  if eq okx. 0 . do
    rem √(−1) = 2^((p−1)/4),  (p−1)/4 = 2^253 − 5
    guard eq x25519.fzero subslice w. 224 240 . . 1 . else return ok 0 . . .
    set idx w. 224 . 2 .
    guard eq pow2_minus subslice bb. 32 64 . 253 5 . 32 . else return ok 0 . . .
    let _u11 result u64 ed25519_error fpow subslice w. 208 224 . subslice w. 224 240 . subslice bb. 32 64 . subslice w. 240 320 . . .
    guard is_ok _u11. . else return error short_workspace . . .
    guard eq ok_value _u11. . 1 . else return ok 0 . . .
    guard eq x25519.fmul subslice w. 176 192 . subslice w. 176 192 . subslice w. 208 224 . subslice w. 384 415 . . 1 . else return ok 0 . . .
    guard eq x25519.fmul subslice w. 192 208 . subslice w. 176 192 . subslice w. 176 192 . subslice w. 384 415 . . 1 . else return ok 0 . . .
    guard eq x25519.fmul subslice w. 192 208 . subslice w. 192 208 . subslice w. 64 80 . subslice w. 384 415 . . 1 . else return ok 0 . . .
    let okx_s result u64 ed25519_error feq subslice w. 192 208 . subslice w. 48 64 . subslice w. 320 384 . subslice bb. 64 128 . . .
    guard is_ok okx_s. . else return error short_workspace . . .
    set okx. ok_value okx_s. . .
  end .
  guard eq okx. 1 . else return ok 0 . . .

  rem 부호를 맞춘다: 정규화한 x 의 최하위 비트가 sign 과 달라야 하면 x ← −x
  let b0_r result u64 ed25519_error fbit0 subslice w. 176 192 . subslice w. 320 384 . subslice bb. 64 128 . . .
  guard is_ok b0_r. . else return error short_workspace . . .
  let b0 u64 ok_value b0_r. . .
  if ne b0. sign. . do
    guard eq x25519.fzero subslice w. 224 240 . . 1 . else return ok 0 . . .
    guard eq x25519.fsub subslice w. 176 192 . subslice w. 224 240 . subslice w. 176 192 . . 1 . else return ok 0 . . .
  end .

  rem (X, Y, Z=1, T=X·Y)
  var i u64 0 .
  while lt i. 16 . do
    set idx o. i. . idx w. add 176 i. . . .
    set idx o. add 16 i. . . idx w. i. . .
    set i. add i. 1 . .
  end .
  guard eq x25519.fone subslice o. 32 48 . . 1 . else return ok 0 . . .
  return ok x25519.fmul subslice o. 48 64 . subslice o. 0 16 . subslice o. 16 32 . subslice w. 384 415 . . . .
end .

rem ★★★ **지수를 손으로 적지 않는다.** 처음엔 *"1 이 249 개, 그다음 0, 마지막 1"* 처럼
rem   비트 모양을 산문으로 적었다 — 그것이 바로 이 저장소가 세 번 데인 부류다
rem   (십진 변환 두 번 · NIST 케이스 잘림 한 번). ⇒ 지수를 **바이트로 구성**하고
rem   일반 거듭제곱이 그 비트를 읽는다. 적을 상수가 없으면 잘못 적을 수도 없다.

rem exp ← 2^n − k, 32 바이트 리틀엔디언.
export proc pow2_minus input out mut slice u8 . input n u64 . input k u64 . output u64 . effects none . do
  guard ge len out. . 32 . else return 0 . .
  guard lt n. 256 . else return 0 . .
  guard le k. 255 . else return 0 . .
  var i u64 0 .
  while lt i. 32 . do  set idx out. i. . 0 .  set i. add i. 1 . .  end .
  set idx out. shr n. 3 . . cast u8 shl 1 bit_and n. 7 . . . .
  rem − k : 빌림을 바이트로 흘린다.
  var borrow u64 k. .
  var j u64 0 .
  while lt j. 32 . do
    let cur u64 cast u64 idx out. j. . . .
    if ge cur. borrow. . do
      set idx out. j. . cast u8 sub cur. borrow. . . .
      set borrow. 0 .
      set j. 32 .
    end .
    if lt j. 32 . do
      set idx out. j. . cast u8 sub add cur. 256 . borrow. . . .
      set borrow. 1 .
      set j. add j. 1 . .
    end .
  end .
  return 32 .
end .

rem ★ 일반 체 거듭제곱: o ← a^e (e 는 32 바이트 리틀엔디언). `w` 는 조각 ≥ 80.
export proc fpow input o mut slice u64 . input a slice u64 . input e slice u8 . input w mut slice u64 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len w. . 80 . else return error short_workspace . . .
  guard ge len e. . 32 . else return ok 0 . . .
  guard eq x25519.fone subslice w. 0 16 . . 1 . else return ok 0 . . .
  var bi u64 256 .
  var done u64 0 .
  while eq done. 0 . do
    set bi. sub bi. 1 . .
    rem ★ 자리에서 제곱·곱한다(X-0050) — `fsq`·`fmul` 의 `inplace` 가 선 뒤 곁 자리와 되옮기기가 필요 없다.
    guard eq x25519.fsq subslice w. 0 16 . subslice w. 0 16 . subslice w. 48 79 . . 1 . else return ok 0 . . .
    if eq bit_and shr cast u64 idx e. shr bi. 3 . . . bit_and bi. 7 . . 1 . 1 . do
      guard eq x25519.fmul subslice w. 0 16 . subslice w. 0 16 . a. subslice w. 48 79 . . 1 . else return ok 0 . . .
    end .
    if eq bi. 0 . do  set done. 1 .  end .
  end .
  return ok x25519.fcopy o. subslice w. 0 16 . . . .
end .

rem ★ 두 체 원소가 같은가 — **정규화해서** 본다. 같은 값이 여러 모양을 가질 수 있으므로
rem   `fpack` 으로 32 바이트를 낸 뒤 XOR 누적으로 비교한다(조기 반환 없음).
rem   `w` 는 조각 ≥ 64, `b` 는 바이트 ≥ 64.
export proc feq input a slice u64 . input b slice u64 . input w mut slice u64 . input bb mut slice u8 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len w. . 64 . else return error short_workspace . . .
  guard ge len bb. . 64 . else return ok 0 . . .
  guard eq x25519.fcopy subslice w. 0 16 . a. . 1 . else return ok 0 . . .
  guard eq x25519.fcopy subslice w. 16 32 . b. . 1 . else return ok 0 . . .
  guard eq x25519.fpack subslice bb. 0 32 . subslice w. 0 16 . subslice w. 32 48 . . 32 . else return ok 0 . . .
  guard eq x25519.fpack subslice bb. 32 64 . subslice w. 16 32 . subslice w. 48 64 . . 32 . else return ok 0 . . .
  var diff u64 0 .
  var i u64 0 .
  while lt i. 32 . do
    set diff. bit_or diff. bit_xor cast u64 idx bb. i. . . cast u64 idx bb. add 32 i. . . . . . .
    set i. add i. 1 . .
  end .
  if eq diff. 0 . do  return ok 1 . .  end .
  return ok 0 . .
end .

rem ★ 정규화한 x 의 최하위 비트(부호).
export proc fbit0 input a slice u64 . input w mut slice u64 . input bb mut slice u8 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len w. . 32 . else return error short_workspace . . .
  guard ge len bb. . 32 . else return ok 0 . . .
  guard eq x25519.fcopy subslice w. 0 16 . a. . 1 . else return ok 0 . . .
  guard eq x25519.fpack subslice bb. 0 32 . subslice w. 0 16 . subslice w. 16 32 . . 32 . else return ok 0 . . .
  return ok bit_and cast u64 idx bb. 0 . . 1 . . .
end .

rem ── 위수 L 과 기저점 B ────────────────────────────────────────────────────
rem
rem ★★★ **L 은 옮겨 적을 수밖에 없다 — 그래서 성질로 검사한다.**
rem   L = 2^252 + 27742317777372353535851937790883648493 (RFC 8032 §5.1).
rem   d 나 √(−1) 과 달리 이 수는 계산으로 유도되지 않는다. ⇒ 적되, **[L]B 가 항등원인지**
rem   게이트가 본다. 틀리게 적으면 그 검사가 깨진다: 옮겨 적은 것을 **믿지 않고 재는** 방법이다.
export proc make_l input out mut slice u8 . output u64 . effects none . do
  guard ge len out. . 32 . else return 0 . .
  var i u64 0 .
  while lt i. 32 . do  set idx out. i. . 0 .  set i. add i. 1 . .  end .
  set idx out. 0 . 237 .   set idx out. 1 . 211 .  set idx out. 2 . 245 .  set idx out. 3 . 92 .
  set idx out. 4 . 26 .    set idx out. 5 . 99 .   set idx out. 6 . 18 .   set idx out. 7 . 88 .
  set idx out. 8 . 214 .   set idx out. 9 . 156 .  set idx out. 10 . 247 . set idx out. 11 . 162 .
  set idx out. 12 . 222 .  set idx out. 13 . 249 . set idx out. 14 . 222 . set idx out. 15 . 20 .
  set idx out. 31 . 16 .
  return 32 .
end .

rem ★ 기저점 B: y = 4/5 mod p, x 의 부호 비트 0. **계산으로 낸다**(인코딩을 안 적는다).
rem   `w` 는 조각 ≥ 560, `bb` 는 바이트 ≥ 160.
export proc make_base input o mut slice u64 . input d slice u64 . input w mut slice u64 . input bb mut slice u8 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len w. . 560 . else return error short_workspace . . .
  guard ge len bb. . 160 . else return ok 0 . . .
  guard eq x25519.fzero subslice w. 0 16 . . 1 . else return ok 0 . . .
  set idx w. 0 . 4 .
  guard eq x25519.fzero subslice w. 16 32 . . 1 . else return ok 0 . . .
  set idx w. 16 . 5 .
  guard eq x25519.finv subslice w. 32 48 . subslice w. 16 32 . subslice w. 48 64 . subslice w. 64 95 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 96 112 . subslice w. 0 16 . subslice w. 32 48 . subslice w. 64 95 . . 1 . else return ok 0 . . .
  guard eq x25519.fpack subslice bb. 0 32 . subslice w. 96 112 . subslice w. 112 128 . . 32 . else return ok 0 . . .
  set idx bb. 31 . cast u8 bit_and cast u64 idx bb. 31 . . 127 . . .
  return decompress o. subslice bb. 0 32 . d. subslice w. 128 548 . subslice bb. 32 160 . . .
end .

rem ★ 점을 32 바이트로 압축한다: y 를 싣고 x 의 최하위 비트를 최상위 비트에 얹는다.
rem   `w` 는 조각 ≥ 128, `bb` 는 바이트 ≥ 64.
export proc compress input out mut slice u8 . input pt slice u64 . input w mut slice u64 . input bb mut slice u8 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len out. . 32 . else return ok 0 . . .
  guard ge len w. . 128 . else return error short_workspace . . .
  guard ge len bb. . 64 . else return ok 0 . . .
  guard eq x25519.finv subslice w. 0 16 . subslice pt. 32 48 . subslice w. 16 32 . subslice w. 32 63 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 64 80 . subslice pt. 0 16 . subslice w. 0 16 . subslice w. 32 63 . . 1 . else return ok 0 . . .
  guard eq x25519.fmul subslice w. 80 96 . subslice pt. 16 32 . subslice w. 0 16 . subslice w. 32 63 . . 1 . else return ok 0 . . .
  guard eq x25519.fpack out. subslice w. 80 96 . subslice w. 96 112 . . 32 . else return ok 0 . . .
  let xb_r result u64 ed25519_error fbit0 subslice w. 64 80 . subslice w. 96 128 . bb. . .
  guard is_ok xb_r. . else return error short_workspace . . .
  let xb u64 ok_value xb_r. . .
  set idx out. 31 . cast u8 bit_or bit_and cast u64 idx out. 31 . . 127 . shl xb. 7 . . . .
  return ok 32 . .
end .

rem ★★ 64 바이트를 L 로 줄인다. **바이트를 위에서부터 흘려 넣는다**:
rem   acc ← acc·256 + byte (mod L). 곱하기 256 은 배로 늘리기 여덟 번이다 —
rem   나눗셈도 바렛도 필요 없다. `lw` 는 L 의 조각(16), `w` 는 조각 ≥ 40.
export proc reduce_l input out mut slice u8 . input h slice u8 . input lw slice u64 . input w mut slice u64 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard ge len w. . 40 . else return error short_workspace . . .
  guard ge len h. . 64 . else return ok 0 . . .
  guard eq bigint.zero subslice w. 0 16 . 16 . 1 . else return ok 0 . . .
  var i u64 64 .
  var done u64 0 .
  while eq done. 0 . do
    set i. sub i. 1 . .
    var s u64 0 .
    while lt s. 8 . do
      guard eq bigint.dbl_mod subslice w. 0 16 . lw. 16 . 1 . else return ok 0 . . .
      set s. add s. 1 . .
    end .
    rem + byte (mod L) — 한 조각에 더하고 자리올림을 흘린 뒤 필요하면 L 을 한 번 뺀다.
    guard eq bigint.zero subslice w. 16 32 . 16 . 1 . else return ok 0 . . .
    set idx w. 16 . cast u64 idx h. i. . . .
    guard eq addmod_l subslice w. 0 16 . subslice w. 16 32 . lw. . 1 . else return ok 0 . . .
    if eq i. 0 . do  set done. 1 .  end .
  end .
  return ok bigint.to_bytes_le out. subslice w. 0 16 . . . .
end .

rem a ← (a + b) mod L.
proc addmod_l input a mut slice u64 . input b slice u64 . input lw slice u64 . output u64 . effects none . do
  var carry u64 0 .
  var i u64 0 .
  while lt i. 16 . do
    let s u64 add add idx a. i. . idx b. i. . . carry. . .
    set idx a. i. . bit_and s. 65535 . .
    set carry. shr s. 16 . .
    set i. add i. 1 . .
  end .
  if eq bigint.ge_mod a. lw. 16 . 1 . do
    var borrow u64 0 .
    var j u64 0 .
    while lt j. 16 . do
      let dd u64 wrap_sub wrap_sub idx a. j. . idx lw. j. . . borrow. . .
      set idx a. j. . bit_and dd. 65535 . .
      set borrow. bit_and shr dd. 63 . 1 . .
      set j. add j. 1 . .
    end .
  end .
  return 1 .
end .

rem ★★★ **Ed25519 서명 검증** (RFC 8032 §5.1.7).
rem     sig = R(32) ‖ S(32),  pub = A(32),  k = SHA-512(R ‖ A ‖ M) mod L
rem     참이면 [S]B = R + [k]A.
rem
rem ★★ **거절하는 쪽을 고른다**(RFC 8032 은 구현에 맡긴다):
rem   ① S < L 이 아니면 거절 — 안 하면 **같은 메시지에 서명이 여럿** 생긴다(가변성).
rem   ② R 이나 A 가 곡선 위 점이 아니면 거절.
rem   ☞ "받아 주고 넘어가기" 는 여기서 관대함이 아니라 **약속을 무르게 하는 것**이다.
rem
rem   `msg` 는 전사/메시지. `sc` 는 바이트 작업 공간(≥ 96 + len(msg)),
rem   `bb` 는 바이트 ≥ 320, `w` 는 조각 ≥ 1400.
export proc verify input sig slice u8 . input pub slice u8 . input msg slice u8 .
     input sc mut slice u8 . input bb mut slice u8 . input w mut slice u64 . output result u64 ed25519_error . effects none .
errors short_workspace . do
  guard eq len sig. . 64 . else return ok 0 . . .
  guard eq len pub. . 32 . else return ok 0 . . .
  guard ge len sc. . add 96 len msg. . . . else return ok 0 . . .
  guard ge len bb. . 320 . else return ok 0 . . .
  rem ★★ 자리 배치는 **1004 조각**이다. 처음엔 1400 을 넉넉히 잡았는데 그러면
  rem   `--run` 의 인자 상한(u64 1024)을 넘어 시험이 못 돈다 — 겹칠 수 있는 것을 겹쳐
  rem   하나의 **공용 스크래치**(432..1004)로 모았다. 넉넉함은 공짜가 아니다.
  rem     0..16 S · 16..32 L · 32..48 d · 48..112 B · 112..176 R · 176..240 A
  rem     240..304 [S]B · 304..368 [k]A · 368..432 R+[k]A · 432..1004 공용(572)
  guard ge len w. . 1004 . else return error short_workspace . . .

  rem ① S < L 인가 — 안 보면 **같은 메시지에 서명이 여럿** 생긴다(가변성).
  guard eq make_l subslice bb. 0 32 . . 32 . else return ok 0 . . .
  guard eq bigint.from_bytes_le subslice sig. 32 64 . subslice w. 0 16 . . 16 . else return ok 0 . . .
  guard eq bigint.from_bytes_le subslice bb. 0 32 . subslice w. 16 32 . . 16 . else return ok 0 . . .
  guard eq bigint.ge_mod subslice w. 0 16 . subslice w. 16 32 . 16 . 0 . else return ok 0 . . .

  rem ② 곡선 상수 d 와 기저점 B — 둘 다 **계산으로** 낸다.
  let _u0 result u64 ed25519_error make_d subslice w. 32 48 . subslice w. 432 560 . . .
  guard is_ok _u0. . else return error short_workspace . . .
  guard eq ok_value _u0. . 1 . else return ok 0 . . .
  let _u1 result u64 ed25519_error make_base subslice w. 48 112 . subslice w. 32 48 . subslice w. 432 992 . subslice bb. 32 192 . . .
  guard is_ok _u1. . else return error short_workspace . . .
  guard eq ok_value _u1. . 1 . else return ok 0 . . .

  rem ③ R 과 A 를 푼다 — 곡선 위가 아니면 거절이다.
  let _u2 result u64 ed25519_error decompress subslice w. 112 176 . subslice sig. 0 32 . subslice w. 32 48 . subslice w. 432 852 . subslice bb. 32 160 . . .
  guard is_ok _u2. . else return error short_workspace . . .
  guard eq ok_value _u2. . 1 . else return ok 0 . . .
  let _u3 result u64 ed25519_error decompress subslice w. 176 240 . pub. subslice w. 32 48 . subslice w. 432 852 . subslice bb. 32 160 . . .
  guard is_ok _u3. . else return error short_workspace . . .
  guard eq ok_value _u3. . 1 . else return ok 0 . . .

  rem ④ k = SHA-512(R ‖ A ‖ M) mod L
  var i u64 0 .
  while lt i. 32 . do
    set idx sc. i. . idx sig. i. . .
    set idx sc. add 32 i. . . idx pub. i. . .
    set i. add i. 1 . .
  end .
  var j u64 0 .
  while lt j. len msg. . . do  set idx sc. add 64 j. . . idx msg. j. . .  set j. add j. 1 . .  end .
  guard eq call_builtin sha512 subslice sc. 0 add 64 len msg. . . . subslice bb. 192 256 . . 64 . else return ok 0 . . .
  let _u4 result u64 ed25519_error reduce_l subslice bb. 256 288 . subslice bb. 192 256 . subslice w. 16 32 . subslice w. 432 472 . . .
  guard is_ok _u4. . else return error short_workspace . . .
  guard eq ok_value _u4. . 32 . else return ok 0 . . .

  rem ⑤ [S]B  와  R + [k]A
  let _u5 result u64 ed25519_error esmul subslice w. 240 304 . subslice sig. 32 64 . subslice w. 48 112 . subslice w. 32 48 . subslice w. 432 832 . . .
  guard is_ok _u5. . else return error short_workspace . . .
  guard eq ok_value _u5. . 1 . else return ok 0 . . .
  let _u6 result u64 ed25519_error esmul subslice w. 304 368 . subslice bb. 256 288 . subslice w. 176 240 . subslice w. 32 48 . subslice w. 432 832 . . .
  guard is_ok _u6. . else return error short_workspace . . .
  guard eq ok_value _u6. . 1 . else return ok 0 . . .
  let _u7 result u64 ed25519_error eadd subslice w. 368 432 . subslice w. 112 176 . subslice w. 304 368 . subslice w. 32 48 . subslice w. 432 632 . . .
  guard is_ok _u7. . else return error short_workspace . . .
  guard eq ok_value _u7. . 1 . else return ok 0 . . .

  rem ⑥ 압축해서 바이트로 비교한다 — 사영 좌표는 같은 점이 여러 모양이므로
  rem   **정규화가 곧 비교**다. XOR 누적: 조기 반환이 없다.
  let _u8 result u64 ed25519_error compress subslice bb. 288 320 . subslice w. 240 304 . subslice w. 432 560 . subslice bb. 32 96 . . .
  guard is_ok _u8. . else return error short_workspace . . .
  guard eq ok_value _u8. . 32 . else return ok 0 . . .
  let _u9 result u64 ed25519_error compress subslice bb. 0 32 . subslice w. 368 432 . subslice w. 432 560 . subslice bb. 32 96 . . .
  guard is_ok _u9. . else return error short_workspace . . .
  guard eq ok_value _u9. . 32 . else return ok 0 . . .
  var diff u64 0 .
  var q u64 0 .
  while lt q. 32 . do
    set diff. bit_or diff. bit_xor cast u64 idx bb. add 288 q. . . . cast u64 idx bb. q. . . . . .
    set q. add q. 1 . .
  end .
  guard eq diff. 0 . else return ok 0 . . .
  return ok 1 . .
end .
