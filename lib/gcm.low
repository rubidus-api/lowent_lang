rem ★★★ **AES-128-GCM** (NIST SP 800-38D) — Lowent 로 쓴다.
rem   TLS 1.3 이 MUST 로 요구하는 스위트(TLS_AES_128_GCM_SHA256)가 이것을 쓴다.
rem
rem ★ 오라클: **NIST GCM 시험벡터** · **RFC 8448 §3 의 레코드 암호문**.
rem
rem ★★ GHASH 는 GF(2^128) 곱이다. 축약 다항식은 x^128 + x^7 + x^2 + x + 1 이고,
rem   **비트 순서가 뒤집혀 있다** — 블록의 첫 바이트 최상위 비트가 x^0 이다.
rem   그래서 곱셈이 오른쪽 시프트로 돌고, 넘친 비트는 **앞 바이트에 0xE1 로** 되돌아온다.
rem   ☞ 이 관례를 반대로 읽으면 태그가 통째로 달라진다. 여기 적어 두는 이유다.
rem
rem ☞ 안 지은 것: **상수시간 보장**. 이 저장소의 다른 암호 모듈과 같은 자리다.

module gcm .

rem ★★★★ **「자리가 모자라다」와 「답이 아니다」는 다른 사실이다** (X-0035, 소유자 결정 2026-09-20).
rem   그전에는 둘 다 0 이었다 — 재지 못한 것과 재고 나서 «아니다» 하는 것이 **같은 값**이었고,
rem   그래서 작업 공간을 잘못 준 판이 «답이 틀렸다» 로 보였다. 이제 모자람은 값이 아니라 **실패**다.
export def enum gcm_error do
  short_workspace .
end


rem ☞ **왜 `seal`/`unseal` 이 아니라 `encrypt`/`decrypt` 인가.**
rem   `lib/aead.low`(ChaCha20-Poly1305)가 이미 그 이름을 쓴다. 두 모듈이 같은 이름을 가지면
rem   한정해서 불러도 도구가 **다른 쪽 시그니처로 arity 를 잰다**(7 vs 12 → E-IR-ARITY).
rem   알려진 결함이다 — docs/known-defects/qualifier-erased-flat-lookup.md.
rem   ★ 그리고 이번엔 검사기가 아니라 **arity 정규화**가 물었다: 같은 뿌리, 새 얼굴.

use aes from "aes.low" .

rem 16 바이트를 XOR 로 겹친다.
proc xor16 input z mut slice u8 . input x slice u8 . output u64 . effects none . do
  var i be u64 0 .
  while lt i 16 . do
    set (idx z i) (cast u8 (bit_xor (cast u64 (idx z i)) (cast u64 (idx x i)))) .
    set i (add i 1) .
  end
  return 1 .
end

rem ★★ z = z · h  in GF(2^128).  `v` 는 16 바이트 작업 공간.
export proc gmul128 input z mut slice u8 . input h slice u8 . input v mut slice u8 . output u64 . effects none . do
  guard ge (len z) 16 . else return 0 .
  guard ge (len h) 16 . else return 0 .
  guard ge (len v) 16 . else return 0 .
  rem v ← z, 그리고 z ← 0. (곱해질 쪽을 옮겨 놓고 누산기를 비운다.)
  var i be u64 0 .
  while lt i 16 . do
    set (idx v i) (idx z i) .
    set (idx z i) 0 .
    set i (add i 1) .
  end
  var b be u64 0 .
  while lt b 128 . do
    rem h 의 비트 b — **첫 바이트의 최상위 비트가 b=0** 이다.
    let byte be u64 cast u64 (idx h (shr b 3)) .
    let bit be u64 bit_and (shr byte (sub 7 (bit_and b 7))) 1 .
    if eq bit 1 . do
      let zz be u64 xor16 z v .
    end
    rem v 를 오른쪽으로 한 비트. 밀려난 최하위 비트는 0xE1 로 되돌아온다.
    let lsb be u64 bit_and (cast u64 (idx v 15)) 1 .
    var k be u64 15 .
    var done be u64 0 .
    while eq done 0 . do
      var cur be u64 shr (cast u64 (idx v k)) 1 .
      if gt k 0 . do
        set cur (bit_or cur (shl (bit_and (cast u64 (idx v (sub k 1))) 1) 7)) .
      end
      set (idx v k) (cast u8 cur) .
      if eq k 0 . do  set done 1 .  end
      if eq done 0 . do  set k (sub k 1) .  end
    end
    if eq lsb 1 . do
      set (idx v 0) (cast u8 (bit_xor (cast u64 (idx v 0)) 225)) .
    end
    set b (add b 1) .
  end
  return 1 .
end

rem ★★★★ **한 조각을 GHASH 에 먹인다 — 이제 잎 하나가 판다** (X-0043ⓑ, 2026-09-20).
rem   그전에는 `gmul128` 이 블록마다 128 비트를 하나씩 돌았다. 같은 기계에서 4 MiB 를 재면
rem   GHASH 만 983 ms(4.1 MB/s) 였고, 그래서 AES-GCM 전체가 ChaCha20-Poly1305 의 **123 분의 1**
rem   이었다. `ghash` 는 그 셈을 C 로 한 번 적어 **VM 과 네이티브가 같은 코드를 부른다**.
rem   ☞ `gmul128` 은 지우지 않았다 — 이 모듈이 말하는 **뜻의 정의**로 남고, 골든이 둘을 맞댄다.
proc ghash_feed input z mut slice u8 . input h slice u8 . input data slice u8 . output u64 . effects none . do
  guard ge (len z) 16 . else return 0 .
  guard ge (len h) 16 . else return 0 .
  let g be u64 call_builtin ghash (subslice h 0 16) (subslice z 0 16) data .
  return 1 .
end

rem ★ 길이 블록: [len(A)]64 ‖ [len(C)]64, **비트 수**로, 빅엔디언.
rem   ☞ 바이트가 아니라 **비트**다. 여기서 8 을 빠뜨리는 것이 이 알고리즘의 고전적 오답이다.
proc ghash_lens input z mut slice u8 . input h slice u8 . input alen u64 . input clen u64 . input blk mut slice u8 . output u64 . effects none . do
  guard ge (len blk) 16 . else return 0 .
  let abits be u64 mul alen 8 .
  let cbits be u64 mul clen 8 .
  var i be u64 0 .
  while lt i 8 . do
    set (idx blk i) (cast u8 (bit_and (shr abits (mul (sub 7 i) 8)) 255)) .
    set (idx blk (add 8 i)) (cast u8 (bit_and (shr cbits (mul (sub 7 i) 8)) 255)) .
    set i (add i 1) .
  end
  return ghash_feed z h (subslice blk 0 16) .
end

rem ★ GCTR 한 블록: 카운터 블록을 암호화해 평문과 XOR 한다.
proc gctr_block input rk slice u8 . input ctr mut slice u8 . input ks mut slice u8 . input tmp mut slice u8 . output u64 . effects none . do
  var i be u64 0 .
  while lt i 16 . do  set (idx ks i) (idx ctr i) .  set i (add i 1) .  end
  guard eq (aes.encrypt_block rk ks tmp) 16 . else return 0 .
  rem 카운터의 **뒤 4 바이트**를 1 증가(inc32).
  var k be u64 15 .
  var carry be u64 1 .
  var n be u64 0 .
  while lt n 4 . do
    let s be u64 add (cast u64 (idx ctr k)) carry .
    set (idx ctr k) (cast u8 (bit_and s 255)) .
    set carry (shr s 8) .
    set k (sub k 1) .
    set n (add n 1) .
  end
  return 16 .
end

rem ★★ 봉인: 평문 → 암호문 + 16 바이트 태그. nonce 는 **12 바이트**만 받는다.
rem   ☞ 96비트가 아닌 IV 는 J0 를 GHASH 로 만들어야 한다 — TLS 는 언제나 96비트이므로
rem     **안 지었다**. 다른 길이를 주면 거절한다(조용히 다르게 하지 않는다).
rem   작업 공간: rk 176 · h 16 · z 16 · v 16 · blk 16 · ctr 16 · j0 16 · ks 16 · tmp 16.
rem ★★★ **암호화와 복호는 같은 계산이다 — 다만 순서가 다르다.**
rem   GCM 의 태그는 **암호문**에서 나온다. 암호화는 *흐름 → 태그*(방금 만든 암호문에 매긴다),
rem   복호는 *태그 → 흐름*(받은 암호문을 먼저 증언하고, 맞을 때만 푼다).
rem   ☞ 처음엔 `core` 하나가 흐름을 돌리고 나서 태그를 냈고, 복호는 그 뒤에 비교했다.
rem     그러면 태그가 **틀려도 평문이 이미 `msg` 에 쓰여 있다** — 증언 안 된 평문이 밖에 있는
rem     것이고, 그것을 돌려주는 호출자는 패딩 오라클류의 자리를 판다(2026-09-04 검토 A2).
rem     ⇒ 세 조각(`gcm_prep`·`gcm_tag`·`gcm_stream`)으로 갈라 **순서를 이름으로** 말한다.
rem   ☞ 부수 효과: `ct` 와 `msg` 가 같은 버퍼여도(제자리 복호) 이제 옳다 — GHASH 가 아직
rem     손대지 않은 암호문을 본다.

rem ★ 한 판의 준비: rk(0..176) · H(176..192) · J0(256..272) · ctr(240..256) = J0+1.
proc gcm_prep input key slice u8 . input nonce slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard eq (len nonce) 12 . else return 0 .
  guard eq (len key) 16 . else return 0 .
  guard ge (len w) 320 . else return 0 .
  rem w 의 자리: 0..176 **안 쓴다**(아래 ★) · 176..192 h · 192..208 z · 208..224 v · 224..240 blk
  rem            240..256 ctr · 256..272 j0 · 272..288 AES_K(J0) · 288..304 tmp · 304..320 key

  rem ★★★★★ **한 판을 여는 값이 셈보다 컸다** (RFC-0130, 2026-09-24).
  rem   그전에는 여기서 `aes.expand_key` 로 키 스케줄을 폈다 — 실측 **16,505 사이클**이다.
  rem   16 바이트를 봉인하는 데 드는 17,502 사이클 가운데 **94%** 가 그것이었다. 까닭은
  rem   `lib/aes.low` 의 S-box 가 표가 아니라 **대수적 역원**(`ginv`)이라, 키 스케줄이 쓰는
  rem   S-box 마흔 번이 각각 400 사이클 남짓 걸리기 때문이다.
  rem   ☞ 그래서 4 MiB 한 덩이는 3,650 MB/s 인데 **1 KiB 는 153** 이었다. TLS 레코드가 그 크기다.
  rem
  rem ★★ 고친 방법: **잎 `aes_ctr` 가 이미 제 안에서 키를 편다.** 그리고 CTR 은 평문이 0 이면
  rem   답이 곧 키스트림, 즉 `AES_K(카운터)` 다. 그러므로 확장키도 `encrypt_block` 도 필요 없다 —
  rem   이 판이 쓰는 AES 는 **H 하나와 AES_K(J0) 하나**뿐이고 둘 다 그 꼴이다.
  rem   ⇒ `expand_key` 와 `gctr_block` 이 이 길에서 사라진다. `lib/aes.low` 는 **뜻의 정의로 남는다**.
  rem   ☞ w[0..176] 은 이제 안 쓴다. 일터 크기(320)는 그대로 둔다 — 부르는 쪽의 약속이다.

  rem 원래 키를 일터에 둔다 — 잎은 확장키가 아니라 **16 바이트 키**를 받는다.
  var kk be u64 0 .
  while lt kk 16 . do  set (idx w (add 304 kk)) (idx key kk) .  set kk (add kk 1) .  end

  rem H = AES_K(0^128) — 카운터 0, 평문 0 으로 한 블록.
  var i be u64 0 .
  while lt i 16 . do
    set (idx w (add 176 i)) 0 .
    set (idx w (add 208 i)) 0 .
    set i (add i 1) .
  end
  let h1 be u64 call_builtin aes_ctr (subslice w 304 320) (subslice w 208 224) (subslice w 176 192) (subslice w 176 192) .
  guard eq h1 16 . else return 0 .

  rem J0 = nonce ‖ 0x00000001. 카운터를 J0 으로 놓고 한 블록을 흘리면 **둘이 한 번에** 온다:
  rem   나온 값 = AES_K(J0)(태그가 쓴다) · 카운터 = J0+1(흐름이 쓴다).
  var n be u64 0 .
  while lt n 12 . do
    set (idx w (add 256 n)) (idx nonce n) .
    set n (add n 1) .
  end
  set (idx w 268) 0 .  set (idx w 269) 0 .  set (idx w 270) 0 .  set (idx w 271) 1 .
  var c be u64 0 .
  while lt c 16 . do
    set (idx w (add 240 c)) (idx w (add 256 c)) .
    set (idx w (add 272 c)) 0 .
    set c (add c 1) .
  end
  let j1 be u64 call_builtin aes_ctr (subslice w 304 320) (subslice w 240 256) (subslice w 272 288) (subslice w 272 288) .
  guard eq j1 16 . else return 0 .
  return 16 .
end

rem ★★★★ **흐름 — 이제 잎 하나가 판다** (X-0043ⓑ, 2026-09-20).
rem   그전에는 `gctr_block` 이 블록마다 `aes.encrypt_block` 을 불렀고, 4 MiB 에 7172 ms
rem   (0.6 MB/s) 였다 — AES-GCM 느림의 **88%** 가 여기였다. `aes_ctr` 는 키 확장부터
rem   카운터 증가까지 한 번의 호출 안에서 돈다.
rem   ☞ 카운터는 `w[240..256]` — `gcm_prep` 이 J0+1 로 놓았고, 잎이 **뒤 4 바이트만** 올린다
rem     (inc32). 그래서 여러 번 나눠 불러도 이어진다.
proc gcm_stream input src slice u8 . input dst mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard ge (len dst) (len src) . else return 0 .
  guard ge (len w) 320 . else return 0 .
  let n be u64 call_builtin aes_ctr (subslice w 304 320) (subslice w 240 256) src dst .
  guard eq n (len src) . else return 0 .
  return 16 .
end

rem ★ 태그: T = GHASH(H, A ‖ pad ‖ C ‖ pad ‖ [len(A)]64 ‖ [len(C)]64) XOR AES_K(J0).
rem   `ct` 는 **암호문**이다 — 암호화면 방금 쓴 것, 복호면 받은 것. 평문을 넣으면 틀린다.
proc gcm_tag input aad slice u8 . input ct slice u8 . input tag mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard ge (len tag) 16 . else return 0 .
  var q be u64 0 .
  while lt q 16 . do  set (idx w (add 192 q)) 0 .  set q (add q 1) .  end
  let g1 be u64 ghash_feed (subslice w 192 208) (subslice w 176 192) aad .
  let g2 be u64 ghash_feed (subslice w 192 208) (subslice w 176 192) ct .
  return gcm_tag_finish (len aad) (len ct) tag w .
end

rem ★★★ **태그 마무리** — 길이 블록을 먹이고 `T = S XOR AES_K(J0)` 를 낸다.
rem   누산은 **이미 되어 있다**: 봉인은 낱말이 흐르며 먹였고(RFC-0124), 복호는 `gcm_tag` 가 먹였다.
rem   ☞ 갈라 둔 까닭이 그것이다 — 먹이는 자리는 둘인데 마무리는 하나다.
proc gcm_tag_finish input alen u64 . input clen u64 . input tag mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard ge (len tag) 16 . else return 0 .
  guard ge (len w) 320 . else return 0 .
  let g3 be u64 ghash_lens (subslice w 192 208) (subslice w 176 192) alen clen (subslice w 224 240) .
  rem ★ `AES_K(J0)` 는 `gcm_prep` 이 w[272..288] 에 놓아 두었다(RFC-0130) — 여기서 다시 안 만든다.
  rem   그 사이에 그 자리를 건드리는 것은 없다: 누산은 192·176 을, 길이 블록은 224 를 쓴다.
  var t be u64 0 .
  while lt t 16 . do
    set (idx tag t) (cast u8 (bit_xor (cast u64 (idx w (add 192 t))) (cast u64 (idx w (add 272 t))))) .
    set t (add t 1) .
  end
  return 16 .
end

rem ★★★★★ **봉인의 흐름 — 흐르는 자리와 누산하는 자리를 한 바퀴에** (RFC-0124, 2026-09-24).
rem   그전에는 `gcm_stream`(흐름) 한 바퀴, `gcm_tag`(누산) 또 한 바퀴였다. 둘 다 기계 명령을
rem   쓰는데도 **따로 돌면 처리량이 둘의 조화평균에 묶인다** — 실측 2,848 MB/s 가 그 한계였다.
rem   낱말 `aes_gcm` 은 그 둘을 한 바퀴에 돈다(엮은 판은 방출 C 에만, VM 은 잎 둘을 차례로).
rem
rem ★★ **차례는 여기 남는다.** 낱말이 아는 것은 «한 덩이를 흘리고 그 암호문을 누산한다» 뿐이다:
rem   누산기를 0 으로 놓는 것 · AAD 를 **먼저** 먹이는 것 · 길이 블록을 **마지막에** 먹이는 것은
rem   이 프로시저와 `gcm_tag_finish` 가 한다. 숨은 규율은 검사할 수 없다.
rem
rem ☞ **복호는 이 길로 안 온다.** 받은 암호문을 먼저 증언하고 **맞을 때만** 푸는 차례여야 하므로
rem   (2026-09-04 검토 A2 — 증언 안 된 평문을 내놓지 않는다) 복호는 두 바퀴로 남는다.
rem   규율이 값을 치르는 자리이고, 그 값은 이제 수로 보인다.
proc gcm_seal_stream input aad slice u8 . input src slice u8 . input dst mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard ge (len dst) (len src) . else return 0 .
  guard ge (len w) 320 . else return 0 .
  var q be u64 0 .
  while lt q 16 . do  set (idx w (add 192 q)) 0 .  set q (add q 1) .  end
  let g1 be u64 ghash_feed (subslice w 192 208) (subslice w 176 192) aad .
  let n be u64 call_builtin aes_gcm (subslice w 304 320) (subslice w 240 256)
                       (subslice w 176 192) (subslice w 192 208) src dst .
  guard eq n (len src) . else return 0 .
  return 16 .
end

rem ★ 암호화 — 흐름을 먼저 돌리고, **만든 암호문**에 태그를 매긴다.
export proc encrypt input key slice u8 . input nonce slice u8 . input aad slice u8 . input msg slice u8 .
     input ct mut slice u8 . input tag mut slice u8 . input w mut slice u8 . output result u64 gcm_error . effects none .
errors short_workspace . do
  rem ★ 일터가 모자란 것은 **답이 아니라 실패**다(X-0035). 안쪽 `gcm_prep` 이 320 을 쓴다.
  guard ge (len w) 320 . else return error short_workspace .
  guard ge (len ct) (len msg) . else return ok 0 .
  guard ge (len tag) 16 . else return ok 0 .
  guard eq (gcm_prep key nonce w) 16 . else return ok 0 .
  guard eq (gcm_seal_stream aad msg ct w) 16 . else return ok 0 .
  return ok (gcm_tag_finish (len aad) (len msg) tag w) .
end

rem ★★ 복호 — **받은 암호문**에 태그를 매겨 먼저 대조하고, 맞을 때만 평문을 낸다.
rem   태그가 틀리면 `msg` 에는 **한 바이트도 쓰지 않는다**.
rem   ☞ `tag` 는 **정확히 16** 이어야 한다 — 짧으면 비교가 경계를 넘고(트랩), 길면 앞 16 만
rem     보고 나머지를 말없이 지나친다. 둘 다 *"조용히 다르게"* 다. `hash.sha256_ok` 와 같은
rem     정확 길이 규칙이다(2026-09-04 검토 RU: 복사본들이 갈라져 있었다).
rem   ☞ 비교는 XOR 누적이다 — 조기 반환이 없다.
export proc decrypt input key slice u8 . input nonce slice u8 . input aad slice u8 . input ct slice u8 .
     input tag slice u8 . input msg mut slice u8 . input want mut slice u8 . input w mut slice u8 . output result u64 gcm_error . effects none .
errors short_workspace . do
  guard ge (len w) 320 . else return error short_workspace .
  guard eq (len tag) 16 . else return ok 0 .
  guard ge (len want) 16 . else return ok 0 .
  guard ge (len msg) (len ct) . else return ok 0 .
  guard eq (gcm_prep key nonce w) 16 . else return ok 0 .
  guard eq (gcm_tag aad ct want w) 16 . else return ok 0 .
  var diff be u64 0 .
  var i be u64 0 .
  while lt i 16 . do
    set diff (bit_or diff (bit_xor (cast u64 (idx want i)) (cast u64 (idx tag i)))) .
    set i (add i 1) .
  end
  guard eq diff 0 . else return ok 0 .
  guard eq (gcm_stream ct msg w) 16 . else return ok 0 .
  return ok 1 .
end
