rem ★★★ **AES-128-GCM** (NIST SP 800-38D) — Lowent 로 쓴다.
rem   TLS 1.3 이 MUST 로 요구하는 스위트(TLS_AES_128_GCM_SHA256)가 이것을 쓴다.
rem
rem ★ 오라클: **NIST GCM 시험벡터** · **RFC 8448 §3 의 레코드 암호문**.
rem
rem ★★ GHASH 는 GF(2^128) 곱이다. 축약 다항식은 x^128 + x^7 + x^2 + x + 1 이고,
rem   **비트 순서가 뒤집혀 있다** — 블록의 첫 바이트 최상위 비트가 x^0 이다.
rem   그래서 곱셈이 오른쪽 시프트로 돌고, 넘친 비트는 **앞 바이트에 0xE1 로** 되돌아온다.
rem   ☞ 이 관례를 반대로 읽으면 태그가 통째로 달라진다. 여기 적어 두는 이유다.
rem
rem ☞ 안 지은 것: **상수시간 보장**. 이 저장소의 다른 암호 모듈과 같은 자리다.

module gcm .

rem ☞ **왜 `seal`/`unseal` 이 아니라 `encrypt`/`decrypt` 인가.**
rem   `lib/aead.low`(ChaCha20-Poly1305)가 이미 그 이름을 쓴다. 두 모듈이 같은 이름을 가지면
rem   한정해서 불러도 도구가 **다른 쪽 시그니처로 arity 를 잰다**(7 vs 12 → E-IR-ARITY).
rem   알려진 결함이다 — docs/known-defects/qualifier-erased-flat-lookup.md.
rem   ★ 그리고 이번엔 검사기가 아니라 **arity 정규화**가 물었다: 같은 뿌리, 새 얼굴.

use aes from "aes.low" .

rem 16 바이트를 XOR 로 겹친다.
proc xor16 input z mut slice u8 . input x slice u8 . output u64 . effects none . do
  var i u64 be 0 .
  while lt i 16 . do
    set (index z i) (cast u8 (bit_xor (cast u64 (index z i)) (cast u64 (index x i)))) .
    set i (add i 1) .
  end .
  return 1 .
end .

rem ★★ z = z · h  in GF(2^128).  `v` 는 16 바이트 작업 공간.
export proc gmul128 input z mut slice u8 . input h slice u8 . input v mut slice u8 . output u64 . effects none . do
  guard ge (len z) 16 . else return 0 .
  guard ge (len h) 16 . else return 0 .
  guard ge (len v) 16 . else return 0 .
  rem v ← z, 그리고 z ← 0. (곱해질 쪽을 옮겨 놓고 누산기를 비운다.)
  var i u64 be 0 .
  while lt i 16 . do
    set (index v i) (index z i) .
    set (index z i) 0 .
    set i (add i 1) .
  end .
  var b u64 be 0 .
  while lt b 128 . do
    rem h 의 비트 b — **첫 바이트의 최상위 비트가 b=0** 이다.
    let byte u64 be cast u64 (index h (shr b 3)) .
    let bit u64 be bit_and (shr byte (sub 7 (bit_and b 7))) 1 .
    if eq bit 1 . do
      let zz u64 be xor16 z v .
    end .
    rem v 를 오른쪽으로 한 비트. 밀려난 최하위 비트는 0xE1 로 되돌아온다.
    let lsb u64 be bit_and (cast u64 (index v 15)) 1 .
    var k u64 be 15 .
    var done u64 be 0 .
    while eq done 0 . do
      var cur u64 be shr (cast u64 (index v k)) 1 .
      if gt k 0 . do
        set cur (bit_or cur (shl (bit_and (cast u64 (index v (sub k 1))) 1) 7)) .
      end .
      set (index v k) (cast u8 cur) .
      if eq k 0 . do  set done 1 .  end .
      if eq done 0 . do  set k (sub k 1) .  end .
    end .
    if eq lsb 1 . do
      set (index v 0) (cast u8 (bit_xor (cast u64 (index v 0)) 225)) .
    end .
    set b (add b 1) .
  end .
  return 1 .
end .

rem ★ 한 조각을 16 바이트 블록으로 잘라 GHASH 에 먹인다. 꼬리는 0 으로 채운다.
proc ghash_feed input z mut slice u8 . input h slice u8 . input data slice u8 . input v mut slice u8 . input blk mut slice u8 . output u64 . effects none . do
  var off u64 be 0 .
  while lt off (len data) . do
    var i u64 be 0 .
    while lt i 16 . do  set (index blk i) 0 .  set i (add i 1) .  end .
    var j u64 be 0 .
    while lt j 16 . do
      if lt (add off j) (len data) . do
        set (index blk j) (index data (add off j)) .
      end .
      set j (add j 1) .
    end .
    let z1 u64 be xor16 z blk .
    let z2 u64 be gmul128 z h v .
    set off (add off 16) .
  end .
  return 1 .
end .

rem ★ 길이 블록: [len(A)]64 ‖ [len(C)]64, **비트 수**로, 빅엔디언.
rem   ☞ 바이트가 아니라 **비트**다. 여기서 8 을 빠뜨리는 것이 이 알고리즘의 고전적 오답이다.
proc ghash_lens input z mut slice u8 . input h slice u8 . input alen u64 . input clen u64 . input v mut slice u8 . input blk mut slice u8 . output u64 . effects none . do
  let abits u64 be mul alen 8 .
  let cbits u64 be mul clen 8 .
  var i u64 be 0 .
  while lt i 8 . do
    set (index blk i) (cast u8 (bit_and (shr abits (mul (sub 7 i) 8)) 255)) .
    set (index blk (add 8 i)) (cast u8 (bit_and (shr cbits (mul (sub 7 i) 8)) 255)) .
    set i (add i 1) .
  end .
  let z1 u64 be xor16 z blk .
  return gmul128 z h v .
end .

rem ★ GCTR 한 블록: 카운터 블록을 암호화해 평문과 XOR 한다.
proc gctr_block input rk slice u8 . input ctr mut slice u8 . input ks mut slice u8 . input tmp mut slice u8 . output u64 . effects none . do
  var i u64 be 0 .
  while lt i 16 . do  set (index ks i) (index ctr i) .  set i (add i 1) .  end .
  guard eq (aes.encrypt_block rk ks tmp) 16 . else return 0 .
  rem 카운터의 **뒤 4 바이트**를 1 증가(inc32).
  var k u64 be 15 .
  var carry u64 be 1 .
  var n u64 be 0 .
  while lt n 4 . do
    let s u64 be add (cast u64 (index ctr k)) carry .
    set (index ctr k) (cast u8 (bit_and s 255)) .
    set carry (shr s 8) .
    set k (sub k 1) .
    set n (add n 1) .
  end .
  return 16 .
end .

rem ★★ 봉인: 평문 → 암호문 + 16 바이트 태그. nonce 는 **12 바이트**만 받는다.
rem   ☞ 96비트가 아닌 IV 는 J0 를 GHASH 로 만들어야 한다 — TLS 는 언제나 96비트이므로
rem     **안 지었다**. 다른 길이를 주면 거절한다(조용히 다르게 하지 않는다).
rem   작업 공간: rk 176 · h 16 · z 16 · v 16 · blk 16 · ctr 16 · j0 16 · ks 16 · tmp 16.
rem ★★★ **암호화와 복호는 같은 계산이다 — 다만 순서가 다르다.**
rem   GCM 의 태그는 **암호문**에서 나온다. 암호화는 *흐름 → 태그*(방금 만든 암호문에 매긴다),
rem   복호는 *태그 → 흐름*(받은 암호문을 먼저 증언하고, 맞을 때만 푼다).
rem   ☞ 처음엔 `core` 하나가 흐름을 돌리고 나서 태그를 냈고, 복호는 그 뒤에 비교했다.
rem     그러면 태그가 **틀려도 평문이 이미 `msg` 에 쓰여 있다** — 증언 안 된 평문이 밖에 있는
rem     것이고, 그것을 돌려주는 호출자는 패딩 오라클류의 자리를 판다(2026-09-04 검토 A2).
rem     ⇒ 세 조각(`gcm_prep`·`gcm_tag`·`gcm_stream`)으로 갈라 **순서를 이름으로** 말한다.
rem   ☞ 부수 효과: `ct` 와 `msg` 가 같은 버퍼여도(제자리 복호) 이제 옳다 — GHASH 가 아직
rem     손대지 않은 암호문을 본다.

rem ★ 한 판의 준비: rk(0..176) · H(176..192) · J0(256..272) · ctr(240..256) = J0+1.
proc gcm_prep input key slice u8 . input nonce slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard eq (len nonce) 12 . else return 0 .
  guard ge (len w) 320 . else return 0 .
  rem w 의 자리: 0..176 rk · 176..192 h · 192..208 z · 208..224 v · 224..240 blk
  rem            240..256 ctr · 256..272 j0 · 272..288 ks · 288..304 tmp
  guard eq (aes.expand_key key (subslice w 0 176)) 176 . else return 0 .

  rem H = AES_K(0^128)
  var i u64 be 0 .
  while lt i 16 . do  set (index w (add 176 i)) 0 .  set i (add i 1) .  end .
  guard eq (aes.encrypt_block (subslice w 0 176) (subslice w 176 192) (subslice w 288 304)) 16 . else return 0 .

  rem J0 = nonce ‖ 0x00000001,  카운터는 J0+1 부터
  var n u64 be 0 .
  while lt n 12 . do
    set (index w (add 256 n)) (index nonce n) .
    set n (add n 1) .
  end .
  set (index w 268) 0 .  set (index w 269) 0 .  set (index w 270) 0 .  set (index w 271) 1 .
  var c u64 be 0 .
  while lt c 16 . do  set (index w (add 240 c)) (index w (add 256 c)) .  set c (add c 1) .  end .
  let bump u64 be gctr_block (subslice w 0 176) (subslice w 240 256) (subslice w 272 288) (subslice w 288 304) .
  guard eq bump 16 . else return 0 .
  return 16 .
end .

rem ★ 흐름: dst = src XOR 키스트림(카운터 J0+1 부터). 암호화도 복호도 이것이다.
proc gcm_stream input src slice u8 . input dst mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard ge (len dst) (len src) . else return 0 .
  var off u64 be 0 .
  while lt off (len src) . do
    guard eq (gctr_block (subslice w 0 176) (subslice w 240 256) (subslice w 272 288) (subslice w 288 304)) 16 . else return 0 .
    var k u64 be 0 .
    while lt k 16 . do
      if lt (add off k) (len src) . do
        set (index dst (add off k)) (cast u8 (bit_xor (cast u64 (index src (add off k))) (cast u64 (index w (add 272 k))))) .
      end .
      set k (add k 1) .
    end .
    set off (add off 16) .
  end .
  return 16 .
end .

rem ★ 태그: T = GHASH(H, A ‖ pad ‖ C ‖ pad ‖ [len(A)]64 ‖ [len(C)]64) XOR AES_K(J0).
rem   `ct` 는 **암호문**이다 — 암호화면 방금 쓴 것, 복호면 받은 것. 평문을 넣으면 틀린다.
proc gcm_tag input aad slice u8 . input ct slice u8 . input tag mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard ge (len tag) 16 . else return 0 .
  var q u64 be 0 .
  while lt q 16 . do  set (index w (add 192 q)) 0 .  set q (add q 1) .  end .
  let g1 u64 be ghash_feed (subslice w 192 208) (subslice w 176 192) aad (subslice w 208 224) (subslice w 224 240) .
  let g2 u64 be ghash_feed (subslice w 192 208) (subslice w 176 192) ct (subslice w 208 224) (subslice w 224 240) .
  let g3 u64 be ghash_lens (subslice w 192 208) (subslice w 176 192) (len aad) (len ct) (subslice w 208 224) (subslice w 224 240) .

  rem T = S XOR AES_K(J0)
  var m u64 be 0 .
  while lt m 16 . do  set (index w (add 272 m)) (index w (add 256 m)) .  set m (add m 1) .  end .
  guard eq (aes.encrypt_block (subslice w 0 176) (subslice w 272 288) (subslice w 288 304)) 16 . else return 0 .
  var t u64 be 0 .
  while lt t 16 . do
    set (index tag t) (cast u8 (bit_xor (cast u64 (index w (add 192 t))) (cast u64 (index w (add 272 t))))) .
    set t (add t 1) .
  end .
  return 16 .
end .

rem ★ 암호화 — 흐름을 먼저 돌리고, **만든 암호문**에 태그를 매긴다.
export proc encrypt input key slice u8 . input nonce slice u8 . input aad slice u8 . input msg slice u8 .
     input ct mut slice u8 . input tag mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard ge (len ct) (len msg) . else return 0 .
  guard ge (len tag) 16 . else return 0 .
  guard eq (gcm_prep key nonce w) 16 . else return 0 .
  guard eq (gcm_stream msg ct w) 16 . else return 0 .
  return gcm_tag aad (subslice ct 0 (len msg)) tag w .
end .

rem ★★ 복호 — **받은 암호문**에 태그를 매겨 먼저 대조하고, 맞을 때만 평문을 낸다.
rem   태그가 틀리면 `msg` 에는 **한 바이트도 쓰지 않는다**.
rem   ☞ `tag` 는 **정확히 16** 이어야 한다 — 짧으면 비교가 경계를 넘고(트랩), 길면 앞 16 만
rem     보고 나머지를 말없이 지나친다. 둘 다 *"조용히 다르게"* 다. `hash.digest_ok` 와 같은
rem     정확 길이 규칙이다(2026-09-04 검토 RU: 복사본들이 갈라져 있었다).
rem   ☞ 비교는 XOR 누적이다 — 조기 반환이 없다.
export proc decrypt input key slice u8 . input nonce slice u8 . input aad slice u8 . input ct slice u8 .
     input tag slice u8 . input msg mut slice u8 . input want mut slice u8 . input w mut slice u8 . output u64 . effects none . do
  guard eq (len tag) 16 . else return 0 .
  guard ge (len want) 16 . else return 0 .
  guard ge (len msg) (len ct) . else return 0 .
  guard eq (gcm_prep key nonce w) 16 . else return 0 .
  guard eq (gcm_tag aad ct want w) 16 . else return 0 .
  var diff u64 be 0 .
  var i u64 be 0 .
  while lt i 16 . do
    set diff (bit_or diff (bit_xor (cast u64 (index want i)) (cast u64 (index tag i)))) .
    set i (add i 1) .
  end .
  guard eq diff 0 . else return 0 .
  guard eq (gcm_stream ct msg w) 16 . else return 0 .
  return 1 .
end .
