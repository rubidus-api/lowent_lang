rem ★★★ **HTTP/1.1 요청 파서** (RFC 9112) — RFC-0090 §N6 의 첫 칸.
rem
rem   §N6 이 적어 둔 순서를 지킨다: **파서를 먼저, 전송을 나중에.** 파싱은 순수하다
rem   (바이트열 → 자리와 길이) ⇒ 오라클 안이고, 전송만 권한을 쓴다.
rem
rem ★ **자리를 낸다. 잘라 주지 않는다.** `der.low` 와 같은 모양이다: 어디서 시작해 몇
rem   바이트인지 답하고, 자르는 것은 부르는 쪽이 `subslice` 로 한다. 그래야 이 모듈이
rem   버퍼를 몰래 잡지 않는다(RFC-0043 D1).
rem   ☞ **모든 실패는 `0` 이다** — 예외가 아니라 값이다. 0 은 정당한 자리가 될 수 없다
rem     (요청은 최소 `GET / HTTP/1.1\r\n\r\n` 이라 어떤 필드도 0 에서 시작하지 않는다).
rem
rem ★★ **길이도 이름도 상대가 쓴 것이다.** 이 파서가 지키는 것 다섯:
rem   ① 어떤 자리도 **버퍼를 넘으면 즉시 실패**한다.
rem   ② **줄 끝은 CRLF 뿐이다** — 맨 LF 를 줄 끝으로 받지 않는다.
rem   ③ 헤더 이름과 콜론 사이에 **공백을 허용하지 않는다**.
rem   ④ `Content-Length` 가 **둘 이상이면 거절**한다(값이 같아도 거절한다).
rem   ⑤ 재귀를 안 한다 — 걷기는 부르는 쪽이 정하는 반복이다.
rem   ☞ ②③④ 는 취향이 아니다. 이 셋이 **요청 밀반입(request smuggling)** 이 사는 자리다:
rem     앞단과 뒷단이 같은 바이트를 다르게 읽으면 하나가 본 요청을 다른 하나가 못 본다.
rem     *"보통은 괜찮다"* 가 파서에서 실패의 이름이다.
rem
rem ★★★ **`Transfer-Encoding` 은 여기서 정하지 않는다.** 찾아 주기만 하고(`header_find`),
rem   받을지 거절할지는 **부르는 쪽**의 정책이다 — 다만 지금 이 모듈은 청크 해체를 **안 짓는다**
rem   ⇒ 그 헤더가 있으면 서버는 거절해야 한다. 그렇게 적어 두는 것이 이 문단의 일이다.
rem
rem ★★★★★ **`str` 이라고 썼다가 통째로 태그 경로로 떨어졌다**(2026-08-21).
rem   `str` 은 빌트인이 아니다 — `lib/str.low` 이 **자기 안에서** `type str slice u8 . .` 로
rem   선언하는 지역 별칭이고, 저장소의 관용은 `slice u8` 이다. 그런데 검사기는 `str` 을
rem   **이름만 받는 목록**에 두어 통과시키고, 하강은 그 이름의 뜻을 모른다
rem   ⇒ `--check` 는 초록인데 21 중 **16 개 op 이 해석기로 떨어졌다**(~80배).
rem   ☞ **조용한 80 배**였다. `--why-slow` 가 없었으면 이 파일은 그대로 실렸을 것이다.
rem
rem ☞ 안 지은 것: 청크 전송 · 트레일러 · 여러 줄 헤더(obs-fold, 규격이 폐기했다) ·
rem   URL 퍼센트 해체 · 응답 파싱(클라이언트 쪽) · HTTP/2 이상.

module http .

rem ── 메서드 ────────────────────────────────────────────────────────────────
rem ★ 코드로 낸다(0 = 모르는 메서드). enum 이 아닌 이유: 이 값이 곧 호출자의 표 색인이
rem   되기도 하고, **모름**을 0 으로 두면 `guard` 한 줄로 걸린다.
export fn method_get     output u64 . do  return 1 . end
export fn method_head    output u64 . do  return 2 . end
export fn method_post    output u64 . do  return 3 . end
export fn method_put     output u64 . do  return 4 . end
export fn method_delete  output u64 . do  return 5 . end

rem 요청 줄의 메서드. 첫 SP 까지를 본다. 0 = 모름(또는 SP 가 없다).
export fn method_code input b slice u8 . . output u64 . do
  var i be u64 0 .
  var n be u64 len b .
  if gt n 8 . do set n 8 . end
  while lt i n . do
    if eq (index b i) 32 . do
      if eq i 3 . do
        if eq (index b 0) 71 . do
          if eq (index b 1) 69 . do if eq (index b 2) 84 . do return 1 . end end
        end
        if eq (index b 0) 80 . do
          if eq (index b 1) 85 . do if eq (index b 2) 84 . do return 4 . end end
        end
      end
      if eq i 4 . do
        if eq (index b 0) 72 . do
          if eq (index b 1) 69 . do
            if eq (index b 2) 65 . do if eq (index b 3) 68 . do return 2 . end end
          end
        end
        if eq (index b 0) 80 . do
          if eq (index b 1) 79 . do
            if eq (index b 2) 83 . do if eq (index b 3) 84 . do return 3 . end end
          end
        end
      end
      if eq i 6 . do
        if eq (index b 0) 68 . do
          if eq (index b 1) 69 . do
            if eq (index b 2) 76 . do
              if eq (index b 3) 69 . do
                if eq (index b 4) 84 . do if eq (index b 5) 69 . do return 5 . end end
              end
            end
          end
        end
      end
      return 0 .
    end
    set i (add i 1) .
  end
  return 0 .
end

rem ── 줄 걷기 ───────────────────────────────────────────────────────────────
rem ★★ **CRLF 만 줄 끝이다.** `off` 에서 시작하는 줄의 **다음 줄 자리**를 낸다(0 = 없다).
rem   맨 CR 이나 맨 LF 는 줄 끝이 아니다 — 그것을 줄 끝으로 받으면 앞단과 다르게 읽는다.
export fn line_next input b slice u8 . . input off u64 . output u64 . do
  if ge off (len b) . do return 0 . end
  var i be u64 off .
  while lt (add i 1) (len b) . do
    if eq (index b i) 13 . do
      if eq (index b (add i 1)) 10 . do return add i 2 . end
      return 0 .                    rem CR 뒤가 LF 가 아니면 줄이 아니다
    end
    if eq (index b i) 10 . do return 0 . end     rem 맨 LF 는 줄 끝이 아니다 . .
    set i (add i 1) .
  end
  return 0 .
end

rem 그 줄의 **내용** 길이(CRLF 제외). `line_next` 가 0 이면 0 이다.
export fn line_len input b slice u8 . . input off u64 . output u64 . do
  let nxt be u64 line_next b off .
  if eq nxt 0 . do return 0 . end
  return sub (sub nxt off) 2 .
end

rem ── 요청 줄 ───────────────────────────────────────────────────────────────
rem 대상(target)이 시작하는 자리. 0 = 요청 줄이 성하지 않다.
export fn target_off input b slice u8 . . output u64 . do
  if eq (line_next b 0) 0 . do return 0 . end
  var i be u64 0 .
  let end0 be u64 line_len b 0 .
  while lt i end0 . do
    if eq (index b i) 32 . do
      if eq (add i 1) end0 . do return 0 . end      rem 메서드 뒤가 비었다 . .
      return add i 1 .
    end
    set i (add i 1) .
  end
  return 0 .
end

rem 대상의 길이. 0 = 없다.
export fn target_len input b slice u8 . . output u64 . do
  let t be u64 target_off b .
  if eq t 0 . do return 0 . end
  let end0 be u64 line_len b 0 .
  var i be u64 t .
  while lt i end0 . do
    if eq (index b i) 32 . do
      if eq i t . do return 0 . end                 rem 빈 대상 . .
      return sub i t .
    end
    set i (add i 1) .
  end
  return 0 .                                        rem 버전 앞의 SP 가 없다
end

rem ★ 버전은 **`HTTP/1.1` 뿐**이다. 1.0 은 지속 연결 규칙이 다르고, 그것을 안 지었으므로
rem   받는 척하지 않는다. 0.9 는 요청 줄 모양 자체가 다르다.
export fn version_ok input b slice u8 . . output bool . do
  let t be u64 target_off b .
  let tl be u64 target_len b .
  if eq tl 0 . do return false . end
  let v be u64 add (add t tl) 1 .
  let end0 be u64 line_len b 0 .
  if ne (sub end0 v) 8 . do return false . end
  if ne (index b v) 72 . do return false . end
  if ne (index b (add v 1)) 84 . do return false . end
  if ne (index b (add v 2)) 84 . do return false . end
  if ne (index b (add v 3)) 80 . do return false . end
  if ne (index b (add v 4)) 47 . do return false . end
  if ne (index b (add v 5)) 49 . do return false . end
  if ne (index b (add v 6)) 46 . do return false . end
  if ne (index b (add v 7)) 49 . do return false . end
  return true .
end

rem ── 헤더 ──────────────────────────────────────────────────────────────────
rem 첫 헤더가 시작하는 자리. 0 = 요청 줄이 성하지 않다.
export fn headers_off input b slice u8 . . output u64 . do
  if eq (version_ok b) false . do return 0 . end
  return line_next b 0 .
end

rem ★ 다음 헤더 자리. **빈 줄(헤더 끝)이면 0** 을 낸다 — 끝과 실패를 같은 값으로 두는 것은
rem   이 파서의 규약이다(둘 다 *"더 걸을 수 없다"* 이고, 몸통 자리는 `body_off` 가 따로 답한다).
export fn header_next input b slice u8 . . input off u64 . output u64 . do
  if eq (line_len b off) 0 . do return 0 . end
  return line_next b off .
end

rem 헤더 이름의 길이(콜론 앞까지). 0 = 성하지 않다.
rem ★★ 이름과 콜론 사이의 **공백을 허용하지 않는다**(RFC 9112 §5.1) — 밀반입 자리다.
export fn name_len input b slice u8 . . input off u64 . output u64 . do
  let ll be u64 line_len b off .
  if eq ll 0 . do return 0 . end
  var i be u64 0 .
  while lt i ll . do
    let c be u8 index b (add off i) .
    if eq c 58 . do
      if eq i 0 . do return 0 . end                 rem 이름이 비었다 . .
      return i .
    end
    if eq c 32 . do return 0 . end                  rem 이름 안/뒤의 공백 — 거절 . .
    if eq c 9 . do return 0 . end
    set i (add i 1) .
  end
  return 0 .                                        rem 콜론이 없다
end

rem 값이 시작하는 자리(앞 공백을 건너뛴다). 0 = 성하지 않다.
export fn value_off input b slice u8 . . input off u64 . output u64 . do
  let nl be u64 name_len b off .
  if eq nl 0 . do return 0 . end
  let ll be u64 line_len b off .
  var i be u64 add nl 1 .
  while lt i ll . do
    let c be u8 index b (add off i) .
    if ne c 32 . do
      if ne c 9 . do return add off i . end
    end
    set i (add i 1) .
  end
  return add off ll .                               rem 값이 비었다 — 길이 0 으로 답한다
end

rem 값의 길이(뒤 공백을 뺀다).
export fn value_len input b slice u8 . . input off u64 . output u64 . do
  let v be u64 value_off b off .
  if eq v 0 . do return 0 . end
  let ll be u64 line_len b off .
  var e be u64 add off ll .
  while gt e v . do
    let c be u8 index b (sub e 1) .
    if ne c 32 . do
      if ne c 9 . do return sub e v . end
    end
    set e (sub e 1) .
  end
  return 0 .
end

rem ── 몸통 ──────────────────────────────────────────────────────────────────
rem 몸통이 시작하는 자리. 0 = 헤더가 안 끝났다(빈 줄을 못 찾았다).
export fn body_off input b slice u8 . . output u64 . do
  var off be u64 headers_off b .
  if eq off 0 . do return 0 . end
  var guard_n be u64 0 .
  while lt guard_n (len b) . do
    let ll be u64 line_len b off .
    if eq ll 0 . do
      let nxt be u64 line_next b off .
      if eq nxt 0 . do return 0 . end
      return nxt .
    end
    if eq (name_len b off) 0 . do return 0 . end    rem 성하지 않은 헤더 . .
    let nxt be u64 line_next b off .
    if eq nxt 0 . do return 0 . end
    set off nxt .
    set guard_n (add guard_n 1) .
  end
  return 0 .
end

rem ── 찾기 ──────────────────────────────────────────────────────────────────
rem ★ 헤더 이름은 **대소문자를 안 가린다**(RFC 9110 §5.1). 값은 가린다.
export fn name_eq input b slice u8 . . input off u64 . input want slice u8 . . output bool . do
  let nl be u64 name_len b off .
  if eq nl 0 . do return false . end
  if ne nl (len want) . do return false . end
  var i be u64 0 .
  while lt i nl . do
    var a be u64 cast u64 (index b (add off i)) .
    var w be u64 cast u64 (index want i) .
    if ge a 65 . do if le a 90 . do set a (add a 32) . end end
    if ge w 65 . do if le w 90 . do set w (add w 32) . end end
    if ne a w . do return false . end
    set i (add i 1) .
  end
  return true .
end

rem 그 이름의 **값 자리**를 낸다(0 = 없다). 같은 이름이 **둘 이상이면 0** 이다.
rem ☞ 여기서 거절하는 것이 규격보다 엄하다는 것을 안다. 목록 헤더(예: `Accept`)는 합칠 수
rem   있지만, **합쳐도 되는지는 헤더마다 다르고** 그 표를 안 지었다. 표 없이 합치면
rem   `Content-Length` 를 합치는 코드가 된다 — 그래서 **모르면 거절한다.**
export fn header_find input b slice u8 . . input want slice u8 . . output u64 . do
  var off be u64 headers_off b .
  if eq off 0 . do return 0 . end
  var found be u64 0 .
  var cnt be u64 0 .
  var steps be u64 0 .
  while lt steps (len b) . do
    rem ★★★ **`line_len` 의 0 은 두 가지다** — 「빈 줄(헤더 끝)」과 「성하지 않은 줄」(2026-09-04
    rem   보안 검토). 그 둘을 같이 읽으면 **안 끝난 헤더 블록**이나 **맨 LF 가 낀 블록**에서도
    rem   자리를 내주게 되고, 그것은 `body_off` 가 거절한 바이트에서 값을 꺼내는 일이다 —
    rem   앞단과 뒷단이 같은 바이트를 다르게 읽는 자리, 곧 요청 밀반입(smuggling)의 자리다.
    rem   ☞ 가르는 잣대는 `body_off` 가 이미 쓰던 것 그대로다: 빈 줄이면 `line_next` 가 있다.
    if eq (line_len b off) 0 . do
      if eq (line_next b off) 0 . do return 0 . end   rem 안 끝났거나 성하지 않다 . .
      if eq cnt 1 . do return found . end
      return 0 .
    end
    if eq (name_len b off) 0 . do return 0 . end       rem 성하지 않은 헤더 줄 — **건너뛰지 않는다** . .
    if name_eq b off want . do
      set cnt (add cnt 1) .
      if gt cnt 1 . do return 0 . end              rem 중복 — 거절한다 . .
      set found (value_off b off) .
    end
    let nxt be u64 line_next b off .
    if eq nxt 0 . do return 0 . end
    set off nxt .
    set steps (add steps 1) .
  end
  return 0 .
end

rem 그 이름의 값 **길이**. `header_find` 와 짝이다.
export fn header_find_len input b slice u8 . . input want slice u8 . . output u64 . do
  var off be u64 headers_off b .
  if eq off 0 . do return 0 . end
  var flen be u64 0 .
  var cnt be u64 0 .
  var steps be u64 0 .
  while lt steps (len b) . do
    rem ★ `header_find` 와 **같은 잣대**로 걷는다(2026-09-04). 짝인 두 op 이 같은 바이트를 다르게
    rem   읽으면, 자리는 없다면서 길이는 있다고 답하는 일이 생긴다 — 중복 헤더에서 실제로 그랬다.
    if eq (line_len b off) 0 . do
      if eq (line_next b off) 0 . do return 0 . end
      if eq cnt 1 . do return flen . end
      return 0 .
    end
    if eq (name_len b off) 0 . do return 0 . end
    if name_eq b off want . do
      set cnt (add cnt 1) .
      if gt cnt 1 . do return 0 . end              rem 중복 — `header_find` 와 같이 거절한다 . .
      set flen (value_len b off) .
    end
    let nxt be u64 line_next b off .
    if eq nxt 0 . do return 0 . end
    set off nxt .
    set steps (add steps 1) .
  end
  return 0 .
end

rem ★★★ **`Content-Length`** — 없으면 `some 0`, 성하지 않으면 `none`.
rem   ☞ *"없다"* 와 *"틀렸다"* 를 가른다: 없는 것은 몸통이 없는 것(정상)이고, 틀린 것은
rem     **연결을 끊어야 할 일**이다. 한 값으로 두면 그 둘이 섞인다.
rem   ☞ 숫자만 받는다. 앞의 `+`·공백·여러 값(`5, 5`)을 전부 거절한다 — 그 관용이 밀반입이다.
export proc content_length input b slice u8 . . output option u64 . effects none . do
  let hoff be u64 headers_off b .
  if eq hoff 0 . do return none . end
  var off be u64 hoff .
  var seen be u64 0 .
  var val be u64 0 .
  var steps be u64 0 .
  while lt steps (len b) . do
    rem ★ 헤더 끝인지 **성하지 않은 줄**인지 가른다 — 안 끝난 블록에서 길이를 답하면
    rem   몸통 경계를 앞단과 다르게 잡는다(밀반입). `body_off` 와 같은 잣대다(2026-09-04).
    if eq (line_len b off) 0 . do
      if eq (line_next b off) 0 . do return none . end
      if gt seen 1 . do return none . end
      return (some val) .
    end
    if eq (name_len b off) 0 . do return none . end   rem 성하지 않은 헤더 줄 — 건너뛰지 않는다 . .
    if name_eq b off "content-length" . do
      set seen (add seen 1) .
      if gt seen 1 . do return none . end
      let v be u64 value_off b off .
      let vl be u64 value_len b off .
      if eq vl 0 . do return none . end
      if gt vl 19 . do return none . end            rem u64 를 넘길 자릿수는 안 받는다 . .
      var acc be u64 0 .
      var i be u64 0 .
      while lt i vl . do
        let c be u64 cast u64 (index b (add v i)) .
        if lt c 48 . do return none . end
        if gt c 57 . do return none . end
        set acc (add (mul acc 10) (sub c 48)) .
        set i (add i 1) .
      end
      set val acc .
    end
    let nxt be u64 line_next b off .
    if eq nxt 0 . do return none . end
    set off nxt .
    set steps (add steps 1) .
  end
  return none .
end
