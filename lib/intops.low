end .

export fn mul_wide_u16 input a u16 . input b u16 . output wide_u16 .
do
  let p u32 mul widen u32 a. . widen u32 b. . . .
  return lit wide_u16 do lo narrow_wrap u16 p. . . hi narrow_wrap u16 shr p. 16 . . . end . .
end .

