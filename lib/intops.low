export struct carry_u64 do
  sum u64 .
  carry u64 .
end .

export struct borrow_u64 do
  diff u64 .
  borrow u64 .
end .

export struct wide_u64 do
  lo u64 .
  hi u64 .
end .

export fn add_carry_u64 input a u64 . input b u64 . input c u64 . output carry_u64 .
  requires le c. 1 . .
do
  let s1 u64 wrap_add a. b. . .
  let s u64 wrap_add s1. c. . .
  if or lt s1. a. . lt s. s1. . . do return lit carry_u64 do sum s. . carry 1 . end . . end .
  return lit carry_u64 do sum s. . carry 0 . end . .
