export struct swide_idiff do
  lo usize .
  hi idiff .
end .

export fn mul_wide_s_idiff input a idiff . input b idiff . output swide_idiff .
do
  let p i128 mul cast i128 a. . cast i128 b. . . .
  return lit swide_idiff do lo narrow_wrap usize p. . . hi narrow_wrap idiff shr p. machine.addr_bits. . . . end . .
end .
