rem ★★ **정수 연산 — 정확한 비교 · 자리올림 · 빌림 · 넓은 곱** (`intops`) — RFC-0156 §8-3 · §8-6 (2026-11-08 · 소유자 «RFC-156의 방향대로»).
rem
rem   기본 타입 시스템(basic_type_system 02 §2.6 · §2.7)이 모든 처리기에 두라고 하는 연산이다. 빌트인이 아니라 라이브러리인 까닭:
rem   모두 Lowent 로 적힌다(리프 규칙 — «Lowent 로 쓸 수 있으면 라이브러리»). 가장 안쪽의 `u64` 윗말만 빌트인 `mul_hi` 를 부른다.
rem
rem   · `cmp_eq` · `cmp_lt` · `cmp_le` — 두 정수의 **수학적 값**을 견준다. 타입이 달라도 된다(부호 · 폭 · `usize` · `idiff` · 128 비트).
rem     중위 `lt` 는 부호가 섞이면 거절된다(`E-TYPE-SIGN`) — 값으로 견주려면 이름으로 말한다. 타입 인자는 적는다: `intops.cmp_lt i64. u64. a. b. .`
rem     방법: 부호를 먼저 본다. 둘 다 음수면 `i128` 로, 둘 다 0 이상이면 `u128` 로 견준다 — 어느 정수든 그 둘 가운데 하나에 들어간다.
rem   · `add_carry_*` → `{sum, carry}` · `sub_borrow_*` → `{diff, borrow}` · `mul_wide_*` → `{lo, hi}` · `mul_wide_s_*` → `{lo, hi}`(lo 는 부호 없음, hi 는 부호 있음).
rem     폭마다 하나씩 둔다(구조체에 타입 매개변수가 없다). 들어오는 자리올림 · 빌림은 0 또는 1 이다(계약).

module intops .

export fn cmp_lt input comptime ta type . input comptime tb type . input a ta . input b tb . output bool .
do
  if lt a. 0 . do
    if lt b. 0 . do return lt cast i128 a. . cast i128 b. . . . end .
    return true .
  end .
  if lt b. 0 . do return false . end .
  return lt cast u128 a. . cast u128 b. . . .
end .

export fn cmp_eq input comptime ta type . input comptime tb type . input a ta . input b tb . output bool .
do
  if lt a. 0 . do
    if lt b. 0 . do return eq cast i128 a. . cast i128 b. . . . end .
    return false .
  end .
  if lt b. 0 . do return false . end .
  return eq cast u128 a. . cast u128 b. . . .
end .

export fn cmp_le input comptime ta type . input comptime tb type . input a ta . input b tb . output bool .
do
  if cmp_lt tb. ta. b. a. . do return false . end .
  return true .
end .

export struct carry_u8 do
  sum u8 .
  carry u8 .
end .

export struct borrow_u8 do
  diff u8 .
  borrow u8 .
end .

export struct wide_u8 do
  lo u8 .
  hi u8 .
end .

export fn add_carry_u8 input a u8 . input b u8 . input c u8 . output carry_u8 .
  requires le c. 1 . .
do
  let s1 u8 wrap_add a. b. . .
  let s u8 wrap_add s1. c. . .
  if or lt s1. a. . lt s. s1. . . do return lit carry_u8 do sum s. . carry 1 . end . . end .
  return lit carry_u8 do sum s. . carry 0 . end . .
end .

export fn sub_borrow_u8 input a u8 . input b u8 . input c u8 . output borrow_u8 .
  requires le c. 1 . .
do
  let d1 u8 wrap_sub a. b. . .
  let d u8 wrap_sub d1. c. . .
  if or lt a. b. . lt d1. c. . . do return lit borrow_u8 do diff d. . borrow 1 . end . . end .
  return lit borrow_u8 do diff d. . borrow 0 . end . .
end .

export fn mul_wide_u8 input a u8 . input b u8 . output wide_u8 .
do
  let p u16 mul widen u16 a. . widen u16 b. . . .
  return lit wide_u8 do lo narrow_wrap u8 p. . . hi narrow_wrap u8 shr p. 8 . . . end . .
end .

