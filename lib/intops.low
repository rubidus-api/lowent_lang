  let d u64 wrap_sub d1. c. . .
  if or lt a. b. . lt d1. c. . . do return lit borrow_u64 do diff d. . borrow 1 . end . . end .
  return lit borrow_u64 do diff d. . borrow 0 . end . .
end .

export fn mul_wide_u64 input a u64 . input b u64 . output wide_u64 .
do
  return lit wide_u64 do lo wrap_mul a. b. . . hi call_builtin mul_hi a. b. . . end . .
end .

export struct carry_usize do
  sum usize .
  carry usize .
end .

export struct borrow_usize do
  diff usize .
  borrow usize .
end .

export struct wide_usize do
  lo usize .
  hi usize .
end .

export fn add_carry_usize input a usize . input b usize . input c usize . output carry_usize .
  requires le c. 1 . .
do
  let s1 usize wrap_add a. b. . .
  let s usize wrap_add s1. c. . .
  if or lt s1. a. . lt s. s1. . . do return lit carry_usize do sum s. . carry 1 . end . . end .
  return lit carry_usize do sum s. . carry 0 . end . .
end .

export fn sub_borrow_usize input a usize . input b usize . input c usize . output borrow_usize .
  requires le c. 1 . .
do
  let d1 usize wrap_sub a. b. . .
  let d usize wrap_sub d1. c. . .
  if or lt a. b. . lt d1. c. . . do return lit borrow_usize do diff d. . borrow 1 . end . . end .
  return lit borrow_usize do diff d. . borrow 0 . end . .
end .

rem `usize` 의 폭은 대상의 주소 폭(`machine.addr_bits`)이다. 곱은 `u128` 에서 하고 그 폭으로 나눈다.
export fn mul_wide_usize input a usize . input b usize . output wide_usize .
do
  let p u128 mul cast u128 a. . cast u128 b. . . .
  return lit wide_usize do lo narrow_wrap usize p. . . hi narrow_wrap usize shr p. machine.addr_bits. . . . end . .
end .

export struct swide_i8 do
  lo u8 .
  hi i8 .
end .

export fn mul_wide_s_i8 input a i8 . input b i8 . output swide_i8 .
do
  let p i16 mul widen i16 a. . widen i16 b. . . .
  return lit swide_i8 do lo narrow_wrap u8 p. . . hi narrow_wrap i8 shr p. 8 . . . end . .
end .

