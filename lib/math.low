rem ★★★ **부동 수학 — 표준 라이브러리** (RFC-0090 N2, 2026-08-11).
rem
rem   빌트인은 열이다: `sqrt`·`abs`·`floor`·`ceil` 은 전부터 있었고, 이번에 여섯이 붙었다 —
rem   `sin`·`cos`·`exp`·`log`·`round`(단항) · `pow`(이항). **권한이 없다**(순수 계산).
rem   libm 에 붙으므로 **호스트 전용**이다.
rem
rem ★★ **오라클은 알려진 답과 항등식**이지 비트가 아니다. libm 은 구현마다 마지막 자리가
rem   다를 수 있고, 정확한 비트를 주장하면 **거짓 실패**가 난다. 그래서 이 라이브러리는
rem   `close` 를 주고, 시험도 그것으로 판정한다 — *"얼마나 가까우면 같다고 볼 것인가"* 를
rem   **쓰는 사람이 적게** 만든다.
rem
rem ★ 안 지은 것: `atan2`·`asin`·`acos`·`tan`·`log2`·`log10`·`cbrt`·`hypot`.
rem   필요해지면 같은 자리에 붙는다(빌트인 하나 + 이 파일 한 줄).

module math .

rem ── 견줌 ───────────────────────────────────────────────────────────────────

rem ★★ 부동소수를 `eq` 로 견주지 않는다 — 그것이 이 축에서 가장 흔한 결함이다.
rem   허용 오차를 **인자로 받는다**: 기본값을 숨기면 그 값이 두 번째 진실이 된다.
rem ★★★ `link "math_close"` 인 까닭(2026-09-07): 내보낸 op 은 C 에서 **저자가 적은 이름 그대로**
rem   나간다(RFC-0063 — 도구는 공개 이름을 발명하지 않는다). 그런데 `close` 는 `unistd.h` 에도
rem   있어서, 이 모듈을 쓰는 프로그램의 **네이티브 빌드가 깨져 있었다**
rem   (`impl/tests/prog/mcpi.low` — VM 으로는 잘 돌아 아무도 몰랐다).
rem   ⇒ Lowent 쪽 이름은 그대로 `math.close` 이고, **C 쪽 이름만** 옮긴다. `link` 절이 바로
rem     이 자리를 위해 있다. 새 게이트 `check-export-names.py` 가 이것을 찾았다.
export fn close input a f64 . input b f64 . input tol f64 . output bool . link "math_close" . do
  return lt abs sub a. b. . . tol. . .
end .

rem ── 상수 (계산으로 낸다 — 리터럴을 손으로 적으면 그것이 두 번째 진실이다) ──

rem ★ π = acos(-1) 이 정석이나 `acos` 가 아직 없다. 대신 **정의로** 낸다: 4·atan(1) 도
rem   `atan` 이 없으므로, 지금은 리터럴을 쓰되 **출처를 적는다**(IEEE-754 배정도 최근접).
export fn pi output f64 . do
  return 3.141592653589793 .
end .

rem ★ e = exp(1) — 이것은 **계산으로 낸다**. 상수를 적을 이유가 없다.
export fn e output f64 . do
  return call_builtin exp 1.0 . .
end .

rem ── 각도 ───────────────────────────────────────────────────────────────────

export fn deg_to_rad input d f64 . output f64 . do
  return div mul d. 3.141592653589793 . 180.0 . .
end .

export fn rad_to_deg input r f64 . output f64 . do
  return div mul r. 180.0 . 3.141592653589793 . .
end .

rem ── 자주 쓰는 조합 ─────────────────────────────────────────────────────────

rem ★ 빗변 — `hypot` 이 없으므로 조합한다. 큰 값에서 넘칠 수 있다는 점은 이름이 못 말한다.
rem   ☞ 안 지은 것에 적었다: 넘침에 강한 `hypot` 은 별도 리프가 필요하다.
export fn hyp input x f64 . input y f64 . output f64 . do
  return call_builtin sqrt add mul x. x. . mul y. y. . . . .
end .

rem ★ 밑이 임의인 로그 — log_b(x) = ln x / ln b.
export fn log_base input x f64 . input b f64 . output f64 . do
  return div call_builtin log x. . call_builtin log b. . . .
end .

rem ★ 선형 보간. t 를 [0,1] 로 가정하지 **않는다** — 밖이면 외삽이고, 그것도 쓸모가 있다.
export fn lerp input a f64 . input b f64 . input t f64 . output f64 . do
  return add a. mul t. sub b. a. . . . .
end .

rem ── 부동소수점 함수 (빌트인 연산의 감싸개 · RFC-0147, 2026-10-12) ─────────────────

rem ★★★ 아래 열둘은 **빌트인 연산을 그대로 넘기는 얇은 감싸개**다. 기계 명령이나 C 의 셈 라이브러리로 내려가는
rem   일이라 언어로는 적을 수 없고, 처리기가 `call_builtin <이름>` 으로 내놓는다. 프로그램은 `math.sqrt x` 로 부른다.
rem ★ 네이티브 코드에서는 C 컴파일러가 감싸개를 펼친다(잰 값은 RFC-0147 §5). VM 에서는 호출 한 번이 더 든다.
rem ★ 정수를 넘기면 번역이 거절한다 — 조용히 틀린 답을 내지 않는다(정본 §6.3.9).

rem 제곱근.
export fn sqrt input x f64 . output f64 . do return call_builtin sqrt x. . . end .
rem 내림 — 그 수보다 크지 않은 가장 큰 정수.
export fn floor input x f64 . output f64 . do return call_builtin floor x. . . end .
rem 올림 — 그 수보다 작지 않은 가장 작은 정수.
export fn ceil input x f64 . output f64 . do return call_builtin ceil x. . . end .
rem 반올림 — 가운데(…​.5)는 0 에서 먼 쪽으로.
export fn round input x f64 . output f64 . do return call_builtin round x. . . end .
rem 사인(라디안).
export fn sin input x f64 . output f64 . do return call_builtin sin x. . . end .
rem 코사인(라디안).
export fn cos input x f64 . output f64 . do return call_builtin cos x. . . end .
rem e 의 거듭제곱.
export fn exp input x f64 . output f64 . do return call_builtin exp x. . . end .
rem 자연로그.
export fn log input x f64 . output f64 . do return call_builtin log x. . . end .
rem 거듭제곱 — `x` 의 `y` 제곱.
export fn pow input x f64 . input y f64 . output f64 . do return call_builtin pow x. y. . . end .
rem 부동소수점 나머지 — 부호는 `x` 를 따른다.
export fn fmod input x f64 . input y f64 . output f64 . do return call_builtin fmod x. y. . . end .

rem ★ 합 둘 — 이름이 오차를 말한다. `sum_seq` 는 앞에서 뒤로 한 번 더한다(오차가 항의 수에 비례한다).
rem   `sum_neumaier` 는 보정하며 더한다(오차가 항의 수에 매이지 않는다).
export fn sum_seq input xs slice f64 . output f64 . do return call_builtin sum_seq xs. . . end .
export fn sum_neumaier input xs slice f64 . output f64 . do return call_builtin sum_neumaier xs. . . end .
