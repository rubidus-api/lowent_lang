rem ★★★ **NIST P-256 (secp256r1)** — ECDSA 검증에 필요한 만큼만.
rem
rem   p = 2^256 − 2^224 + 2^192 + 2^96 − 1,  곡선 y² = x³ − 3x + b.
rem   TLS 1.3 의 `ecdsa_secp256r1_sha256` 이 이 곡선을 쓴다.
rem
rem ★★ **표현**: `bigint` 와 같은 16비트 조각 × 16 개. 모듈러 곱은 **몽고메리**를 그대로
rem   재사용한다 — p 도 n(위수)도 홀수라 조건이 맞는다.
rem   ☞ 새 산술을 또 짓지 않는다. 같은 곱을 두 모듈러스에 쓴다.
rem
rem ★★★ **왜 야코비 좌표인가**: 아핀 좌표의 점 덧셈은 매번 **모듈러 역원**을 요구하고,
rem   역원은 곱보다 수백 배 비싸다. 야코비 좌표는 역원을 **맨 끝 한 번**으로 미룬다.
rem
rem ★ 오라클: **NIST CAVP 의 P-256/SHA-256 서명 검증 벡터** — 양성과 **음성** 둘 다.
rem
rem ☞ 안 지은 것: 서명 생성 · 상수시간(검증은 공개 정보다) · 점 압축 해제 ·
rem   P-384/P-521(같은 코드로 붙지만 지금 필요하지 않다).

module p256 .

rem ★★★★ **「자리가 모자라다」와 「답이 아니다」는 다른 사실이다** (X-0035, 소유자 결정 2026-09-20).
rem   그전에는 둘 다 0 이었다 — 재지 못한 것과 재고 나서 «아니다» 하는 것이 **같은 값**이었고,
rem   그래서 작업 공간을 잘못 준 판이 «답이 틀렸다» 로 보였다. 이제 모자람은 값이 아니라 **실패**다.
export enum p256_error do
  short_workspace .
end .


rem ☞ **왜 `padd`/`pdbl` 인가**: `add` 는 빌트인이고 `dbl` 은 짧아 남과 부딪히기 쉽다.
rem   이름공간이 평면이라 모듈 안이라고 안전하지 않다 — 도구가 E-VISIBILITY 로 잡았다.

use bigint from "bigint.low" .

rem 조각 수는 16(=256비트).
export fn limbs output u64 . do  return 16 . end .

rem ★ 모듈러 뺄셈: o ← (a − b) mod m. 빌림이 나면 m 을 더해 되돌린다.
export proc msub input o mut slice u64 . input a slice u64 . input b slice u64 . input m slice u64 . output u64 . effects none . inplace o a . inplace o b . do
  var borrow u64 be 0 .
  var i u64 be 0 .
  while lt i 16 . do
    let d u64 be wrap_sub (wrap_sub (index a i) (index b i)) borrow .
    set (index o i) (bit_and d 65535) .
    set borrow (bit_and (shr d 63) 1) .
    set i (add i 1) .
  end .
  if eq borrow 1 . do
    var carry u64 be 0 .
    var j u64 be 0 .
    while lt j 16 . do
      let s u64 be add (add (index o j) (index m j)) carry .
      set (index o j) (bit_and s 65535) .
      set carry (shr s 16) .
      set j (add j 1) .
    end .
  end .
  return 1 .
end .

rem ★ 모듈러 덧셈: o ← (a + b) mod m.
export proc madd input o mut slice u64 . input a slice u64 . input b slice u64 . input m slice u64 . output u64 . effects none . inplace o a . inplace o b . do
  var carry u64 be 0 .
  var i u64 be 0 .
  while lt i 16 . do
    let s u64 be add (add (index a i) (index b i)) carry .
    set (index o i) (bit_and s 65535) .
    set carry (shr s 16) .
    set i (add i 1) .
  end .
  rem 넘쳤거나 m 이상이면 한 번 뺀다.
  if eq carry 1 . do
    var borrow u64 be 0 .
    var j u64 be 0 .
    while lt j 16 . do
      let d u64 be wrap_sub (wrap_sub (index o j) (index m j)) borrow .
      set (index o j) (bit_and d 65535) .
      set borrow (bit_and (shr d 63) 1) .
      set j (add j 1) .
    end .
    return 1 .
  end .
  if eq (bigint.ge_mod o m 16) 1 . do
    var borrow2 u64 be 0 .
    var q u64 be 0 .
    while lt q 16 . do
      let d2 u64 be wrap_sub (wrap_sub (index o q) (index m q)) borrow2 .
      set (index o q) (bit_and d2 65535) .
      set borrow2 (bit_and (shr d2 63) 1) .
      set q (add q 1) .
    end .
  end .
  return 1 .
end .

rem ★★ 모듈러 역원 — 페르마(a^(m−2)). m 이 소수일 때만 옳다: p 도 n 도 소수다.
rem   ☞ 확장 유클리드가 더 빠르지만 **입력에 따라 도는 횟수가 달라진다**. 여기는 고정이다.
rem   `w` 는 조각 작업 공간(≥ 6·18).
export proc minv input o mut slice u64 . input a slice u64 . input m slice u64 . input w mut slice u64 . output result u64 p256_error . effects none .
errors short_workspace . do
  guard ge (len w) 108 . else return error short_workspace .
  rem exp = m − 2 를 만든다.
  let z0 u64 be bigint.zero (subslice w 0 18) 16 .
  set (index w 0) 2 .
  let z1 u64 be msub (subslice w 18 36) m (subslice w 0 18) m .
  rem 왼쪽→오른쪽 이진 거듭제곱을 조각 위에서 직접 돈다(몽고메리 형태로).
  let n0i u64 be bigint.n0inv16 (index m 0) .
  rem R^2 mod m
  let z2 u64 be bigint.zero (subslice w 36 54) 16 .
  set (index w 36) 1 .
  var d u64 be 0 .
  while lt d 512 . do
    let zz u64 be bigint.dbl_mod (subslice w 36 54) m 16 .
    set d (add d 1) .
  end .
  rem acc ← R mod m,  base ← a·R mod m
  let z3 u64 be bigint.zero (subslice w 54 72) 16 .
  set (index w 54) 1 .
  let m1 u64 be bigint.mont_mul (subslice w 54 72) (subslice w 54 72) (subslice w 36 54) m 16 n0i (subslice w 90 108) .
  let m2 u64 be bigint.mont_mul (subslice w 72 90) a (subslice w 36 54) m 16 n0i (subslice w 90 108) .
  rem 지수 비트를 위에서부터 — 256 비트 고정으로 돈다(맨 위 0 들은 제곱만 한다).
  var bi u64 be 256 .
  var done u64 be 0 .
  while eq done 0 . do
    set bi (sub bi 1) .
    let sq u64 be bigint.mont_mul (subslice w 54 72) (subslice w 54 72) (subslice w 54 72) m 16 n0i (subslice w 90 108) .
    let limb u64 be index w (add 18 (shr bi 4)) .
    if eq (bit_and (shr limb (bit_and bi 15)) 1) 1 . do
      let mu u64 be bigint.mont_mul (subslice w 54 72) (subslice w 54 72) (subslice w 72 90) m 16 n0i (subslice w 90 108) .
    end .
    if eq bi 0 . do  set done 1 .  end .
  end .
  rem 몽고메리 벗기기
  let z4 u64 be bigint.zero (subslice w 72 90) 16 .
  set (index w 72) 1 .
  return ok (bigint.mont_mul o (subslice w 54 72) (subslice w 72 90) m 16 n0i (subslice w 90 108)) .
end .

rem ── 곡선 위의 점 (야코비 좌표) ────────────────────────────────────────────
rem
rem ★★ 점 하나는 조각 48 개다: X(16) ‖ Y(16) ‖ Z(16). 아핀 (x,y) 는 (X/Z², Y/Z³).
rem   Z = 0 이 무한원점이다 — 이 표현에서는 그것이 **특별한 값이 아니라 그냥 한 점**이다.
rem
rem ★ 모듈러 곱은 몽고메리를 **일반 형태로** 감싼다: a·b mod p 를 그대로 얻으려면
rem   mont(mont(a,b), R²) 두 번이면 된다. 곱 두 번이 곱 하나보다 느리지만, **곱을 새로
rem   짓지 않는다** — 이 축에서는 그 편이 값싸다(검증은 한 번에 한 번뿐이다).

rem o ← a·b mod p (일반 형태). `t`·`u` 는 18 조각 작업 공간, r2 는 R² mod p.
export proc pmul input o mut slice u64 . input a slice u64 . input b slice u64 . input p slice u64 .
     input r2 slice u64 . input n0i u64 . input t mut slice u64 . input u mut slice u64 . output u64 . effects none . inplace o a . inplace o b . do
  guard eq (bigint.mont_mul u a b p 16 n0i t) 1 . else return 0 .
  return bigint.mont_mul o u r2 p 16 n0i t .
end .

rem ★ R² mod p 를 한 번 만들어 둔다(1 을 512 번 배로 늘린다).
export proc make_r2 input r2 mut slice u64 . input p slice u64 . output u64 . effects none . do
  let z u64 be bigint.zero r2 16 .
  set (index r2 0) 1 .
  var d u64 be 0 .
  while lt d 512 . do
    let zz u64 be bigint.dbl_mod r2 p 16 .
    set d (add d 1) .
  end .
  return 1 .
end .

rem ★★ 점 두 배 `pdbl` (야코비, a = −3 인 곡선의 표준 식).
rem   `w` 는 조각 작업 공간(≥ 8·18 = 144).
export proc pdbl input o mut slice u64 . input pt slice u64 . input p slice u64 .
     input r2 slice u64 . input n0i u64 . input w mut slice u64 . output result u64 p256_error . effects none .
errors short_workspace . do
  guard ge (len w) 180 . else return error short_workspace .
  let X slice u64 be subslice pt 0 16 .
  let Y slice u64 be subslice pt 16 32 .
  let Z slice u64 be subslice pt 32 48 .
  rem delta = Z², gamma = Y², beta = X·gamma
  let a1 u64 be pmul (subslice w 0 16) Z Z p r2 n0i (subslice w 144 162) (subslice w 162 180) .
  let a2 u64 be pmul (subslice w 16 32) Y Y p r2 n0i (subslice w 144 162) (subslice w 162 180) .
  let a3 u64 be pmul (subslice w 32 48) X (subslice w 16 32) p r2 n0i (subslice w 144 162) (subslice w 162 180) .
  rem alpha = 3·(X − delta)·(X + delta)
  let a4 u64 be msub (subslice w 48 64) X (subslice w 0 16) p .
  let a5 u64 be madd (subslice w 64 80) X (subslice w 0 16) p .
  let a6 u64 be pmul (subslice w 80 96) (subslice w 48 64) (subslice w 64 80) p r2 n0i (subslice w 144 162) (subslice w 162 180) .
  let a7 u64 be madd (subslice w 96 112) (subslice w 80 96) (subslice w 80 96) p .
  let a8 u64 be madd (subslice w 96 112) (subslice w 96 112) (subslice w 80 96) p .
  rem X' = alpha² − 8·beta
  let a9 u64 be pmul (subslice w 112 128) (subslice w 96 112) (subslice w 96 112) p r2 n0i (subslice w 144 162) (subslice w 162 180) .
  let b1 u64 be madd (subslice w 128 144) (subslice w 32 48) (subslice w 32 48) p .
  let b2 u64 be madd (subslice w 128 144) (subslice w 128 144) (subslice w 128 144) p .
  let b3 u64 be madd (subslice w 128 144) (subslice w 128 144) (subslice w 128 144) p .
  let b4 u64 be msub (subslice o 0 16) (subslice w 112 128) (subslice w 128 144) p .
  rem Z' = (Y + Z)² − gamma − delta
  let b5 u64 be madd (subslice w 48 64) Y Z p .
  let b6 u64 be pmul (subslice w 64 80) (subslice w 48 64) (subslice w 48 64) p r2 n0i (subslice w 144 162) (subslice w 162 180) .
  let b7 u64 be msub (subslice w 64 80) (subslice w 64 80) (subslice w 16 32) p .
  let b8 u64 be msub (subslice o 32 48) (subslice w 64 80) (subslice w 0 16) p .
  rem Y' = alpha·(4·beta − X') − 8·gamma²
  let b9 u64 be madd (subslice w 48 64) (subslice w 32 48) (subslice w 32 48) p .
  let c1 u64 be madd (subslice w 48 64) (subslice w 48 64) (subslice w 48 64) p .
  let c2 u64 be msub (subslice w 48 64) (subslice w 48 64) (subslice o 0 16) p .
  let c3 u64 be pmul (subslice w 64 80) (subslice w 96 112) (subslice w 48 64) p r2 n0i (subslice w 144 162) (subslice w 162 180) .
  let c4 u64 be pmul (subslice w 80 96) (subslice w 16 32) (subslice w 16 32) p r2 n0i (subslice w 144 162) (subslice w 162 180) .
  let c5 u64 be madd (subslice w 80 96) (subslice w 80 96) (subslice w 80 96) p .
  let c6 u64 be madd (subslice w 80 96) (subslice w 80 96) (subslice w 80 96) p .
  let c7 u64 be madd (subslice w 80 96) (subslice w 80 96) (subslice w 80 96) p .
  let c8 u64 be msub (subslice o 16 32) (subslice w 64 80) (subslice w 80 96) p .
  return ok 1 .
end .

rem 16 조각이 전부 0 인가 — 무한원점 판정과 H=0 판정에 쓴다.
export fn is_zero input a slice u64 . output u64 . do
  var i u64 be 0 .
  var acc u64 be 0 .
  while lt i 16 . do  set acc (bit_or acc (index a i)) .  set i (add i 1) .  end .
  if eq acc 0 . do  return 1 .  end .
  return 0 .
end .

proc copy48 input o mut slice u64 . input a slice u64 . output u64 . effects none . do
  var i u64 be 0 .
  while lt i 48 . do  set (index o i) (index a i) .  set i (add i 1) .  end .
  return 1 .
end .

rem ★★ 점 덧셈 `padd` (야코비 + 야코비, EFD add-2007-bl).
rem   `w` 는 조각 작업 공간(≥ 300). 무한원점과 **같은 점**(H=0)을 따로 다룬다 —
rem   ☞ 그 갈래를 빠뜨리면 *"거의 언제나 맞는"* 구현이 된다. 거의는 여기서 실패다.
export proc padd input o mut slice u64 . input pa slice u64 . input pb slice u64 . input p slice u64 .
     input r2 slice u64 . input n0i u64 . input w mut slice u64 . output result u64 p256_error . effects none .
errors short_workspace . do
  guard ge (len w) 300 . else return error short_workspace .
  if eq (is_zero (subslice pa 32 48)) 1 . do  return ok (copy48 o pb) .  end .
  if eq (is_zero (subslice pb 32 48)) 1 . do  return ok (copy48 o pa) .  end .
  let T slice u64 be subslice w 264 282 .
  let U slice u64 be subslice w 282 300 .
  rem Z1Z1 = Z1² (w0) · Z2Z2 = Z2² (w1)
  let e1 u64 be pmul (subslice w 0 16) (subslice pa 32 48) (subslice pa 32 48) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let e2 u64 be pmul (subslice w 16 32) (subslice pb 32 48) (subslice pb 32 48) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  rem U1 = X1·Z2Z2 (w2) · U2 = X2·Z1Z1 (w3)
  let e3 u64 be pmul (subslice w 32 48) (subslice pa 0 16) (subslice w 16 32) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let e4 u64 be pmul (subslice w 48 64) (subslice pb 0 16) (subslice w 0 16) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  rem S1 = Y1·Z2·Z2Z2 (w4) · S2 = Y2·Z1·Z1Z1 (w5)
  let e5 u64 be pmul (subslice w 64 80) (subslice pa 16 32) (subslice pb 32 48) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let e6 u64 be pmul (subslice w 64 80) (subslice w 64 80) (subslice w 16 32) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let e7 u64 be pmul (subslice w 80 96) (subslice pb 16 32) (subslice pa 32 48) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let e8 u64 be pmul (subslice w 80 96) (subslice w 80 96) (subslice w 0 16) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  rem H = U2 − U1 (w6) · r = 2(S2 − S1) (w7)
  let e9 u64 be msub (subslice w 96 112) (subslice w 48 64) (subslice w 32 48) p .
  let f1 u64 be msub (subslice w 112 128) (subslice w 80 96) (subslice w 64 80) p .
  rem ★ H = 0 이면 같은 x 다: r 도 0 이면 같은 점(두 배), 아니면 서로의 역(무한원점).
  if eq (is_zero (subslice w 96 112)) 1 . do
    if eq (is_zero (subslice w 112 128)) 1 . do
      return pdbl o pa p r2 n0i w .
    end .
    var zi u64 be 0 .
    while lt zi 48 . do  set (index o zi) 0 .  set zi (add zi 1) .  end .
    return ok 1 .
  end .
  let f2 u64 be madd (subslice w 112 128) (subslice w 112 128) (subslice w 112 128) p .
  rem I = (2H)² (w8) · J = H·I (w9) · V = U1·I (w10)
  let f3 u64 be madd (subslice w 128 144) (subslice w 96 112) (subslice w 96 112) p .
  let f4 u64 be pmul (subslice w 128 144) (subslice w 128 144) (subslice w 128 144) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let f5 u64 be pmul (subslice w 144 160) (subslice w 96 112) (subslice w 128 144) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let f6 u64 be pmul (subslice w 160 176) (subslice w 32 48) (subslice w 128 144) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  rem X3 = r² − J − 2V
  let f7 u64 be pmul (subslice w 176 192) (subslice w 112 128) (subslice w 112 128) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let f8 u64 be msub (subslice w 176 192) (subslice w 176 192) (subslice w 144 160) p .
  let f9 u64 be madd (subslice w 192 208) (subslice w 160 176) (subslice w 160 176) p .
  let g1 u64 be msub (subslice w 208 224) (subslice w 176 192) (subslice w 192 208) p .
  rem Y3 = r·(V − X3) − 2·S1·J
  let g2 u64 be msub (subslice w 224 240) (subslice w 160 176) (subslice w 208 224) p .
  let g3 u64 be pmul (subslice w 224 240) (subslice w 112 128) (subslice w 224 240) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let g4 u64 be pmul (subslice w 240 256) (subslice w 64 80) (subslice w 144 160) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let g5 u64 be madd (subslice w 240 256) (subslice w 240 256) (subslice w 240 256) p .
  let g6 u64 be msub (subslice w 224 240) (subslice w 224 240) (subslice w 240 256) p .
  rem Z3 = ((Z1+Z2)² − Z1Z1 − Z2Z2)·H
  let g7 u64 be madd (subslice w 240 256) (subslice pa 32 48) (subslice pb 32 48) p .
  let g8 u64 be pmul (subslice w 240 256) (subslice w 240 256) (subslice w 240 256) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  let g9 u64 be msub (subslice w 240 256) (subslice w 240 256) (subslice w 0 16) p .
  let h1 u64 be msub (subslice w 240 256) (subslice w 240 256) (subslice w 16 32) p .
  let h2 u64 be pmul (subslice w 240 256) (subslice w 240 256) (subslice w 96 112) p r2 n0i (subslice w 264 282) (subslice w 282 300) .
  rem 이제서야 o 에 쓴다 — pa/pb 와 겹쳐도 안전하도록 **읽기를 다 끝낸 뒤**다.
  var c u64 be 0 .
  while lt c 16 . do
    set (index o c) (index w (add 208 c)) .
    set (index o (add 16 c)) (index w (add 224 c)) .
    set (index o (add 32 c)) (index w (add 240 c)) .
    set c (add c 1) .
  end .
  return ok 1 .
end .

rem ★★ 스칼라 곱 acc ← k·P (이진 두 배-더하기, 위에서부터).
rem   `w` 는 조각 작업 공간(≥ 396): 0..48 tmp · 48..96 tmp2 · 96..396 add/dbl 공용.
export proc smul input acc mut slice u64 . input k slice u64 . input pt slice u64 . input p slice u64 .
     input r2 slice u64 . input n0i u64 . input w mut slice u64 . output result u64 p256_error . effects none .
errors short_workspace . do
  guard ge (len w) 396 . else return error short_workspace .
  var zi u64 be 0 .
  while lt zi 48 . do  set (index acc zi) 0 .  set zi (add zi 1) .  end .
  var bi u64 be 256 .
  var done u64 be 0 .
  while eq done 0 . do
    set bi (sub bi 1) .
    let d_r result u64 p256_error . be pdbl (subslice w 0 48) acc p r2 n0i (subslice w 96 396) .
    guard is_ok d_r . else return error short_workspace .
    let d u64 be ok_value d_r .
    let c u64 be copy48 acc (subslice w 0 48) .
    if eq (bit_and (shr (index k (shr bi 4)) (bit_and bi 15)) 1) 1 . do
      let a_r result u64 p256_error . be padd (subslice w 48 96) acc pt p r2 n0i (subslice w 96 396) .
      guard is_ok a_r . else return error short_workspace .
      let a u64 be ok_value a_r .
      let c2 u64 be copy48 acc (subslice w 48 96) .
    end .
    if eq bi 0 . do  set done 1 .  end .
  end .
  return ok 1 .
end .

rem ★★★★★ **상수시간 갈래** — 서명이 쓰는 자리 (2026-08-21, RFC-0090 §N7b⑤).
rem
rem   위 `smul` 은 스칼라 비트로 **분기한다**(`if eq (bit …) 1 . do padd … end`).
rem   검증에서는 괜찮다 — 스칼라(u1·u2)가 **공개** 정보이기 때문이고, 그것이 이 파일이
rem   *"검증은 공개 정보만 다룬다"* 를 근거로 삼은 이유다.
rem   ★ **서명은 다르다.** 스칼라가 nonce k 이고, k 가 한 비트라도 새면 개인키가 통째로
rem     드러난다(`s = k^-1(h + r·d)` 를 d 에 대해 풀면 끝이다).
rem   ⇒ 서명은 **덧셈을 언제나 하고**, 쓸지 말지는 **분기가 아니라 마스크**로 고른다.
rem
rem ☞ **약속의 크기를 적는다**(RFC-0090 §N7b⑤ 그대로): 여기서 없애는 것은 *비밀 스칼라에
rem   의존하는 분기와 메모리 접근*이다. 몽고메리 곱의 마지막 조건부 뺄셈·캐시 계층·
rem   전력/전자기는 **여전히 약속하지 않는다.** 약속의 크기를 적는 것이 약속의 절반이다.

rem 마스크로 고른다: `bit` 가 1 이면 b, 0 이면 a. **분기가 없다.**
proc csel48 input o mut slice u64 . input a slice u64 . input b slice u64 . input bit u64 . output u64 . effects none . do
  rem bit ∈ {0,1} → m ∈ {0, 0xFFFF}. 조각이 16 비트이므로 그 폭의 마스크면 족하다.
  rem ★ `sub 0 bit` 로 쓰면 **무부호 언더플로**다(E-VM-OVERFLOW 가 잡았다). 곱이 맞다 —
  rem   그리고 곱은 분기가 아니므로 상수시간 약속을 안 깬다.
  let m u64 be mul bit 65535 .
  var i u64 be 0 .
  while lt i 48 . do
    set (index o i) (bit_and (bit_or (bit_and (index a i) (bit_not m)) (bit_and (index b i) m)) 65535) .
    set i (add i 1) .
  end .
  return 1 .
end .

rem ★★★ 상수시간 스칼라 곱 — 걸음마다 **두 배와 덧셈을 둘 다** 하고 마스크로 고른다.
export proc smul_ct input acc mut slice u64 . input k slice u64 . input pt slice u64 . input p slice u64 .
     input r2 slice u64 . input n0i u64 . input w mut slice u64 . output result u64 p256_error . effects none .
errors short_workspace . do
  guard ge (len w) 396 . else return error short_workspace .
  var zi u64 be 0 .
  while lt zi 48 . do  set (index acc zi) 0 .  set zi (add zi 1) .  end .
  var bi u64 be 256 .
  var done u64 be 0 .
  while eq done 0 . do
    set bi (sub bi 1) .
    let d_r result u64 p256_error . be pdbl (subslice w 0 48) acc p r2 n0i (subslice w 96 396) .
    guard is_ok d_r . else return error short_workspace .
    let d u64 be ok_value d_r .
    rem ★ 덧셈을 **언제나** 한다 — 비트를 보고 하지 않는다.
    let a_r result u64 p256_error . be padd (subslice w 48 96) (subslice w 0 48) pt p r2 n0i (subslice w 96 396) .
    guard is_ok a_r . else return error short_workspace .
    let a u64 be ok_value a_r .
    let bit u64 be bit_and (shr (index k (shr bi 4)) (bit_and bi 15)) 1 .
    let c u64 be csel48 acc (subslice w 0 48) (subslice w 48 96) bit .
    if eq bi 0 . do  set done 1 .  end .
  end .
  return ok 1 .
end .

rem ★★★ **ECDSA 검증** (`ecdsa_secp256r1_sha256`).
rem   s^-1 = w,  u1 = e·w mod n,  u2 = r·w mod n,  R = u1·G + u2·Q,  R.x ≡ r (mod n) 이면 참.
rem
rem ★★ **검사가 먼저다.** r 과 s 가 [1, n−1] 안에 있는지, Q 가 무한원점이 아닌지 본다.
rem   ☞ 이것을 안 보면 s=0 같은 값이 통과할 수 있다 — 서명 검증에서 가장 흔한 구멍이다.
rem
rem   pub 은 아핀 (x‖y) 조각 32 개. `w` 는 조각 작업 공간(≥ 1400).
export proc ecdsa_verify input r slice u64 . input s slice u64 . input e slice u64 . input pub slice u64 .
     input p slice u64 . input n slice u64 . input gx slice u64 . input gy slice u64 .
     input w mut slice u64 . output result u64 p256_error . effects none .
errors short_workspace . do
  rem ☞ **작업 공간은 924 조각이면 족하다.** 처음엔 1400 을 요구했는데, 그러면
  rem   `--run` 의 배열 인자 상한(8192 바이트 = u64 1024)을 넘어 시험이 못 돈다.
  rem   자리를 겹치지 않게 다시 짜서 924 로 줄였다 — 넉넉함은 공짜가 아니다.
  guard ge (len w) 924 . else return error short_workspace .
  rem ① r, s 가 [1, n−1] 인가
  guard eq (is_zero r) 0 . else return ok 0 .
  guard eq (is_zero s) 0 . else return ok 0 .
  guard eq (bigint.ge_mod r n 16) 0 . else return ok 0 .
  guard eq (bigint.ge_mod s n 16) 0 . else return ok 0 .

  let n0p u64 be bigint.n0inv16 (index p 0) .
  let n0n u64 be bigint.n0inv16 (index n 0) .
  rem R² — p 쪽(w 0..16)과 n 쪽(w 16..32)을 따로 만든다.
  guard eq (make_r2 (subslice w 0 16) p) 1 . else return ok 0 .
  guard eq (make_r2 (subslice w 16 32) n) 1 . else return ok 0 .

  rem ② winv = s^-1 mod n · u1 = e·winv · u2 = r·winv
  let _u0 result u64 p256_error . be minv (subslice w 32 48) s n (subslice w 780 888) .
  guard is_ok _u0 . else return error short_workspace .
  guard eq (ok_value _u0) 1 . else return ok 0 .
  guard eq (pmul (subslice w 48 64) e (subslice w 32 48) n (subslice w 16 32) n0n (subslice w 888 906) (subslice w 906 924)) 1 . else return ok 0 .
  guard eq (pmul (subslice w 64 80) r (subslice w 32 48) n (subslice w 16 32) n0n (subslice w 888 906) (subslice w 906 924)) 1 . else return ok 0 .

  rem ③ G 와 Q 를 야코비 점으로(Z=1)
  var i u64 be 0 .
  while lt i 16 . do
    set (index w (add 80 i)) (index gx i) .
    set (index w (add 96 i)) (index gy i) .
    set (index w (add 112 i)) 0 .
    set (index w (add 128 i)) (index pub i) .
    set (index w (add 144 i)) (index pub (add 16 i)) .
    set (index w (add 160 i)) 0 .
    set i (add i 1) .
  end .
  set (index w 112) 1 .
  set (index w 160) 1 .

  rem ④ R = u1·G + u2·Q
  let _u1 result u64 p256_error . be smul (subslice w 176 224) (subslice w 48 64) (subslice w 80 128) p (subslice w 0 16) n0p (subslice w 384 780) .
  guard is_ok _u1 . else return error short_workspace .
  guard eq (ok_value _u1) 1 . else return ok 0 .
  let _u2 result u64 p256_error . be smul (subslice w 224 272) (subslice w 64 80) (subslice w 128 176) p (subslice w 0 16) n0p (subslice w 384 780) .
  guard is_ok _u2 . else return error short_workspace .
  guard eq (ok_value _u2) 1 . else return ok 0 .
  let _u3 result u64 p256_error . be padd (subslice w 272 320) (subslice w 176 224) (subslice w 224 272) p (subslice w 0 16) n0p (subslice w 384 684) .
  guard is_ok _u3 . else return error short_workspace .
  guard eq (ok_value _u3) 1 . else return ok 0 .
  rem 무한원점이면 거짓이다 — 여기서 참을 내면 **아무 서명이나 통과**한다.
  guard eq (is_zero (subslice w 304 320)) 0 . else return ok 0 .

  rem ⑤ R 을 아핀으로: x = X/Z²
  let _u4 result u64 p256_error . be minv (subslice w 320 336) (subslice w 304 320) p (subslice w 780 888) .
  guard is_ok _u4 . else return error short_workspace .
  guard eq (ok_value _u4) 1 . else return ok 0 .
  guard eq (pmul (subslice w 336 352) (subslice w 320 336) (subslice w 320 336) p (subslice w 0 16) n0p (subslice w 888 906) (subslice w 906 924)) 1 . else return ok 0 .
  guard eq (pmul (subslice w 352 368) (subslice w 272 288) (subslice w 336 352) p (subslice w 0 16) n0p (subslice w 888 906) (subslice w 906 924)) 1 . else return ok 0 .

  rem ⑥ x mod n 이 r 과 같은가. x < p 이고 n < p 이므로 한 번 빼면 족하다.
  var c u64 be 0 .
  while lt c 16 . do  set (index w (add 368 c)) (index w (add 352 c)) .  set c (add c 1) .  end .
  if eq (bigint.ge_mod (subslice w 368 384) n 16) 1 . do
    let z u64 be msub (subslice w 368 384) (subslice w 368 384) n n .
  end .
  rem 비교는 XOR 누적 — 조기 반환이 없다.
  var diff u64 be 0 .
  var q u64 be 0 .
  while lt q 16 . do
    set diff (bit_or diff (bit_xor (index w (add 368 q)) (index r q))) .
    set q (add q 1) .
  end .
  guard eq diff 0 . else return ok 0 .
  return ok 1 .
end .
