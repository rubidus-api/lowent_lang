rem ★★★ **NIST P-384 (secp384r1)** — ECDSA 검증에 필요한 만큼만.
rem
rem   p = 2^384 − 2^128 − 2^96 + 2^32 − 1,  곡선 y² = x³ − 3x + b.
rem   TLS 1.3 의 `ecdsa_secp384r1_sha384` 가 이 곡선을 쓴다. **오늘의 공개 웹이 이것으로
rem   서명한다** — 널리 쓰이는 중간 CA(예: 여러 상용 CA 의 ECC 중간자)와 그 뿌리가 P-384 다.
rem
rem ★★ **왜 `p256.low` 를 고쳐 쓰지 않고 새 모듈인가.** `p256` 은 조각 수 16 을 **글 안에
rem   박아** 두었고(루프 상한·작업 공간 칸의 자리마다), 검산이 끝난 채 세 소비자가
rem   쓰고 있다. 그것을 조각 수로 매개변수화하면 **검산이 끝난 코드를 건드린다**.
rem   이 저장소는 곡선마다 제 모듈을 준다(`x25519`·`ed25519`·`p256`) — 그 규율을 잇는다.
rem   ☞ 이 파일은 `p256.low` 를 16 → 24 조각으로 옮긴 것이다. **식은 한 글자도 다르지 않다.**
rem   자리 수만 다르다: 점 = 72 조각 · 몽고메리 임시 = 26 조각 · 지수 비트 = 384.
rem
rem ★★ **표현**: `bigint` 와 같은 16비트 조각 × 24 개. 모듈러 곱은 **몽고메리**를 그대로
rem   재사용한다 — p 도 n(위수)도 홀수라 조건이 맞는다.
rem   ☞ 새 산술을 또 짓지 않는다. 같은 곱을 두 모듈러스에 쓴다.
rem
rem ★★★ **왜 야코비 좌표인가**: 아핀 좌표의 점 덧셈은 매번 **모듈러 역원**을 요구하고,
rem   역원은 곱보다 수백 배 비싸다. 야코비 좌표는 역원을 **맨 끝 한 번**으로 미룬다.
rem
rem ★ 오라클 — **우리가 지은 것이 아니다.** 둘이다:
rem   ① `openssl`(secp384r1 · SHA-384)이 **짓고** `openssl dgst -verify` 가 맞다고 말한 서명
rem      한 벌(`impl/tests/prog/p384vec.low` 에 못박혀 있다) — 양성 하나와 **음성 셋**
rem      (s 한 비트 · 해시 한 비트 · s = 0).
rem   ② 진짜 CA 가 서명한 **진짜 인증서 체인** — example.com · cloudflare.com · github.com 의
rem      중간 마디가 P-384 다(2026-09-19 실측).
rem   ☞ **NIST CAVP 벡터는 아직 안 돌렸다.** 그 파일이 이 저장소에 없다 — 없는 것을 있는 척
rem     적지 않는다. `p256.low` 의 머리글은 CAVP 를 말하지만 이 파일은 말하지 못한다.
rem
rem ☞ 안 지은 것: 서명 생성 · 점 압축 해제 · P-521.

module p384 .

rem ☞ **왜 `padd`/`pdbl` 인가**: `add` 는 빌트인이고 `dbl` 은 짧아 남과 부딪히기 쉽다.
rem   이름공간이 평면이라 모듈 안이라고 안전하지 않다 — 도구가 E-VISIBILITY 로 잡았다.

use bigint from "bigint.low" .

rem 조각 수는 24(=384비트).
fn limbs output u64 . do  return 24 . end .

rem ★ 모듈러 뺄셈: o ← (a − b) mod m. 빌림이 나면 m 을 더해 되돌린다.
proc msub input o mut slice u64 . input a slice u64 . input b slice u64 . input m slice u64 . output u64 . effects none . do
  var borrow u64 be 0 .
  var i u64 be 0 .
  while lt i 24 . do
    let d u64 be wrap_sub (wrap_sub (index a i) (index b i)) borrow .
    set (index o i) (bit_and d 65535) .
    set borrow (bit_and (shr d 63) 1) .
    set i (add i 1) .
  end .
  if eq borrow 1 . do
    var carry u64 be 0 .
    var j u64 be 0 .
    while lt j 24 . do
      let s u64 be add (add (index o j) (index m j)) carry .
      set (index o j) (bit_and s 65535) .
      set carry (shr s 16) .
      set j (add j 1) .
    end .
  end .
  return 1 .
end .

rem ★ 모듈러 덧셈: o ← (a + b) mod m.
proc madd input o mut slice u64 . input a slice u64 . input b slice u64 . input m slice u64 . output u64 . effects none . do
  var carry u64 be 0 .
  var i u64 be 0 .
  while lt i 24 . do
    let s u64 be add (add (index a i) (index b i)) carry .
    set (index o i) (bit_and s 65535) .
    set carry (shr s 16) .
    set i (add i 1) .
  end .
  rem 넘쳤거나 m 이상이면 한 번 뺀다.
  if eq carry 1 . do
    var borrow u64 be 0 .
    var j u64 be 0 .
    while lt j 24 . do
      let d u64 be wrap_sub (wrap_sub (index o j) (index m j)) borrow .
      set (index o j) (bit_and d 65535) .
      set borrow (bit_and (shr d 63) 1) .
      set j (add j 1) .
    end .
    return 1 .
  end .
  if eq (bigint.ge_mod o m 24) 1 . do
    var borrow2 u64 be 0 .
    var q u64 be 0 .
    while lt q 24 . do
      let d2 u64 be wrap_sub (wrap_sub (index o q) (index m q)) borrow2 .
      set (index o q) (bit_and d2 65535) .
      set borrow2 (bit_and (shr d2 63) 1) .
      set q (add q 1) .
    end .
  end .
  return 1 .
end .

rem ★★ 모듈러 역원 — 페르마(a^(m−2)). m 이 소수일 때만 옳다: p 도 n 도 소수다.
rem   ☞ 확장 유클리드가 더 빠르지만 **입력에 따라 도는 횟수가 달라진다**. 여기는 고정이다.
rem   `w` 는 조각 작업 공간(≥ 6·26 = 156).
proc minv input o mut slice u64 . input a slice u64 . input m slice u64 . input w mut slice u64 . output u64 . effects none . do
  guard ge (len w) 156 . else return 0 .
  rem exp = m − 2 를 만든다.
  let z0 u64 be bigint.zero (subslice w 0 26) 24 .
  set (index w 0) 2 .
  let z1 u64 be msub (subslice w 26 52) m (subslice w 0 26) m .
  rem 왼쪽→오른쪽 이진 거듭제곱을 조각 위에서 직접 돈다(몽고메리 형태로).
  let n0i u64 be bigint.n0inv16 (index m 0) .
  rem R^2 mod m
  let z2 u64 be bigint.zero (subslice w 52 78) 24 .
  set (index w 52) 1 .
  var d u64 be 0 .
  while lt d 768 . do
    let zz u64 be bigint.dbl_mod (subslice w 52 78) m 24 .
    set d (add d 1) .
  end .
  rem acc ← R mod m,  base ← a·R mod m
  let z3 u64 be bigint.zero (subslice w 78 104) 24 .
  set (index w 78) 1 .
  let m1 u64 be bigint.mont_mul (subslice w 78 104) (subslice w 78 104) (subslice w 52 78) m 24 n0i (subslice w 130 156) .
  let m2 u64 be bigint.mont_mul (subslice w 104 130) a (subslice w 52 78) m 24 n0i (subslice w 130 156) .
  rem 지수 비트를 위에서부터 — 384 비트 고정으로 돈다(맨 위 0 들은 제곱만 한다).
  var bi u64 be 384 .
  var done u64 be 0 .
  while eq done 0 . do
    set bi (sub bi 1) .
    let sq u64 be bigint.mont_mul (subslice w 78 104) (subslice w 78 104) (subslice w 78 104) m 24 n0i (subslice w 130 156) .
    let limb u64 be index w (add 26 (shr bi 4)) .
    if eq (bit_and (shr limb (bit_and bi 15)) 1) 1 . do
      let mu u64 be bigint.mont_mul (subslice w 78 104) (subslice w 78 104) (subslice w 104 130) m 24 n0i (subslice w 130 156) .
    end .
    if eq bi 0 . do  set done 1 .  end .
  end .
  rem 몽고메리 벗기기
  let z4 u64 be bigint.zero (subslice w 104 130) 24 .
  set (index w 104) 1 .
  return bigint.mont_mul o (subslice w 78 104) (subslice w 104 130) m 24 n0i (subslice w 130 156) .
end .

rem ── 곡선 위의 점 (야코비 좌표) ────────────────────────────────────────────
rem
rem ★★ 점 하나는 조각 72 개다: X(24) ‖ Y(24) ‖ Z(24). 아핀 (x,y) 는 (X/Z², Y/Z³).
rem   Z = 0 이 무한원점이다 — 이 표현에서는 그것이 **특별한 값이 아니라 그냥 한 점**이다.
rem
rem ★ 모듈러 곱은 몽고메리를 **일반 형태로** 감싼다: a·b mod p 를 그대로 얻으려면
rem   mont(mont(a,b), R²) 두 번이면 된다. 곱 두 번이 곱 하나보다 느리지만, **곱을 새로
rem   짓지 않는다** — 이 축에서는 그 편이 값싸다(검증은 한 번에 한 번뿐이다).

rem o ← a·b mod p (일반 형태). `t`·`u` 는 26 조각 작업 공간, r2 는 R² mod p.
proc pmul input o mut slice u64 . input a slice u64 . input b slice u64 . input p slice u64 .
     input r2 slice u64 . input n0i u64 . input t mut slice u64 . input u mut slice u64 . output u64 . effects none . do
  guard eq (bigint.mont_mul u a b p 24 n0i t) 1 . else return 0 .
  return bigint.mont_mul o u r2 p 24 n0i t .
end .

rem ★ R² mod p 를 한 번 만들어 둔다(1 을 768 번 배로 늘린다).
proc make_r2 input r2 mut slice u64 . input p slice u64 . output u64 . effects none . do
  let z u64 be bigint.zero r2 24 .
  set (index r2 0) 1 .
  var d u64 be 0 .
  while lt d 768 . do
    let zz u64 be bigint.dbl_mod r2 p 24 .
    set d (add d 1) .
  end .
  return 1 .
end .

rem ★★ 점 두 배 `pdbl` (야코비, a = −3 인 곡선의 표준 식).
rem   `w` 는 조각 작업 공간(≥ 268).
proc pdbl input o mut slice u64 . input pt slice u64 . input p slice u64 .
     input r2 slice u64 . input n0i u64 . input w mut slice u64 . output u64 . effects none . do
  guard ge (len w) 268 . else return 0 .
  let X slice u64 be subslice pt 0 24 .
  let Y slice u64 be subslice pt 24 48 .
  let Z slice u64 be subslice pt 48 72 .
  rem delta = Z², gamma = Y², beta = X·gamma
  let a1 u64 be pmul (subslice w 0 24) Z Z p r2 n0i (subslice w 216 242) (subslice w 242 268) .
  let a2 u64 be pmul (subslice w 24 48) Y Y p r2 n0i (subslice w 216 242) (subslice w 242 268) .
  let a3 u64 be pmul (subslice w 48 72) X (subslice w 24 48) p r2 n0i (subslice w 216 242) (subslice w 242 268) .
  rem alpha = 3·(X − delta)·(X + delta)
  let a4 u64 be msub (subslice w 72 96) X (subslice w 0 24) p .
  let a5 u64 be madd (subslice w 96 120) X (subslice w 0 24) p .
  let a6 u64 be pmul (subslice w 120 144) (subslice w 72 96) (subslice w 96 120) p r2 n0i (subslice w 216 242) (subslice w 242 268) .
  let a7 u64 be madd (subslice w 144 168) (subslice w 120 144) (subslice w 120 144) p .
  let a8 u64 be madd (subslice w 144 168) (subslice w 144 168) (subslice w 120 144) p .
  rem X' = alpha² − 8·beta
  let a9 u64 be pmul (subslice w 168 192) (subslice w 144 168) (subslice w 144 168) p r2 n0i (subslice w 216 242) (subslice w 242 268) .
  let b1 u64 be madd (subslice w 192 216) (subslice w 48 72) (subslice w 48 72) p .
  let b2 u64 be madd (subslice w 192 216) (subslice w 192 216) (subslice w 192 216) p .
  let b3 u64 be madd (subslice w 192 216) (subslice w 192 216) (subslice w 192 216) p .
  let b4 u64 be msub (subslice o 0 24) (subslice w 168 192) (subslice w 192 216) p .
  rem Z' = (Y + Z)² − gamma − delta
  let b5 u64 be madd (subslice w 72 96) Y Z p .
  let b6 u64 be pmul (subslice w 96 120) (subslice w 72 96) (subslice w 72 96) p r2 n0i (subslice w 216 242) (subslice w 242 268) .
  let b7 u64 be msub (subslice w 96 120) (subslice w 96 120) (subslice w 24 48) p .
  let b8 u64 be msub (subslice o 48 72) (subslice w 96 120) (subslice w 0 24) p .
  rem Y' = alpha·(4·beta − X') − 8·gamma²
  let b9 u64 be madd (subslice w 72 96) (subslice w 48 72) (subslice w 48 72) p .
  let c1 u64 be madd (subslice w 72 96) (subslice w 72 96) (subslice w 72 96) p .
  let c2 u64 be msub (subslice w 72 96) (subslice w 72 96) (subslice o 0 24) p .
  let c3 u64 be pmul (subslice w 96 120) (subslice w 144 168) (subslice w 72 96) p r2 n0i (subslice w 216 242) (subslice w 242 268) .
  let c4 u64 be pmul (subslice w 120 144) (subslice w 24 48) (subslice w 24 48) p r2 n0i (subslice w 216 242) (subslice w 242 268) .
  let c5 u64 be madd (subslice w 120 144) (subslice w 120 144) (subslice w 120 144) p .
  let c6 u64 be madd (subslice w 120 144) (subslice w 120 144) (subslice w 120 144) p .
  let c7 u64 be madd (subslice w 120 144) (subslice w 120 144) (subslice w 120 144) p .
  let c8 u64 be msub (subslice o 24 48) (subslice w 96 120) (subslice w 120 144) p .
  return 1 .
end .

rem 24 조각이 전부 0 인가 — 무한원점 판정과 H=0 판정에 쓴다.
fn is_zero input a slice u64 . output u64 . do
  var i u64 be 0 .
  var acc u64 be 0 .
  while lt i 24 . do  set acc (bit_or acc (index a i)) .  set i (add i 1) .  end .
  if eq acc 0 . do  return 1 .  end .
  return 0 .
end .

proc copy72 input o mut slice u64 . input a slice u64 . output u64 . effects none . do
  var i u64 be 0 .
  while lt i 72 . do  set (index o i) (index a i) .  set i (add i 1) .  end .
  return 1 .
end .

rem ★★ 점 덧셈 `padd` (야코비 + 야코비, EFD add-2007-bl).
rem   `w` 는 조각 작업 공간(≥ 436). 무한원점과 **같은 점**(H=0)을 따로 다룬다 —
rem   ☞ 그 갈래를 빠뜨리면 *"거의 언제나 맞는"* 구현이 된다. 거의는 여기서 실패다.
proc padd input o mut slice u64 . input pa slice u64 . input pb slice u64 . input p slice u64 .
     input r2 slice u64 . input n0i u64 . input w mut slice u64 . output u64 . effects none . do
  guard ge (len w) 436 . else return 0 .
  if eq (is_zero (subslice pa 48 72)) 1 . do  return copy72 o pb .  end .
  if eq (is_zero (subslice pb 48 72)) 1 . do  return copy72 o pa .  end .
  let T slice u64 be subslice w 384 410 .
  let U slice u64 be subslice w 410 436 .
  rem Z1Z1 = Z1² (w0) · Z2Z2 = Z2² (w1)
  let e1 u64 be pmul (subslice w 0 24) (subslice pa 48 72) (subslice pa 48 72) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let e2 u64 be pmul (subslice w 24 48) (subslice pb 48 72) (subslice pb 48 72) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  rem U1 = X1·Z2Z2 (w2) · U2 = X2·Z1Z1 (w3)
  let e3 u64 be pmul (subslice w 48 72) (subslice pa 0 24) (subslice w 24 48) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let e4 u64 be pmul (subslice w 72 96) (subslice pb 0 24) (subslice w 0 24) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  rem S1 = Y1·Z2·Z2Z2 (w4) · S2 = Y2·Z1·Z1Z1 (w5)
  let e5 u64 be pmul (subslice w 96 120) (subslice pa 24 48) (subslice pb 48 72) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let e6 u64 be pmul (subslice w 96 120) (subslice w 96 120) (subslice w 24 48) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let e7 u64 be pmul (subslice w 120 144) (subslice pb 24 48) (subslice pa 48 72) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let e8 u64 be pmul (subslice w 120 144) (subslice w 120 144) (subslice w 0 24) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  rem H = U2 − U1 (w6) · r = 2(S2 − S1) (w7)
  let e9 u64 be msub (subslice w 144 168) (subslice w 72 96) (subslice w 48 72) p .
  let f1 u64 be msub (subslice w 168 192) (subslice w 120 144) (subslice w 96 120) p .
  rem ★ H = 0 이면 같은 x 다: r 도 0 이면 같은 점(두 배), 아니면 서로의 역(무한원점).
  if eq (is_zero (subslice w 144 168)) 1 . do
    if eq (is_zero (subslice w 168 192)) 1 . do
      return pdbl o pa p r2 n0i w .
    end .
    var zi u64 be 0 .
    while lt zi 72 . do  set (index o zi) 0 .  set zi (add zi 1) .  end .
    return 1 .
  end .
  let f2 u64 be madd (subslice w 168 192) (subslice w 168 192) (subslice w 168 192) p .
  rem I = (2H)² (w8) · J = H·I (w9) · V = U1·I (w10)
  let f3 u64 be madd (subslice w 192 216) (subslice w 144 168) (subslice w 144 168) p .
  let f4 u64 be pmul (subslice w 192 216) (subslice w 192 216) (subslice w 192 216) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let f5 u64 be pmul (subslice w 216 240) (subslice w 144 168) (subslice w 192 216) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let f6 u64 be pmul (subslice w 240 264) (subslice w 48 72) (subslice w 192 216) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  rem X3 = r² − J − 2V
  let f7 u64 be pmul (subslice w 264 288) (subslice w 168 192) (subslice w 168 192) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let f8 u64 be msub (subslice w 264 288) (subslice w 264 288) (subslice w 216 240) p .
  let f9 u64 be madd (subslice w 288 312) (subslice w 240 264) (subslice w 240 264) p .
  let g1 u64 be msub (subslice w 312 336) (subslice w 264 288) (subslice w 288 312) p .
  rem Y3 = r·(V − X3) − 2·S1·J
  let g2 u64 be msub (subslice w 336 360) (subslice w 240 264) (subslice w 312 336) p .
  let g3 u64 be pmul (subslice w 336 360) (subslice w 168 192) (subslice w 336 360) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let g4 u64 be pmul (subslice w 360 384) (subslice w 96 120) (subslice w 216 240) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let g5 u64 be madd (subslice w 360 384) (subslice w 360 384) (subslice w 360 384) p .
  let g6 u64 be msub (subslice w 336 360) (subslice w 336 360) (subslice w 360 384) p .
  rem Z3 = ((Z1+Z2)² − Z1Z1 − Z2Z2)·H
  let g7 u64 be madd (subslice w 360 384) (subslice pa 48 72) (subslice pb 48 72) p .
  let g8 u64 be pmul (subslice w 360 384) (subslice w 360 384) (subslice w 360 384) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  let g9 u64 be msub (subslice w 360 384) (subslice w 360 384) (subslice w 0 24) p .
  let h1 u64 be msub (subslice w 360 384) (subslice w 360 384) (subslice w 24 48) p .
  let h2 u64 be pmul (subslice w 360 384) (subslice w 360 384) (subslice w 144 168) p r2 n0i (subslice w 384 410) (subslice w 410 436) .
  rem 이제서야 o 에 쓴다 — pa/pb 와 겹쳐도 안전하도록 **읽기를 다 끝낸 뒤**다.
  var c u64 be 0 .
  while lt c 24 . do
    set (index o c) (index w (add 312 c)) .
    set (index o (add 24 c)) (index w (add 336 c)) .
    set (index o (add 48 c)) (index w (add 360 c)) .
    set c (add c 1) .
  end .
  return 1 .
end .

rem ★★ 스칼라 곱 acc ← k·P (이진 두 배-더하기, 위에서부터).
rem   `w` 는 조각 작업 공간(≥ 580): 0..72 tmp · 72..144 tmp2 · 144..580 add/dbl 공용.
proc smul input acc mut slice u64 . input k slice u64 . input pt slice u64 . input p slice u64 .
     input r2 slice u64 . input n0i u64 . input w mut slice u64 . output u64 . effects none . do
  guard ge (len w) 580 . else return 0 .
  var zi u64 be 0 .
  while lt zi 72 . do  set (index acc zi) 0 .  set zi (add zi 1) .  end .
  var bi u64 be 384 .
  var done u64 be 0 .
  while eq done 0 . do
    set bi (sub bi 1) .
    let d u64 be pdbl (subslice w 0 72) acc p r2 n0i (subslice w 144 580) .
    let c u64 be copy72 acc (subslice w 0 72) .
    if eq (bit_and (shr (index k (shr bi 4)) (bit_and bi 15)) 1) 1 . do
      let a u64 be padd (subslice w 72 144) acc pt p r2 n0i (subslice w 144 580) .
      let c2 u64 be copy72 acc (subslice w 72 144) .
    end .
    if eq bi 0 . do  set done 1 .  end .
  end .
  return 1 .
end .

rem ★★★ **ECDSA 검증** (`ecdsa_secp384r1_sha384`).
rem   s^-1 = w,  u1 = e·w mod n,  u2 = r·w mod n,  R = u1·G + u2·Q,  R.x ≡ r (mod n) 이면 참.
rem
rem ★★ **검사가 먼저다.** r 과 s 가 [1, n−1] 안에 있는지, Q 가 무한원점이 아닌지 본다.
rem   ☞ 이것을 안 보면 s=0 같은 값이 통과할 수 있다 — 서명 검증에서 가장 흔한 구멍이다.
rem
rem   pub 은 아핀 (x‖y) 조각 48 개. `w` 는 조각 작업 공간(≥ 1364).
export proc ecdsa_ok input r slice u64 . input s slice u64 . input e slice u64 . input pub slice u64 .
     input p slice u64 . input n slice u64 . input gx slice u64 . input gy slice u64 .
     input w mut slice u64 . output u64 . effects none . do
  rem ☞ **작업 공간은 1364 조각이다.** `p256` 의 924 를 그대로 1.5 배 한 자리이고,
  rem   `--run` 의 배열 인자 상한(u64 1024)을 **넘는다** — 그래서 이 곡선의 시험은 인자로
  rem   공간을 넘기지 않고 프로그램이 제 버퍼에서 잘라 준다(`p384vec.low`).
  guard ge (len w) 1364 . else return 0 .
  rem ① r, s 가 [1, n−1] 인가
  guard eq (is_zero r) 0 . else return 0 .
  guard eq (is_zero s) 0 . else return 0 .
  guard eq (bigint.ge_mod r n 24) 0 . else return 0 .
  guard eq (bigint.ge_mod s n 24) 0 . else return 0 .

  let n0p u64 be bigint.n0inv16 (index p 0) .
  let n0n u64 be bigint.n0inv16 (index n 0) .
  rem R² — p 쪽(w 0..24)과 n 쪽(w 24..48)을 따로 만든다.
  guard eq (make_r2 (subslice w 0 24) p) 1 . else return 0 .
  guard eq (make_r2 (subslice w 24 48) n) 1 . else return 0 .

  rem ② winv = s^-1 mod n · u1 = e·winv · u2 = r·winv
  guard eq (minv (subslice w 48 72) s n (subslice w 1156 1312)) 1 . else return 0 .
  guard eq (pmul (subslice w 72 96) e (subslice w 48 72) n (subslice w 24 48) n0n (subslice w 1312 1338) (subslice w 1338 1364)) 1 . else return 0 .
  guard eq (pmul (subslice w 96 120) r (subslice w 48 72) n (subslice w 24 48) n0n (subslice w 1312 1338) (subslice w 1338 1364)) 1 . else return 0 .

  rem ③ G 와 Q 를 야코비 점으로(Z=1)
  var i u64 be 0 .
  while lt i 24 . do
    set (index w (add 120 i)) (index gx i) .
    set (index w (add 144 i)) (index gy i) .
    set (index w (add 168 i)) 0 .
    set (index w (add 192 i)) (index pub i) .
    set (index w (add 216 i)) (index pub (add 24 i)) .
    set (index w (add 240 i)) 0 .
    set i (add i 1) .
  end .
  set (index w 168) 1 .
  set (index w 240) 1 .

  rem ④ R = u1·G + u2·Q
  guard eq (smul (subslice w 264 336) (subslice w 72 96) (subslice w 120 192) p (subslice w 0 24) n0p (subslice w 576 1156)) 1 . else return 0 .
  guard eq (smul (subslice w 336 408) (subslice w 96 120) (subslice w 192 264) p (subslice w 0 24) n0p (subslice w 576 1156)) 1 . else return 0 .
  guard eq (padd (subslice w 408 480) (subslice w 264 336) (subslice w 336 408) p (subslice w 0 24) n0p (subslice w 576 1012)) 1 . else return 0 .
  rem 무한원점이면 거짓이다 — 여기서 참을 내면 **아무 서명이나 통과**한다.
  guard eq (is_zero (subslice w 456 480)) 0 . else return 0 .

  rem ⑤ R 을 아핀으로: x = X/Z²
  guard eq (minv (subslice w 480 504) (subslice w 456 480) p (subslice w 1156 1312)) 1 . else return 0 .
  guard eq (pmul (subslice w 504 528) (subslice w 480 504) (subslice w 480 504) p (subslice w 0 24) n0p (subslice w 1312 1338) (subslice w 1338 1364)) 1 . else return 0 .
  guard eq (pmul (subslice w 528 552) (subslice w 408 432) (subslice w 504 528) p (subslice w 0 24) n0p (subslice w 1312 1338) (subslice w 1338 1364)) 1 . else return 0 .

  rem ⑥ x mod n 이 r 과 같은가. x < p 이고 n < p 이므로 한 번 빼면 족하다.
  var c u64 be 0 .
  while lt c 24 . do  set (index w (add 552 c)) (index w (add 528 c)) .  set c (add c 1) .  end .
  if eq (bigint.ge_mod (subslice w 552 576) n 24) 1 . do
    let z u64 be msub (subslice w 552 576) (subslice w 552 576) n n .
  end .
  rem 비교는 XOR 누적 — 조기 반환이 없다.
  var diff u64 be 0 .
  var q u64 be 0 .
  while lt q 24 . do
    set diff (bit_or diff (bit_xor (index w (add 552 q)) (index r q))) .
    set q (add q 1) .
  end .
  guard eq diff 0 . else return 0 .
  return 1 .
end .
