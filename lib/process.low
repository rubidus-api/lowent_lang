rem 표준 라이브러리 — 프로세스 (RFC-0136). 잎 다섯(`proc_spawn` · `proc_read` · `proc_poll` · `proc_wait` · `proc_kill`)을 감싼다.
rem
rem   자식은 `owned child` 다. 끝내는 op `wait_exit` 가 그것을 받아 기다리고 닫으며 `result` 를 낸다 — 그래서 띄우고 안 기다리면
rem   컴파일이 안 된다(RFC-0058, 파일 핸들과 같은 꼴). 강제로 끝내도(`kill_child`) `wait_exit` 로 거둬야 한다.
rem   인자는 NUL 로 이은 바이트 한 조각이다(`"prog\0arg1\0arg2"`). 표준 입력은 비어 있고, 표준 출력과 오류는 한 파이프로 모인다.
rem   상태 수: 낮은 32 비트 = 종료 코드 · 비트 32 = 신호로 끝났다(POSIX, 낮은 비트는 신호 번호).

module process .

export def struct child do
  h u64 .
end .

export def enum process_error do
  wait_failed .
end .

rem 띄운다. 못 띄우면 none(프로그램이 없다 · 인자가 틀렸다 · 표가 찼다).
export proc launch input k cap process . input argv slice u8 . output option child . effects io . do
  let h option u64 call_builtin proc_spawn k. argv. . .
  guard is_some h. . else return none . .
  return some lit child do h some_value h. . . end . . .
end .

rem 출력을 읽는다 — 막지 않는다. some n(n > 0) 읽음 · some 0 지금은 없다 · none 출력이 끝났다.
export proc read_output input k cap process . input c child . input buf mut slice u8 . output option u64 . effects io . do
  return call_builtin proc_read k. field c. h . buf. . .
end .

rem 막지 않는 확인. some still_running = 아직 돈다 · some s = 끝났다 · none = 잘못된 핸들.
export proc check input k cap process . input c child . output option u64 . effects io . do
  return call_builtin proc_poll k. field c. h . . .
end .

export fn still_running output u64 . do
  return 18446744073709551615 .
end .

rem 끝날 때까지 기다리고 닫는다(완결). 상태를 낸다.
export proc wait_exit input k cap process . input c owned child . output result u64 process_error . effects io .
errors wait_failed .
do
  let s option u64 call_builtin proc_wait k. field c. h . . .
  drop c. .
  guard is_some s. . else return error wait_failed . . .
  return ok some_value s. . . .
end .

rem 강제로 끝낸다(POSIX SIGKILL · Windows TerminateProcess). 손자는 남을 수 있다.
export proc kill_child input k cap process . input c child . output bool . effects io . do
  return call_builtin proc_kill k. field c. h . . .
end .

export fn exited_normally input s u64 . output bool . do
  return lt s. 4294967296 . .
end .

export fn exit_code input s u64 . output u64 . do
  return bit_and s. 4294967295 . .
end .
