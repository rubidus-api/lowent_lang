rem ★★★ **Lowent 로 쓰인 첫 표준 라이브러리 모듈** — RFC-0068 S2 (문자열 뷰 절반).
rem
rem   여기 있는 모든 op 은 **순수하고(effects none) 아무것도 할당하지 않는다** — 자르기·찾기·비교는
rem   원본을 가리키는 **뷰**를 낼 뿐이다(subslice). 이것이 RFC-0068 의 핵심 분할이다: 문자열 연산의
rem   압도적 다수는 소유가 필요 없고, 소유(str_buf)는 capability(RFC-0011) 뒤의 별도 단계다.
rem
rem ★★ **빌트인 op 증가 0.** 이 파일은 언어가 이미 가진 것(len·index·subslice·eq·option·guard·
rem   while·actor)만으로 지어졌다 — check-builtins 가 세는 137 은 그대로다. 그리고 이것이 곧
rem   RFC-0068 D5 의 시험이었다: "언어가 자기 라이브러리를 자기로 쓸 수 있는가?" — 쓸 수 있었다.
rem
rem ★ **`str` 은 투명 별칭이다 — newtype 이 아니다** (D1 을 실측이 정정, RFC-0068 §3-D1′).
rem   D3 이 "str 은 바이트다"(인코딩 불가지)를 확정했으므로 str 에는 slice u8 이상의 **불변식이
rem   없고**, 불변식 없는 타입에 명목 벽을 세우면 지키는 것 없이 cast 마찰만 남는다. 실측:
rem   slice 코어 newtype 은 현재 명목 검사가 물지 않아(장식 — §0 금지) 어차피 그대로 못 쓴다.
rem   newtype 은 UTF-8 검증 타입(F2-b)이 생겨 **지킬 불변식이 생기면** 그때 쓴다.
rem
rem ★ 없는 것도 뜻이 있다: str_len·str_sub 는 **없다** — 별칭이므로 len·subslice 가 그대로 str 에
rem   작동하고, 같은 뜻의 두 이름은 §2.5(동의어 금지)가 거부한다. 표면이 저절로 작아졌다.

module strings .

type str slice u8 . .

rem ── 비교 ──────────────────────────────────────────────────────────────

rem 바이트 단위 동등 — 빌트인 `eq` 는 스칼라 전용이라(E-VM-TYPE) 슬라이스 비교는 여기 산다.
export fn eq_str input a str . input b str . output bool . do
  guard eq (len a) (len b) . else return false .
  var i u64 be 0 .
  while lt i (len a) . do
    guard eq (index a i) (index b i) . else return false .
    set i (add i 1) .
  end .
  return true .
end .

rem 바이트 멤버십 — 빌트인 `contains` 는 bitset 전용이다. cut 집합 검사(trim)가 쓴다.
export fn has_byte input s str . input b u8 . output bool . do
  var i u64 be 0 .
  while lt i (len s) . do
    if eq (index s i) b . do return true . end .
    set i (add i 1) .
  end .
  return false .
end .

rem ── 찾기 ──────────────────────────────────────────────────────────────

rem 부분열 탐색, from 부터. ★ **없음은 값이다** — option u64. proven 의 (size_t)-1 센티널도,
rem Go 의 -1 도 필요 없다(RFC-0068 §5.1). from 인자가 기본이다: 커서는 호출자가 드는 u64 값
rem (RFC-0069 §4 위치 지정 원칙 — 커서를 상태에 숨기지 않는다).
export fn find input hay str . input needle str . input from u64 . output option u64 .
do
  guard le from (len hay) . else return none .
  guard gt (len needle) 0 . else return (some from) .   rem 빈 needle = 그 자리(규약)
  var i u64 be from .
  while le (add i (len needle)) (len hay) . do
    if eq_str (subslice hay i (add i (len needle))) needle . do
      return (some i) .
    end .
    set i (add i 1) .
  end .
  return none .
end .

export fn has input hay str . input needle str . output bool . do
  return is_some (find hay needle 0) .
end .

rem ── 접두 · 접미 ───────────────────────────────────────────────────────

export fn starts_with input s str . input prefix str . output bool . do
  guard le (len prefix) (len s) . else return false .
  return eq_str (subslice s 0 (len prefix)) prefix .
end .

export fn ends_with input s str . input suffix str . output bool . do
  guard le (len suffix) (len s) . else return false .
  return eq_str (subslice s (sub (len s) (len suffix)) (len s)) suffix .
end .

rem 접두/접미 제거 — 없으면 **원본 그대로**(Luca Sas 의 모양). 뷰라 복사 0.
export fn remove_prefix input s str . input prefix str . output str . do
  if starts_with s prefix . do return (subslice s (len prefix) (len s)) . end .
  return s .
end .

export fn remove_suffix input s str . input suffix str . output str . do
  if ends_with s suffix . do return (subslice s 0 (sub (len s) (len suffix))) . end .
  return s .
end .

rem ── 다듬기 — cut 은 "잘라낼 바이트들의 집합" (예: " \t\n") ──────────────

export fn trim_start input s str . input cut str . output str . do
  var i u64 be 0 .
  while lt i (len s) . do
    guard has_byte cut (index s i) . else return (subslice s i (len s)) .
    set i (add i 1) .
  end .
  return (subslice s (len s) (len s)) .                 rem 전부 잘림 → 빈 뷰
end .

export fn trim_end input s str . input cut str . output str . do
  var j u64 be (len s) .
  while gt j 0 . do
    guard has_byte cut (index s (sub j 1)) . else return (subslice s 0 j) .
    set j (sub j 1) .
  end .
  return (subslice s 0 0) .
end .

rem ── 분할 ──────────────────────────────────────────────────────────────

rem ★ **커서가 값이다** (RFC-0069 §4 — Rust 의 Seek &mut 참사의 역). 호출자가 pos u64 를 들고,
rem   조각을 받으면 `pos + len 조각 + 1` 로 스스로 전진한다. pos 가 len 을 넘으면 끝(none).
rem     "a,b" → "a"·"b"    "a," → "a"·""(꼬리 빈 조각)    "" → ""(빈 조각 하나)
rem   상태를 나눠 갖지 않으므로 같은 src 를 여러 커서가 **동시에** 읽어도 자유다.
export fn split_next input src str . input sep u8 . input pos u64 . output option str .
do
  guard le pos (len src) . else return none .
  var j u64 be pos .
  while lt j (len src) . do
    if eq (index src j) sep . do return (some (subslice src pos j)) . end .
    set j (add j 1) .
  end .
  return (some (subslice src pos (len src))) .          rem 마지막 조각(sep 없음)
end .

rem ★ pull 소스 판 — RFC-0010 파이프라인의 `next` 규약(RFC-0068 §5.2). 상태를 원할 때는 이것.
rem   spawn 뒤 `send sp init <src> <sep>` 로 채우고, `send sp next` 가 조각을 option 으로 낸다.
export actor str_splitter do
  state do
    src slice u8 .
    sep u8 .
    pos u64 .
    fin bool .
  end .
  proc init input s2 slice u8 . input b u8 . output u64 . effects state . do
    set src s2 .
    set sep b .
    set pos 0 .
    set fin false .
    return 0 .
  end .
  proc next output option slice u8 . effects state . do
    guard eq fin false . else return none .
    var j u64 be pos .
    while lt j (len src) . do
      if eq (index src j) sep . do
        let piece slice u8 be subslice src pos j .
        set pos (add j 1) .
        return (some piece) .
      end .
      set j (add j 1) .
    end .
    let last slice u8 be subslice src pos (len src) .
    set fin true .
    return (some last) .
  end .
end .
