rem ★★★ **열아홉 번째 표준 라이브러리 — 터미널 렌더러 (순수 절반)** (RFC-0075 §5 · 3차 슬라이스 3).
rem
rem ★ RFC-0075 의 "터미널 = 순수 인코딩 + 얇은 cap 껍질" 반 가르기의 **순수 절반**이다:
rem   ANSI 이스케이프 시퀀스를 **호출자 버퍼에 짓는 것**과 **화면 diff 계산**은 IO 가 아니라
rem   바이트 계산이다 — effects none, 오라클 안에서 검증된다. 실제로 쓰는 쪽(cap tty·raw 모드·
rem   키 입력)은 `lib/tty.low` 가 맡는다(`cap tty` — 2026-07-26 에 지었다).
rem
rem ★ 시퀀스 op 은 fmt 의 규약 그대로다: (buf, pos, …) → option u64 (새 pos),
rem   **전량 아니면 무** — 자리가 모자라면 한 바이트도 안 쓴다(절반 쓴 이스케이프는 화면을 깨는
rem   조용히 틀린 출력이다). 좌표는 **0-기준**으로 받고 ANSI 의 1-기준으로 변환해 낸다.
rem
rem ★ 화면 모델(이 슬라이스): 셀 = 바이트 1개(ASCII/단일 바이트 charset). UTF-8 셀·속성(색) 셀은
rem   별도 슬라이스다 — 셀이 넓어지는 것은 diff 의 표현이 바뀌는 일이라 따로 승인받아야 한다.
rem   `diff` 는 복합 op 라 전량-아니면-무를 **약속하지 않는다**: none 이면 버퍼 내용은 미정이다
rem   (정확한 크기를 먼저 알려면 두 번 훑어야 하고, 그 비용을 낼지는 호출자가 고른다 — 문서로 말한다).

module term .

use fmt from "fmt.low" .
use utf8 from "utf8.low" .
use unicode from "unicode.low" .

rem ESC '[' 두 바이트 — 모든 CSI 의 머리.
rem ★ 전엔 `set (index buf pos) 27 .` 이었다 — ESC 를 **리터럴로 적을 방법이 없어서** 산술로
rem   썼기 때문이다(이스케이프 어휘에 `\xNN` 이 없었다). 이제 바이트열이 바이트열로 보인다.
proc t_csi output option u64 . input buf mut slice u8 . . input pos u64 . effects none . do
  return fmt.put_str buf pos "\x1b[" .
end .

rem 화면 지우기 ESC[2J.
export proc clear output option u64 . input buf mut slice u8 . . input pos u64 . effects none . do
  guard le (add pos 4) (len buf) . else return none .
  let p option u64 . be t_csi buf pos .
  guard is_some p . else return none .
  let q option u64 . be fmt.put_byte buf (some_value p) 50 .
  guard is_some q . else return none .
  return fmt.put_byte buf (some_value q) 74 .
end .

rem 커서를 (row, col) 로 — **0-기준** 입력, ANSI 1-기준 출력: ESC[<r+1>;<c+1>H.
export proc goto output option u64 . input buf mut slice u8 . . input pos u64 . input row u64 . input col u64 . effects none . do
  rem 전량 아니면 무: 최대 폭을 먼저 잰다.
  let need u64 be add 4 (add (fmt.dec_width (add row 1)) (fmt.dec_width (add col 1))) .
  guard le (add pos need) (len buf) . else return none .
  let p0 option u64 . be t_csi buf pos .
  guard is_some p0 . else return none .
  let p1 option u64 . be fmt.put_u64 buf (some_value p0) (add row 1) .
  guard is_some p1 . else return none .
  let p2 option u64 . be fmt.put_byte buf (some_value p1) 59 .
  guard is_some p2 . else return none .
  let p3 option u64 . be fmt.put_u64 buf (some_value p2) (add col 1) .
  guard is_some p3 . else return none .
  return fmt.put_byte buf (some_value p3) 72 .
end .

rem SGR 하나짜리 ESC[<n>m — t_reset 은 n=0, 굵게 1, 밑줄 4, 반전 7.
export proc sgr output option u64 . input buf mut slice u8 . . input pos u64 . input n u64 . effects none . do
  let need u64 be add 3 (fmt.dec_width n) .
  guard le (add pos need) (len buf) . else return none .
  let p0 option u64 . be t_csi buf pos .
  guard is_some p0 . else return none .
  let p1 option u64 . be fmt.put_u64 buf (some_value p0) n .
  guard is_some p1 . else return none .
  return fmt.put_byte buf (some_value p1) 109 .
end .

rem 256색 전경 ESC[38;5;<n>m / 배경 ESC[48;5;<n>m.
export proc color256 output option u64 . input buf mut slice u8 . . input pos u64 . input n u64 . input bg bool . effects none . do
  let need u64 be add 8 (fmt.dec_width n) .
  guard le (add pos need) (len buf) . else return none .
  let p0 option u64 . be t_csi buf pos .
  guard is_some p0 . else return none .
  var head u64 be 51 .
  if bg . do set head 52 . end .
  let p1 option u64 . be fmt.put_byte buf (some_value p0) (narrow u8 head) .
  guard is_some p1 . else return none .
  let p2 option u64 . be fmt.put_str buf (some_value p1) "8;5;" .
  guard is_some p2 . else return none .
  let p3 option u64 . be fmt.put_u64 buf (some_value p2) n .
  guard is_some p3 . else return none .
  return fmt.put_byte buf (some_value p3) 109 .
end .

rem 커서 보이기/숨기기 ESC[?25h / ESC[?25l.
export proc cursor output option u64 . input buf mut slice u8 . . input pos u64 . input show bool . effects none . do
  guard le (add pos 6) (len buf) . else return none .
  let p0 option u64 . be t_csi buf pos .
  guard is_some p0 . else return none .
  let p1 option u64 . be fmt.put_str buf (some_value p0) "?25" .
  guard is_some p1 . else return none .
  var t u64 be 104 .
  if eq show false . do set t 108 . end .
  return fmt.put_byte buf (some_value p1) (narrow u8 t) .
end .

rem ★★ **화면 diff** — 이 라이브러리의 존재 이유. prev 와 nxt(같은 길이, 폭 w 의 행들)를 비교해
rem   **바뀐 연속 구간만** `goto + 바이트들` 로 out 에 쓴다. 반환 = 새 pos.
rem   바뀐 것이 없으면 pos 그대로 — **0 바이트가 곧 "화면 건드리지 마라"** 는 답이다.
export proc diff output option u64 . input prev slice u8 . input nxt slice u8 . input w u64 . input out mut slice u8 . . input pos u64 . effects none . do
  guard eq (len prev) (len nxt) . else return none .
  guard gt w 0 . else return none .
  guard eq (mod (len prev) w) 0 . else return none .
  var p u64 be pos .
  var i u64 be 0 .
  while lt i (len nxt) . do
    guard ne (index prev i) (index nxt i) . else do
      set i (add i 1) .
      continue .
    end .
    rem 바뀐 구간 [i, j): 같은 행 안에서 연속으로 다른 셀들.
    let row u64 be div i w .
    let rowend u64 be mul (add row 1) w .
    var j u64 be add i 1 .
    var scanning u64 be 1 .
    while eq scanning 1 . do
      if ge j rowend . do
        set scanning 0 .
      end .
      if eq scanning 1 . do
        if eq (index prev j) (index nxt j) . do
          set scanning 0 .
        end .
        if eq scanning 1 . do
          set j (add j 1) .
        end .
      end .
    end .
    let g option u64 . be goto out p row (mod i w) .
    guard is_some g . else return none .
    set p (some_value g) .
    var q u64 be i .
    while lt q j . do
      guard lt p (len out) . else return none .
      set (index out p) (index nxt q) .
      set p (add p 1) .
      set q (add q 1) .
    end .
    set i j .
  end .
  return some p .
end .

rem ── UTF-8 셀 (3차 슬라이스 5, 2026-07-26) ──
rem
rem ★★★ **셀이 넓어지면 diff 의 표현이 바뀐다** — 그래서 별도 op 이다(1바이트 셀 diff 를
rem   고치는 대신 나란히 둔다: 옛 계약을 쓰던 코드가 조용히 뜻이 달라지면 안 된다).
rem   모델: 화면은 **행마다 w 개의 코드포인트**를 담는 UTF-8 바이트열이고, 행은 개행(10)으로
rem   나뉜다. 즉 열은 **바이트 오프셋이 아니라 코드포인트 번째**다 — 터미널 커서가 그렇게 센다.
rem   ☞ 폭(칸 수)은 **아래 슬라이스 9** 가 센다(`row_width`·`fit_width`) — 한글·CJK 는 두 칸이다.
rem     결합 문자(폭 0)와 grapheme cluster 는 아래 슬라이스 11 이 센다. Ambiguous 폭은 여전히 1 이다(로케일 의존).

rem ★ `at` 의 코드포인트 **바이트 길이 — 검증하고** 낸다: `utf8.decode` 가 받는 것만 받는다(이어지는 바이트·
rem   과길이·서로게이트·상한). 전엔 이 파일의 셀 셈이 선두 바이트와 잘림만 봐서, `row_cells` 가 "유효하지
rem   않으면 none" 을 약속하고도 `E2 41 42` 를 셀 하나로 셌다 — 같은 바이트에 `row_width` 와 다른 답이었고,
rem   그 틈에서 `col_off` 는 터미널이 동의하지 않는 열을 냈다. 잣대는 하나여야 한다.
proc t_cp_len output option u64 . input s slice u8 . input at u64 . effects none . do
  guard is_some (utf8.decode s at) . else return none .
  return some (utf8.seq_len (index s at)) .
end .

rem 한 행(개행 없는 UTF-8 바이트열)에서 **코드포인트 c 번째의 바이트 오프셋**. 모자라면 none.
export proc col_off output option u64 . input row_bytes slice u8 . input c u64 . effects none . do
  var off u64 be 0 .
  var seen u64 be 0 .
  while lt seen c . do
    guard lt off (len row_bytes) . else return none .
    let n option u64 . be t_cp_len row_bytes off .
    guard is_some n . else return none .
    set off (add off (some_value n)) .
    set seen (add seen 1) .
  end .
  return some off .
end .

rem 행의 **코드포인트 개수**. 유효하지 않은 UTF-8 이면 none(값으로 답한다).
export proc row_cells output option u64 . input row_bytes slice u8 . effects none . do
  var off u64 be 0 .
  var cells u64 be 0 .
  while lt off (len row_bytes) . do
    let n option u64 . be t_cp_len row_bytes off .
    guard is_some n . else return none .
    set off (add off (some_value n)) .
    set cells (add cells 1) .
  end .
  return some cells .
end .

rem ★ UTF-8 한 행의 diff — prev/nxt 는 **같은 행**(개행 없음)의 바이트열이고, 화면 행 번호는
rem   호출자가 준다. 바뀐 **코드포인트 구간**만 goto(row, 코드포인트 열) + 그 구간 바이트로 낸다.
rem   같으면 0 바이트. 유효하지 않은 UTF-8 · 버퍼 부족 = none.
rem ★ nxt 가 prev 보다 **짧으면** 마지막 구간 뒤에 EL(ESC[K)을 붙여 남은 셀을 지운다 — 안 지우면 이전
rem   화면의 글자가 그 자리에 남는다(바이트 셀 `diff` 는 길이가 같아야 해서 이 일이 없었다).
rem ★ 잘린 다중바이트가 어느 행의 끝에 있어도 none 이다 — 전엔 그 자리에서 나아가지 못한 채 **영원히
rem   돌았다**(나아감이 조건부였고 else 가 없었다). 신뢰할 수 없는 텍스트를 그리는 렌더러가 멈추는 길이었다.
export proc diff_row_utf8 output option u64 . input prev slice u8 . input nxt slice u8 . input row u64 . input out mut slice u8 . . input pos u64 . effects none . do
  var p u64 be pos .
  var po u64 be 0 .
  var no u64 be 0 .
  var col u64 be 0 .
  var runsc u64 be 0 .
  var runso u64 be 0 .
  var inrun u64 be 0 .
  var stale u64 be 0 .
  var going u64 be 1 .
  while eq going 1 . do
    let pend bool be ge po (len prev) .
    let nend bool be ge no (len nxt) .
    if pend . do
      if nend . do set going 0 . end .
    end .
    if eq going 1 . do
      rem 한쪽이 끝났거나 코드포인트가 다르면 "바뀐 셀"이다.
      var differ u64 be 0 .
      var pn u64 be 0 .
      var nn u64 be 0 .
      if pend . do set differ 1 . end .
      if nend . do
        set differ 1 .
        rem prev 에는 셀이 남았는데 nxt 는 끝났다 — 그 셀들은 화면에서 **지워야** 한다.
        if eq pend false . do set stale 1 . end .
      end .
      if eq differ 0 . do
        let pl option u64 . be t_cp_len prev po .
        let nl option u64 . be t_cp_len nxt no .
        guard is_some pl . else return none .
        guard is_some nl . else return none .
        set pn (some_value pl) .
        set nn (some_value nl) .
        if ne pn nn . do set differ 1 . end .
        if eq differ 0 . do
          var b u64 be 0 .
          while lt b pn . do
            if ne (index prev (add po b)) (index nxt (add no b)) . do set differ 1 . end .
            set b (add b 1) .
          end .
        end .
      end .
      if eq differ 1 . do
        if eq inrun 0 . do
          set inrun 1 .
          set runsc col .
          set runso no .
        end .
      end .
      if eq differ 0 . do
        if eq inrun 1 . do
          let e option u64 . be t_flush_run nxt runso no runsc row out p .
          guard is_some e . else return none .
          set p (some_value e) .
          set inrun 0 .
        end .
      end .
      rem 진행: 각각 자기 코드포인트만큼.
      rem ★ 나아감은 **무조건**이다: 유효하면 그만큼, 아니면 none. 조건부 나아감은 제자리걸음 = 무한 루프였다.
      if eq pend false . do
        if eq differ 0 . do set po (add po pn) . end .
        if eq differ 1 . do
          let s option u64 . be t_cp_len prev po .
          guard is_some s . else return none .
          set po (add po (some_value s)) .
        end .
      end .
      if eq nend false . do
        if eq differ 0 . do set no (add no nn) . end .
        if eq differ 1 . do
          let s option u64 . be t_cp_len nxt no .
          guard is_some s . else return none .
          set no (add no (some_value s)) .
        end .
      end .
      set col (add col 1) .
    end .
  end .
  if eq inrun 1 . do
    let e option u64 . be t_flush_run nxt runso no runsc row out p .
    guard is_some e . else return none .
    set p (some_value e) .
  end .
  rem 마지막 구간을 쓴 뒤 커서는 nxt 의 끝 다음 칸에 있다 — 거기서 줄 끝까지 지우면 남은 셀이 사라진다.
  if eq stale 1 . do
    let e option u64 . be fmt.put_str out p "\x1b[K" .
    guard is_some e . else return none .
    set p (some_value e) .
  end .
  return some p .
end .

rem 바뀐 구간 하나를 낸다: goto(row, 시작 코드포인트 열) + nxt[method from to) 바이트.
proc t_flush_run output option u64 . input nxt slice u8 . input lo u64 . input hi u64 . input col u64 . input row u64 . input out mut slice u8 . . input pos u64 . effects none . do
  let g option u64 . be goto out pos row col .
  guard is_some g . else return none .
  var p u64 be some_value g .
  var q u64 be lo .
  while lt q hi . do
    guard lt p (len out) . else return none .
    set (index out p) (index nxt q) .
    set p (add p 1) .
    set q (add q 1) .
  end .
  return some p .
end .

rem ── 표시 폭 (슬라이스 9, 2026-07-26) — 셀 하나가 늘 한 칸은 아니다 ──
rem
rem ★★★ **한글·CJK 는 터미널에서 두 칸을 먹는다.** 그래서 코드포인트를 세는 것과 **칸을 세는
rem   것**은 다른 일이고, 열 계산에 코드포인트 수를 쓰면 화면이 어긋난다. 여기서 그 둘을 가른다:
rem   `row_cells` 는 글자 수를, `row_width` 는 **칸 수**를 센다.
rem
rem ★ 표는 **범위 목록**이다(Unicode EastAsianWidth 의 W·F 구간). 전체 표를 싣지 않고 실제로
rem   두 칸인 큰 구간만 담는다 — 없는 구간을 있다고 하지 않고, 담은 구간은 정확하다.
rem   ☞ 안 하는 것(정직히): Ambiguous(A) 폭은 **1 로 센다**(로케일에 따라 달라지는데 로케일을
rem     모르는 층에서 정하면 그것이 거짓말이다) · 결합 문자(폭 0)·이모지 ZWJ 시퀀스.

rem 코드포인트 하나의 표시 폭(0 은 안 낸다 — 결합 문자는 아직 1 로 센다).
export proc cp_width output u64 . input cp u64 . effects none . do
  rem ★ 폭 0 이 먼저다(2026-07-26): 결합 문자·서식 문자는 **앞 글자에 얹혀** 자기 칸이 없다.
  rem   이걸 1 로 세면 악센트 하나마다 화면이 한 칸씩 밀린다.
  if unicode.is_zerowidth cp . do return 0 . end .
  rem 한글 자모 (Hangul Jamo 초성/중성/종성 일부) — 1100–115F 는 폭 2.
  if ge cp 4352 . do if le cp 4447 . do return 2 . end end .
  rem CJK 부수·한자·한글 음절 등 큰 덩어리: 2E80–303E, 3041–33FF, 3400–4DBF, 4E00–9FFF,
  rem   A000–A4CF, AC00–D7A3(한글 음절), F900–FAFF, FE10–FE19, FE30–FE6F, FF00–FF60, FFE0–FFE6
  if ge cp 11904 . do if le cp 12350 . do return 2 . end end .
  if ge cp 12353 . do if le cp 13311 . do return 2 . end end .
  if ge cp 13312 . do if le cp 19903 . do return 2 . end end .
  if ge cp 19968 . do if le cp 40959 . do return 2 . end end .
  if ge cp 40960 . do if le cp 42127 . do return 2 . end end .
  if ge cp 44032 . do if le cp 55203 . do return 2 . end end .
  if ge cp 63744 . do if le cp 64255 . do return 2 . end end .
  if ge cp 65040 . do if le cp 65049 . do return 2 . end end .
  if ge cp 65072 . do if le cp 65135 . do return 2 . end end .
  if ge cp 65280 . do if le cp 65376 . do return 2 . end end .
  if ge cp 65504 . do if le cp 65510 . do return 2 . end end .
  rem 이모지·보조 평면의 넓은 구간: 1F300–1F64F, 1F900–1F9FF, 20000–3FFFD
  if ge cp 127744 . do if le cp 128591 . do return 2 . end end .
  if ge cp 129280 . do if le cp 129535 . do return 2 . end end .
  if ge cp 131072 . do if le cp 262141 . do return 2 . end end .
  return 1 .
end .

rem ★ 한 행(개행 없는 UTF-8)의 **표시 폭**. 유효하지 않은 UTF-8 이면 none.
export proc row_width output option u64 . input row_bytes slice u8 . effects none . do
  var off u64 be 0 .
  var w u64 be 0 .
  while lt off (len row_bytes) . do
    let c option u64 . be utf8.decode row_bytes off .
    guard is_some c . else return none .
    let n u64 be utf8.seq_len (index row_bytes off) .
    guard gt n 0 . else return none .
    guard le (add off n) (len row_bytes) . else return none .
    set w (add w (cp_width (some_value c))) .
    set off (add off n) .
  end .
  return some w .
end .

rem ★ 표시 폭이 `cols` 를 넘지 않는 **가장 긴 앞부분**의 바이트 길이. 글자 한가운데서 자르지
rem   않는다 — 자르면 그 뒤 바이트가 쓰레기가 되고 화면이 깨진다.
export proc fit_width output option u64 . input row_bytes slice u8 . input cols u64 . effects none . do
  var off u64 be 0 .
  var w u64 be 0 .
  while lt off (len row_bytes) . do
    let c option u64 . be utf8.decode row_bytes off .
    guard is_some c . else return none .
    let n u64 be utf8.seq_len (index row_bytes off) .
    guard gt n 0 . else return none .
    guard le (add off n) (len row_bytes) . else return none .
    let cw u64 be cp_width (some_value c) .
    if gt (add w cw) cols . do return some off . end .
    set w (add w cw) .
    set off (add off n) .
  end .
  return some off .
end .

rem ── grapheme cluster (슬라이스 11, 2026-07-26) — 사람이 "한 글자" 라고 부르는 것 ──
rem
rem ★★★ **코드포인트 하나가 곧 한 글자는 아니다.** "e" 뒤에 결합 악센트(U+0301)가 오면 화면에는
rem   "é" 하나가 보인다 — 코드포인트는 둘, 칸은 하나, 사람이 세는 글자도 하나다. 커서를 옮기거나
rem   지울 때 이 단위를 안 쓰면 **악센트만 지워지거나 커서가 글자 가운데 선다.**
rem
rem ★ 규칙(이 슬라이스): 선두 코드포인트 하나 + 뒤따르는 **폭 0**(결합·서식) 전부가 한 덩어리다.
rem   ☞ 안 세는 것(정직히): 지역 표시 기호 쌍(국기)·이모지 ZWJ 시퀀스·한글 자모 조합(L+V+T).
rem     전부 UAX #29 의 나머지 규칙이 필요하고, 그건 또 다른 표다.

rem ★ `at` 에서 시작하는 덩어리의 **바이트 길이**. 유효하지 않은 UTF-8 이면 none.
export proc cluster_len output option u64 . input s slice u8 . input at u64 . effects none . do
  guard lt at (len s) . else return none .
  let n0 option u64 . be t_cp_len s at .
  guard is_some n0 . else return none .
  var off u64 be add at (some_value n0) .
  var going bool be true .
  while going . do
    if ge off (len s) . do set going false . end .
    if going . do
      let c option u64 . be utf8.decode s off .
      guard is_some c . else return none .
      if unicode.is_zerowidth (some_value c) . do
        let n u64 be utf8.seq_len (index s off) .
        guard gt n 0 . else return none .
        guard le (add off n) (len s) . else return none .
        set off (add off n) .
      end .
      if eq (unicode.is_zerowidth (some_value c)) false . do set going false . end .
    end .
  end .
  return some (sub off at) .
end .

rem ★ 행의 **덩어리 개수** — 사람이 세는 글자 수다(코드포인트 수와 다르다).
export proc row_clusters output option u64 . input row_bytes slice u8 . effects none . do
  var off u64 be 0 .
  var cnt u64 be 0 .
  while lt off (len row_bytes) . do
    let n option u64 . be cluster_len row_bytes off .
    guard is_some n . else return none .
    guard gt (some_value n) 0 . else return none .
    set off (add off (some_value n)) .
    set cnt (add cnt 1) .
  end .
  return some cnt .
end .
