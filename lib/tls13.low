rem ★★★ **TLS 1.3 키 스케줄** (RFC 8446 §7.1) — Lowent 로 쓴다. N7b 의 첫 칸.
rem
rem   전송이 없어도 지을 수 있는 자리다: 키 스케줄은 **순수 계산**이고, 입력은 바이트열
rem   (공유 비밀 · 전사 해시)뿐이다. ⇒ N4(논블로킹)·N5(주소/DNS) 를 기다릴 이유가 없다.
rem   RFC-0090 §N6 이 HTTP 에 쓴 것과 같은 순서다: **파서를 먼저, 전송을 나중에.**
rem
rem ★ 오라클: 파이썬 `hashlib`/`hmac` 로 **따로 구현한 것**과 바이트 단위로 맞댄다.
rem   ☞ 정직히: 이것은 *"두 구현이 같은 규격을 같게 읽었다"* 는 주장이고, RFC 8448 의
rem     실제 핸드셰이크 추적만큼 강하지 않다. 추적을 붙이는 것은 N7b 의 다음 칸이다 —
rem     **없는 강도를 있다고 적지 않는다.**
rem
rem ★★ 이 스케줄이 하는 일의 뼈대(RFC 8446 §7.1):
rem
rem     0 ─HKDF-Extract(PSK)→ Early Secret ─Derive-Secret("derived","")→ ┐
rem     ECDHE ─HKDF-Extract────────────────→ Handshake Secret ←──────────┘
rem       ├─ Derive-Secret("c hs traffic", method CH SH) → 클라이언트 핸드셰이크 비밀
rem       └─ Derive-Secret("s hs traffic", method CH SH) → 서버 핸드셰이크 비밀
rem     ─Derive-Secret("derived","")→ ┐
rem     0 ─HKDF-Extract──────────────→ Master Secret
rem       ├─ Derive-Secret("c ap traffic", CH..서버 Finished)
rem       └─ Derive-Secret("s ap traffic", …)
rem
rem   각 비밀에서 레코드 키가 나온다: key = Expand-Label(비밀,"key","",32) ·
rem   iv = Expand-Label(비밀,"iv","",12).
rem
rem ☞ 안 지은 것: PSK/0-RTT 갈래(binder·early traffic) · exporter/resumption 비밀.
rem   1-RTT 한 갈래만 짓는다 — 그것이 N7b 가 약속한 범위다.

module tls13 .

rem ★★★★ **「자리가 모자라다」와 「답이 아니다」는 다른 사실이다** (X-0035, 소유자 결정 2026-09-20).
rem   그전에는 둘 다 0 이었다 — 재지 못한 것과 재고 나서 «아니다» 하는 것이 **같은 값**이었고,
rem   그래서 작업 공간을 잘못 준 판이 «답이 틀렸다» 로 보였다. 이제 모자람은 값이 아니라 **실패**다.
export enum tls13_error do
  short_workspace .
end .


use hmac from "hmac.low" .
rem 레코드 계층이 AEAD 를 쓴다 — 그리고 그것이 chacha·poly 를 끌고 온다.
use aead from "aead.low" .
use chacha from "chacha.low" .
use poly from "poly.low" .
use gcm from "gcm.low" .
use aes from "aes.low" .

rem ★ HkdfLabel 을 만든다 (RFC 8446 §7.1):
rem     uint16 length · opaque label<7..255> = "tls13 " ‖ label · opaque context<0..255>
rem   `info` 는 이 구조가 놓일 자리다(2 + 1 + 6 + len(label) + 1 + len(ctx) 바이트).
rem   ☞ **길이 필드는 장식이 아니다** — 뽑을 바이트 수가 라벨 안에 들어가므로, 32 를
rem     달라고 하고 12 를 쓰면 **다른 키가 나온다**. 그래서 `outlen` 을 인자로 받는다.
export proc build_label input label slice u8 . input ctx slice u8 . input outlen u64 . input info mut slice u8 . output u64 . effects none . do
  guard le (len label) 32 . else return 0 .
  guard le (len ctx) 32 . else return 0 .
  guard le outlen 32 . else return 0 .
  let total u64 be add (add 10 (len label)) (len ctx) .
  guard ge (len info) total . else return 0 .
  set (index info 0) (cast u8 (bit_and (shr outlen 8) 255)) .
  set (index info 1) (cast u8 (bit_and outlen 255)) .
  set (index info 2) (cast u8 (add 6 (len label))) .
  rem "tls13 " — 여섯 바이트. 리터럴을 여기 한 곳에만 적는다.
  set (index info 3) 116 .
  set (index info 4) 108 .
  set (index info 5) 115 .
  set (index info 6) 49 .
  set (index info 7) 51 .
  set (index info 8) 32 .
  var i u64 be 0 .
  while lt i (len label) . do
    set (index info (add 9 i)) (index label i) .
    set i (add i 1) .
  end .
  set (index info (add 9 (len label))) (cast u8 (len ctx)) .
  var j u64 be 0 .
  while lt j (len ctx) . do
    set (index info (add (add 10 (len label)) j)) (index ctx j) .
    set j (add j 1) .
  end .
  return total .
end .

rem ★ HKDF-Expand-Label. `out` 은 32 바이트를 받고, 쓸 만큼은 호출자가 앞에서 잘라 쓴다.
rem   ☞ 32 바이트 한 블록만 낸다 — TLS 1.3 의 라벨은 전부 32 이하다(키·IV·finished).
export proc expand_label input secret slice u8 . input label slice u8 . input ctx slice u8 . input outlen u64 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output result u64 tls13_error . effects none .
errors short_workspace . do
  let n u64 be build_label label ctx outlen info .
  guard gt n 0 . else return ok 0 .
  let _u7 result u64 hmac.hmac_error . be hmac.expand1 secret (subslice info 0 n) scratch out .
  guard is_ok _u7 . else return error short_workspace .
  guard eq (ok_value _u7) 32 . else return ok 0 .
  return ok outlen .
end .

rem ★ Derive-Secret(비밀, 라벨, 전사해시) — 문맥이 곧 전사 해시이고 길이는 32 고정.
export proc derive_secret input secret slice u8 . input label slice u8 . input thash slice u8 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output result u64 tls13_error . effects none .
errors short_workspace . do
  guard eq (len thash) 32 . else return ok 0 .
  return expand_label secret label thash 32 info scratch out .
end .

rem ★★ 사다리 한 칸: 앞 비밀에서 "derived" 를 뽑아 그것을 salt 로 새 재료를 Extract 한다.
rem   빈 전사 해시(SHA-256(""))는 **호출자가 준다** — 라이브러리가 몰래 계산하지 않는다.
rem   `prev` 가 비면(첫 칸) 호출자가 0 32 바이트를 준다: 그것이 RFC 의 `0` 이다.
export proc advance input prev slice u8 . input ikm slice u8 . input empty_hash slice u8 . input derived mut slice u8 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output result u64 tls13_error . effects none .
errors short_workspace . do
  rem "derived" — 일곱 바이트.
  guard ge (len scratch) 512 . else return error short_workspace .
  var lbl u64 be 0 .
  set (index scratch 400) 100 .
  set (index scratch 401) 101 .
  set (index scratch 402) 114 .
  set (index scratch 403) 105 .
  set (index scratch 404) 118 .
  set (index scratch 405) 101 .
  set (index scratch 406) 100 .
  rem ★ 라벨이 `scratch[400..]` 에 산다 — 작업 칸은 **그 앞까지만** 넘긴다(겹치면 E-EXCL-INPLACE, RFC-0116 D2).
  rem   `hmac.expand1` 은 작업 칸을 130 + len(info) ≤ 190 바이트만 쓴다.
  let _u6 result u64 tls13_error . be derive_secret prev (subslice scratch 400 407) empty_hash info (subslice scratch 0 400) derived .
  guard is_ok _u6 . else return error short_workspace .
  guard eq (ok_value _u6) 32 . else return ok 0 .
  return hmac.extract derived ikm scratch out .
end .

rem ★ 레코드 키: key = Expand-Label(비밀,"key","",klen).
rem
rem ★★★ **키 길이는 암호 스위트가 정한다 — 상수로 박으면 안 된다.**
rem   처음엔 32 로 박아 뒀다(ChaCha20-Poly1305 의 키 길이). 그런데 그 길이는
rem   **HkdfLabel 안에 들어가므로**, AES-128-GCM(16)을 쓰는 상대와는 키가 통째로 달라진다.
rem   ☞ 이 결함은 **두 번째 구현으로는 안 잡혔다** — 참조도 내가 썼고 같이 32 를 썼기 때문이다.
rem     RFC 8448 §3 의 실제 추적(AES-128-GCM, `key info` 가 `0010…`)이 잡았다.
rem     *"두 구현이 같은 오독을 하면 둘 다 통과한다"* 가 실제로 일어났고, 정본이 그것을 깼다.
export proc traffic_key input secret slice u8 . input klen u64 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output result u64 tls13_error . effects none .
errors short_workspace . do
  guard ge (len scratch) 512 . else return error short_workspace .
  guard le klen 32 . else return ok 0 .
  guard gt klen 0 . else return ok 0 .
  set (index scratch 400) 107 .
  set (index scratch 401) 101 .
  set (index scratch 402) 121 .
  return expand_label secret (subslice scratch 400 403) (subslice scratch 407 407) klen info (subslice scratch 0 400) out .
end .

rem ★ 레코드 IV: iv = Expand-Label(비밀,"iv","",12). 앞 12 바이트만 쓴다.
export proc traffic_iv input secret slice u8 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output result u64 tls13_error . effects none .
errors short_workspace . do
  guard ge (len scratch) 512 . else return error short_workspace .
  set (index scratch 400) 105 .
  set (index scratch 401) 118 .
  return expand_label secret (subslice scratch 400 402) (subslice scratch 407 407) 12 info (subslice scratch 0 400) out .
end .

rem ★★ Finished — 상대가 **같은 전사를 보았음**을 증언한다.
rem   finished_key = Expand-Label(비밀,"finished","",32) · verify_data = HMAC(finished_key, 전사해시)
rem   ☞ 이것이 핸드셰이크가 중간자를 배제하는 자리다: 키가 같아도 **본 것이 다르면** 다르다.
export proc finished_key input secret slice u8 . input info mut slice u8 . input scratch mut slice u8 . input out mut slice u8 . output result u64 tls13_error . effects none .
errors short_workspace . do
  guard ge (len scratch) 512 . else return error short_workspace .
  set (index scratch 400) 102 .
  set (index scratch 401) 105 .
  set (index scratch 402) 110 .
  set (index scratch 403) 105 .
  set (index scratch 404) 115 .
  set (index scratch 405) 104 .
  set (index scratch 406) 101 .
  set (index scratch 407) 100 .
  return expand_label secret (subslice scratch 400 408) (subslice scratch 408 408) 32 info (subslice scratch 0 400) out .
end .

rem ★ verify_data = HMAC(finished_key, 전사해시).
export proc verify_data input fkey slice u8 . input thash slice u8 . input scratch mut slice u8 . input out mut slice u8 . output result u64 tls13_error . effects none .
errors short_workspace . do
  guard eq (len thash) 32 . else return ok 0 .
  return hmac.mac fkey thash scratch out .
end .

rem ★★ 레코드 nonce: IV 를 시퀀스 번호와 XOR 한다(RFC 8446 §5.3).
rem   ☞ **번호를 세는 것은 호출자의 일이다.** 같은 nonce 를 두 번 쓰면 ChaCha20-Poly1305 는
rem     무너진다 — 그 책임을 라이브러리가 몰래 지지 않고, 인자로 드러내 놓는다.
export proc record_nonce input iv slice u8 . input seq u64 . input out mut slice u8 . output u64 . effects none . do
  guard ge (len iv) 12 . else return 0 .
  guard ge (len out) 12 . else return 0 .
  var i u64 be 0 .
  while lt i 12 . do
    set (index out i) (index iv i) .
    set i (add i 1) .
  end .
  var b u64 be 0 .
  while lt b 8 . do
    let pos u64 be sub 11 b .
    set (index out pos) (cast u8 (bit_xor (cast u64 (index out pos)) (bit_and (shr seq (mul b 8)) 255))) .
    set b (add b 1) .
  end .
  return 12 .
end .

rem ── 레코드 계층 (RFC 8446 §5) ────────────────────────────────────────────
rem
rem ★★★ TLS 1.3 의 레코드는 겉과 속이 다르다:
rem     겉(TLSCiphertext) : opaque_type=23 ‖ 0x0303 ‖ uint16 길이 ‖ 암호문‖태그
rem     속(TLSInnerPlaintext): 내용 ‖ **진짜 내용 타입 1 바이트** ‖ 0 패딩
rem   ⇒ 진짜 타입은 **속에, 그것도 끝에** 있다. 겉의 23 은 늘 23 이고 아무것도 안 말한다.
rem     ☞ 관찰자에게 *"이것이 핸드셰이크인가 데이터인가"* 를 감추려고 그렇게 짰다.
rem
rem ★★ **AAD 는 5 바이트 헤더 그 자체다** — 따로 만들지 않는다(TLS 1.2 와 다른 자리).
rem   길이 필드는 봉인 **뒤** 크기(암호문+태그)이므로, 헤더를 먼저 쓰고 그 헤더를
rem   AAD 로 넘긴다. 순서가 뒤집히면 조용히 다른 태그가 나온다.

rem ★ 레코드 헤더를 쓴다. `n` 은 **봉인된 뒤**의 바이트 수(속 평문 + 태그 16).
export proc record_header input n u64 . input out mut slice u8 . output u64 . effects none . do
  guard ge (len out) 5 . else return 0 .
  guard le n 65535 . else return 0 .
  set (index out 0) 23 .
  set (index out 1) 3 .
  set (index out 2) 3 .
  set (index out 3) (cast u8 (bit_and (shr n 8) 255)) .
  set (index out 4) (cast u8 (bit_and n 255)) .
  return 5 .
end .

rem ★★★ **스위트가 둘이므로 레코드 계층은 갈라진다.**
rem     suite 1 = TLS_AES_128_GCM_SHA256        (RFC 8446 §9.1 **MUST**)
rem     suite 2 = TLS_CHACHA20_POLY1305_SHA256  (SHOULD)
rem   ☞ 하나만 지었을 때는 이 자리가 **죽은 분기**였다. 둘이 되어야 협상이 뜻을 갖는다.
rem
rem ★★ 작업 공간은 **둘로 묶는다** — 바이트 `w`(≥ 460)와 u64 `u`(≥ 42).
rem   파라미터 상한이 16 이라 스위트마다 버퍼를 늘어놓으면 금방 넘는다(lockbox 에서 이미 밟았다).
rem     w: 0..12 nonce · 12..44 otk · 44..108 ks · 108..124 pad · 124..140 want · 140..460 gcm
rem     u: 0..10 poly 상태 · 10..26 chacha 상태 · 26..42 chacha 작업
export proc record_seal input suite u64 . input key slice u8 . input iv slice u8 . input seq u64 .
     input inner slice u8 . input rec mut slice u8 . input w mut slice u8 . input u mut slice u64 . output result u64 tls13_error . effects none .
errors short_workspace . do
  guard ge (len w) 460 . else return error short_workspace .
  guard ge (len u) 42 . else return ok 0 .
  let total u64 be add (len inner) 16 .
  guard ge (len rec) (add 5 total) . else return ok 0 .
  guard eq (record_header total rec) 5 . else return ok 0 .
  guard eq (record_nonce iv seq (subslice w 0 12)) 12 . else return ok 0 .
  rem ★ AAD 는 방금 쓴 헤더 다섯 바이트 **그대로**다.
  let ctp slice u8 be subslice rec 5 (add 5 (len inner)) .
  if eq suite 1 . do
    let _u4 result u64 gcm.gcm_error . be gcm.encrypt key (subslice w 0 12) (subslice rec 0 5) inner (subslice rec 5 (add 5 (len inner))) (subslice rec (add 5 (len inner)) (add 5 total)) (subslice w 140 460) .
    guard is_ok _u4 . else return error short_workspace .
    guard eq (ok_value _u4) 16 . else return ok 0 .
    return ok (add 5 total) .
  end .
  if eq suite 2 . do
    let _u5 result u64 aead.aead_error . be aead.seal key (subslice w 0 12) (subslice rec 0 5) inner (subslice rec 5 (add 5 (len inner))) (subslice rec (add 5 (len inner)) (add 5 total)) (subslice w 12 44) (subslice u 0 10) (subslice u 10 26) (subslice u 26 42) (subslice w 44 108) (subslice w 108 124) .
    guard is_ok _u5 . else return error short_workspace .
    guard eq (ok_value _u5) 16 . else return ok 0 .
    return ok (add 5 total) .
  end .
  rem ☞ 모르는 스위트는 **거절한다**. 조용히 하나를 고르지 않는다.
  return ok 0 .
end .

rem ★★ 레코드 하나를 개봉한다. 태그가 맞을 때만 속 평문을 낸다.
rem   ☞ 겉 타입이 23 이 아니면 **거절한다**: TLS 1.3 에서 보호된 레코드는 언제나 23 이다.
rem     "그럴 리 없다" 를 검사로 바꾸는 자리다.
export proc record_open input suite u64 . input key slice u8 . input iv slice u8 . input seq u64 .
     input rec slice u8 . input inner mut slice u8 . input w mut slice u8 . input u mut slice u64 . output result u64 tls13_error . effects none .
errors short_workspace . do
  guard ge (len w) 460 . else return error short_workspace .
  guard ge (len u) 42 . else return ok 0 .
  guard ge (len rec) 21 . else return ok 0 .
  guard eq (index rec 0) 23 . else return ok 0 .
  let n u64 be add (shl (cast u64 (index rec 3)) 8) (cast u64 (index rec 4)) .
  guard eq (add 5 n) (len rec) . else return ok 0 .
  guard ge n 16 . else return ok 0 .
  let plen u64 be sub n 16 .
  guard ge (len inner) plen . else return ok 0 .
  guard eq (record_nonce iv seq (subslice w 0 12)) 12 . else return ok 0 .
  if eq suite 1 . do
    let _u2 result u64 gcm.gcm_error . be gcm.decrypt key (subslice w 0 12) (subslice rec 0 5) (subslice rec 5 (add 5 plen)) (subslice rec (add 5 plen) (add 5 n)) (subslice inner 0 plen) (subslice w 124 140) (subslice w 140 460) .
    guard is_ok _u2 . else return error short_workspace .
    guard eq (ok_value _u2) 1 . else return ok 0 .
    return ok plen .
  end .
  if eq suite 2 . do
    let _u3 result u64 aead.aead_error . be aead.unseal key (subslice w 0 12) (subslice rec 0 5) (subslice rec 5 (add 5 plen)) (subslice rec (add 5 plen) (add 5 n)) (subslice inner 0 plen) (subslice w 12 44) (subslice u 0 10) (subslice u 10 26) (subslice u 26 42) (subslice w 44 108) (subslice w 108 124) (subslice w 124 140) .
    guard is_ok _u3 . else return error short_workspace .
    guard eq (ok_value _u3) 1 . else return ok 0 .
    return ok plen .
  end .
  return ok 0 .
end .

rem ★ 속 평문의 **끝**에서 진짜 내용 타입을 읽는다 — 0 패딩을 건너뛴다.
rem   ☞ 패딩이 전부 0 인지도 본다: 0 이 아닌 것이 섞였는데 지나치면, 그것은
rem     **말하지 않은 바이트**를 받아들이는 것이다. RFC 8446 §5.4 가 거절하라고 한다.
export proc inner_type input inner slice u8 . output u64 . effects none . do
  guard gt (len inner) 0 . else return 256 .
  var i u64 be sub (len inner) 1 .
  var found u64 be 256 .
  var done u64 be 0 .
  while eq done 0 . do
    if ne (index inner i) 0 . do
      set found (cast u64 (index inner i)) .
      set done 1 .
    end .
    if eq i 0 . do  set done 1 .  end .
    if eq done 0 . do  set i (sub i 1) .  end .
  end .
  return found .
end .

rem ── 핸드셰이크: 전사(transcript)와 메시지 걷기 (RFC 8446 §4) ──────────────
rem
rem ★★★ **전사 해시가 핸드셰이크의 뼈대다.** 키도, Finished 도 전부 *"지금까지 오간
rem   메시지 전부"* 의 해시 위에 선다. ⇒ 중간자가 한 바이트라도 바꾸면 **양쪽 키가 갈린다.**
rem   그래서 전사를 어디서 자르는지가 규격의 절반이다:
rem     c/s hs traffic : ClientHello … ServerHello
rem     서버 Finished  : ClientHello … CertificateVerify
rem     c/s ap traffic : ClientHello … 서버 Finished
rem     클라 Finished  : ClientHello … 서버 Finished (그리고 그 위에 클라 것이 붙는다)
rem
rem ☞ 이 언어의 `sha256` 은 **한 번에 하는** 리프다(스트리밍이 없다). 그래서 전사는
rem   호출자가 이어 붙인 버퍼 위에서 잰다 — 버퍼를 라이브러리가 몰래 잡지 않는다.

rem ★ 전사 해시: 버퍼 앞 `n` 바이트의 SHA-256.
export proc transcript input buf slice u8 . input n u64 . input out mut slice u8 . output u64 . effects none . do
  guard le n (len buf) . else return 0 .
  guard ge (len out) 32 . else return 0 .
  return sha256 (subslice buf 0 n) out .
end .

rem ★ 핸드셰이크 메시지 하나의 겉모습: type(1) ‖ length(3, 빅엔디언) ‖ body.
export fn hs_type input buf slice u8 . input off u64 . output u64 . do
  guard lt off (len buf) . else return 256 .
  return cast u64 (index buf off) .
end .

rem 메시지 전체 길이(머리 4 포함). 버퍼를 넘으면 0 — **넘는 길이를 믿지 않는다**.
export fn hs_size input buf slice u8 . input off u64 . output u64 . do
  guard le (add off 4) (len buf) . else return 0 .
  let n u64 be add (add (shl (cast u64 (index buf (add off 1))) 16) (shl (cast u64 (index buf (add off 2))) 8)) (cast u64 (index buf (add off 3))) .
  guard le (add (add off 4) n) (len buf) . else return 0 .
  return add 4 n .
end .

rem ★★ 버퍼에 온전히 담긴 메시지가 몇 개인가. 길이가 버퍼를 넘으면 거기서 멈춘다.
rem   ☞ 길이 필드는 **상대가 쓴 것**이다. 그것을 믿고 읽으면 상대가 우리 메모리를 읽는다.
rem     이 언어는 경계 검사로 그것을 막지만, **막힌 뒤 무엇을 할지**는 여기서 정한다: 센다.
export fn hs_count input buf slice u8 . output u64 . do
  var off u64 be 0 .
  var n u64 be 0 .
  var done u64 be 0 .
  while eq done 0 . do
    let sz u64 be hs_size buf off .
    if eq sz 0 . do  set done 1 .  end .
    if eq done 0 . do
      set off (add off sz) .
      set n (add n 1) .
      if ge off (len buf) . do  set done 1 .  end .
    end .
  end .
  return n .
end .

rem ★★ 서버가 보낸 Finished 가 **우리가 본 전사와 맞는가**.
rem   verify_data = HMAC(Expand-Label(비밀,"finished","",32), 전사해시)
rem   ☞ 이것이 핸드셰이크가 중간자를 배제하는 자리다. 키가 같아도 **본 것이 다르면** 다르다.
rem   `w` 는 바이트 작업 공간(≥ 576): 0..32 fkey · 32..64 계산된 verify · 64..576 scratch.
export proc check_finished input secret slice u8 . input thash slice u8 . input got slice u8 .
     input info mut slice u8 . input w mut slice u8 . output result u64 tls13_error . effects none .
errors short_workspace . do
  guard ge (len w) 576 . else return error short_workspace .
  rem ★ verify_data 는 **정확히** 해시 길이(32)다 (RFC 8446 §4.4.4, 2026-09-04 보안 검토).
  rem   전에는 `ge` 라서 더 긴 것을 받고 **앞 32 바이트만** 견줬다 — 뒤에 무엇이 붙어도 통과했다.
  rem   길이가 다르면 decode_error 다: 고쳐 읽지 않고 거절한다.
  guard eq (len got) 32 . else return ok 0 .
  let _u0 result u64 tls13_error . be finished_key secret info (subslice w 64 576) (subslice w 0 32) .
  guard is_ok _u0 . else return error short_workspace .
  guard eq (ok_value _u0) 32 . else return ok 0 .
  let _u1 result u64 tls13_error . be verify_data (subslice w 0 32) thash (subslice w 64 576) (subslice w 32 64) .
  guard is_ok _u1 . else return error short_workspace .
  guard eq (ok_value _u1) 32 . else return ok 0 .
  rem 비교는 XOR 누적 — 조기 반환이 없다.
  var diff u64 be 0 .
  var i u64 be 0 .
  while lt i 32 . do
    set diff (bit_or diff (bit_xor (cast u64 (index w (add 32 i))) (cast u64 (index got i)))) .
    set i (add i 1) .
  end .
  guard eq diff 0 . else return ok 0 .
  return ok 1 .
end .
