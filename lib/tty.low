rem ★★★ **스물한 번째 표준 라이브러리 — 터미널 입력** (RFC-0075 · cap tty 슬라이스, 2026-07-26).
rem
rem ★ RFC-0075 의 반 가르기에서 **권한 있는 절반**이다. 순수 절반(ANSI 조립·화면 diff·표시 폭)은
rem   `term` 이 이미 한다. 여기엔 커널이 필요한 셋만 있다: raw 모드·키 읽기·화면 크기.
rem   그리고 그 셋을 감싸는 얇은 껍질 말고는 **전부 순수**다 — 특히 **키 파싱**이 그렇다:
rem   터미널이 보내는 것은 바이트열이고, 그것을 키로 읽는 것은 계산이지 IO 가 아니다.
rem   그래서 파싱은 `effects none` 이고 오라클이 그대로 돌린다(화면 없이 검증된다).
rem
rem ★ 왜 `cap tty` 인가: raw 모드는 **사용자의 터미널 설정을 바꾼다** — 프로그램이 죽어도 그
rem   변경은 남는다. 그런 권한이 ambient 면 아무 라이브러리나 남의 셸을 망가뜨릴 수 있다.
rem   ⇒ 들고 있는 자만 행사한다(RFC-0011). 리프는 `cap tty` 를 안 들면 E-IR-UNSUP 이다.
rem
rem ☞ 안 지은 것(정직히): 마우스 보고 · bracketed paste · 터미널 질의 응답(DA/DSR) 파싱 ·
rem   시그널(SIGWINCH) 연동. 각각 별도 슬라이스다.

module tty .

rem ── 키 코드 (파싱 결과) ──
rem   0 이하는 안 쓴다. 평범한 바이트는 그 값 그대로(1~255), 특수키는 1000 위로 둔다 —
rem   그래야 "이건 글자다" 와 "이건 방향키다" 를 한 값으로 구별할 수 있다.
export fn key_up output u64 . do return 1001 . end .
export fn key_down output u64 . do return 1002 . end .
export fn key_right output u64 . do return 1003 . end .
export fn key_left output u64 . do return 1004 . end .
export fn key_home output u64 . do return 1005 . end .
export fn key_end output u64 . do return 1006 . end .
export fn key_delete output u64 . do return 1007 . end .
export fn key_pageup output u64 . do return 1008 . end .
export fn key_pagedown output u64 . do return 1009 . end .
export fn key_esc output u64 . do return 1010 . end .
rem ★★ **못 알아보는 것과 모자라는 것은 다른 답이다** (2026-09-04). 전엔 둘 다 none 이었다 — 그러면
rem   호출자는 완전하지만 모르는 시퀀스(`ESC [ 1 ; 5 A` Ctrl-↑ · `ESC [ 2 ~` Insert · `ESC [ 1 5 ~` F5)를
rem   "잘렸다" 로 알고 한 바이트씩 건너뛰며 **`[`·`2`·`~` 를 글자로 배달**했다(텍스트 칸에 "[2~" 가 찍힌다).
rem   이제 CSI 는 ECMA-48 의 꼴(매개 0x30–0x3F · 중간 0x20–0x2F · 마침 0x40–0x7E)대로 **한 덩이로 먹고**,
rem   아는 것은 그 키, 모르는 것은 이 코드 + 먹은 길이다. none 은 **오직** 바이트가 모자랄 때다.
rem   ☞ 길이 칸이 4 비트라 15 바이트를 넘는 시퀀스(마우스 보고 따위)는 15 바이트까지만 unknown 으로 먹는다
rem     — 시그니처를 안 바꾸는 한 이것이 한계다(포크로 남긴다).
export fn key_unknown output u64 . do return 1011 . end .

rem ★★ **키 하나를 읽는다 — 순수 계산.** buf 의 at 부터 보고 (키코드, 먹은 바이트 수)를 낸다.
rem   반환은 한 값에 둘을 담는다: `키코드 * 16 + 길이`(길이는 1~8 이라 4비트면 넉넉하다).
rem   못 읽으면(바이트가 모자라면) none — **불완전한 시퀀스를 지어내지 않는다.**
rem   완전하지만 모르는 시퀀스는 `key_unknown` + 먹은 길이다(none 이 아니다 — 위 참조).
rem   ☞ 이것이 순수한 이유: 터미널이 보낸 것은 그냥 바이트열이고, 그것을 키로 읽는 것은 계산이다.
export proc parse_key input buf slice u8 . input at u64 . output option u64 . effects none . do
  guard lt at (len buf) . else return none .
  let b0 u8 be index buf at .
  rem ESC 가 아니면 그 바이트가 곧 키다(제어문자 포함 — Ctrl-C 는 3 이다).
  guard eq b0 27 . else return some (add (mul (widen u64 b0) 16) 1) .
  rem ESC 하나만 왔으면 그것은 **ESC 키**다(뒤가 없으면 기다릴 수 없다 — 지금 답한다).
  guard lt (add at 1) (len buf) . else return some (add (mul 1010 16) 1) .
  let b1 u8 be index buf (add at 1) .
  rem ESC O x — 응용 커서 모드(일부 터미널의 방향키).
  if eq b1 79 . do
    guard lt (add at 2) (len buf) . else return none .
    let c u8 be index buf (add at 2) .
    if eq c 65 . do return some (add (mul 1001 16) 3) . end .
    if eq c 66 . do return some (add (mul 1002 16) 3) . end .
    if eq c 67 . do return some (add (mul 1003 16) 3) . end .
    if eq c 68 . do return some (add (mul 1004 16) 3) . end .
    if eq c 72 . do return some (add (mul 1005 16) 3) . end .
    if eq c 70 . do return some (add (mul 1006 16) 3) . end .
    rem 완전하되 모르는 ESC O x — 세 바이트를 한 덩이로 먹는다.
    return some (add (mul 1011 16) 3) .
  end .
  rem ESC [ … — CSI. 매개 바이트(0x30–0x3F) · 중간 바이트(0x20–0x2F) · 마침 바이트(0x40–0x7E) 순이다.
  rem   그 꼴을 **끝까지 읽어** 한 덩이로 먹는다. 바이트가 모자라면 none — 지어내지 않는다.
  guard eq b1 91 . else return some (add (mul 1010 16) 1) .
  var i u64 be add at 2 .
  var np u64 be 0 .            rem 매개 바이트 수
  var digits bool be true .    rem 매개가 전부 숫자인가(`;` 따위 없이)
  var num u64 be 0 .           rem 그 숫자 값(15 자리 미만이라 넘치지 않는다)
  var going bool be true .
  while going . do
    guard lt i (len buf) . else return none .
    guard lt (sub i at) 15 . else return some (add (mul 1011 16) 15) .
    let c u8 be index buf i .
    if lt c 48 . do set going false . end .
    if gt c 63 . do set going false . end .
    if going . do
      if lt c 58 . do set num (add (mul num 10) (widen u64 (sub c 48))) . end .
      if ge c 58 . do set digits false . end .
      set np (add np 1) .
      set i (add i 1) .
    end .
  end .
  var ni u64 be 0 .            rem 중간 바이트 수
  set going true .
  while going . do
    guard lt i (len buf) . else return none .
    guard lt (sub i at) 15 . else return some (add (mul 1011 16) 15) .
    let c u8 be index buf i .
    if lt c 32 . do set going false . end .
    if gt c 47 . do set going false . end .
    if going . do
      set ni (add ni 1) .
      set i (add i 1) .
    end .
  end .
  guard lt i (len buf) . else return none .
  let f u8 be index buf i .
  rem 마침 바이트가 아닌 것(제어문자·0x7F 이상)이 오면 시퀀스는 거기서 **깨진 것**이다 — 그 앞까지를
  rem   unknown 으로 먹고 그 바이트는 남긴다(ESC 면 새 시퀀스의 머리다. 먹어 버리면 다음 키가 사라진다).
  guard ge f 64 . else return some (add (mul 1011 16) (sub i at)) .
  guard le f 126 . else return some (add (mul 1011 16) (sub i at)) .
  let used u64 be add (sub i at) 1 .
  rem 매개 없는 한 글자: 방향키·Home·End.
  if eq np 0 . do
    if eq ni 0 . do
      if eq f 65 . do return some (add (mul 1001 16) used) . end .
      if eq f 66 . do return some (add (mul 1002 16) used) . end .
      if eq f 67 . do return some (add (mul 1003 16) used) . end .
      if eq f 68 . do return some (add (mul 1004 16) used) . end .
      if eq f 72 . do return some (add (mul 1005 16) used) . end .
      if eq f 70 . do return some (add (mul 1006 16) used) . end .
    end .
  end .
  rem 숫자꼴: ESC [ <n> ~  (7·8 은 rxvt 계열의 Home·End 다).
  if digits . do
    if gt np 0 . do
      if eq ni 0 . do
        if eq f 126 . do
          if eq num 1 . do return some (add (mul 1005 16) used) . end .
          if eq num 3 . do return some (add (mul 1007 16) used) . end .
          if eq num 4 . do return some (add (mul 1006 16) used) . end .
          if eq num 5 . do return some (add (mul 1008 16) used) . end .
          if eq num 6 . do return some (add (mul 1009 16) used) . end .
          if eq num 7 . do return some (add (mul 1005 16) used) . end .
          if eq num 8 . do return some (add (mul 1006 16) used) . end .
        end .
      end .
    end .
  end .
  rem 완전하지만 모르는 시퀀스 — 통째로 먹었다고 답한다. 호출자는 한 바이트씩 글자로 배달하지 않게 된다.
  return some (add (mul 1011 16) used) .
end .

rem 파싱 결과에서 키코드만 / 먹은 길이만 꺼낸다.
export fn key_of input packed u64 . output u64 . do return div packed 16 . end .
export fn len_of input packed u64 . output u64 . do return mod packed 16 . end .

rem ★ 이 값이 **평범한 글자**인가(특수키가 아닌가).
export fn is_char input keycode u64 . output bool . do return lt keycode 1000 . end .
