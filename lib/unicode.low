rem ★★★ **스물세 번째 표준 라이브러리 — 유니코드 속성** (RFC-0075 · 2026-07-26).
rem
rem ★★★ **표는 데이터다 — 코드로 쓰면 거짓말이 섞인다.** 글자 범주(L·N·P·Z·M)는 구간이
rem   2,000 개가 넘는다. 손으로 고르면 반드시 빠뜨리고, 빠뜨린 구간은 "글자가 아니다" 라는
rem   **조용히 틀린 답**이 된다(폭 표는 못 맞혀도 1 이라는 쓸 만한 기본값이 있었지만, 여기서는
rem   틀린 답이 곧 오답이다). ⇒ Unicode 15.1.0 의 표에서 **기계적으로 뽑아** 그대로 싣는다.
rem
rem ★ 싣는 법: 각 구간을 `<시작 6자리><끝 6자리>` 16진수로 붙인 **문자열 하나**다(구간 하나 =
rem   12바이트, 고정폭). 고정폭이라 **디코드 없이 이진 탐색**이 된다 — 표를 펼칠 버퍼가 필요
rem   없고(할당 0), 이 층이 순수하게 남는다.
rem
rem ★ 범위: U+0000–U+2FFFF (BMP + SMP + SIP 시작). 그 위(U+30000+)는 아직 거의 안 쓰이고,
rem   담지 않은 것을 담은 척하지 않는다 — 그 위는 전부 "속성 없음" 으로 답한다.
rem
rem ☞ 안 지은 것(정직히): 대소문자 변환·정규화·조합(모두 별도 표가 더 필요하다) ·
rem   세부 범주(Lu/Ll/Lt … 를 L 로 뭉쳤다 — 필요해지면 그때 나눈다).

module unicode .

use codec from "codec.low" .

rem ── 표 (Unicode 15.1.0 에서 기계적으로 뽑았다) ──
rem 문자(Letter) — 658 구간.
export fn tab_letter output slice u8 . do
  return "" .
end .

rem 숫자(Number) — 137 구간.
export fn tab_number output slice u8 . do
  return "" .
end .

rem 문장부호(Punctuation) — 191 구간.
export fn tab_punct output slice u8 . do
  return "" .
end .

rem 공백(Separator) — 8 구간.
export fn tab_space output slice u8 . do
  return "0000200000200000a00000a000168000168000200000200a00202800202900202f00202f00205f00205f003000003000" .
end .

rem 결합 표시(Mark) — 309 구간.
export fn tab_mark output slice u8 . do
  return "" .
end .

rem ── 조회 ──

rem 표에서 6자리 16진수 하나를 읽는다(구간 i 의 시작 = 12i, 끝 = 12i+6).
proc hex6_at output option u64 . input tab slice u8 . input off u64 . effects none . do
  guard le (add off 6) (len tab) . else return none .
  var v u64 be 0 .
  var k u64 be 0 .
  while lt k 6 . do
    let d option u64 . be codec.hex_val (index tab (add off k)) .
    guard is_some d . else return none .
    set v (add (mul v 16) (some_value d)) .
    set k (add k 1) .
  end .
  return some v .
end .

rem 표의 구간 개수.
export fn range_count output u64 . input tab slice u8 . do
  return div (len tab) 12 .
end .

rem ★ 이 코드포인트가 표의 어느 구간에 드는가 — **이진 탐색**(구간이 정렬돼 있고 겹치지 않는다).
rem   표가 망가졌으면(16진수가 아니면) `false` — 지어내지 않는다.
export proc has_cp output bool . input tab slice u8 . input cp u64 . effects none . do
  var lo u64 be 0 .
  var hi u64 be range_count tab .
  while lt lo hi . do
    let mid u64 be add lo (div (sub hi lo) 2) .
    let s option u64 . be hex6_at tab (mul mid 12) .
    guard is_some s . else return false .
    let e option u64 . be hex6_at tab (add (mul mid 12) 6) .
    guard is_some e . else return false .
    if lt cp (some_value s) . do
      set hi mid .
    end .
    if ge cp (some_value s) . do
      if le cp (some_value e) . do return true . end .
      set lo (add mid 1) .
    end .
  end .
  return false .
end .

rem ── 편의 술어 (표를 골라 주는 얇은 껍질) ──
export proc is_letter output bool . input cp u64 . effects none . do return has_cp tab_letter cp . end .
export proc is_number output bool . input cp u64 . effects none . do return has_cp tab_number cp . end .
export proc is_punct  output bool . input cp u64 . effects none . do return has_cp tab_punct cp . end .
export proc is_space  output bool . input cp u64 . effects none . do return has_cp tab_space cp . end .
export proc is_mark   output bool . input cp u64 . effects none . do return has_cp tab_mark cp . end .

rem ★ 글자 또는 숫자 — 식별자 검사 같은 데 가장 자주 쓰는 조합이다.
export proc is_alnum output bool . input cp u64 . effects none . do
  if is_letter cp . do return true . end .
  return is_number cp .
end .

rem ── 폭 0 (결합 문자·서식 문자, 2026-07-26) ──
rem ★ Mn(결합 표시)·Me(둘러싸는 표시)·Cf(서식)는 **자기 칸을 차지하지 않는다** — 앞 글자에
rem   얹힌다. 그래서 표시 폭을 셀 때 이 구간은 0 이고, grapheme cluster 를 셀 때는 **앞 글자에
rem   붙는다**. 둘은 같은 표에서 나온다.
rem   354 구간.
export fn tab_zerowidth output slice u8 . do
  return "" .
end .

rem ★ 이 코드포인트가 **폭 0** 인가(결합 문자·서식 문자).
export proc is_zerowidth output bool . input cp u64 . effects none . do
  return has_cp tab_zerowidth cp .
end .

rem ── 세부 범주 (2026-07-26) ──
rem ★ 나눈 시점이 요점이다: L 은 통째로 묻는 일이 압도적이라 한 표로 뒀고, **regex `\p{Lu}` 가
rem   생기면서** 비로소 따로 물을 곳이 생겼다 — 그때 나눴지 미리 나누지 않았다. 미리 나누면
rem   안 쓰는 표를 모든 바이너리가 지고 다닌다.
rem ☞ 여전히 안 나눈 것: Lt/Lm/Lo · Nl/No · P·Z·M 의 하위 범주. 물을 곳이 생기면 그때 나눈다.
rem upper — 646 구간.
export fn tab_upper output slice u8 . do
  return "" .
end .
rem lower — 658 구간.
export fn tab_lower output slice u8 . do
  return "" .
end .
rem digit — 64 구간.
export fn tab_digit output slice u8 . do
  return "" .
end .

rem ★ 대문자(Lu) · 소문자(Ll) · 십진 숫자(Nd).
rem   `is_digit` 는 `is_number` 보다 **좁다**: 로마 숫자(Ⅶ)나 분수(½)는 N 이지만 Nd 가 아니다.
rem   자릿수 계산을 하려면 Nd 여야 한다 — N 이면 값이 10 진 자릿수가 아닌 것이 섞인다.
export proc is_upper output bool . input cp u64 . effects none . do return has_cp tab_upper cp . end .
export proc is_lower output bool . input cp u64 . effects none . do return has_cp tab_lower cp . end .
export proc is_digit output bool . input cp u64 . effects none . do return has_cp tab_digit cp . end .

rem ── 나머지 세부 범주 (2026-07-26) ──
rem ★ 앞서와 같은 규칙으로 나눴다: **물을 곳이 생겨서**다(regex `\p{Lt}`·`\p{Lo}` …).
rem   이제 L 과 N 의 하위가 전부 있다 — L = Lu+Ll+Lt+Lm+Lo, N = Nd+Nl+No.
rem title — 10 구간.
export fn tab_title output slice u8 . do
  return "0001c50001c50001c80001c80001cb0001cb0001f20001f2001f88001f8f001f98001f9f001fa8001faf001fbc001fbc001fcc001fcc001ffc001ffc" .
end .
rem modifier — 71 구간.
export fn tab_modifier output slice u8 . do
  return "" .
end .
rem other_letter — 509 구간.
export fn tab_other_letter output slice u8 . do
  return "" .
end .
rem numletter — 12 구간.
export fn tab_numletter output slice u8 . do
  return "0016ee0016f000216000218200218500218800300700300700302100302900303800303a00a6e600a6ef01014001017401034101034101034a01034a0103d10103d501240001246e" .
end .
rem numother — 72 구간.
export fn tab_numother output slice u8 . do
  return "" .
end .

export proc is_title    output bool . input cp u64 . effects none . do return has_cp tab_title cp . end .
export proc is_modifier output bool . input cp u64 . effects none . do return has_cp tab_modifier cp . end .
export proc is_other_letter output bool . input cp u64 . effects none . do return has_cp tab_other_letter cp . end .
export proc is_numletter output bool . input cp u64 . effects none . do return has_cp tab_numletter cp . end .
export proc is_numother  output bool . input cp u64 . effects none . do return has_cp tab_numother cp . end .

rem ── 대소문자 변환 (2026-07-26) ──
rem
rem ★★★ **변환은 구간이 아니라 짝이다.** 범주는 "이 구간에 드는가" 를 묻지만 변환은 "이것이
rem   **어디로** 가는가" 다. 그래서 같은 고정폭이되 `<from6><to6>` 짝을 싣고, 앞자리로 이진 탐색한다.
rem
rem ★★ **1:1 만 싣는다 — 그리고 그 사실을 숨기지 않는다.** 독일어 ß(U+00DF)의 대문자는 "SS" 로
rem   **두 글자**다. 짝으로는 못 적는다. 그런 코드포인트를 조용히 "안 바뀜" 으로 두면 그것은
rem   **틀린 답**이므로, `is_special_case` 가 그 목록을 따로 답한다. 호출자는 물어볼 수 있고,
rem   안 물으면 적어도 **무엇을 놓쳤는지** 문서에 적혀 있다.
rem toupper — 1423 짝.
export fn tab_toupper output slice u8 . do
  return "" .
end .
rem tolower — 1432 짝.
export fn tab_tolower output slice u8 . do
  return "" .
end .
rem casespecial — 103 짝.
export fn tab_casespecial output slice u8 . do
  return "" .
end .

rem 짝 표에서 앞자리(from)로 찾아 뒷자리(to)를 준다. 없으면 none.
proc map_cp output option u64 . input tab slice u8 . input cp u64 . effects none . do
  var lo u64 be 0 .
  var hi u64 be range_count tab .
  while lt lo hi . do
    let mid u64 be add lo (div (sub hi lo) 2) .
    let f option u64 . be hex6_at tab (mul mid 12) .
    guard is_some f . else return none .
    if lt cp (some_value f) . do
      set hi mid .
    end .
    if ge cp (some_value f) . do
      if eq cp (some_value f) . do return hex6_at tab (add (mul mid 12) 6) . end .
      set lo (add mid 1) .
    end .
  end .
  return none .
end .

rem ★ 대문자로 / 소문자로. **바뀌지 않으면 그대로 돌려준다**(none 이 아니다 — 대부분의
rem   코드포인트는 대소문자가 없고, 그때 "없다" 를 답하면 호출자가 매번 풀어야 한다).
export proc to_upper output u64 . input cp u64 . effects none . do
  let m option u64 . be map_cp tab_toupper cp .
  guard is_some m . else return cp .
  return some_value m .
end .

export proc to_lower output u64 . input cp u64 . effects none . do
  let m option u64 . be map_cp tab_tolower cp .
  guard is_some m . else return cp .
  return some_value m .
end .

rem ★ 이 코드포인트는 **1:1 로 못 바꾸는가**(변환 결과가 두 글자 이상). ß·ﬁ 같은 것들이다.
rem   `to_upper` 는 이런 코드포인트를 **그대로** 돌려준다 — 그것이 틀린 답일 수 있으니 물어본다.
export proc is_special_case output bool . input cp u64 . effects none . do
  let m option u64 . be map_cp tab_casespecial cp .
  return is_some m .
end .
