rem ★★★ **열째 표준 라이브러리 — UTF-16** (RFC-0068 S6. 2026-07-20).
rem
rem ★★★ **S6 는 새 타입을 요구했지만, 리프 규칙이 그것을 기각한다.**
rem   S6 는 `u16str`/`u32str` 를 **언어 타입**으로 달라고 적었다. 그런데 재 보니
rem   **`slice u16`·`slice u32` 가 이미 완벽히 된다**(2026-07-20 실측: 읽기·쓰기·인덱싱 전부).
rem   ⇒ 리프 규칙(SPEC-002 부록 P)이 묻는 두 질문에 **둘 다 아니오**다:
rem       ① capability 가 필요한가 — 아니다. 순수 계산이다.
rem       ② 언어에 없는 표현이 필요한가 — **아니다. `slice u16` 이 곧 그 표현이다.**
rem     그리고 **편의는 자격이 아니다.** ⇒ **새 타입 0 · 새 키워드 0 · 빌트인 op 0.**
rem
rem ★★ **그래서 진짜 없던 것만 짓는다: 서로게이트 산술.** UTF-16 이 UTF-8 과 다른 점은
rem   **딱 하나** — BMP 밖(≥ U+10000)을 **짝(surrogate pair)** 으로 쪼갠다는 것이다.
rem   그 산술과 그 실패 방식이 이 파일의 전부다.
rem
rem ★★★ **거절하는 것들** — `lib/utf8.low` 과 **짝이 맞는다**:
rem     · 짝 없는 상위 서로게이트(D800–DBFF 뒤에 하위가 안 옴)   → none
rem     · 짝 없는 하위 서로게이트(DC00–DFFF 가 혼자 옴)          → none
rem     · 범위 밖 코드포인트(> U+10FFFF)                          → none
rem   ☞ `lib/utf8.low` 이 UTF-8 안의 서로게이트를 **거절**하므로, 서로게이트는 **오직
rem     UTF-16 안에서만, 오직 짝으로만** 존재한다. 두 라이브러리가 함께 그 불변을 지킨다.
rem
rem ☞ **안 지은 것(정직히)**: 정규화(NFC/NFD) · 대소문자 · 조합 문자 · UTF-16 **바이트 순서**
rem   (BOM·big/little — `slice u16` 은 이미 기계 순서다; 바이트로 오갈 일이 생기면 그때 답한다).
rem   ★ 그리고 **UTF-32 는 라이브러리가 필요 없다**: `slice u32` 의 한 칸이 곧 코드포인트다.
rem     검증만 필요하고, 그건 `cp_valid` 한 줄이다. **없는 일을 만들지 않는다.**

module utf16 .

rem ★ `link` — **C 가 부를 이름은 저자가 정한다**(RFC-0063). `utf8` 과 `utf16` 은 이 넷을
rem   겹치는데 C 의 이름공간은 평평하다. 도구는 이름을 **지어내지 않는다**(E-ABI-NAME-DUP) —
rem   C 심볼은 다른 언어에 하는 약속이고, 약속은 저자의 것이다. Lowent 안에서는 여전히
rem   `utf8.decode`·`utf16.decode` 이고, 겹치지 않는 이름들은 그대로 맨이름으로 나간다.

rem ── 경계 상수. 이름을 준다 — 숫자가 코드에 흩어지면 그것이 두 번째 표현이다 ──

export fn is_high input u u64 . output bool . do
  return and (ge u 55296) (le u 56319) .          rem D800–DBFF
end

export fn is_low input u u64 . output bool . do
  return and (ge u 56320) (le u 57343) .          rem DC00–DFFF
end

rem ★ 코드포인트로서 유효한가 — 서로게이트는 **코드포인트가 아니다**(UTF-16 의 부품일 뿐).
export fn cp_valid input c u64 . output bool . do
  if gt c 1114111 . do return false . end        rem > U+10FFFF . .
  if and (ge c 55296) (le c 57343) . do return false . end
  return true .
end

rem ── ① 한 코드포인트가 몇 칸을 먹는가 ──────────────────────────────────

rem ★ BMP 는 한 칸, 그 밖은 **두 칸**. 이것이 UTF-16 의 전부이자 UTF-8 과 다른 점이다.
export fn units input c u64 . output u64 . do
  if ge c 65536 . do return 2 . end
  return 1 .
end

rem ── ② 코드포인트 → UTF-16 칸 ─────────────────────────────────────────
rem
rem ★★ 시프트 op 이 없으므로 `div`/`mod` 1024 로 10 비트를 가른다(부호 없는 정수에서 같다).
rem   v = c - 0x10000 ;  hi = 0xD800 + v/1024 ;  lo = 0xDC00 + v%1024

rem 상위 칸(BMP 면 그 자체가 답이다).
export fn unit_hi input c u64 . output option u64 . do
  guard cp_valid c . else return none .
  if lt c 65536 . do return (some c) . end
  let v u64 be sub c 65536 .
  return (some (add 55296 (div v 1024))) .
end

rem 하위 칸 — BMP 면 **없다**. `none` 이 "칸이 하나뿐" 을 뜻한다.
export fn unit_lo input c u64 . output option u64 . do
  guard cp_valid c . else return none .
  if lt c 65536 . do return none . end
  let v u64 be sub c 65536 .
  return (some (add 56320 (mod v 1024))) .
end

rem ★ 실제로 써 넣는다. 자리가 모자라면 **한 칸도 안 쓴다**(전량-아니면-무 — lib/strbuf.low 규율).
rem   쓴 칸 수를 낸다; 못 쓰면 `none`.
rem ★★★★ **답은 "새 위치" 다 — 쓴 칸 수가 아니다** (2026-08-15, RFC-0075 §9.3.5).
rem   전에는 1 또는 2(쓴 칸 수)를 돌려줬다. 그런데 이 모듈의 `decode`·`next` 는 **위치 축**이라,
rem   둘을 함께 쓰는 코드가 `put` 의 답을 위치로 알고 더하지 않으면 **조용히 틀린다** —
rem   `prog/enc.low` 의 첫 판이 실제로 그렇게 틀렸다(글자 수가 1 로 나왔다).
rem   ☞ 같은 축을 두 뜻으로 답하지 않는다. 몇 칸 썼는지가 필요하면 `units c` 가 이미 답한다.
export proc put input dst mut slice u16 . . input at u64 . input c u64 .
  output option u64 . effects none .
do
  guard cp_valid c . else return none .
  let n u64 be units c .
  guard le (add at n) (len dst) . else return none .
  let h option u64 . be unit_hi c .
  guard is_some h . else return none .
  if eq n 1 . do
    set (index dst at) (some_value h) .
    return (some (add at 1)) .
  end
  let l option u64 . be unit_lo c .
  guard is_some l . else return none .
  set (index dst at) (some_value h) .
  set (index dst (add at 1)) (some_value l) .
  return (some (add at 2)) .
end

rem ── ③ UTF-16 칸 → 코드포인트 ─────────────────────────────────────────
rem
rem ★★★ **짝이 안 맞으면 거절한다.** 여기가 이 파일이 실제로 값을 하는 자리다 —
rem   짝 없는 서로게이트를 조용히 통과시키면 그 뒤의 모든 것이 틀린다.
export fn decode input s slice u16 . input at u64 . output option u64 . link "utf16_decode" . do
  guard lt at (len s) . else return none .
  let u u64 be index s at .
  if is_low u . do return none . end             rem 하위가 혼자 왔다 — 짝 없는 꼬리 . .
  if is_high u . do
    guard lt (add at 1) (len s) . else return none .   rem 잘렸다
    let v u64 be index s (add at 1) .
    guard is_low v . else return none .          rem 상위 뒤에 하위가 안 왔다
    return (some (add 65536 (add (mul (sub u 55296) 1024) (sub v 56320)))) .
  end
  return (some u) .                               rem 평범한 BMP 칸
end

rem 다음 코드포인트의 자리. 끝이거나 망가졌으면 `none`.
export fn next input s slice u16 . input at u64 . output option u64 . link "utf16_next" . do
  guard lt at (len s) . else return none .
  let c option u64 . be decode s at .
  guard is_some c . else return none .
  let u u64 be index s at .
  if is_high u . do return (some (add at 2)) . end
  return (some (add at 1)) .
end

rem ── ④ 전체를 훑는다 ──────────────────────────────────────────────────

export fn count_chars input s slice u16 . output option u64 . link "utf16_count_chars" . do
  var n u64 be 0 .
  var i u64 be 0 .
  while lt i (len s) . do
    let nx option u64 . be next s i .
    guard is_some nx . else return none .        rem 망가진 자리를 만나면 **수를 안 낸다**
    set i (some_value nx) .
    set n (add n 1) .
  end
  return (some n) .
end

export fn is_valid input s slice u16 . output bool . link "utf16_is_valid" . do
  return is_some (count_chars s) .
end
