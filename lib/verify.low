rem ★★★★★ **인증서의 서명을 확인한다** (백로그 X-0032 P3)
rem
rem   [x509](x509) 가 인증서를 **읽어** 주고, 이 모듈이 그 위에서 **한 장이 다른 한 장에게
rem   서명받았는가**를 답한다. 체인을 잇는 판단·유효기간·이름 대조는 부르는 쪽이 이 op 을
rem   되풀이해 짓는다.
rem
rem ★★ **서명 알고리즘을 이름으로 가른다.** 인증서가 스스로 적은 OID 를 보고 고르되, 우리가
rem   검증할 수 있는 넷만 받는다: `sha256WithRSAEncryption`(1.2.840.113549.1.1.11) ·
rem   `sha384WithRSAEncryption`(…1.1.12) · `ecdsa-with-SHA256`(1.2.840.10045.4.3.2) ·
rem   `ecdsa-with-SHA384`(…4.3.3). 곡선은 **공개키 길이**가 가른다(65 = P-256 · 97 = P-384).
rem   모르는 알고리즘은 **거절**한다 — 모르는 것을 통과시키면 그때부터 이 함수의 답은
rem   «확인했다» 가 아니라 «못 알아봤다» 가 된다.
rem
rem ☞ 안 지은 것: SHA-512 계열 · RSA-PSS 서명 인증서 · Ed25519 인증서 · P-521 · 폐기.
rem   그 인증서를 만나면 **거절한다**(조용히 지나가지 않는다).

module verify .

use x509 from "x509.low" .
use der from "der.low" .
use rsa from "rsa.low" .
use p256 from "p256.low" .
use p384 from "p384.low" .
use bigint from "bigint.low" .

rem ── 알고리즘 이름 ────────────────────────────────────────────────────────
rem 1 = RSA v1.5 + SHA-256 · 2 = ECDSA + SHA-256 · 3 = RSA v1.5 + SHA-384 ·
rem 4 = ECDSA + SHA-384 · 0 = 우리가 모른다
rem ☞ SHA-384 은 2026-09-18 에 들어왔다(소유자 결정 — 빌트인 `sha384`). 그전에는 진짜 체인의
rem   중간 마디를 **거절만** 했다: 안 지은 것을 지은 척하지 않는 쪽이었고, 이제 지었다.
export fn sig_kind input c slice u8 . output u64 . do
  let o u64 be x509.sigalg_oid_off c .
  let n u64 be x509.sigalg_oid_len c .
  if eq o 0 . do  return 0 . end .
  if eq n 9 . do
    rem 2a 86 48 86 f7 0d 01 01 <0b=SHA-256 · 0c=SHA-384>
    if eq (index c o) 42 . do
      if eq (index c (add o 3)) 134 . do
        if eq (index c (add o 8)) 11 . do  return 1 . end .
        if eq (index c (add o 8)) 12 . do  return 3 . end .
      end .
    end .
  end .
  if eq n 8 . do
    rem 2a 86 48 ce 3d 04 03 <02=SHA-256 · 03=SHA-384>
    if eq (index c o) 42 . do
      if eq (index c (add o 3)) 206 . do
        if eq (index c (add o 7)) 2 . do  return 2 . end .
        if eq (index c (add o 7)) 3 . do  return 4 . end .
      end .
    end .
  end .
  return 0 .
end .

rem ── ECDSA 서명은 DER 이다: SEQUENCE { r INTEGER, s INTEGER } ─────────────
rem ★ INTEGER 는 **앞에 0 이 붙을 수 있고**(최상위 비트가 1 이면 붙는다) 짧을 수도 있다.
rem   그래서 32 바이트 자리에 **오른쪽 맞춤**으로 옮긴다 — 그냥 베끼면 한 바이트 밀린 값으로
rem   검증하게 되고, 그것은 언제나 «서명이 틀렸다» 로만 보인다.
export proc ecdsa_rs input sig slice u8 . input out mut slice u8 . input sz u64 . output u64 . effects none . do
  rem ★ `sz` 는 **곡선의 크기**다(P-256 은 32 · P-384 은 48). 값이 아니라 자리를 정한다.
  guard gt sz 0 . else return 0 .
  guard ge (len out) (mul sz 2) . else return 0 .
  guard gt (len sig) 8 . else return 0 .
  guard eq (der.tag_at sig 0) 48 . else return 0 .
  var i u64 be 0 .
  while lt i (mul sz 2) . do  set (index out i) 0 .  set i (add i 1) .  end .
  let ro u64 be der.value_off sig 0 .
  guard gt ro 0 . else return 0 .
  guard eq (der.tag_at sig ro) 2 . else return 0 .
  let rv u64 be der.value_off sig ro .
  let rl u64 be der.value_len sig ro .
  guard gt rv 0 . else return 0 .
  let so u64 be der.next_off sig ro .
  guard gt so 0 . else return 0 .
  guard eq (der.tag_at sig so) 2 . else return 0 .
  let sv u64 be der.value_off sig so .
  let sl u64 be der.value_len sig so .
  guard gt sv 0 . else return 0 .
  rem 앞의 0 을 떼고, 곡선 크기를 넘으면 이 곡선의 값이 아니다.
  var rs2 u64 be rv .
  var rn2 u64 be rl .
  while gt rn2 sz . do
    guard eq (index sig rs2) 0 . else return 0 .
    set rs2 (add rs2 1) .
    set rn2 (sub rn2 1) .
  end .
  var ss2 u64 be sv .
  var sn2 u64 be sl .
  while gt sn2 sz . do
    guard eq (index sig ss2) 0 . else return 0 .
    set ss2 (add ss2 1) .
    set sn2 (sub sn2 1) .
  end .
  var a u64 be 0 .
  while lt a rn2 . do
    set (index out (add (sub sz rn2) a)) (index sig (add rs2 a)) .
    set a (add a 1) .
  end .
  var b u64 be 0 .
  while lt b sn2 . do
    set (index out (add (add sz (sub sz sn2)) b)) (index sig (add ss2 b)) .
    set b (add b 1) .
  end .
  return mul sz 2 .
end .

rem ── P-256 의 상수 ────────────────────────────────────────────────────────
rem   p · n · Gx · Gy 를 16 조각씩. 한 자리에만 적는다.
fn hexd input c u64 . output u64 . do
  if lt c 58 . do  return sub c 48 . end .
  return sub c 87 .
end .
proc limbs_of input h slice u8 . input out mut slice u64 . input w mut slice u8 . output u64 . effects none . do
  guard eq (len h) 64 . else return 0 .
  guard ge (len w) 32 . else return 0 .
  var i u64 be 0 .
  while lt i 32 . do
    set (index w i) (narrow u8 (add (mul (hexd (cast u64 (index h (mul i 2)))) 16)
                                    (hexd (cast u64 (index h (add (mul i 2) 1)))))) .
    set i (add i 1) .
  end .
  return bigint.from_bytes (subslice w 0 32) out 16 .
end .
export proc curve input cw mut slice u64 . input w mut slice u8 . output u64 . effects none . do
  guard ge (len cw) 64 . else return 0 .
  guard eq (limbs_of "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff" (subslice cw 0 16) w) 16 . else return 0 .
  guard eq (limbs_of "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551" (subslice cw 16 32) w) 16 . else return 0 .
  guard eq (limbs_of "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296" (subslice cw 32 48) w) 16 . else return 0 .
  guard eq (limbs_of "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5" (subslice cw 48 64) w) 16 . else return 0 .
  return 1 .
end .

rem ── P-384 의 상수 ────────────────────────────────────────────────────────
rem   p · n · Gx · Gy 를 24 조각씩(FIPS 186-4 D.1.2.4). 한 자리에만 적는다.
proc limbs_of96 input h slice u8 . input out mut slice u64 . input w mut slice u8 . output u64 . effects none . do
  guard eq (len h) 96 . else return 0 .
  guard ge (len w) 48 . else return 0 .
  var i u64 be 0 .
  while lt i 48 . do
    set (index w i) (narrow u8 (add (mul (hexd (cast u64 (index h (mul i 2)))) 16)
                                    (hexd (cast u64 (index h (add (mul i 2) 1)))))) .
    set i (add i 1) .
  end .
  return bigint.from_bytes (subslice w 0 48) out 24 .
end .
export proc curve384 input cw mut slice u64 . input w mut slice u8 . output u64 . effects none . do
  guard ge (len cw) 96 . else return 0 .
  guard eq (limbs_of96 "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff" (subslice cw 0 24) w) 24 . else return 0 .
  guard eq (limbs_of96 "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973" (subslice cw 24 48) w) 24 . else return 0 .
  guard eq (limbs_of96 "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7" (subslice cw 48 72) w) 24 . else return 0 .
  guard eq (limbs_of96 "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f" (subslice cw 72 96) w) 24 . else return 0 .
  return 1 .
end .

rem ★★★ **ECDSA P-384 갈래** — `signed_by` 에서 갈라져 나온 자리.
rem
rem   자리를 따로 둔 까닭은 **수가 다르기 때문**이다: 조각 24 · 서명 96 바이트 ·
rem   일터 1364 조각. 한 함수 안에서 두 곡선의 자리를 같이 세면 읽는 이가 매번 어느
rem   곡선의 수인지 되짚어야 한다.
rem
rem ★ 해시는 **왼쪽에서 곡선 크기만큼** 쓴다(SEC1 §4.1.4). SHA-384 은 48 바이트라 그대로고,
rem   SHA-256 으로 서명한 P-384 키라면 32 바이트를 **오른쪽에 맞춰** 48 자리에 넣는다 —
rem   그것이 그 해시가 나타내는 수다. 왼쪽에 붙이면 2^128 배가 된 수를 검증하게 된다.
rem
rem   wu 는 1600 조각 이상: 곡선 96 · r·s·e·키 120 · 일터 1364.
proc ec384 input c slice u8 . input so u64 . input sl u64 . input issuer slice u8 . input ko u64 .
     input mh slice u8 . input hn u64 . input wb mut slice u8 . input wu mut slice u64 . output u64 . effects none .
do
  guard ge (len wu) 1600 . else return 0 .
  guard ge (len wb) 256 . else return 0 .
  guard eq (index issuer ko) 4 . else return 0 .
  guard eq (ecdsa_rs (subslice c so (add so sl)) (subslice wb 64 160) 48) 96 . else return 0 .
  rem e ← 해시를 48 바이트 자리에 오른쪽 맞춤으로.
  var i u64 be 0 .
  while lt i 48 . do  set (index wb (add 160 i)) 0 .  set i (add i 1) .  end .
  let hb u64 be hn .
  guard le hb 48 . else return 0 .
  var j u64 be 0 .
  while lt j hb . do
    set (index wb (add (add 160 (sub 48 hb)) j)) (index mh j) .
    set j (add j 1) .
  end .
  guard eq (curve384 (subslice wu 0 96) (subslice wb 208 256)) 1 . else return 0 .
  guard eq (bigint.from_bytes (subslice wb 64 112) (subslice wu 96 120) 24) 24 . else return 0 .
  guard eq (bigint.from_bytes (subslice wb 112 160) (subslice wu 120 144) 24) 24 . else return 0 .
  guard eq (bigint.from_bytes (subslice wb 160 208) (subslice wu 144 168) 24) 24 . else return 0 .
  guard eq (bigint.from_bytes (subslice issuer (add ko 1) (add ko 49)) (subslice wu 168 192) 24) 24 . else return 0 .
  guard eq (bigint.from_bytes (subslice issuer (add ko 49) (add ko 97)) (subslice wu 192 216) 24) 24 . else return 0 .
  return p384.ecdsa_ok (subslice wu 96 120) (subslice wu 120 144) (subslice wu 144 168)
                           (subslice wu 168 216)
                           (subslice wu 0 24) (subslice wu 24 48)
                           (subslice wu 48 72) (subslice wu 72 96)
                           (subslice wu 216 1580) .
end .

rem ★★★★★ **한 장이 다른 한 장에게 서명받았는가.** 1 = 그렇다 · 0 = 아니다(또는 못 알아본다).
rem
rem   wb: 바이트 작업 공간 1024 이상 · wu: 조각 작업 공간 2200 이상.
rem ☞ 서명은 **원본 바이트** 위에서 확인한다 — `tbs_off`..`tbs_end` 를 그대로 해시한다.
rem   베낀 자리에서 하면 언젠가 베끼기가 틀려도 서명이 맞는 것처럼 보인다.
export proc signed_by input c slice u8 . input issuer slice u8 .
     input wb mut slice u8 . input wu mut slice u64 . output u64 . effects none .
do
  guard ge (len wb) 1024 . else return 0 .
  rem ★ 실제로 쓰는 만큼만 요구한다: RSA 는 (k+4)×7 ≤ 1820(4096 비트), P-256 은 곡선 64 +
  rem   r·s·e·키 80 + 일터 924 = 1068. 넉넉함은 공짜가 아니다 — 아레나에서는 그 넉넉함이 곧
  rem   다른 자리를 못 쓰게 만든다.
  rem   ☞ **P-384 는 1600 을 따로 요구한다**(`ec384` 가 그 자리에서 막는다) — 여기서 한꺼번에
  rem     1600 을 요구하면 P-384 를 안 쓰는 부르는 쪽까지 그만큼 내놓아야 한다.
  guard ge (len wu) 1100 . else return 0 .
  let kind u64 be sig_kind c .
  guard gt kind 0 . else return 0 .

  let tb u64 be x509.tbs_off c .
  let te u64 be x509.tbs_end c .
  guard gt tb 0 . else return 0 .
  guard gt te tb . else return 0 .
  rem ★ 해시는 서명 알고리즘이 고른다 — 그것이 OID 가 말하는 절반이다.
  var hn u64 be 32 .
  if lt kind 3 . do
    guard eq (sha256 (subslice c tb te) (subslice wb 0 32)) 32 . else return 0 .
  end .
  if ge kind 3 . do
    guard eq (sha384 (subslice c tb te) (subslice wb 0 48)) 48 . else return 0 .
    set hn 48 .
  end .

  let so u64 be x509.sig_off c .
  let sl u64 be x509.sig_len c .
  guard gt so 0 . else return 0 .
  guard gt sl 0 . else return 0 .

  let sp u64 be x509.spki_off issuer .
  guard gt sp 0 . else return 0 .
  let ko u64 be der.spki_key_off issuer sp .
  guard gt ko 0 . else return 0 .

  if lt kind 3 . do  set kind kind . end .
  if eq (mod kind 2) 1 . do
    let no u64 be der.rsa_n_off issuer ko .
    let nl u64 be der.rsa_n_len issuer ko .
    let e  u64 be der.rsa_e issuer ko .
    guard gt no 0 . else return 0 .
    guard gt nl 0 . else return 0 .
    guard gt e 0 . else return 0 .
    guard eq sl nl . else return 0 .
    guard le nl 512 . else return 0 .
    rem ★★★ **조각은 k 가 아니라 k+4 여야 한다.** 몽고메리 곱이 자리를 더 쓴다 —
    rem   정확히 k 를 주면 `mod_exp` 가 0 을 답하고, 그것은 «서명이 틀렸다» 와 **같은 얼굴**로
    rem   나온다. 그래서 진짜 인증서 넷이 모두 거절됐다(2026-09-18 실측). `lockbox` 가 이미
    rem   `need = k + 4` 로 쓰고 있었고, 나는 그 수를 안 보고 새로 지었다.
    let k u64 be shr nl 1 .
    let need u64 be add k 4 .
    guard ge (len wu) (mul need 7) . else return 0 .
    rem DigestInfo 의 머리 — 해시마다 다르다.
    var di slice u8 be "\x30\x31\x30\x0d\x06\x09\x60\x86\x48\x01\x65\x03\x04\x02\x01\x05\x00\x04\x20" .
    if eq hn 48 . do
      set di "\x30\x41\x30\x0d\x06\x09\x60\x86\x48\x01\x65\x03\x04\x02\x02\x05\x00\x04\x30" .
    end .
    return rsa.verify_pkcs1 (subslice c so (add so sl)) (subslice issuer no (add no nl)) e (subslice wb 0 hn)
             di (subslice wb 64 576)
             (subslice wu 0 need) (subslice wu need (mul need 2)) (subslice wu (mul need 2) (mul need 3))
             (subslice wu (mul need 3) (mul need 4)) (subslice wu (mul need 4) (mul need 5))
             (subslice wu (mul need 5) (mul need 6)) (subslice wu (mul need 6) (mul need 7)) .
  end .

  rem ECDSA P-256 — 공개키는 04‖X‖Y 예순다섯 바이트다(압축은 안 받는다).
  rem ★ `key_len` 은 **SPKI 자리**를 받고 `rsa_n_off` 는 **키 자리**를 받는다 — 둘을 바꿔
  rem   넣었다가 모든 ECDSA 인증서를 거절했다(2026-09-18). 같은 모듈의 이웃 두 얼굴이 서로
  rem   다른 자리를 받는 것은 읽는 사람이 매번 확인해야 하는 모양이다 — [der](der) 쪽에
  rem   물어볼 자리로 적어 둔다.
  let kl u64 be der.spki_key_len issuer sp .
  rem ★★ 곡선은 **공개키의 길이**가 말한다 — 04‖X‖Y 이므로 65 = P-256 · 97 = P-384.
  rem   ☞ 인증서는 곡선 OID 도 적어 두지만, 우리가 실제로 쓰는 것은 이 바이트들이다.
  rem     길이와 OID 가 어긋난 인증서라면 **어느 쪽을 믿어도 서명이 맞지 않는다.**
  if eq kl 97 . do
    return ec384 c so sl issuer ko (subslice wb 0 hn) hn wb wu .
  end .
  guard eq kl 65 . else return 0 .
  guard eq (index issuer ko) 4 . else return 0 .
  guard eq (ecdsa_rs (subslice c so (add so sl)) (subslice wb 64 128) 32) 64 . else return 0 .
  guard eq (curve (subslice wu 0 64) (subslice wb 128 256)) 1 . else return 0 .
  guard eq (bigint.from_bytes (subslice wb 64 96) (subslice wu 64 80) 16) 16 . else return 0 .
  guard eq (bigint.from_bytes (subslice wb 96 128) (subslice wu 80 96) 16) 16 . else return 0 .
  rem ★★ ECDSA 는 해시를 **곡선의 크기만큼 왼쪽에서** 잘라 쓴다(RFC 6979 §2.3.2 · SEC1 §4.1.4).
  rem   P-256 에 SHA-384 을 쓰면 48 바이트 가운데 **앞 32**만 쓴다 — 뒤를 쓰거나 전체를 넣으면
  rem   서명이 언제나 틀린 것처럼 보인다(그리고 그 실패는 「서명 오류」로만 나온다).
  guard eq (bigint.from_bytes (subslice wb 0 32) (subslice wu 96 112) 16) 16 . else return 0 .
  guard eq (bigint.from_bytes (subslice issuer (add ko 1) (add ko 33)) (subslice wu 112 128) 16) 16 . else return 0 .
  guard eq (bigint.from_bytes (subslice issuer (add ko 33) (add ko 65)) (subslice wu 128 144) 16) 16 . else return 0 .
  return p256.ecdsa_verify (subslice wu 64 80) (subslice wu 80 96) (subslice wu 96 112)
                           (subslice wu 112 144)
                           (subslice wu 0 16) (subslice wu 16 32)
                           (subslice wu 32 48) (subslice wu 48 64)
                           (subslice wu 144 1068) .
end .

rem ── 체인을 잇는 판단 ────────────────────────────────────────────────────

rem ★ 두 이름이 **바이트로** 같은가. 이름을 `dn_eq` 로 지은 까닭: `name_eq` 는 [http](http) 가
rem   이미 쓰고 있었고, 이름공간이 평평한 이 언어에서 그것은 곧 부딪치는 이름이다
rem   (`check-export-names` 가 그 자리에서 말했다, 2026-09-18). DN 은 Distinguished Name 이다. DER 은 한 이름에 한 바이트열이므로 그것이 옳다.
rem   ☞ 문자열로 풀어 견주면 대소문자·인코딩·공백 규칙이 끼어들고, 그 규칙마다 «같다» 의
rem     뜻이 조금씩 달라진다. 여기서는 그 물음을 아예 만들지 않는다.
export fn dn_eq input a slice u8 . input ao u64 . input b slice u8 . input bo u64 . output bool . do
  if eq ao 0 . do  return false . end .
  if eq bo 0 . do  return false . end .
  let al u64 be x509.elem_len a ao .
  let bl u64 be x509.elem_len b bo .
  if eq al 0 . do  return false . end .
  if ne al bl . do  return false . end .
  if gt (add ao al) (len a) . do  return false . end .
  if gt (add bo bl) (len b) . do  return false . end .
  var i u64 be 0 .
  var diff u64 be 0 .
  while lt i al . do
    set diff (bit_or diff (bit_xor (cast u64 (index a (add ao i))) (cast u64 (index b (add bo i))))) .
    set i (add i 1) .
  end .
  return eq diff 0 .
end .

rem ★ 유효기간이 지금을 담는가. `now` 는 YYYYMMDDhhmmss 한 수다.
export fn dates_ok input c slice u8 . input now u64 . output bool . do
  let nb u64 be x509.not_before c .
  let na u64 be x509.not_after c .
  if eq nb 0 . do  return false . end .
  if eq na 0 . do  return false . end .
  if lt now nb . do  return false . end .
  if gt now na . do  return false . end .
  return true .
end .

rem ★★ 한 이름이 SAN 의 한 칸과 맞는가 — 와일드카드는 **맨 앞 한 마디**만 받는다.
rem   `*.a.b` 는 `x.a.b` 와 맞고 `a.b` 나 `y.x.a.b` 와는 맞지 않는다(RFC 6125 §6.4.3).
rem   ☞ 대소문자는 아스키로만 내린다 — 이름에 아스키 밖이 오면 그것은 A-라벨이어야 하고,
rem     A-라벨은 이미 아스키다.
fn lower input c u64 . output u64 . do
  if lt c 65 . do  return c . end .
  if gt c 90 . do  return c . end .
  return add c 32 .
end .
fn label_eq input pat slice u8 . input po u64 . input pn u64 . input h slice u8 . input ho u64 . input hn u64 . output bool . do
  if ne pn hn . do  return false . end .
  var i u64 be 0 .
  while lt i pn . do
    if ne (lower (cast u64 (index pat (add po i)))) (lower (cast u64 (index h (add ho i)))) . do  return false . end .
    set i (add i 1) .
  end .
  return true .
end .
export fn san_matches input c slice u8 . input so u64 . input host slice u8 . output bool . do
  let vo u64 be der.value_off c so .
  let vl u64 be der.value_len c so .
  if eq vo 0 . do  return false . end .
  if eq vl 0 . do  return false . end .
  if eq (len host) 0 . do  return false . end .
  rem 와일드카드가 아니면 통째로 견준다.
  if ne (index c vo) 42 . do
    return label_eq c vo vl host 0 (len host) .
  end .
  rem `*` 다음은 반드시 `.` 이어야 한다.
  if lt vl 3 . do  return false . end .
  if ne (index c (add vo 1)) 46 . do  return false . end .
  rem 호스트의 첫 `.` 뒤가 패턴의 `.` 뒤와 같아야 하고, 첫 마디는 비어 있지 않아야 한다.
  var d u64 be 0 .
  var seen u64 be 0 .
  while lt d (len host) . do
    if eq (index host d) 46 . do
      if eq seen 0 . do  set seen (add d 1) . end .
    end .
    set d (add d 1) .
  end .
  if eq seen 0 . do  return false . end .
  if eq seen 1 . do  return false . end .
  return label_eq c (add vo 2) (sub vl 2) host seen (sub (len host) seen) .
end .
export fn host_ok input c slice u8 . input host slice u8 . output bool . do
  var s u64 be x509.san_next c 0 .
  var steps u64 be 0 .
  while gt s 0 . do
    if san_matches c s host . do  return true . end .
    set s (x509.san_next c s) .
    set steps (add steps 1) .
    if gt steps 128 . do  return false . end .
  end .
  return false .
end .

rem ★★★★★ **한 마디를 잇는다**: child 가 parent 에게 서명받았고, parent 가 남을 발급할 수
rem   있으며, 이름이 이어지고, 둘 다 기간 안에 있는가.
rem   1 = 잇는다 · 그 밖 = 거절한 까닭(2 이름 · 3 CA 아님 · 4 기간 · 5 서명)
export proc link_ok input child slice u8 . input parent slice u8 . input now u64 .
     input wb mut slice u8 . input wu mut slice u64 . output u64 . effects none .
do
  if eq (dn_eq child (x509.issuer_off child) parent (x509.subject_off parent)) false . do  return 2 . end .
  if eq (x509.is_ca parent) false . do  return 3 . end .
  if eq (dates_ok child now) false . do  return 4 . end .
  if eq (dates_ok parent now) false . do  return 4 . end .
  if eq (signed_by child parent wb wu) 1 . do  return 1 . end .
  return 5 .
end .
