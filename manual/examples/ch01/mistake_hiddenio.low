module mistake_hiddenio .
rem expect: E-EFFECT-CALC

rem ko: ✘ fn 이라고 적고서 몰래 화면에 쓰려 한다 /// en: ✘ declared as fn, yet it tries to write to the screen on the quiet
fn area_loud input out cap io . input w u64 . input h u64 . output u64 .
  requires le w 1000 .
  requires le h 1000 .
do
  let n be u64 write_out out 1 "computing\n" .
  return mul w h .
end
