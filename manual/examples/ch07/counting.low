module counting .
rem run: tally 4

rem ko: 수를 세는 `for` --- `count` 는 끝을 빼고, `range` 는 두 끝을 넣는다 /// en: a counting `for` --- `count` leaves out the end, `range` includes both ends
export fn tally input n u64 . output u64 .
do
  var s be u64 0 .
  for i count u64 n . do
    set s (add s i) .
  end
  for j range u64 10 1 step -3 . do
    set s (add (mul s 100) j) .
  end
  return s .
end
