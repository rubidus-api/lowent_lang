module compt_names .
rem run: page_bytes
rem run: lanes_twice

rem ko: 모듈 상수는 `comptime` 식으로 적을 수 있다 /// en: a module constant can be written as a `comptime` expression
let KIB u64 1024 .
let PAGE u64 comptime mul 4 KIB. . . .

fn page_bytes output u64 .
do
  let extra u64 4 .
  rem ko: 상수 · 값이 번역 시점에 나온 `let` 을 읽는다 /// en: reads a constant and a `let` whose value is known at compile time
  return comptime add PAGE. extra. . . .
end .

fn lanes_twice output usize .
do
  rem ko: 대상에게 묻는 값도 셈에 쓴다 /// en: a value asked of the target takes part too
  return comptime mul native_lanes u32 . 2 . . .
end .
