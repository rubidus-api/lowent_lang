module mistake_viewro .
rem expect: E-TYPE-MUT

struct pt do
  x u8 .
  y u8 .
end .

fn mark input b slice u8 . output u8 . do
  rem ko: ✘ 읽기 전용으로 받은 바이트에서 쓰기 창(mut view)을 묶는다 --- 칸에 쓰면 부른 쪽의 b 가 바뀐다 /// en: ✘ a write window (mut view) over bytes received read-only --- a field write would change the caller's b
  let h mut view pt view pt b. . .
  set field h. y . 9 .
  return 0 .
end .
