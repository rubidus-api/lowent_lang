module escape .
rem expect: E-REGION-ESCAPE

proc leak output u64 . effects alloc .
do
  var keep be mut slice u8 subslice "abcd" 0 0 .
  region r arena do
    let g be option mut slice u8 alloc_bytes r capacity 16 .
    if is_some g . do
      set keep (some_value g) .
    end
  end
  return len keep .
end
