module mistake_outlives .
rem expect: E-ALLOC-OUTLIVES

use allocs .

proc carve_inside output u64 . effects alloc state .
do
  var a be allocs.bump_bytes spawn actor allocs.bump_bytes .
  region r arena do
    let g be option mut slice u8 alloc_bytes r capacity 16 .
    if is_some g . do
      rem ko: ✘ 영역 밖에서 태어난 액터에게 영역의 바이트를 건넨다 /// en: ✘ handing region bytes to an actor born outside the region
      let c be u64 send a init (some_value g) .
    end
  end
  return 0 .
end
