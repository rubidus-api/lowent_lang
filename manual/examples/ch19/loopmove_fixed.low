module loopmove_fixed .
rem run: three_times 5

def type buffer u8 .

fn consume input h owned buffer . output u8 .
do
  drop h. .
  return 1 .
end .

fn three_times input v u8 . output u8 .
do
  var h owned buffer v. .
  var n u8 0 .
  var i u64 0 .
  while lt i. 3 . do
    set n. add n. consume h. . . .
    rem ko: 넘긴 자리를 새 값으로 다시 채운다 --- 바퀴가 시작할 때와 같은 모양으로 끝난다 /// en: refill the moved place with a new value --- the round ends in the same shape it began
    set h. v. .
    set i. add i. 1 . .
  end .
  drop h. .
  return n. .
end .
