module mistake_novia .
rem expect: E-EFFECT

use allocs .

proc one_from
  input comptime a type .
  using al a .
  output u64 .
  rem ko: ✘ `via a` 가 없다 --- 할당기가 내는 `alloc` 이 이 op 의 선언에 들어오지 않는다 /// en: ✘ no `via a` --- the `alloc` the allocator performs is not part of this op's declaration
  effects state .
  requires allocs.byte_allocator a. . .
do
  let p option mut slice u8 send al. reserve 3 . .
  guard is_some p. . else return 91 . .
  return send al. used . .
end .

proc with_fixed input al cap allocator . output u64 . effects alloc state .
do
  var fb allocs.fixed_bytes spawn actor allocs.fixed_bytes . .
  let n use fb. u64 one_from. .
  return n. .
end .
