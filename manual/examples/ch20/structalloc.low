module structalloc .
rem run: place 5

use allocs .

def struct pt do
  x u32 .
  y u64 .
end .

rem ko: 구조체도 할당기가 준 바이트에 짓는다 --- 바이트 배치가 있는 구조체만 /// en: a struct can be built in an allocator's bytes too --- only a struct with a byte layout
export proc place input a u64 . output u64 . effects state .
do
  var back lit array u8 64 _ . .
  var bb allocs.bump_bytes spawn actor allocs.bump_bytes . .
  let got u64 send bb. init back. . .
  var q use bb. pt lit pt do x 7 . y a. . end . else return 0 . .
  set field q. y . add field q. y . 1 . .
  return add widen u64 field q. x . . mul send bb. used . 100 . . .
end .
