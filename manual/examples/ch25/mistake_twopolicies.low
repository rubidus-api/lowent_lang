module mistake_twopolicies .
rem expect: E-ACTOR-FAILURE

actor worker do
  state do
    n u64 .
  end .
  rem ko: ✘ 실패 정책이 둘이다 /// en: ✘ two failure policies
  failure restart max 3 .
  failure restart never .
  proc tick output u64 . effects state .
  do
    set n. add n. 1 . .
    return n. .
  end .
end .
