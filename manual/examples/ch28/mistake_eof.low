module mistake_eof .
rem trap: main

use files .

proc main input out cap io . input fs cap file_system . input al cap allocator .
  output u8 .
  effects io alloc .
do
  let g be option mut slice u8 alloc_bytes al capacity 64 .
  guard is_some g . else return 1 .
  let buf be mut slice u8 some_value g .
  let o be result files.handle files.file_error files.open fs "notes.txt" 0 .
  guard is_ok o . else return 2 .
  var h be owned files.handle ok_value o .
  var total be u64 0 .
  var i be u64 0 .
  while lt i 3 . do
    let r be result (option u64) files.file_error files.read fs h buf .
    guard is_ok r . else return 3 .
    rem ko: ✘ 실패만 물었다 --- 파일 끝의 `ok none` 에서 `some_value` 가 멈춘다 /// en: ✘ only failure is checked --- `some_value` stops at the end-of-file `ok none`
    set total (add total (some_value (ok_value r))) .
    set i (add i 1) .
  end
  let c be result void files.file_error files.close fs h .
  drop c .
  return narrow u8 total .
end
