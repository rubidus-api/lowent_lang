module bound_stages .
rem run: direct [1,2,3]
rem run: stored [1,2,3]
rem run: capacity [1,2,3,4] 3
rem run: grid [1,2,3,4] 2
rem proof

rem ko: 1 --- 반복 조건이 len 을 직접 본다 /// en: 1 --- the loop condition looks at len directly
fn direct input s slice u8 . output u64 . do
  var t be u64 0 .
  var i be u64 0 .
  while lt i (len s) . do
    set t (wrap_add t (widen u64 (idx s i))) .
    set i (add i 1) .
  end
  return t .
end

rem ko: 2 --- 길이를 지역에 담았다 /// en: 2 --- the length is stored in a local
fn stored input s slice u8 . output u64 . do
  let n be u64 len s .
  var t be u64 0 .
  var i be u64 0 .
  while lt i n . do
    set t (wrap_add t (widen u64 (idx s i))) .
    set i (add i 1) .
  end
  return t .
end

rem ko: 3 --- 계약이 용량을 말한다 /// en: 3 --- a contract states the capacity
fn capacity input s slice u8 . input cap u64 . output u64 .
  requires ge (len s) cap .
do
  var t be u64 0 .
  var j be u64 0 .
  while lt j cap . do
    set t (wrap_add t (widen u64 (idx s j))) .
    set j (add j 1) .
  end
  return t .
end

rem ko: 4 --- 행우선 주소 i·n + k /// en: 4 --- row-major address i·n + k
fn grid input a slice u8 . input n u64 . output u64 .
  requires le n 1000 .
  requires ge (len a) (mul n n) .
do
  var t be u64 0 .
  var i be u64 0 .
  while lt i n . do
    var k be u64 0 .
    while lt k n . do
      set t (wrap_add t (widen u64 (idx a (add (mul i n) k)))) .
      set k (add k 1) .
    end
    set i (add i 1) .
  end
  return t .
end
