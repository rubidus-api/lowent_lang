module loop_stale .
rem expect: E-EXCL

fn drift input n u64 . output u64 .
  requires le n 100 .
do
  var x be u64 1 .
  let r be ref u64 ref x .
  var i be u64 0 .
  var seen be u64 0 .
  while lt i n . do
    set x (add x 1) .
    set seen (deref r) .
    set i (add i 1) .
  end
  return seen .
end
