// ── 조판 값의 단일 출처 (RFC-0027, 저자 지시 2026-08-10) ─────────────
//
// 이 파일에는 *디자인만* 있다. 본문도, 장치의 논리도 없다.
// 반대로 lib.typ 과 main.typ 에는 숫자를 적지 않는다 --- 여기서 가져다 쓴다.
//
// ★ 왜 가르는가
//   디자인을 고칠 때는 본문을 시험할 까닭이 없고, 본문을 고칠 때는 디자인을
//   시험할 까닭이 없다. 그런데 값이 두 파일에 흩어져 있으면 무엇을 건드렸는지
//   알 수 없어 매번 787쪽을 다시 찍게 된다. 값을 한자리에 모으면
//   `scripts/style-preview.sh` 가 만드는 *한 쪽짜리 견본*으로 확인이 끝난다.
//
// ★ 값을 고치는 절차
//   1. 이 파일만 고친다.
//   2. `scripts/style-preview.sh` --- 몇 초. 견본으로 눈으로 본다.
//   3. 마음에 들면 그때 전체 빌드.

// ── 시험 중인 값 (저자 지시 2026-08-10) ─────────────────────────
// ★ 「본문은 건드리지 말고 견본에서만 바꿔 보라」는 지시를 따르는 장치다.
//   `--input trial=1` 로 빌드할 때만 아래의 값이 이긴다. 견본을 만드는 두
//   스크립트(style-preview.sh · make-specimen.sh)가 그 인자를 준다. 책 빌드는
//   주지 않으므로 787쪽은 한 톨도 달라지지 않는다.
//   마음에 들면 그때 왼쪽(평소 값)에 옮겨 적는다 --- 그것이 채택이다.
#let trial = sys.inputs.at("trial", default: "0") == "1"
// 다음 시험을 위해 장치는 남겨 둔다: `_pick(지금, 시험)` 으로 감싸면
// `--input trial=1`(견본 스크립트만 준다) 일 때만 오른쪽이 이긴다.
#let _pick(now, try) = if trial { try } else { now }

// ── 왼쪽 세로선 (장치가 영역을 말하는 방식) ─────────────────────
// ★ 선의 색은 하나다(저자 지시 2026-08-10). 굵기로 층위를 말하고 색은 물러
//   선다 --- 표만 예외로 제 색을 쓴다(격자는 색이 옅으면 칸이 안 읽힌다).
#let rule-fill = rgb("#d5d5d5")
#let rail-head = 3.2pt + rule-fill        // 표지·질문 --- 굵다
#let rail-body = 1.2pt + rule-fill  // 내용·답 --- 가늘다
#let rail-gap = 3pt                        // 표지와 내용 사이 (붙지 않는다)
#let rail-pad = 9pt                        // 선과 글 사이
// 서두 칸(「이 장의 필요성과 맥락」 …)의 표지 줄 위아래 숨 --- 넉넉하게
#let open-label-top = 3.5pt
#let open-label-bottom = 3.5pt
// 장치·서두의 *내용* 칸 위아래 숨 --- 예전에는 lib.typ 에 2pt 로 박혀 있었다
#let body-pad-y = 7pt
// 장치(문답·오해·실제 사례·반례·플랫폼·수학·복습)의 *표지 줄* 위아래 숨.
// 시험 중: 서두 다섯 칸의 표지 줄만큼 넉넉하게(저자 지시 2026-08-10).
#let dev-label-top = open-label-top
#let dev-label-bottom = open-label-bottom

// ── 제목 (경계를 말하는 방식: 전폭 밑줄, 수준마다 굵기가 다르다) ──
// ★ 함정: Typst 는 이웃한 블록 사이를 max(뒤의 above, 앞의 below) 로 잡는다.
//   그래서 *제목 블록의 below* 를 거의 0 으로 두어야 밑줄이 글자에 붙는다.
//   필요한 숨은 밑줄 *아래*(head-gap)로 준다.
#let head-rule-w = (2.0pt, 1.0pt, 0.5pt, 0.4pt)   // 1~4단계
// 제목 밑줄의 색 --- 시험 중: 검정 대신 흐린 회색(저자 지시 2026-08-10)
#let head-rule-fill = rule-fill
#let head-gap = (1.55em, 1.28em, 1.08em, 0.95em)  // 밑줄 아래 숨
// 제목과 밑줄 사이 --- 저자 지시 2026-08-11: 더 넉넉하게
#let head-tight = (0.55em, 0.50em, 0.44em, 0.40em)
#let head-above = (auto, 2.1em, 1.7em, 1.4em)     // 제목 위 숨
// 제목의 줄 사이 --- 시험 중: 본문과 같게(저자 지시 2026-08-10). 조판 기본값
// 0.65em 은 두 줄짜리 제목에서 본문보다 눈에 띄게 촘촘하다.
#let head-leading = 0.94em

// ── 본문 ────────────────────────────────────────────────────────
#let body-leading = 0.94em
#let body-size = 10.5pt
// 문단과 문단 사이 --- 일반적인 책의 숨에 가깝게
// ★ 들여쓰기와 문단 사이 여백을 *둘 다* 쓰지 않는다(저자 승인 2026-08-11).
//   첫 줄 들여쓰기가 이미 문단의 시작을 말하므로 여백은 중복이고, 재 보니
//   그 중복이 830쪽에서 30쪽 남짓을 먹고 있었다. 조판의 관례대로 하나만 쓴다.
#let par-spacing = body-leading
// 장 서두 다섯 칸의 *내용* 줄 사이 --- 시험 중: 본문과 같게(저자 지시)
// ★ 서두 칸의 글은 본문과 *완전히 같아야* 한다(저자 지시 2026-08-10) --- 크기도
//   행간도. 값을 따로 두면 반드시 갈린다. body-leading 을 그대로 가리킨다.
#let open-body-leading = body-leading
// 서두 칸 안에서 줄과 줄, 항목과 항목 사이 (「먼저 알아야 할 것」의 두 줄,
// 「이 장에서 답할 질문」의 번호 항목들)
#let open-body-spacing = par-spacing
// 인출 문답의 「답」 칸 안쪽 --- 질문과 답이 붙어 보이지 않게
#let deepqa-a-pad = 4pt

// ── 차례 ────────────────────────────────────────────────────────
// ★ 앞차례(2~15쪽)만 조금 넓게 --- 장 안의 차례는 지금이 알맞다(저자 지시
//   2026-08-10). 두 차례는 값을 따로 쓴다: 앞차례는 절까지 펴서 줄이 빽빽하고,
//   장 안 차례는 그 장 것만 담아 원래 성기다.
#let toc-row-above = 1.10em      // 장 항목 위
#let toc-row-below = 0.58em      // 장 항목 아래
#let toc-sub-gap = 0.60em        // 절 항목 위아래
// 장 안 차례의 줄 간격 --- 시험 중: 앞차례의 절 항목과 같은 값으로 살짝 좁힌다
// (저자 지시 2026-08-10: 「아주 살짝만 줄이고 책 전체 목차와 똑같이」)
// ★ 실측으로 맞춘 값(저자 지시 2026-08-11) --- 200ppi 렌더에서 차례 줄의
//   간격이 18.7pt, 본문 줄이 17.6pt 였다. 그 1.1pt 차이가 「어색함」의 정체다.
#let chtoc-row-gap = 0.84em
#let toc-dot = rgb("#bbbbbb")    // 잇는 점선만 흐리다 (글자는 본문색)

// ── 시연(소스 코드와 실행 결과) --- ★ 여기만 상자를 쓴다 ─────────
// 저자 지시 2026-08-10: 코드와 결과는 옛 모양 그대로 둔다.
// 시연 상자의 테두리 --- 시험 중: 진한 검정 대신 연한 회색(저자 지시 2026-08-10).
// 코드 자체가 이미 검은 덩어리라, 테두리까지 검으면 쪽이 무거워진다.
#let demo-rule = 0.5pt + rule-fill
// ── 표 ─────────────────────────────────────────────────────────
// 시험 중: 바깥 선을 가늘게, 다만 안쪽 선보다는 살짝 굵게(저자 지시 2026-08-10).
#let tbl-outer = 0.6pt
#let tbl-inner = 0.4pt
#let tbl-head  = 0.5pt   // 머리행 아래
#let tbl-outer-fill = rgb("#8a8a8a")
#let tbl-inner-fill = rgb("#c4c4c4")

#let demo-pad-x = 8pt
#let demo-pad-y = 6pt

// ── 지면 ────────────────────────────────────────────────────────
// ★ 제본 여백(gutter). 830쪽을 실제로 묶으면 안쪽이 접혀 들어가 안쪽 글줄이
//   읽기 어렵다. 그래서 좌우를 비대칭으로 둔다 --- 합계는 예전(4.4cm)과 같게
//   유지해 판면 폭과 밀도는 그대로다(저자 승인 2026-08-11).
#let margin-inside = 2.7cm
#let margin-outside = 1.7cm
#let margin-y = 2.5cm

// ── 쪽 머리말 ───────────────────────────────────────────────────
#let runhead-size = 8.5pt
// 시험 중: 쪽 머리말도 흐린 회색(저자 지시 2026-08-10) --- 쪽마다 되풀이되는
// 글이라 진하면 눈에 걸린다. 선보다는 조금 진해야 읽힌다.
#let runhead-fill = rgb("#9a9a9a")
