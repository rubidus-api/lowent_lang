{
  "comments": { "lineComment": "rem " },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["\"", "\""]],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "\\bdo\\s*(rem\\b.*)?$",
    "decreaseIndentPattern": "^\\s*end\\b"
  }
}
